{
  "scopeName": "source.orna",
  "patterns": [{ "include": "#comments" }, { "include": "#string" }, { "include": "#contextual_name" }, { "include": "#keyword" }, { "include": "#number" }, { "include": "#operator" }, { "include": "#punctuation" }, { "include": "#identifier" }],
  "repository": {
    "comments": { "patterns": [{ "include": "#line_comment" }, { "include": "#block_comment" }] },
    "line_comment": { "name": "comment.orna", "match": "//.*" },
    "block_comment": { "name": "comment.orna", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#block_comment" }] },
    "string": { "name": "string.quoted.double.orna", "begin": "\"", "end": "\"", "patterns": [
      { "name": "constant.character.escape.orna", "match": "\\\\(?:[\"0\\\\nrt]|u\\{[0-9A-Fa-f]{1,6}\\})" },
      { "name": "meta.interpolation.orna", "begin": "\\{", "end": "\\}", "beginCaptures": { "0": { "name": "punctuation.orna" } }, "endCaptures": { "0": { "name": "punctuation.orna" } }, "patterns": [{ "include": "#expressions" }] }
    ]},
    "braces": { "begin": "\\{", "end": "\\}", "beginCaptures": { "0": { "name": "punctuation.orna" } }, "endCaptures": { "0": { "name": "punctuation.orna" } }, "patterns": [{ "include": "#expressions" }] },
    "expressions": { "patterns": [{ "include": "#comments" }, { "include": "#string" }, { "include": "#braces" }, { "include": "#contextual_name" }, { "include": "#keyword" }, { "include": "#number" }, { "include": "#operator" }, { "include": "#punctuation" }, { "include": "#identifier" }] },
    "contextual_name": { "name": "variable.other.orna", "match": "(?:(?<=[^.]\\.)|(?<=^\\.))(?:continue|protocol|assert|offset|affine|return|static|break|false|table|while|base|case|else|enum|impl|loop|null|self|true|type|unit|dim|for|let|pub|use|as|fn|if|in)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}])|(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}])(?:continue|protocol|assert|offset|affine|return|static|break|table|while|base|case|else|enum|impl|loop|self|type|unit|dim|for|let|pub|use|as|fn|if|in)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}])(?=[ \\t]*:)" },
    "keyword": { "name": "keyword.control.orna", "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}])(?:continue|protocol|assert|offset|affine|return|static|break|false|table|while|base|case|else|enum|impl|loop|null|self|true|type|unit|dim|for|let|pub|use|as|fn|if|in)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}])" },
    "number": { "name": "constant.numeric.orna", "match": "(?<![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}])(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9][0-9]*)?(?:Z|[+\\-][0-9]{2}:[0-9]{2})|[0-9]{4}-[0-9]{2}-[0-9]{2}|0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0b[01](?:_?[01])*|[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[Ee][+\\-]?[0-9](?:_?[0-9])*)?f?)(?![\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}])" },
    "operator": { "name": "keyword.operator.orna", "match": "(?:\\.\\.=|=>|==|!=|<=|>=|\\?\\?|\\|\\?|&&|\\|\\||\\+=|-=|\\*=|/=|\\.\\.|\\||!|=|<|>|\\+|-|\\*|/|%|\\^|\\?)" },
    "punctuation": { "name": "punctuation.orna", "match": "(?:\\{|\\}|\\(|\\)|\\[|\\]|,|;|:|\\.)" },
    "identifier": { "name": "variable.other.orna", "match": "[_\\p{L}\\p{Nl}][\\p{L}\\p{Nl}\\p{Mn}\\p{Mc}\\p{Nd}\\p{Pc}]*" }
  }
}
