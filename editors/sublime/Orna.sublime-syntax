%YAML 1.2
---
name: Orna 1.0
file_extensions: [orna]
scope: source.orna
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.orna
    - match: '/\*'
      push: block-comment
    - match: '"(?:\\.|[^"\\])*"'
      scope: string.quoted.double.orna
    - match: '\b(?:as|assert|base|break|case|continue|dim|else|enum|false|fn|for|if|impl|in|let|loop|null|offset|affine|protocol|pub|return|self|static|table|true|type|unit|use|while)\b'
      scope: keyword.control.orna
    - match: '\b[0-9]+(?:\.[0-9]+)?\b'
      scope: constant.numeric.orna
    - match: '[[:alpha:]_][[:alnum:]_]*'
      scope: variable.other.orna
    - match: '[+*/%^=!<>|?&.-]+'
      scope: keyword.operator.orna
  block-comment:
    - meta_scope: comment.block.orna
    - match: '\*/'
      pop: true
    - match: '/\*'
      push: block-comment
