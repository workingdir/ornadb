{
    "name": "tree-sitter-orna",
    "version": "0.1.0",
    "private": true,
    "description": "Tree-sitter grammar for the Orna language",
    "tree-sitter": {
        "scopes": {
            "source.orna": "orna"
        },
        "file-types": [
            "orna"
        ],
        "highlights": [
            "queries/highlights.scm"
        ]
    },
    "devDependencies": {
        "tree-sitter-cli": "^0.26.5"
    }
}
