{ id: "asset-6173736574732f7374646c69622f7374642f74696d652e6f726e61", path: "assets/stdlib/std/time.orna", media_type: "text/plain; charset=utf-8", content: "// The evaluator profile embeds this immutable time-zone edition. Keeping its\n// identity in ordinary pinned source lets old snapshots reject runtime data\n// they did not capture instead of silently borrowing the current edition.\npub fn timezone_data_version(): Str = \"orna-iana-2024a\";\n\n// These helpers name elapsed arithmetic explicitly. Calendar movement belongs\n// to std.time.calendar and never treats a civil day or month as fixed seconds.\npub fn add_elapsed(instant: Instant, elapsed: Duration): Instant = instant + elapsed;\n\npub fn elapsed_between(start: Instant, end: Instant): Duration = end - start;\n\n/// Returns the earlier absolute instant. Equal instants preserve the left value.\npub fn instant_min(left: Instant, right: Instant): Instant =\n    if left <= right \u{7b} left \u{7d} else \u{7b} right \u{7d};\n\n/// Returns the later absolute instant. Equal instants preserve the left value.\npub fn instant_max(left: Instant, right: Instant): Instant =\n    if left >= right \u{7b} left \u{7d} else \u{7b} right \u{7d};\n\n/// Bounds an absolute instant to an inclusive interval. Reversed bounds return\n/// the lower bound, matching std.math.clamp and duration_clamp.\npub fn instant_clamp(value: Instant, lower: Instant, upper: Instant): Instant =\n    instant_max(lower, instant_min(value, upper));\n\n/// Returns the non-negative magnitude of an elapsed duration without converting\n/// it through floating point or changing its nanosecond precision.\npub fn duration_abs(value: Duration): Duration =\n    if value < 0.seconds \u{7b} -value \u{7d} else \u{7b} value \u{7d};\n\n/// Returns -1, 0 or 1 for a negative, zero or positive elapsed duration.\npub fn duration_signum(value: Duration): Int =\n    if value < 0.seconds \u{7b} -1 \u{7d} else if value > 0.seconds \u{7b} 1 \u{7d} else \u{7b} 0 \u{7d};\n\n/// Returns the lesser duration; equal values return the right operand.\npub fn duration_min(left: Duration, right: Duration): Duration =\n    if left < right \u{7b} left \u{7d} else \u{7b} right \u{7d};\n\n/// Returns the greater duration; equal values return the right operand.\npub fn duration_max(left: Duration, right: Duration): Duration =\n    if left > right \u{7b} left \u{7d} else \u{7b} right \u{7d};\n\n/// Bounds an elapsed duration to the inclusive interval. Like std.math.clamp,\n/// reversed bounds return the lower bound. All comparisons remain exact.\npub fn duration_clamp(value: Duration, lower: Duration, upper: Duration): Duration =\n    duration_max(lower, duration_min(value, upper));\n\n// This pinned profile carries UTC and Europe/London from its recorded IANA\n// edition. Other IANA identifiers are unsupported and fail closed; evaluation\n// never consults a host-installed zone database. Offsets are signed seconds\n// east of UTC at the requested Instant, including the new offset at an exact\n// transition. Callers always supply a zone and never inherit a process-local\n// default.\npub fn offset_at(instant: Instant, zone: Str): Int = __offset_at(instant, zone);\nfn __offset_at(instant: Instant, zone: Str): Int = offset_at(instant, zone);\n\n// `local` is exactly YYYY-MM-DDTHH:MM:SS with an optional dot and 1..9 ASCII\n// fractional digits. It has no offset suffix; invalid Gregorian dates, hour\n// or minute overflow, leap-second 60, and fractions longer than nanoseconds\n// are rejected. A fraction is right-padded to nanoseconds (`.1` means\n// 100,000,000 nanoseconds). `ambiguous` must explicitly be\n// \"earlier\", \"later\", or \"reject\". The first two choices select an overlap\n// occurrence; \"reject\" accepts only unique local times. `gap` defaults to\n// \"reject\" and may be \"shift_forward\" or \"shift_backward\" for a nonexistent\n// local time. A shift preserves the position within the gap using the offset\n// before or after the transition, respectively.\npub fn resolve_local(local: Str, zone: Str, ambiguous: Str, gap: Str? = null): Instant =\n    __resolve_local(local, zone, ambiguous, gap);\nfn __resolve_local(local: Str, zone: Str, ambiguous: Str, gap: Str?): Instant =\n    resolve_local(local, zone, ambiguous, gap);\n\n// Keep the four elapsed-duration presentations reachable from std.time. Their\n// sources are separate pinned modules, so a snapshot captures each formatter\n// independently and cannot acquire one from an installed library later.\n// Elapsed decimal unit literals must resolve exactly to core nanoseconds;\n// calendar day periods stay distinct and cannot be formatted as elapsed time.\n// Gregorian civil-date helpers are source-level functions with no zone or\n// elapsed-clock dependency.\nuse std.time.calendar as calendar;\nuse std.time.duration.compact;\nuse std.time.duration.clock;\nuse std.time.duration.words;\nuse std.time.duration.iso;\n" }
