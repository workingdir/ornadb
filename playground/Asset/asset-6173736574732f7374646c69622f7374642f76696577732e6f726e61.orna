{ id: "asset-6173736574732f7374646c69622f7374642f76696577732e6f726e61", path: "assets/stdlib/std/views.orna", media_type: "text/plain; charset=utf-8", content: "// Views keep one immutable source list and a zero-based half-open range into\n// it. Constructing and slicing a view retain that source; `to_list` explicitly\n// materializes the selected values in source order.\n// The enum variant is public, so operations validate ranges constructed\n// directly by callers as well as ranges returned by these helpers.\npub enum View<T> \u{7b}\n    Slice \u{7b} source: [T], start: Int, end: Int \u{7d},\n\u{7d}\n\nfn valid_range<T>(source: [T], start: Int, end: Int): Bool =\n    start >= 0 && end >= start && end <= std.collection.count(source);\n\npub fn from_list<T>(source: [T]): View<T> = View.Slice \u{7b}\n    source: source,\n    start: 0,\n    end: std.collection.count(source),\n\u{7d};\n\npub fn length<T>(view: View<T>): Int = case view \u{7b}\n    View.Slice \u{7b} source, start, end \u{7d}:\n        if valid_range(source, start, end) \u{7b}\n            end - start\n        \u{7d} else \u{7b}\n            fail(error(code: \"std.views.invalid_view\", message: \"view range is outside its source list\"))\n        \u{7d},\n\u{7d};\n\npub fn is_empty<T>(view: View<T>): Bool = length(view) == 0;\n\n// `get` returns null for any negative or out-of-range index. A present list\n// element is returned as Some(value); no later elements are enumerated.\npub fn get<T>(view: View<T>, index: Int): T? = case view \u{7b}\n    View.Slice \u{7b} source, start, end \u{7d}:\n        if !valid_range(source, start, end) \u{7b}\n            fail(error(code: \"std.views.invalid_view\", message: \"view range is outside its source list\"))\n        \u{7d} else if index < 0 || index >= end - start \u{7b}\n            null\n        \u{7d} else \u{7b}\n            std.collection.first(std.collection.drop(source, start + index))\n        \u{7d},\n\u{7d};\n\n// Slice bounds are relative to the current view and use [start, end).\n// Invalid bounds fail instead of being clamped. The result retains the original list.\npub fn slice<T>(view: View<T>, start: Int, end: Int): View<T> = case view \u{7b}\n    View.Slice \u{7b} source, start: base_start, end: base_end \u{7d}:\n        if !valid_range(source, base_start, base_end) \u{7b}\n            fail(error(code: \"std.views.invalid_view\", message: \"view range is outside its source list\"))\n        \u{7d} else if start < 0 || end < start || end > base_end - base_start \u{7b}\n            fail(error(\n                code: \"std.views.invalid_bounds\",\n                message: \"slice bounds must satisfy 0 <= start <= end <= view length\"\n            ))\n        \u{7d} else \u{7b}\n            View.Slice \u{7b}\n                source: source,\n                start: base_start + start,\n                end: base_start + end,\n            \u{7d}\n        \u{7d},\n\u{7d};\n\npub fn take<T>(view: View<T>, count: Int): View<T> =\n    if count < 0 \u{7b}\n        fail(error(code: \"std.views.negative_count\", message: \"view count must be nonnegative\"))\n    \u{7d} else \u{7b}\n        slice(view, 0, if count < length(view) \u{7b} count \u{7d} else \u{7b} length(view) \u{7d})\n    \u{7d};\n\npub fn drop<T>(view: View<T>, count: Int): View<T> =\n    if count < 0 \u{7b}\n        fail(error(code: \"std.views.negative_count\", message: \"view count must be nonnegative\"))\n    \u{7d} else \u{7b}\n        slice(\n            view,\n            if count < length(view) \u{7b} count \u{7d} else \u{7b} length(view) \u{7d},\n            length(view)\n        )\n    \u{7d};\n\npub fn to_list<T>(view: View<T>): [T] = case view \u{7b}\n    View.Slice \u{7b} source, start, end \u{7d}:\n        if valid_range(source, start, end) \u{7b}\n            std.collection.take(std.collection.drop(source, start), end - start)\n        \u{7d} else \u{7b}\n            fail(error(code: \"std.views.invalid_view\", message: \"view range is outside its source list\"))\n        \u{7d},\n\u{7d};\n\nfn windows_from<T>(\n    view: View<T>,\n    width: Int,\n    step: Int,\n    cursor_index: Int,\n    collected: [View<T>]\n): [View<T>] =\n    if cursor_index + width > length(view) \u{7b}\n        collected\n    \u{7d} else \u{7b}\n        windows_from(\n            view,\n            width,\n            step,\n            cursor_index + step,\n            std.collection.union(\n                collected,\n                [slice(view, cursor_index, cursor_index + width)]\n            )\n        )\n    \u{7d};\n\n// Windows are complete views starting at offsets 0, step, 2*step, and so on.\n// An incomplete final window is omitted; empty input yields [].\npub fn windows<T>(view: View<T>, width: Int, step: Int = 1): [View<T>] =\n    if width <= 0 \u{7b}\n        fail(error(code: \"std.views.invalid_width\", message: \"window width must be positive\"))\n    \u{7d} else if step <= 0 \u{7b}\n        fail(error(code: \"std.views.invalid_step\", message: \"window step must be positive\"))\n    \u{7d} else \u{7b}\n        windows_from(view, width, step, 0, [])\n    \u{7d};\n" }
