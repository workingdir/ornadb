{ id: "asset-6173736574732f7374646c69622f7374642f6974657261746f722e6f726e61", path: "assets/stdlib/std/iterator.orna", media_type: "text/plain; charset=utf-8", content: "// Iterators are persistent pull cursors. Creating or composing one does no\n// traversal; `next` requests one value and returns a new cursor without\n// mutating the input cursor. A cursor may be shared: pulling the same cursor\n// again replays its computation, including callback calls, so use pure\n// callbacks when repeatable observations are required. These in-memory\n// iterators do not wait, checkpoint, or perform stream-provider work, and do\n// not transfer or close an external resource when a successor is returned.\npub type Iterator<T> \u{7b}\n    pub pull: fn(): (T?, Iterator<T>),\n\u{7d}\n\npub fn empty<T>(): Iterator<T> = Iterator \u{7b}\n    pull: () => (null, empty()),\n\u{7d};\n\n// Advances by observation: the returned cursor represents the successor while\n// `iterator` remains available to replay from its original position.\npub fn next<T>(iterator: Iterator<T>): (T?, Iterator<T>) = iterator.pull();\n\nfn list_pull<T>(values: [T], start_index: Int): (T?, Iterator<T>) =\n    if start_index < std.collection.count(values) \u{7b}\n        (\n            Some(values[start_index]),\n            Iterator \u{7b} pull: () => list_pull(values, start_index + 1) \u{7d},\n        )\n    \u{7d} else \u{7b}\n        (null, empty())\n    \u{7d};\n\npub fn from_list<T>(values: [T]): Iterator<T> = Iterator \u{7b}\n    pull: () => list_pull(values, 0),\n\u{7d};\n\n// Infinite sources stay productive: the successor is computed only when the\n// following cursor is pulled. Use `take` before `collect` on an infinite source.\npub fn iterate<T>(seed: T, successor: fn(T): T): Iterator<T> = Iterator \u{7b}\n    pull: () => (\n        Some(seed),\n        Iterator \u{7b}\n            pull: () => next(iterate(successor(seed), successor)),\n        \u{7d},\n    ),\n\u{7d};\n\npub fn repeat<T>(value: T): Iterator<T> = Iterator \u{7b}\n    pull: () => (Some(value), repeat(value)),\n\u{7d};\n\nfn map_pull<T, U>(source: Iterator<T>, transform: fn(T): U): (U?, Iterator<U>) =\n    case next(source) \u{7b}\n        (Some(value), tail): (\n            Some(transform(value)),\n            Iterator \u{7b} pull: () => map_pull(tail, transform) \u{7d},\n        ),\n        (null, _): (null, empty()),\n    \u{7d};\n\npub fn map<T, U>(source: Iterator<T>, transform: fn(T): U): Iterator<U> =\n    Iterator \u{7b} pull: () => map_pull(source, transform) \u{7d};\n\nfn chain_pull<T>(left: Iterator<T>, right: Iterator<T>): (T?, Iterator<T>) =\n    case next(left) \u{7b}\n        (Some(value), tail): (\n            Some(value),\n            Iterator \u{7b} pull: () => chain_pull(tail, right) \u{7d},\n        ),\n        (null, _): next(right),\n    \u{7d};\n\n// Pulls every item from left before requesting an item from right.\npub fn chain<T>(left: Iterator<T>, right: Iterator<T>): Iterator<T> =\n    Iterator \u{7b} pull: () => chain_pull(left, right) \u{7d};\n\nfn zip_with_pull<T, U, V>(\n    left: Iterator<T>, right: Iterator<U>, combine: fn(T, U): V\n): (V?, Iterator<V>) =\n    case next(left) \u{7b}\n        (Some(left_value), left_tail): case next(right) \u{7b}\n            (Some(right_value), right_tail): (\n                Some(combine(left_value, right_value)),\n                Iterator \u{7b}\n                    pull: () => zip_with_pull(left_tail, right_tail, combine),\n                \u{7d},\n            ),\n            (null, _): (null, empty()),\n        \u{7d},\n        (null, _): (null, empty()),\n    \u{7d};\n\n// Pulls one value from each cursor in left-to-right order. Stops as soon as\n// either input is exhausted; an unmatched value is never emitted.\npub fn zip_with<T, U, V>(\n    left: Iterator<T>, right: Iterator<U>, combine: fn(T, U): V\n): Iterator<V> = Iterator \u{7b}\n    pull: () => zip_with_pull(left, right, combine),\n\u{7d};\n\n// Zips in input order and stops at the shorter cursor. The resulting cursor is\n// persistent like its inputs: re-pulling an input cursor does not consume it.\npub fn zip<T, U>(left: Iterator<T>, right: Iterator<U>): Iterator<(T, U)> =\n    zip_with(left, right, (left_value, right_value) => (left_value, right_value));\n\nfn enumerate_pull<T>(source: Iterator<T>, index: Int): ((Int, T)?, Iterator<(Int, T)>) =\n    case next(source) \u{7b}\n        (Some(value), tail): (\n            Some((index, value)),\n            Iterator \u{7b} pull: () => enumerate_pull(tail, index + 1) \u{7d},\n        ),\n        (null, _): (null, empty()),\n    \u{7d};\n\n// Enumeration starts at zero and advances once per emitted item.\npub fn enumerate<T>(source: Iterator<T>): Iterator<(Int, T)> =\n    Iterator \u{7b} pull: () => enumerate_pull(source, 0) \u{7d};\n\nfn filter_pull<T>(source: Iterator<T>, predicate: fn(T): Bool): (T?, Iterator<T>) =\n    case next(source) \u{7b}\n        (Some(value), tail) if predicate(value): (\n            Some(value),\n            Iterator \u{7b} pull: () => filter_pull(tail, predicate) \u{7d},\n        ),\n        (Some(_), tail): filter_pull(tail, predicate),\n        (null, _): (null, empty()),\n    \u{7d};\n\npub fn filter<T>(source: Iterator<T>, predicate: fn(T): Bool): Iterator<T> =\n    Iterator \u{7b} pull: () => filter_pull(source, predicate) \u{7d};\n\nfn take_while_pull<T>(source: Iterator<T>, predicate: fn(T): Bool): (T?, Iterator<T>) =\n    case next(source) \u{7b}\n        (Some(value), tail) if predicate(value): (\n            Some(value),\n            Iterator \u{7b} pull: () => take_while_pull(tail, predicate) \u{7d},\n        ),\n        (Some(_), _): (null, empty()),\n        (null, _): (null, empty()),\n    \u{7d};\n\n// Stops at the first rejected value; later source items are never requested.\npub fn take_while<T>(source: Iterator<T>, predicate: fn(T): Bool): Iterator<T> =\n    Iterator \u{7b} pull: () => take_while_pull(source, predicate) \u{7d};\n\nfn scan_emit<T, U>(source: Iterator<T>, accumulated: U, combine: fn(U, T): U): (U?, Iterator<U>) =\n    (\n        Some(accumulated),\n        Iterator \u{7b} pull: () => scan_pull(source, accumulated, combine) \u{7d},\n    );\n\nfn scan_pull<T, U>(source: Iterator<T>, accumulated: U, combine: fn(U, T): U): (U?, Iterator<U>) =\n    case next(source) \u{7b}\n        (Some(value), tail): scan_emit(tail, combine(accumulated, value), combine),\n        (null, _): (null, empty()),\n    \u{7d};\n\n// Emits one left-to-right accumulated value for each source item; the initial\n// value is the accumulator seed and is not emitted for an empty source.\npub fn scan<T, U>(source: Iterator<T>, initial: U, combine: fn(U, T): U): Iterator<U> =\n    Iterator \u{7b} pull: () => scan_pull(source, initial, combine) \u{7d};\n\nfn take_pull<T>(source: Iterator<T>, remaining: Int): (T?, Iterator<T>) =\n    if remaining == 0 \u{7b}\n        (null, empty())\n    \u{7d} else \u{7b}\n        case next(source) \u{7b}\n            (Some(value), tail): (\n                Some(value),\n                Iterator \u{7b} pull: () => take_pull(tail, remaining - 1) \u{7d},\n            ),\n            (null, _): (null, empty()),\n        \u{7d}\n    \u{7d};\n\npub fn take<T>(source: Iterator<T>, count: Int): Iterator<T> =\n    if count < 0 \u{7b}\n        fail(error(code: \"std.iterator.negative_count\", message: \"iterator count must be nonnegative\"))\n    \u{7d} else \u{7b}\n        Iterator \u{7b} pull: () => take_pull(source, count) \u{7d}\n    \u{7d};\n\nfn drop_pull<T>(source: Iterator<T>, remaining: Int): (T?, Iterator<T>) =\n    if remaining == 0 \u{7b}\n        next(source)\n    \u{7d} else \u{7b}\n        case next(source) \u{7b}\n            (Some(_), tail): drop_pull(tail, remaining - 1),\n            (null, _): (null, empty()),\n        \u{7d}\n    \u{7d};\n\npub fn drop<T>(source: Iterator<T>, count: Int): Iterator<T> =\n    if count < 0 \u{7b}\n        fail(error(code: \"std.iterator.negative_count\", message: \"iterator count must be nonnegative\"))\n    \u{7d} else \u{7b}\n        Iterator \u{7b} pull: () => drop_pull(source, count) \u{7d}\n    \u{7d};\n\nfn collect_into<T>(source: Iterator<T>, collected: [T]): [T] =\n    case next(source) \u{7b}\n        (Some(value), tail): collect_into(tail, std.collection.union(collected, [value])),\n        (null, _): collected,\n    \u{7d};\n\n// Terminal operation. Finite iterators are required; infinite ones should be\n// bounded with `take` before collection.\npub fn collect<T>(source: Iterator<T>): [T] = collect_into(source, []);\n\nfn fold_from<T, U>(source: Iterator<T>, accumulator: U, combine: fn(U, T): U): U =\n    case next(source) \u{7b}\n        (Some(value), tail): fold_from(tail, combine(accumulator, value), combine),\n        (null, _): accumulator,\n    \u{7d};\n\n// Folds a finite iterator from left to right; an infinite source does not terminate.\npub fn fold<T, U>(source: Iterator<T>, initial: U, combine: fn(U, T): U): U =\n    fold_from(source, initial, combine);\n\npub fn first<T>(source: Iterator<T>): T? = case next(source) \u{7b}\n    (Some(value), _): Some(value),\n    (null, _): null,\n\u{7d};\n\nfn last_from<T>(source: Iterator<T>, previous: T?): T? =\n    case next(source) \u{7b}\n        (Some(value), tail): last_from(tail, Some(value)),\n        (null, _): previous,\n    \u{7d};\n\n// Returns the last item of a finite iterator, or null when it is empty.\npub fn last<T>(source: Iterator<T>): T? = last_from(source, null);\n\nfn nth_from<T>(source: Iterator<T>, index: Int): T? =\n    if index == 0 \u{7b}\n        first(source)\n    \u{7d} else \u{7b}\n        case next(source) \u{7b}\n            (Some(_), tail): nth_from(tail, index - 1),\n            (null, _): null,\n        \u{7d}\n    \u{7d};\n\n// The index is zero-based. An empty source or an index beyond the final item\n// returns null; a negative index fails with std.iterator.negative_index.\npub fn nth<T>(source: Iterator<T>, index: Int): T? =\n    if index < 0 \u{7b}\n        fail(error(code: \"std.iterator.negative_index\", message: \"iterator index must be nonnegative\"))\n    \u{7d} else \u{7b}\n        nth_from(source, index)\n    \u{7d};\n" }
