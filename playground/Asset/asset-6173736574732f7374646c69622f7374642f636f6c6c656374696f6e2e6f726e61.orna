{ id: "asset-6173736574732f7374646c69622f7374642f636f6c6c656374696f6e2e6f726e61", path: "assets/stdlib/std/collection.orna", media_type: "text/plain; charset=utf-8", content: "// Finite list operations are ordinary Orna functions. The small private\n// leaves below are evaluator primitives for immutable list size/assembly and\n// numeric or relation operations whose source types are intentionally erased.\n// Public collection behavior is expressed by the functions that follow.\n// Contracts: partition returns (matching, remaining); zip stops at the shorter input; unique keeps each lawful equality class's first occurrence; lawful keys while preserving input order inside each group; adjacent and overlapping pairs; window emits complete windows only; split_when starts a group before a matching item; competition ranks (ties share a rank and later ranks skip tied positions).\n// Edge contracts: empty valid chunk/window/partition/pair inputs return empty\n// collections without invoking callbacks. zip truncates to the shorter side, while\n// zip_exact rejects unequal lengths with `std.collection.zip_length_mismatch`.\n// split_when omits empty groups even for leading or adjacent boundaries.\nfn __list_length<T>(values: [T]): Int = 0;\nfn __list_concat<T>(left: [T], right: [T]): [T] = [];\nfn __numeric_sum<T>(values: [T]): T = 0;\nfn __stable_sort<T, K>(values: [T], key: fn(T): K): [T] = values;\nfn __minimum<T>(values: [T]): T? = null;\nfn __maximum<T>(values: [T]): T? = null;\nfn __group_by<T, K>(values: [T], key: fn(T): K): [(K, [T])] = [];\nfn __rank<T, K>(values: [T], key: fn(T): K): [(T, Int)] = [];\nfn __asof_join<T, Time, Key>(\n    left: [T], right: [T], time: fn(T): Time, by: fn(T): Key\n): [(T, T?)] = [];\nfn __bucket_by<T, P>(rows: [T], period: P, zone: Str): [[T]] = [];\n\nfn append<T>(values: [T], value: T): [T] = __list_concat(values, [value]);\n\nfn slice_range<T>(values: [T], index: Int, end: Int, output: [T]): [T] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        slice_range(values, index + 1, end, append(output, values[index]))\n    \u{7d};\n\nfn filter_from<T>(\n    values: [T], predicate: fn(T): Bool, index: Int, end: Int, output: [T]\n): [T] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        let value = values[index];\n        filter_from(\n            values,\n            predicate,\n            index + 1,\n            end,\n            if predicate(value) \u{7b} append(output, value) \u{7d} else \u{7b} output \u{7d}\n        )\n    \u{7d};\n\nfn map_from<T, U>(\n    values: [T], transform: fn(T): U, index: Int, end: Int, output: [U]\n): [U] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        map_from(values, transform, index + 1, end, append(output, transform(values[index])))\n    \u{7d};\n\nfn flat_map_from<T, U>(\n    values: [T], transform: fn(T): [U], index: Int, end: Int, output: [U]\n): [U] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        flat_map_from(\n            values,\n            transform,\n            index + 1,\n            end,\n            __list_concat(output, transform(values[index]))\n        )\n    \u{7d};\n\nfn contains_from<T>(values: [T], value: T, index: Int, end: Int): Bool =\n    if index >= end \u{7b}\n        false\n    \u{7d} else if values[index] == value \u{7b}\n        true\n    \u{7d} else \u{7b}\n        contains_from(values, value, index + 1, end)\n    \u{7d};\n\nfn distinct_from<T>(values: [T], index: Int, end: Int, output: [T]): [T] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        let value = values[index];\n        distinct_from(\n            values,\n            index + 1,\n            end,\n            if contains_from(output, value, 0, __list_length(output)) \u{7b}\n                output\n            \u{7d} else \u{7b}\n                append(output, value)\n            \u{7d}\n        )\n    \u{7d};\n\nfn every_from<T>(values: [T], predicate: fn(T): Bool, index: Int, end: Int): Bool =\n    if index >= end \u{7b}\n        true\n    \u{7d} else if predicate(values[index]) \u{7b}\n        every_from(values, predicate, index + 1, end)\n    \u{7d} else \u{7b}\n        false\n    \u{7d};\n\nfn exists_from<T>(values: [T], predicate: fn(T): Bool, index: Int, end: Int): Bool =\n    if index >= end \u{7b}\n        false\n    \u{7d} else if predicate(values[index]) \u{7b}\n        true\n    \u{7d} else \u{7b}\n        exists_from(values, predicate, index + 1, end)\n    \u{7d};\n\nfn partition_from<T>(\n    values: [T], predicate: fn(T): Bool, index: Int, end: Int, yes: [T], no: [T]\n): ([T], [T]) =\n    if index >= end \u{7b}\n        (yes, no)\n    \u{7d} else \u{7b}\n        let value = values[index];\n        if predicate(value) \u{7b}\n            partition_from(values, predicate, index + 1, end, append(yes, value), no)\n        \u{7d} else \u{7b}\n            partition_from(values, predicate, index + 1, end, yes, append(no, value))\n        \u{7d}\n    \u{7d};\n\nfn flatten_from<T>(values: [[T]], index: Int, end: Int, output: [T]): [T] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        flatten_from(values, index + 1, end, __list_concat(output, values[index]))\n    \u{7d};\n\nfn zip_from<T, U>(left: [T], right: [U], index: Int, end: Int, output: [(T, U)]): [(T, U)] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        zip_from(left, right, index + 1, end, append(output, (left[index], right[index])))\n    \u{7d};\n\nfn chunk_from<T>(values: [T], size: Int, index: Int, end: Int, output: [[T]]): [[T]] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        let next = if index + size < end \u{7b} index + size \u{7d} else \u{7b} end \u{7d};\n        chunk_from(values, size, next, end, append(output, slice_range(values, index, next, [])))\n    \u{7d};\n\nfn pairs_from<T>(values: [T], index: Int, end: Int, output: [(T, T)]): [(T, T)] =\n    if index + 1 >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        pairs_from(values, index + 1, end, append(output, (values[index], values[index + 1])))\n    \u{7d};\n\nfn windows_from<T>(\n    values: [T], size: Int, step: Int, index: Int, end: Int, output: [[T]]\n): [[T]] =\n    if index + size > end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        windows_from(\n            values,\n            size,\n            step,\n            index + step,\n            end,\n            append(output, slice_range(values, index, index + size, []))\n        )\n    \u{7d};\n\nfn split_when_from<T>(\n    values: [T], predicate: fn(T): Bool, index: Int, end: Int,\n    groups: [[T]], current: [T]\n): [[T]] =\n    if index >= end \u{7b}\n        if __list_length(current) == 0 \u{7b} groups \u{7d} else \u{7b} append(groups, current) \u{7d}\n    \u{7d} else \u{7b}\n        let value = values[index];\n        if predicate(value) && __list_length(current) > 0 \u{7b}\n            split_when_from(values, predicate, index + 1, end, append(groups, current), [value])\n        \u{7d} else \u{7b}\n            split_when_from(values, predicate, index + 1, end, groups, append(current, value))\n        \u{7d}\n    \u{7d};\n\n// The evaluator chooses the finite-list implementation from this exact\n// source overload; Relation<T> calls remain relation plans in the core.\npub fn filter<T>(rows: [T], predicate: fn(T): Bool): [T] =\n    filter_from(rows, predicate, 0, __list_length(rows), []);\n\npub fn map<T, U>(rows: [T], transform: fn(T): U): [U] =\n    map_from(rows, transform, 0, __list_length(rows), []);\n\npub fn flat_map<T, U>(rows: [T], transform: fn(T): [U]): [U] =\n    flat_map_from(rows, transform, 0, __list_length(rows), []);\n\n// Key ordering and numeric total-order details are delegated to the leaf\n// sorter; the exported function is an ordinary source function.\npub fn sort_by<T, K>(rows: [T], key: fn(T): K): [T] = __stable_sort(rows, key);\n\npub fn take<T>(rows: [T], count: Int): [T] =\n    if count < 0 \u{7b}\n        fail(error(code: \"std.collection.negative_count\", message: \"take count must be nonnegative\"))\n    \u{7d} else \u{7b}\n        slice_range(rows, 0, if count < __list_length(rows) \u{7b} count \u{7d} else \u{7b} __list_length(rows) \u{7d}, [])\n    \u{7d};\n\npub fn drop<T>(rows: [T], count: Int): [T] =\n    if count < 0 \u{7b}\n        fail(error(code: \"std.collection.negative_count\", message: \"drop count must be nonnegative\"))\n    \u{7d} else \u{7b}\n        let end = __list_length(rows);\n        slice_range(rows, if count < end \u{7b} count \u{7d} else \u{7b} end \u{7d}, end, [])\n    \u{7d};\n\npub fn distinct<T>(rows: [T]): [T] =\n    distinct_from(rows, 0, __list_length(rows), []);\n\npub fn union<T>(left: [T], right: [T]): [T] = __list_concat(left, right);\n\npub fn count<T>(rows: [T]): Int = __list_length(rows);\n\npub fn first<T>(rows: [T]): T? =\n    if __list_length(rows) == 0 \u{7b} null \u{7d} else \u{7b} Some(rows[0]) \u{7d};\n\npub fn one<T>(rows: [T], predicate: fn(T): Bool = value => true): T =\n    case filter(rows, predicate) \u{7b}\n        []: fail(error(code: \"std.collection.one.none\", message: \"one requires exactly one matching value\")),\n        [value]: value,\n        _: fail(error(code: \"std.collection.one.multiple\", message: \"one found multiple matching values\")),\n    \u{7d};\n\npub fn sum<T>(rows: [T]): T = __numeric_sum(rows);\n\npub fn min<T>(rows: [T]): T? = __minimum(rows);\n\npub fn max<T>(rows: [T]): T? = __maximum(rows);\n\npub fn every<T>(rows: [T], predicate: fn(T): Bool): Bool =\n    every_from(rows, predicate, 0, __list_length(rows));\n\npub fn exists<T>(rows: [T], predicate: fn(T): Bool): Bool =\n    exists_from(rows, predicate, 0, __list_length(rows));\n\npub fn asof_join<T, Time, Key>(\n    left: [T], right: [T], time: fn(T): Time, by: fn(T): Key\n): [(T, T?)] = __asof_join(left, right, time, by);\n\npub fn chunk<T>(values: [T], size: Int): [[T]] =\n    if size <= 0 \u{7b}\n        fail(error(code: \"std.collection.invalid_chunk_size\", message: \"chunk size must be positive\"))\n    \u{7d} else \u{7b}\n        chunk_from(values, size, 0, __list_length(values), [])\n    \u{7d};\n\npub fn flatten<T>(values: [[T]]): [T] =\n    flatten_from(values, 0, __list_length(values), []);\n\npub fn partition<T>(values: [T], predicate: fn(T): Bool): ([T], [T]) =\n    partition_from(values, predicate, 0, __list_length(values), [], []);\n\npub fn zip<T, U>(left: [T], right: [U]): [(T, U)] =\n    zip_from(\n        left,\n        right,\n        0,\n        if __list_length(left) < __list_length(right) \u{7b} __list_length(left) \u{7d} else \u{7b} __list_length(right) \u{7d},\n        []\n    );\n\npub fn zip_exact<T, U>(left: [T], right: [U]): [(T, U)] =\n    if __list_length(left) != __list_length(right) \u{7b}\n        fail(error(code: \"std.collection.zip_length_mismatch\", message: \"zip_exact requires equal lengths\"))\n    \u{7d} else \u{7b}\n        zip_from(left, right, 0, __list_length(left), [])\n    \u{7d};\n\npub fn unique<T>(values: [T]): [T] = distinct(values);\n\npub fn group_by<T, K>(values: [T], key: fn(T): K): [(K, [T])] = __group_by(values, key);\n\npub fn pairs<T>(values: [T]): [(T, T)] =\n    pairs_from(values, 0, __list_length(values), []);\n\npub fn window<T>(values: [T], size: Int, step: Int = 1): [[T]] =\n    if size <= 0 \u{7b}\n        fail(error(code: \"std.collection.invalid_window_size\", message: \"window size must be positive\"))\n    \u{7d} else if step <= 0 \u{7b}\n        fail(error(code: \"std.collection.invalid_window_step\", message: \"window step must be positive\"))\n    \u{7d} else \u{7b}\n        windows_from(values, size, step, 0, __list_length(values), [])\n    \u{7d};\n\n// Produces consecutive nonempty groups; each matching item starts a new group.\npub fn split_when<T>(values: [T], predicate: fn(T): Bool): [[T]] =\n    split_when_from(values, predicate, 0, __list_length(values), [], []);\n\npub fn rank<T, K>(values: [T], key: fn(T): K): [(T, Int)] = __rank(values, key);\n\n// Finite lists are grouped by the same explicit elapsed/calendar boundaries\n// used by relation bucketing. Input order must be nondecreasing by time.\npub fn bucket_by<T, P>(rows: [T], period: P, zone: Str): [[T]] =\n    __bucket_by(rows, period, zone);\n" }
