{ id: "asset-6173736574732f7374646c69622f7374642f7061747465726e2e6f726e61", path: "assets/stdlib/std/pattern.orna", media_type: "text/plain; charset=utf-8", content: "// A closed two-way sum for values whose alternatives carry different types.\n// Orna's `case` expression remains the matching syntax; this module supplies\n// ordinary destructuring helpers over a pinned nominal enum.\npub enum Either<LeftValue, RightValue> \u{7b}\n    Left \u{7b} value: LeftValue \u{7d},\n    Right \u{7b} value: RightValue \u{7d},\n\u{7d}\n\npub fn is_left<L, R>(value: Either<L, R>): Bool = case value \u{7b}\n    Either.Left \u{7b} value: _ \u{7d}: true,\n    Either.Right \u{7b} value: _ \u{7d}: false,\n\u{7d};\n\npub fn is_right<L, R>(value: Either<L, R>): Bool = case value \u{7b}\n    Either.Left \u{7b} value: _ \u{7d}: false,\n    Either.Right \u{7b} value: _ \u{7d}: true,\n\u{7d};\n\n// Return null when the requested branch is inactive. `first([value])`\n// constructs Some(value) without changing the payload's type.\npub fn left_value<L, R>(value: Either<L, R>): L? = case value \u{7b}\n    Either.Left \u{7b} value \u{7d}: first([value]),\n    Either.Right \u{7b} value: _ \u{7d}: null,\n\u{7d};\n\npub fn right_value<L, R>(value: Either<L, R>): R? = case value \u{7b}\n    Either.Left \u{7b} value: _ \u{7d}: null,\n    Either.Right \u{7b} value \u{7d}: first([value]),\n\u{7d};\n\n// Split into two optional projections; exactly one component is present.\npub fn split<L, R>(value: Either<L, R>): (L?, R?) = case value \u{7b}\n    Either.Left \u{7b} value \u{7d}: (first([value]), null),\n    Either.Right \u{7b} value \u{7d}: (null, first([value])),\n\u{7d};\n\npub fn left_or<L, R>(value: Either<L, R>, fallback: L): L = case value \u{7b}\n    Either.Left \u{7b} value \u{7d}: value,\n    Either.Right \u{7b} value: _ \u{7d}: fallback,\n\u{7d};\n\npub fn right_or<L, R>(value: Either<L, R>, fallback: R): R = case value \u{7b}\n    Either.Left \u{7b} value: _ \u{7d}: fallback,\n    Either.Right \u{7b} value \u{7d}: value,\n\u{7d};\n\npub fn swap<L, R>(value: Either<L, R>): Either<R, L> = case value \u{7b}\n    Either.Left \u{7b} value \u{7d}: Either.Right \u{7b} value: value \u{7d},\n    Either.Right \u{7b} value \u{7d}: Either.Left \u{7b} value: value \u{7d},\n\u{7d};\n\n// These combinators keep branch selection explicit and preserve the inactive\n// payload without requiring callers to duplicate a case expression.\npub fn fold<L, R, U>(\n    value: Either<L, R>,\n    on_left: fn(L): U,\n    on_right: fn(R): U,\n): U = case value \u{7b}\n    Either.Left \u{7b} value \u{7d}: on_left(value),\n    Either.Right \u{7b} value \u{7d}: on_right(value),\n\u{7d};\n\npub fn map_left<L, R, U>(value: Either<L, R>, transform: fn(L): U): Either<U, R> =\n    case value \u{7b}\n        Either.Left \u{7b} value \u{7d}: Either.Left \u{7b} value: transform(value) \u{7d},\n        Either.Right \u{7b} value \u{7d}: Either.Right \u{7b} value: value \u{7d},\n    \u{7d};\n\npub fn map_right<L, R, U>(value: Either<L, R>, transform: fn(R): U): Either<L, U> =\n    case value \u{7b}\n        Either.Left \u{7b} value \u{7d}: Either.Left \u{7b} value: value \u{7d},\n        Either.Right \u{7b} value \u{7d}: Either.Right \u{7b} value: transform(value) \u{7d},\n    \u{7d};\n\npub fn bimap<L, R, A, B>(\n    value: Either<L, R>,\n    on_left: fn(L): A,\n    on_right: fn(R): B,\n): Either<A, B> = case value \u{7b}\n    Either.Left \u{7b} value \u{7d}: Either.Left \u{7b} value: on_left(value) \u{7d},\n    Either.Right \u{7b} value \u{7d}: Either.Right \u{7b} value: on_right(value) \u{7d},\n\u{7d};\n" }
