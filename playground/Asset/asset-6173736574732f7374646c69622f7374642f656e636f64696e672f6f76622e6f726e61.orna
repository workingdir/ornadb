{ id: "asset-6173736574732f7374646c69622f7374642f656e636f64696e672f6f76622e6f726e61", path: "assets/stdlib/std/encoding/ovb.orna", media_type: "text/plain; charset=utf-8", content: "// OVB-1 is the pinned binary value profile. Encoders use shortest permitted\n// heads, definite lengths, deterministic map-key order, canonical integer and\n// tag payloads, and binary64 Float values (including the single canonical NaN\n// bit pattern). UTF-8 text is not normalised. Unsupported values and unbounded\n// resources fail; operational handles are data descriptions only and cannot\n// be revived by decoding.\n// Bool, Int, Str and Blob use their primitive CBOR items; lists use arrays.\n// Decimal uses tag 60000, Option tag 60013, Unit tag 60014 and Tuple tag 60015.\n// Nominal records, enums, references and system values use the closed OVB-1\n// tag registry and retain their exact type/snapshot identity.\n//\n// Decoding is strict: reject duplicate keys, indefinite items, unsupported\n// simple values or tags, and every noncanonical alias before bytes can be used\n// as identity or a fingerprint. The explicit type witness and captured\n// snapshot provide the schema and context needed to validate nominal values.\n// Decode calls use the required static type witness form `decode(input, as: T)`.\n\npub fn encode<T>(value: T): Blob = __encode(value);\nfn __encode<T>(value: T): Blob = encode(value);\n\npub fn decode<T>(input: Blob): T = __decode(input);\nfn __decode<T>(input: Blob): T = decode(input);\n" }
