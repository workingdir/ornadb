{ id: "asset-6173736574732f7374646c69622f7374642f696f2f7772697465722e6f726e61", path: "assets/stdlib/std/io/writer.orna", media_type: "text/plain; charset=utf-8", content: "// Writer operations are explicit host effects over a caller-authorized root.\n// Each call completes synchronously; no hidden buffer or implicit flush state\n// survives the operation.\n\npub fn write_all_text(root: Str, path: Str, contents: Str, overwrite: Bool): Unit =\n    std.io.fs.write_text(root, path, contents, overwrite);\n\npub fn append_text(root: Str, path: Str, contents: Str): Unit =\n    std.io.fs.append_text(root, path, contents);\n" }
