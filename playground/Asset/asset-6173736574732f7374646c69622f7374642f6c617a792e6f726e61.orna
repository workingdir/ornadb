{ id: "asset-6173736574732f7374646c69622f7374642f6c617a792e6f726e61", path: "assets/stdlib/std/lazy.orna", media_type: "text/plain; charset=utf-8", content: "// Lazy computations are ordinary zero-argument functions. `defer`, `map`,\n// `and_then`, and `zip` return thunks without evaluating their computations.\n// Every `force` call invokes its thunk again. This is call-by-name with no memoization.\n// `from_pull` bridges one delayed pull into the persistent std.iterator cursor;\n// its callback runs only when that cursor is advanced.\npub fn defer<T>(computation: fn(): T): fn(): T = computation;\n\npub fn force<T>(computation: fn(): T): T = computation();\n\npub fn map<T, U>(computation: fn(): T, transform: fn(T): U): fn(): U =\n    () => transform(computation());\n\npub fn and_then<T, U>(\n    computation: fn(): T,\n    next: fn(T): fn(): U,\n): fn(): U = () => next(computation())();\n\npub fn zip<T, U>(left: fn(): T, right: fn(): U): fn(): (T, U) =\n    () => (left(), right());\n\n// Combines two delayed computations when forced, in left-to-right order.\npub fn zip_with<T, U, V>(\n    left: fn(): T,\n    right: fn(): U,\n    combine: fn(T, U): V,\n): fn(): V = () => combine(left(), right());\n\npub fn constant<T>(value: T): fn(): T = () => value;\n\npub fn from_pull<T>(\n    pull: fn(): (T?, std.iterator.Iterator<T>),\n): std.iterator.Iterator<T> = std.iterator.Iterator \u{7b} pull: pull \u{7d};\n" }
