{ id: "asset-6173736574732f7374646c69622f7374642f70617273652f7574696c69746965732e6f726e61", path: "assets/stdlib/std/parse/utilities.orna", media_type: "text/plain; charset=utf-8", content: "// Composed helpers keep std.parse's primitive spellings strict. Delimited\n// lists preserve empty fields, so a leading, trailing, or repeated separator\n// makes the entire parse fail. Empty input represents an empty list.\nfn parse_integer_fields(fields: [Str]): [Int]? \u{7b}\n    let values = [];\n    let index = 0;\n    let valid = true;\n    while index < std.collection.count(fields) && valid \u{7b}\n        let (field_valid, value) = case std.parse.integer(fields[index]) \u{7b}\n            Some(value): (true, value),\n            null: (false, 0),\n        \u{7d};\n        if field_valid \u{7b}\n            values = std.collection.union(values, [value]);\n        \u{7d} else \u{7b}\n            valid = false;\n        \u{7d};\n        index = index + 1;\n    \u{7d};\n    if valid \u{7b} Some(values) \u{7d} else \u{7b} null \u{7d}\n\u{7d}\n\nfn parse_boolean_fields(fields: [Str]): [Bool]? \u{7b}\n    let values = [];\n    let index = 0;\n    let valid = true;\n    while index < std.collection.count(fields) && valid \u{7b}\n        let (field_valid, value) = case std.parse.boolean(fields[index]) \u{7b}\n            Some(value): (true, value),\n            null: (false, false),\n        \u{7d};\n        if field_valid \u{7b}\n            values = std.collection.union(values, [value]);\n        \u{7d} else \u{7b}\n            valid = false;\n        \u{7d};\n        index = index + 1;\n    \u{7d};\n    if valid \u{7b} Some(values) \u{7d} else \u{7b} null \u{7d}\n\u{7d}\n\n/// Returns the parsed canonical integer, or `fallback` when parsing fails.\npub fn integer_or(input: Str, fallback: Int): Int =\n    case std.parse.integer(input) \u{7b}\n        Some(value): value,\n        null: fallback,\n    \u{7d};\n\n/// Returns the parsed lowercase boolean, or `fallback` when parsing fails.\npub fn boolean_or(input: Str, fallback: Bool): Bool =\n    case std.parse.boolean(input) \u{7b}\n        Some(value): value,\n        null: fallback,\n    \u{7d};\n\n/// Parses a delimited list of canonical integers as one all-or-nothing value.\n/// Empty input is `Some([])`. An empty separator or any empty/invalid field\n/// returns null; the delimiter is a literal string, not a pattern.\npub fn integer_list(input: Str, separator: Str): [Int]? =\n    if separator == \"\" \u{7b}\n        null\n    \u{7d} else if input == \"\" \u{7b}\n        Some([])\n    \u{7d} else \u{7b}\n        parse_integer_fields(std.text.split(input, separator))\n    \u{7d};\n\n/// Parses a delimited list of lowercase booleans as one all-or-nothing value.\n/// Empty input is `Some([])`. An empty separator or any empty/invalid field\n/// returns null.\npub fn boolean_list(input: Str, separator: Str): [Bool]? =\n    if separator == \"\" \u{7b}\n        null\n    \u{7d} else if input == \"\" \u{7b}\n        Some([])\n    \u{7d} else \u{7b}\n        parse_boolean_fields(std.text.split(input, separator))\n    \u{7d};\n\n/// Splits at the first literal separator, returning the complete remainder\n/// after it. Missing and empty separators return null; either side may be empty.\npub fn split_once(input: Str, separator: Str): (Str, Str)? =\n    if separator == \"\" \u{7b}\n        null\n    \u{7d} else \u{7b}\n        let fields = std.text.split(input, separator);\n        if std.collection.count(fields) < 2 \u{7b}\n            null\n        \u{7d} else \u{7b}\n            Some((\n                fields[0],\n                std.text.join(std.collection.drop(fields, 1), separator),\n            ))\n        \u{7d}\n    \u{7d};\n" }
