{ id: "asset-6173736574732f7374646c69622f7374642f697465726174696f6e2e6f726e61", path: "assets/stdlib/std/iteration.orna", media_type: "text/plain; charset=utf-8", content: "// Finite-list folds and graph walks. Folds visit list items from left to\n// right. Graph walks visit each reachable node once, keeping neighbors in the\n// order returned by the callback; both walks tolerate cycles and shared nodes.\nfn fold_from<T, U>(\n    values: [T], index: Int, end: Int, accumulated: U, combine: fn(U, T): U\n): U =\n    if index >= end \u{7b}\n        accumulated\n    \u{7d} else \u{7b}\n        fold_from(\n            values,\n            index + 1,\n            end,\n            combine(accumulated, values[index]),\n            combine,\n        )\n    \u{7d};\n\n/// Folds a finite list from left to right, returning `initial` for an empty list.\npub fn fold<T, U>(values: [T], initial: U, combine: fn(U, T): U): U =\n    fold_from(values, 0, std.collection.count(values), initial, combine);\n\nfn fold_while_from<T, U>(\n    values: [T], index: Int, end: Int, accumulated: U,\n    step: fn(U, T): (U, Bool)\n): U =\n    if index >= end \u{7b}\n        accumulated\n    \u{7d} else \u{7b}\n        let (next, continue_iteration) = step(accumulated, values[index]);\n        if continue_iteration \u{7b}\n            fold_while_from(values, index + 1, end, next, step)\n        \u{7d} else \u{7b}\n            next\n        \u{7d}\n    \u{7d};\n\n/// Folds left to right until `step` returns false; the stopping item's state is kept.\npub fn fold_while<T, U>(\n    values: [T], initial: U, step: fn(U, T): (U, Bool)\n): U = fold_while_from(values, 0, std.collection.count(values), initial, step);\n\nfn has_node<T>(nodes: [T], target: T): Bool =\n    std.collection.exists(nodes, node => node == target);\n\nfn depth_first_from<T>(\n    pending: [T], visited: [T], neighbors: fn(T): [T]\n): [T] =\n    if std.collection.count(pending) == 0 \u{7b}\n        visited\n    \u{7d} else \u{7b}\n        let node = pending[0];\n        let remaining = std.collection.drop(pending, 1);\n        if has_node(visited, node) \u{7b}\n            depth_first_from(remaining, visited, neighbors)\n        \u{7d} else \u{7b}\n            let discovered = std.collection.union(visited, [node]);\n            let pending_in_preorder = std.collection.union(neighbors(node), remaining);\n            depth_first_from(pending_in_preorder, discovered, neighbors)\n        \u{7d}\n    \u{7d};\n\n/// Walks reachable nodes depth first, in pre-order and stable neighbor order.\npub fn depth_first<T>(root: T, neighbors: fn(T): [T]): [T] =\n    depth_first_from([root], [], neighbors);\n\nfn breadth_first_from<T>(\n    pending: [T], visited: [T], neighbors: fn(T): [T]\n): [T] =\n    if std.collection.count(pending) == 0 \u{7b}\n        visited\n    \u{7d} else \u{7b}\n        let node = pending[0];\n        let remaining = std.collection.drop(pending, 1);\n        if has_node(visited, node) \u{7b}\n            breadth_first_from(remaining, visited, neighbors)\n        \u{7d} else \u{7b}\n            let discovered = std.collection.union(visited, [node]);\n            let pending_in_level_order = std.collection.union(remaining, neighbors(node));\n            breadth_first_from(pending_in_level_order, discovered, neighbors)\n        \u{7d}\n    \u{7d};\n\n/// Walks reachable nodes breadth first, in stable neighbor order per level.\npub fn breadth_first<T>(root: T, neighbors: fn(T): [T]): [T] =\n    breadth_first_from([root], [], neighbors);\n\nfn reachable_from<T>(\n    pending: [T], visited: [T], target: T, neighbors: fn(T): [T]\n): Bool =\n    if std.collection.count(pending) == 0 \u{7b}\n        false\n    \u{7d} else \u{7b}\n        let node = pending[0];\n        if node == target \u{7b}\n            true\n        \u{7d} else \u{7b}\n            let remaining = std.collection.drop(pending, 1);\n            if has_node(visited, node) \u{7b}\n                reachable_from(remaining, visited, target, neighbors)\n            \u{7d} else \u{7b}\n                let discovered = std.collection.union(visited, [node]);\n                let pending_in_level_order = std.collection.union(remaining, neighbors(node));\n                reachable_from(pending_in_level_order, discovered, target, neighbors)\n            \u{7d}\n        \u{7d}\n    \u{7d};\n\n/// Reports whether `target` is reachable, stopping as soon as it is found.\npub fn reachable<T>(root: T, target: T, neighbors: fn(T): [T]): Bool =\n    reachable_from([root], [], target, neighbors);\n" }
