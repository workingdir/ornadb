{ id: "asset-6173736574732f696e6465782e637373", path: "assets/index.css", media_type: "text/css; charset=utf-8", content: ":root{--lightningcss-light:initial;--lightningcss-dark: ;color-scheme:light;--page-width:120rem;--text:#202122;--background:#fff;--surface:#f8f9fa;--border:#a2a9b1;--muted:#54595d;--link:#0645ad;--visited:#0b0080;--code-font:ui-monospace, SFMono-Regular, Consolas, monospace;color:var(--text);background:var(--background);font:1rem/1.5 Georgia,Times New Roman,serif}*{box-sizing:border-box}body{margin:0}main,.page-header{max-width:var(--page-width);margin:1rem auto;padding:0 1rem}a{color:var(--link)}a:visited{color:var(--visited)}button,select,textarea{color:inherit;font:inherit}button{cursor:pointer}button:disabled,select:disabled{cursor:default}.page-header{border-bottom:1px solid var(--border)}.page-header h1{margin:0;font-size:1.6rem;font-weight:400}.page-header p{margin:.25rem 0 .75rem}.workspace{grid-template-columns:minmax(0,1.1fr) minmax(18rem,.9fr);align-items:start;gap:1rem;display:grid}.editor-pane,.output-pane{min-width:0}.pane-heading{flex-wrap:wrap;align-items:center;gap:.5rem;min-height:2.5rem;display:flex}.pane-heading h2{margin:0 auto 0 0;font-size:1.15rem;font-weight:400}.example-feed{grid-template-columns:auto minmax(10rem,16rem);align-items:center;gap:.1rem .5rem;min-width:0;display:grid}.example-feed label{white-space:nowrap}.example-feed select{min-width:0;max-width:100%}.example-feed-help{color:var(--muted);grid-column:2;margin:0;font-size:.75rem;line-height:1.25}#source{border:1px solid var(--border);background:var(--background);width:100%;height:clamp(20rem,68vh,52rem);min-height:20rem;font:.9rem/1.5 var(--code-font);resize:vertical;tab-size:4;border-radius:0;padding:.65rem;display:block}.actions{align-items:center;gap:.75rem;margin-top:.4rem;display:flex}#run-button{min-height:2.25rem;padding:.2rem .8rem}#editor-status,.output-status{color:var(--muted);margin:.35rem 0;font-size:.875rem}.tabs{border-bottom:1px solid var(--border);gap:.25rem;margin-top:.5rem;display:flex;overflow-x:auto}.tabs button{background:0 0;border:0;flex:none;min-height:2.5rem;padding:.3rem .7rem}.tabs button[aria-selected=true]{border-bottom:2px solid var(--link);color:var(--link)}.panels{border:1px solid var(--border);background:var(--surface);border-top:0;min-height:clamp(12rem,32vh,20rem);padding:.25rem .5rem}.panels h3{margin:.5rem 0;font-size:1rem;font-weight:600}pre{white-space:pre-wrap;overflow-wrap:anywhere;min-height:8rem;font:.9rem/1.5 var(--code-font);margin:0;overflow:auto}.visually-hidden{clip:rect(0, 0, 0, 0);white-space:nowrap;border:0;width:1px;height:1px;margin:-1px;padding:0;position:absolute;overflow:hidden}[hidden]{display:none!important}@media (width<=64rem){.workspace{grid-template-columns:minmax(0,1fr)}#source{height:clamp(18rem,56vh,40rem)}.panels{min-height:14rem}}@media (width<=40rem){main,.page-header{margin:.75rem auto;padding:0 .75rem}.editor-pane .pane-heading{grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:.5rem;display:grid}.editor-pane .pane-heading h2{grid-column:1/-1;margin:0}.example-feed{grid-column:1/-1;grid-template-columns:auto minmax(0,1fr);width:100%}.example-feed select{width:100%}.example-feed-help{grid-column:2}.actions{flex-direction:column;align-items:flex-start;gap:.25rem}#run-button{width:100%}.tabs button{padding-inline:.55rem}.panels{padding-inline:.35rem}}\n" }
