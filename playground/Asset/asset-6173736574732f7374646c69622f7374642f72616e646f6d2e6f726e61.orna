{ id: "asset-6173736574732f7374646c69622f7374642f72616e646f6d2e6f726e61", path: "assets/stdlib/std/random.orna", media_type: "text/plain; charset=utf-8", content: "// Random values come from the host cryptographically secure random source.\n// These calls are nondeterministic host effects: they are not valid in table\n// assertions, deterministic query callbacks, watches or presenters. If the\n// provider cannot supply unbiased output, the operation fails; it never falls\n// back to a clock, UUID-derived sequence or predictable pseudorandom source.\n\n// Return exactly `count` random bytes. Count must be nonnegative and within\n// the active resource budget. Use this operation for secret material only\n// when the host provider confirms its CSPRNG contract.\npub fn bytes(count: Int): Blob = __bytes(count);\nfn __bytes(count: Int): Blob = bytes(count);\n\n// Sample uniformly from the half-open integer interval [lower_inclusive,\n// upper_exclusive). An empty or reversed interval fails. The helper uses\n// rejection sampling, so large range boundaries do not introduce modulo bias.\npub fn integer(lower_inclusive: Int, upper_exclusive: Int): Int =\n    __integer(lower_inclusive, upper_exclusive);\nfn __integer(lower_inclusive: Int, upper_exclusive: Int): Int =\n    integer(lower_inclusive, upper_exclusive);\n\n// Select one list position uniformly. Return null for an empty list; repeated\n// equal values at different positions retain their separate probabilities.\npub fn choose<T>(values: [T]): T? = __choose(values);\nfn __choose<T>(values: [T]): T? = choose(values);\n\n// Apply an unbiased Fisher-Yates permutation. Every input position is retained\n// exactly once; equal values do not collapse the positions they occupy.\npub fn shuffle<T>(values: [T]): [T] = __shuffle(values);\nfn __shuffle<T>(values: [T]): [T] = shuffle(values);\n" }
