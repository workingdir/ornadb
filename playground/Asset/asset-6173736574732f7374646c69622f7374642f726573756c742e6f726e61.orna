{ id: "asset-6173736574732f7374646c69622f7374642f726573756c742e6f726e61", path: "assets/stdlib/std/result.orna", media_type: "text/plain; charset=utf-8", content: "// Result is an ordinary closed enum in the optional std package. Orna's own\n// failures continue through the language Error channel and are not wrapped.\n// These combinators select explicit Ok and Err branches and never catch a\n// language failure raised by a callback.\npub enum Result<T, E> \u{7b}\n    Ok \u{7b} value: T \u{7d},\n    Err \u{7b} error: E \u{7d},\n\u{7d}\n\npub fn is_ok<T, E>(result: Result<T, E>): Bool = case result \u{7b}\n    Result.Ok \u{7b} value: _ \u{7d}: true,\n    Result.Err \u{7b} error: _ \u{7d}: false,\n\u{7d};\n\npub fn is_err<T, E>(result: Result<T, E>): Bool = case result \u{7b}\n    Result.Ok \u{7b} value: _ \u{7d}: false,\n    Result.Err \u{7b} error: _ \u{7d}: true,\n\u{7d};\n\n/// Returns `next` for Ok and preserves the first Err. Both arguments are\n/// evaluated before the call; use `and_then` to construct `next` conditionally.\npub fn and<T, U, E>(result: Result<T, E>, next: Result<U, E>): Result<U, E> = case result \u{7b}\n    Result.Ok \u{7b} value: _ \u{7d}: next,\n    Result.Err \u{7b} error \u{7d}: Result.Err \u{7b} error: error \u{7d},\n\u{7d};\n\n/// Preserves Ok and returns the already-evaluated fallback for Err. Use\n/// `or_else` when recovery should be computed only for the Err branch.\npub fn or<T, E, F>(result: Result<T, E>, fallback: Result<T, F>): Result<T, F> = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: Result.Ok \u{7b} value: value \u{7d},\n    Result.Err \u{7b} error: _ \u{7d}: fallback,\n\u{7d};\n\n/// Tests whether the result is Ok and its value equals `expected`.\npub fn contains<T, E>(result: Result<T, E>, expected: T): Bool = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: value == expected,\n    Result.Err \u{7b} error: _ \u{7d}: false,\n\u{7d};\n\n/// Tests whether the result is Err and its error equals `expected`.\npub fn contains_error<T, E>(result: Result<T, E>, expected: E): Bool = case result \u{7b}\n    Result.Ok \u{7b} value: _ \u{7d}: false,\n    Result.Err \u{7b} error \u{7d}: error == expected,\n\u{7d};\n\npub fn map<T, U, E>(result: Result<T, E>, transform: fn(T): U): Result<U, E> = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: Result.Ok \u{7b} value: transform(value) \u{7d},\n    Result.Err \u{7b} error \u{7d}: Result.Err \u{7b} error: error \u{7d},\n\u{7d};\n\npub fn map_error<T, E, F>(result: Result<T, E>, transform: fn(E): F): Result<T, F> = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: Result.Ok \u{7b} value: value \u{7d},\n    Result.Err \u{7b} error \u{7d}: Result.Err \u{7b} error: transform(error) \u{7d},\n\u{7d};\n\npub fn and_then<T, U, E>(\n    result: Result<T, E>,\n    next: fn(T): Result<U, E>\n): Result<U, E> = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: next(value),\n    Result.Err \u{7b} error \u{7d}: Result.Err \u{7b} error: error \u{7d},\n\u{7d};\n\npub fn or_else<T, E, F>(\n    result: Result<T, E>,\n    recover: fn(E): Result<T, F>\n): Result<T, F> = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: Result.Ok \u{7b} value: value \u{7d},\n    Result.Err \u{7b} error \u{7d}: recover(error),\n\u{7d};\n\npub fn unwrap_or<T, E>(result: Result<T, E>, fallback: T): T = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: value,\n    Result.Err \u{7b} error: _ \u{7d}: fallback,\n\u{7d};\n\npub fn unwrap_or_else<T, E>(result: Result<T, E>, fallback: fn(E): T): T = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: value,\n    Result.Err \u{7b} error \u{7d}: fallback(error),\n\u{7d};\n\npub fn ok<T, E>(result: Result<T, E>): T? = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: first([value]),\n    Result.Err \u{7b} error: _ \u{7d}: null,\n\u{7d};\n\npub fn err<T, E>(result: Result<T, E>): E? = case result \u{7b}\n    Result.Ok \u{7b} value: _ \u{7d}: null,\n    Result.Err \u{7b} error \u{7d}: first([error]),\n\u{7d};\n\n/// Converts `Result<Option<T>, E>` to `Option<Result<T, E>>` without losing\n/// either the successful value, the empty option, or the error payload.\npub fn transpose<T, E>(result: Result<T?, E>): Result<T, E>? = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: case value \u{7b}\n        Some(inner): first([Result.Ok \u{7b} value: inner \u{7d}]),\n        null: null,\n    \u{7d},\n    Result.Err \u{7b} error \u{7d}: first([Result.Err \u{7b} error: error \u{7d}]),\n\u{7d};\n\n// Fold both variants into one result type. Exactly one branch callback runs.\npub fn fold<T, E, U>(\n    result: Result<T, E>,\n    on_ok: fn(T): U,\n    on_err: fn(E): U\n): U = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: on_ok(value),\n    Result.Err \u{7b} error \u{7d}: on_err(error),\n\u{7d};\n\n// `map_or` uses an already-evaluated fallback; use `map_or_else` when\n// computing the fallback should be deferred until the Err branch is selected.\npub fn map_or<T, E, U>(\n    result: Result<T, E>,\n    fallback: U,\n    transform: fn(T): U\n): U = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: transform(value),\n    Result.Err \u{7b} error: _ \u{7d}: fallback,\n\u{7d};\n\npub fn map_or_else<T, E, U>(\n    result: Result<T, E>,\n    fallback: fn(E): U,\n    transform: fn(T): U\n): U = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: transform(value),\n    Result.Err \u{7b} error \u{7d}: fallback(error),\n\u{7d};\n\n// Collapse a nested Result when both layers use the same error type.\npub fn flatten<T, E>(result: Result<Result<T, E>, E>): Result<T, E> = case result \u{7b}\n    Result.Ok \u{7b} value \u{7d}: value,\n    Result.Err \u{7b} error \u{7d}: Result.Err \u{7b} error: error \u{7d},\n\u{7d};\n\n/// Combines two successful values into a pair. If either input is Err, the\n/// first Err from left to right is returned. Both arguments are already evaluated.\npub fn zip<T, U, E>(left: Result<T, E>, right: Result<U, E>): Result<(T, U), E> = case left \u{7b}\n    Result.Ok \u{7b} value: left_value \u{7d}: case right \u{7b}\n        Result.Ok \u{7b} value: right_value \u{7d}:\n            Result.Ok \u{7b} value: (left_value, right_value) \u{7d},\n        Result.Err \u{7b} error \u{7d}: Result.Err \u{7b} error: error \u{7d},\n    \u{7d},\n    Result.Err \u{7b} error \u{7d}: Result.Err \u{7b} error: error \u{7d},\n\u{7d};\n" }
