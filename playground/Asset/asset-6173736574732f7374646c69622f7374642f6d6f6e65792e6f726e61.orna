{ id: "asset-6173736574732f7374646c69622f7374642f6d6f6e65792e6f726e61", path: "assets/stdlib/std/money.orna", media_type: "text/plain; charset=utf-8", content: "// Exact settlement helpers. The amount's decimal precision is retained until\n// a caller explicitly supplies the currency minor-unit scale and rounding\n// rule. `half_even` rounds ties to the even minor unit, `half_up` rounds ties\n// away from zero, `toward_zero` truncates, `away_from_zero` expands, `floor`\n// rounds toward negative infinity, and `ceil` rounds toward positive infinity.\n// Allocation uses the exact integer minor-unit method specified by\n// ORNA-MONEY-006. Formatting takes a currency code, minor-unit scale,\n// rounding rule and explicit locale; symbols, grouping and decimal marks come\n// from this captured locale profile.\n\npub fn quantize<T>(amount: T, minor_digits: Int, rounding: Str): T =\n    __quantize(amount, minor_digits, rounding);\n\nfn __quantize<T>(amount: T, minor_digits: Int, rounding: Str): T =\n    quantize(amount, minor_digits, rounding);\n\npub fn allocate<T>(\n    amount: T,\n    weights: [Int],\n    minor_digits: Int,\n    rounding: Str? = null\n): [T] = __allocate(amount, weights, minor_digits, rounding);\n\nfn __allocate<T>(\n    amount: T,\n    weights: [Int],\n    minor_digits: Int,\n    rounding: Str?\n): [T] = allocate(amount, weights, minor_digits, rounding);\n\npub fn format<T>(\n    amount: T,\n    currency_code: Str,\n    minor_digits: Int,\n    rounding: Str,\n    locale: Str\n): Str = __format(amount, currency_code, minor_digits, rounding, locale);\n\nfn __format<T>(\n    amount: T,\n    currency_code: Str,\n    minor_digits: Int,\n    rounding: Str,\n    locale: Str\n): Str = format(amount, currency_code, minor_digits, rounding, locale);\n" }
