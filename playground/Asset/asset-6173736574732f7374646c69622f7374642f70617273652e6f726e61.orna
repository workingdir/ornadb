{ id: "asset-6173736574732f7374646c69622f7374642f70617273652e6f726e61", path: "assets/stdlib/std/parse.orna", media_type: "text/plain; charset=utf-8", content: "// Text-to-primitive helpers are deliberately strict and locale independent.\n// Integer input is exactly the canonical bare Int spelling: ASCII digits,\n// optional leading minus, no plus, separators, whitespace, or redundant zeroes.\n// Invalid input returns null instead of a partial value or a replacement.\nfn digit_value(character: Str): Int? = case character \u{7b}\n    \"0\": Some(0),\n    \"1\": Some(1),\n    \"2\": Some(2),\n    \"3\": Some(3),\n    \"4\": Some(4),\n    \"5\": Some(5),\n    \"6\": Some(6),\n    \"7\": Some(7),\n    \"8\": Some(8),\n    \"9\": Some(9),\n    _: null,\n\u{7d};\n\n/// Parses a canonical signed decimal Int without passing through Float.\n/// `parse.integer(\"-42\")` returns `Some(-42)`; malformed or noncanonical\n/// spellings such as `\"+42\"`, `\"042\"`, `\"-0\"`, and `\" 42\"` return null.\npub fn integer(input: Str): Int? \u{7b}\n    let characters = std.text.split(input, \"\");\n    let length = std.collection.count(characters);\n    if length == 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        let negative = characters[0] == \"-\";\n        let start = if negative \u{7b} 1 \u{7d} else \u{7b} 0 \u{7d};\n        if start == length \u{7b}\n            null\n        \u{7d} else if characters[start] == \"0\" && (negative || length - start > 1) \u{7b}\n            null\n        \u{7d} else \u{7b}\n            let index = start;\n            let accumulated = 0;\n            let valid = true;\n            while index < length && valid \u{7b}\n                let digit = case digit_value(characters[index]) \u{7b}\n                    Some(value): value,\n                    null: -1,\n                \u{7d};\n                if digit < 0 \u{7b}\n                    valid = false;\n                \u{7d} else \u{7b}\n                    accumulated = accumulated * 10 + digit;\n                \u{7d};\n                index += 1;\n            \u{7d};\n            if valid \u{7b}\n                Some(if negative \u{7b} -accumulated \u{7d} else \u{7b} accumulated \u{7d})\n            \u{7d} else \u{7b}\n                null\n            \u{7d}\n        \u{7d}\n    \u{7d}\n\u{7d}\n\n/// Parses only the lowercase source spellings `true` and `false`.\npub fn boolean(input: Str): Bool? =\n    if input == \"true\" \u{7b} Some(true) \u{7d} else if input == \"false\" \u{7b} Some(false) \u{7d} else \u{7b} null \u{7d};\n" }
