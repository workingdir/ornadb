{ id: "asset-6173736574732f7374646c69622f7374642f626974732e6f726e61", path: "assets/stdlib/std/bits.orna", media_type: "text/plain; charset=utf-8", content: "// std.bits is an optional library API over Int's unbounded signed two's\n// complement model. Shifts reject negative counts, right shift is arithmetic,\n// and left shift remains exact subject to resource limits. `|` remains the\n// source pipeline operator. Public functions are ordinary Orna wrappers over\n// bounded evaluator primitives, so importing this module does not replace or\n// alter core database operators.\nuse std.collection;\n\nfn __bit_or(left: Int, right: Int): Int = std.bits.bit_or(left, right);\nfn __bit_and(left: Int, right: Int): Int = std.bits.bit_and(left, right);\nfn __bit_xor(left: Int, right: Int): Int = std.bits.bit_xor(left, right);\nfn __bit_not(value: Int): Int = std.bits.bit_not(value);\nfn __shift_left(value: Int, count: Int): Int = std.bits.shift_left(value, count);\nfn __shift_right(value: Int, count: Int): Int = std.bits.shift_right(value, count);\n\npub fn bit_or(left: Int, right: Int): Int = __bit_or(left, right);\n\npub fn bit_and(left: Int, right: Int): Int = __bit_and(left, right);\n\npub fn bit_xor(left: Int, right: Int): Int = __bit_xor(left, right);\n\npub fn bit_not(value: Int): Int = __bit_not(value);\n\npub fn shift_left(value: Int, count: Int): Int = __shift_left(value, count);\n\npub fn shift_right(value: Int, count: Int): Int = __shift_right(value, count);\n\n/// Tests a zero-based bit index. Int uses unbounded signed two's-complement\n/// semantics, so negative values have an infinite sign extension. A negative\n/// index returns null.\npub fn test_bit(value: Int, index: Int): Bool? =\n    if index < 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        Some(bit_and(shift_right(value, index), 1) != 0)\n    \u{7d};\n\n/// Sets a zero-based bit and returns null for a negative index.\npub fn set_bit(value: Int, index: Int): Int? =\n    if index < 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        Some(bit_or(value, shift_left(1, index)))\n    \u{7d};\n\n/// Clears a zero-based bit and returns null for a negative index.\npub fn clear_bit(value: Int, index: Int): Int? =\n    if index < 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        Some(bit_and(value, bit_not(shift_left(1, index))))\n    \u{7d};\n\n/// Toggles a zero-based bit and returns null for a negative index.\npub fn toggle_bit(value: Int, index: Int): Int? =\n    if index < 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        Some(bit_xor(value, shift_left(1, index)))\n    \u{7d};\n\n/// Reports whether an integer is an unsigned byte value from 0 through 255.\npub fn is_byte(value: Int): Bool = value >= 0 && value <= 255;\n\nfn supports_byte_order(order: Str): Bool = order == \"little\" || order == \"big\";\n\n/// Encodes a nonnegative integer into exactly `width` bytes in the requested\n/// byte order. The width must be positive and large enough; invalid arguments\n/// return null. Little endian places the least-significant byte first. Big\n/// endian places the most-significant byte first. Resource limits still apply.\npub fn unsigned_to_bytes(value: Int, width: Int, order: Str): [Int]? \u{7b}\n    if value < 0 || width <= 0 || !supports_byte_order(order) || shift_right(value, width * 8) != 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        let index = 0;\n        let output = [];\n        while index < width \u{7b}\n            let byte_index = if order == \"little\" \u{7b} index \u{7d} else \u{7b} width - index - 1 \u{7d};\n            let byte = bit_and(shift_right(value, byte_index * 8), 255);\n            output = std.collection.append(output, byte);\n            index += 1;\n        \u{7d};\n        Some(output)\n    \u{7d}\n\u{7d}\n\n/// Decodes a nonempty list of unsigned byte values in the requested byte\n/// order. Invalid byte values, an empty list, or an unsupported order return\n/// null. Leading zero bytes are accepted and do not survive the Int conversion.\npub fn unsigned_from_bytes(bytes: [Int], order: Str): Int? \u{7b}\n    let length = std.collection.count(bytes);\n    if length == 0 || !supports_byte_order(order) \u{7b}\n        null\n    \u{7d} else \u{7b}\n        let index = 0;\n        let valid = true;\n        while index < length && valid \u{7b}\n            if !is_byte(bytes[index]) \u{7b}\n                valid = false;\n            \u{7d};\n            index += 1;\n        \u{7d};\n        if !valid \u{7b}\n            null\n        \u{7d} else \u{7b}\n            let value = 0;\n            if order == \"little\" \u{7b}\n                let cursor = length;\n                while cursor > 0 \u{7b}\n                    cursor -= 1;\n                    value = value * 256 + bytes[cursor];\n                \u{7d};\n            \u{7d} else \u{7b}\n                let cursor = 0;\n                while cursor < length \u{7b}\n                    value = value * 256 + bytes[cursor];\n                    cursor += 1;\n                \u{7d};\n            \u{7d};\n            Some(value)\n        \u{7d}\n    \u{7d}\n\u{7d}\n" }
