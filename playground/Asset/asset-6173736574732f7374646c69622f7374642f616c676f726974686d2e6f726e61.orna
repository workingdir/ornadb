{ id: "asset-6173736574732f7374646c69622f7374642f616c676f726974686d2e6f726e61", path: "assets/stdlib/std/algorithm.orna", media_type: "text/plain; charset=utf-8", content: "// Search helpers operate on finite lists sorted in ascending key order. The\n// key must have a lawful total order whose equality agrees with ordering.\nuse collection;\n\nfn lower_bound_range<T, K>(\n    values: [T], target: K, key: fn(T): K, low: Int, high: Int\n): Int =\n    if low >= high \u{7b}\n        low\n    \u{7d} else \u{7b}\n        let middle = low + ((high - low) / 2);\n        if key(values[middle]) < target \u{7b}\n            lower_bound_range(values, target, key, middle + 1, high)\n        \u{7d} else \u{7b}\n            lower_bound_range(values, target, key, low, middle)\n        \u{7d}\n    \u{7d};\n\nfn upper_bound_range<T, K>(\n    values: [T], target: K, key: fn(T): K, low: Int, high: Int\n): Int =\n    if low >= high \u{7b}\n        low\n    \u{7d} else \u{7b}\n        let middle = low + ((high - low) / 2);\n        if key(values[middle]) <= target \u{7b}\n            upper_bound_range(values, target, key, middle + 1, high)\n        \u{7d} else \u{7b}\n            upper_bound_range(values, target, key, low, middle)\n        \u{7d}\n    \u{7d};\n\nfn sorted_from<T, K>(values: [T], key: fn(T): K, index: Int, end: Int): Bool =\n    if index + 1 >= end \u{7b}\n        true\n    \u{7d} else \u{7b}\n        key(values[index]) <= key(values[index + 1]) &&\n            sorted_from(values, key, index + 1, end)\n    \u{7d};\n\n// Duplicate keys insert before the first equal value.\npub fn lower_bound<T, K>(values: [T], target: K, key: fn(T): K): Int =\n    lower_bound_range(values, target, key, 0, std.collection.count(values));\n\n// Duplicate keys insert after the last equal value.\npub fn upper_bound<T, K>(values: [T], target: K, key: fn(T): K): Int =\n    upper_bound_range(values, target, key, 0, std.collection.count(values));\n\n// Return the first matching index, or null if the target is absent.\npub fn binary_search<T, K>(values: [T], target: K, key: fn(T): K): Int? \u{7b}\n    let index = lower_bound_range(values, target, key, 0, std.collection.count(values));\n    if index < std.collection.count(values) && key(values[index]) == target \u{7b}\n        Some(index)\n    \u{7d} else \u{7b}\n        null\n    \u{7d}\n\u{7d}\n\npub fn is_sorted_by<T, K>(values: [T], key: fn(T): K): Bool =\n    sorted_from(values, key, 0, std.collection.count(values));\n\n// Ties retain their input order, as required by std.collection.sort_by.\npub fn stable_sort_by<T, K>(values: [T], key: fn(T): K): [T] =\n    std.collection.sort_by(values, key);\n" }
