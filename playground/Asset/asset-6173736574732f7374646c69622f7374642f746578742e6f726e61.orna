{ id: "asset-6173736574732f7374646c69622f7374642f746578742e6f726e61", path: "assets/stdlib/std/text.orna", media_type: "text/plain; charset=utf-8", content: "// std.text pins Unicode 16.0.0 behavior as ordinary library exports. Any\n// positions and lengths exposed by text operations count Unicode scalar values,\n// not UTF-8 bytes or grapheme clusters. trim removes the pinned Unicode\n// White_Space set at both ends and preserves all interior scalars.\n//\n// Full casing and canonical normalization use Unicode 16.0.0 tables and are\n// locale independent; lower applies the contextual Final_Sigma rule.\n// normalise accepts the explicit forms NFC and NFD. Split preserves empty\n// fields at either edge and between adjacent separators; an empty separator\n// yields one field per Unicode scalar (and no fields for empty input). Replace\n// is non-overlapping and scans left to right.\npub fn unicode_version(): Str = \"16.0.0\";\n\n// Private leaves route public source exports through the evaluator primitives\n// registered for this pinned Unicode profile. The Rust toolchain's Unicode\n// version does not replace the captured behavior.\nfn __trim(value: Str): Str = std.text.trim(value);\nfn __split(value: Str, separator: Str): [Str] = std.text.split(value, separator);\nfn __join(values: [Str], separator: Str): Str = std.text.join(values, separator);\nfn __starts_with(value: Str, prefix: Str): Bool = std.text.starts_with(value, prefix);\nfn __ends_with(value: Str, suffix: Str): Bool = std.text.ends_with(value, suffix);\nfn __contains(value: Str, needle: Str): Bool = std.text.contains(value, needle);\nfn __replace(value: Str, from: Str, to: Str): Str = std.text.replace(value, from, to);\nfn __normalise(value: Str, form: Str): Str = std.text.normalise(value, form);\nfn __lower(value: Str): Str = std.text.lower(value);\nfn __upper(value: Str): Str = std.text.upper(value);\n\npub fn trim(value: Str): Str = __trim(value);\npub fn split(value: Str, separator: Str): [Str] = __split(value, separator);\npub fn join(values: [Str], separator: Str): Str = __join(values, separator);\npub fn starts_with(value: Str, prefix: Str): Bool = __starts_with(value, prefix);\npub fn ends_with(value: Str, suffix: Str): Bool = __ends_with(value, suffix);\npub fn contains(value: Str, needle: Str): Bool = __contains(value, needle);\npub fn replace(value: Str, from: Str, to: Str): Str = __replace(value, from, to);\npub fn normalise(value: Str, form: Str): Str = __normalise(value, form);\npub fn lower(value: Str): Str = __lower(value);\npub fn upper(value: Str): Str = __upper(value);\n" }
