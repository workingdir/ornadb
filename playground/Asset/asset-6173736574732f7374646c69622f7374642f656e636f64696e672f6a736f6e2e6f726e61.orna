{ id: "asset-6173736574732f7374646c69622f7374642f656e636f64696e672f6a736f6e2e6f726e61", path: "assets/stdlib/std/encoding/json.orna", media_type: "text/plain; charset=utf-8", content: "// JSON decoding is schema directed and never infers an untyped dynamic value.\n// Duplicate object keys are always rejected. Missing fields remain distinct\n// from explicit null, and numeric tokens are parsed without first rounding\n// through binary Float. Unknown fields fail by default; ignoring them requires\n// the explicit option below. Encoding unsupported Orna values fails rather\n// than dropping fields or emitting nonstandard numeric tokens.\n// The required static result type is supplied through the call form\n// `decode(input, as: T)`, not as a runtime value.\n\npub fn encode<T>(value: T): Str = __encode(value);\nfn __encode<T>(value: T): Str = encode(value);\n\npub fn decode<T>(input: Str): T = __decode(input);\nfn __decode<T>(input: Str): T = decode(input);\n\n// Unknown fields may be ignored only when the caller opts in explicitly.\n// Duplicate keys, malformed values and type mismatches still fail.\npub fn decode_with_options<T>(\n    input: Str,\n    ignore_unknown_fields: Bool = false\n): T = __decode_with_options(input, ignore_unknown_fields);\nfn __decode_with_options<T>(input: Str, ignore_unknown_fields: Bool): T =\n    decode_with_options(input, ignore_unknown_fields);\n" }
