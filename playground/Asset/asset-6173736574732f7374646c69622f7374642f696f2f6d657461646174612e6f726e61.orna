{ id: "asset-6173736574732f7374646c69622f7374642f696f2f6d657461646174612e6f726e61", path: "assets/stdlib/std/io/metadata.orna", media_type: "text/plain; charset=utf-8", content: "// Portable filesystem metadata is the tuple\n// (kind, size_bytes, modified_at, created_at). `kind` is one of \"file\",\n// \"directory\", \"symlink\", or \"other\". Size is present only for regular\n// files; timestamps are optional when a host does not expose them. Creation\n// time is never inferred from a change-time field. Owner names, permission\n// bits, device paths, symlink targets, and absolute host paths are excluded.\npub fn kind(value: (Str, Int?, Instant?, Instant?)): Str = case value \u{7b}\n    (entry_kind, _, _, _): entry_kind,\n\u{7d};\n\npub fn is_file(value: (Str, Int?, Instant?, Instant?)): Bool = kind(value) == \"file\";\n\npub fn is_directory(value: (Str, Int?, Instant?, Instant?)): Bool = kind(value) == \"directory\";\n\npub fn is_symlink(value: (Str, Int?, Instant?, Instant?)): Bool = kind(value) == \"symlink\";\n\npub fn size_bytes(value: (Str, Int?, Instant?, Instant?)): Int? = case value \u{7b}\n    (\"file\", size, _, _): size,\n    (_, _, _, _): null,\n\u{7d};\n\npub fn modified_at(value: (Str, Int?, Instant?, Instant?)): Instant? = case value \u{7b}\n    (_, _, modified, _): modified,\n\u{7d};\n\npub fn created_at(value: (Str, Int?, Instant?, Instant?)): Instant? = case value \u{7b}\n    (_, _, _, created): created,\n\u{7d};\n" }
