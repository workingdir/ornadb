{ id: "asset-6173736574732f7374646c69622f7374642f71756572792e6f726e61", path: "assets/stdlib/std/query.orna", media_type: "text/plain; charset=utf-8", content: "// Query is the explicitly named finite-collection facade. These ordinary\n// Orna functions share the exact collection implementation and therefore keep\n// callback order, failures, and stable ordering aligned across both modules.\n// Contracts: partition returns (matching, remaining); zip stops at the shorter input; unique keeps each lawful equality class's first occurrence; lawful keys while preserving input order inside each group; adjacent and overlapping pairs; window emits complete windows only; split_when starts a group before a matching item; competition ranks (ties share a rank and later ranks skip tied positions).\nuse collection;\n\npub fn filter<T>(rows: [T], predicate: fn(T): Bool): [T] =\n    std.collection.filter(rows, predicate);\n\npub fn map<T, U>(rows: [T], transform: fn(T): U): [U] =\n    std.collection.map(rows, transform);\n\npub fn flat_map<T, U>(rows: [T], transform: fn(T): [U]): [U] =\n    std.collection.flat_map(rows, transform);\n\npub fn sort_by<T, K>(rows: [T], key: fn(T): K): [T] =\n    std.collection.sort_by(rows, key);\n\npub fn take<T>(rows: [T], count: Int): [T] = std.collection.take(rows, count);\n\npub fn drop<T>(rows: [T], count: Int): [T] = std.collection.drop(rows, count);\n\npub fn distinct<T>(rows: [T]): [T] = std.collection.distinct(rows);\n\npub fn union<T>(left: [T], right: [T]): [T] = std.collection.union(left, right);\n\npub fn count<T>(rows: [T]): Int = std.collection.count(rows);\n\npub fn first<T>(rows: [T]): T? = std.collection.first(rows);\n\npub fn one<T>(rows: [T], predicate: fn(T): Bool = value => true): T =\n    std.collection.one(rows, predicate);\n\npub fn sum<T>(rows: [T]): T = std.collection.sum(rows);\n\npub fn min<T>(rows: [T]): T? = std.collection.min(rows);\n\npub fn max<T>(rows: [T]): T? = std.collection.max(rows);\n\npub fn every<T>(rows: [T], predicate: fn(T): Bool): Bool =\n    std.collection.every(rows, predicate);\n\npub fn exists<T>(rows: [T], predicate: fn(T): Bool): Bool =\n    std.collection.exists(rows, predicate);\n\npub fn chunk<T>(values: [T], size: Int): [[T]] =\n    std.collection.chunk(values, size);\n\npub fn flatten<T>(values: [[T]]): [T] = std.collection.flatten(values);\n\npub fn partition<T>(values: [T], predicate: fn(T): Bool): ([T], [T]) =\n    std.collection.partition(values, predicate);\n\npub fn zip<T, U>(left: [T], right: [U]): [(T, U)] =\n    std.collection.zip(left, right);\n\npub fn zip_exact<T, U>(left: [T], right: [U]): [(T, U)] =\n    std.collection.zip_exact(left, right);\n\npub fn unique<T>(values: [T]): [T] = std.collection.unique(values);\n\npub fn group_by<T, K>(values: [T], key: fn(T): K): [(K, [T])] =\n    std.collection.group_by(values, key);\n\npub fn pairs<T>(values: [T]): [(T, T)] = std.collection.pairs(values);\n\npub fn window<T>(values: [T], size: Int, step: Int = 1): [[T]] =\n    std.collection.window(values, size, step);\n\n// Section 9 specifies complete positional windows and statistics separately.\n// This profile helper computes a mean for each complete window, preserving\n// the window's positive size/step checks and the statistic's exactness rules.\npub fn window_mean<T>(values: [T], size: Int, step: Int = 1): [T?] =\n    map(window(values, size, step), window_values => std.stats.mean(window_values));\n\n// Probability bounds and interpolation are preserved by the selected stats\n// operator for every complete window; no host-default interpolation is added.\npub fn window_percentile<T, P>(\n    values: [T],\n    size: Int,\n    probability: P,\n    interpolation: Str,\n    step: Int = 1\n): [T?] \u{7b}\n    let windows = window(values, size, step);\n    // Probability and named interpolation remain valid arguments even when\n    // complete windows are absent; the empty sample validates without sorting.\n    let _validated_options = std.stats.percentile(\n        std.collection.take(values, 0),\n        probability,\n        interpolation\n    );\n    map(\n        windows,\n        window_values => std.stats.percentile(window_values, probability, interpolation)\n    )\n\u{7d}\n\n// The remaining scalar and categorical statistics use the same complete\n// positional windows. Exact scale and rounding options are passed through\n// unchanged, so each window follows std.stats' explicit arithmetic contract.\npub fn window_sum<T>(values: [T], size: Int, step: Int = 1): [T] =\n    map(window(values, size, step), window_values => std.stats.sum(window_values));\n\npub fn window_median<T>(\n    values: [T],\n    size: Int,\n    step: Int = 1,\n    scale: Int? = null,\n    rounding: Str? = null\n): [T?] =\n    map(\n        window(values, size, step),\n        window_values => std.stats.median(window_values, scale, rounding)\n    );\n\npub fn window_min<T>(values: [T], size: Int, step: Int = 1): [T?] =\n    map(window(values, size, step), window_values => std.stats.min(window_values));\n\npub fn window_max<T>(values: [T], size: Int, step: Int = 1): [T?] =\n    map(window(values, size, step), window_values => std.stats.max(window_values));\n\npub fn window_range<T>(values: [T], size: Int, step: Int = 1): [T?] =\n    map(window(values, size, step), window_values => std.stats.range(window_values));\n\npub fn window_mode<T>(values: [T], size: Int, step: Int = 1): [[T]] =\n    map(window(values, size, step), window_values => std.stats.mode(window_values));\n\npub fn window_variance<T>(\n    values: [T],\n    size: Int,\n    step: Int = 1,\n    scale: Int? = null,\n    rounding: Str? = null\n): [T?] =\n    map(\n        window(values, size, step),\n        window_values => std.stats.variance(window_values, scale, rounding)\n    );\n\npub fn window_standard_deviation<T>(\n    values: [T],\n    size: Int,\n    step: Int = 1,\n    scale: Int? = null,\n    rounding: Str? = null\n): [T?] =\n    map(\n        window(values, size, step),\n        window_values => std.stats.standard_deviation(window_values, scale, rounding)\n    );\n\npub fn window_histogram<T>(\n    values: [T],\n    size: Int,\n    bins: [(T, T)],\n    include_final_upper: Bool = false,\n    step: Int = 1\n): [[Int]] \u{7b}\n    let windows = window(values, size, step);\n    // Bin ordering and overlap are part of the call contract, including when\n    // the source is too short to produce a complete window.\n    let _validated_bins = std.stats.histogram(\n        std.collection.take(values, 0),\n        bins,\n        include_final_upper\n    );\n    map(\n        windows,\n        window_values => std.stats.histogram(window_values, bins, include_final_upper)\n    )\n\u{7d}\n\n// Native leaf scans timestamps iteratively so a sparse series' skipped points\n// do not consume one source call frame each. Exported window operators still\n// construct complete windows and compute their real statistic values below.\nfn __strictly_ordered_time_series<T>(points: [(Instant, T)]): Bool = false;\nfn __window_rate<T>(points: [(Instant, T)], size: Int, step: Int): [T?] = [];\nfn __window_rate_integrate<T>(points: [(Instant, T)], size: Int, step: Int): [(T?, T?)] = [];\nfn __window_derivative<T>(points: [(Instant, T)], size: Int, step: Int): [[(Instant, T)]] = [];\nfn __window_integrate<T>(points: [(Instant, T)], size: Int, step: Int): [T?] = [];\n\n// Time-series statistics operate on complete timestamped windows. The stats\n// functions retain strict timestamp ordering and their value/time or\n// value×time result units; derivative timestamps remain each pair's right end.\n\n// Check window parameters before inspecting the source series so an empty or\n// malformed series cannot mask an invalid window request. The source needs at\n// least two strictly ordered points, and each produced time-series window also\n// needs two points. Global ordering catches reversals across sparse step gaps.\nfn ordered_time_series<T>(\n    points: [(Instant, T)],\n    size: Int,\n    step: Int\n): [(Instant, T)] =\n    if size <= 0 \u{7b}\n        fail(error(\n            code: \"std.collection.invalid_window_size\",\n            message: \"window size must be positive\"\n        ))\n    \u{7d} else if step <= 0 \u{7b}\n        fail(error(\n            code: \"std.collection.invalid_window_step\",\n            message: \"window step must be positive\"\n        ))\n    \u{7d} else if size < 2 \u{7b}\n        fail(error(\n            code: \"ORNA-EVAL-VALUE\",\n            message: \"time-series window size must be at least two points\"\n        ))\n    \u{7d} else if count(points) >= 2 && __strictly_ordered_time_series(points) \u{7b}\n        points\n    \u{7d} else \u{7b}\n        fail(error(\n            code: \"ORNA-EVAL-VALUE\",\n            message: \"time series needs at least two points with strictly increasing timestamps\"\n        ))\n    \u{7d};\n\npub fn window_rate<T>(\n    points: [(Instant, T)],\n    size: Int,\n    step: Int = 1\n): [T?] =\n    __window_rate(ordered_time_series(points, size, step), size, step);\n\n// Pair rate and integral from each identical complete window in source order;\n// sparse timestamps remain aligned instead of requiring two independent passes.\npub fn window_rate_integrate<T>(\n    points: [(Instant, T)],\n    size: Int,\n    step: Int = 1\n): [(T?, T?)] =\n    __window_rate_integrate(ordered_time_series(points, size, step), size, step);\n\npub fn window_derivative<T>(\n    points: [(Instant, T)],\n    size: Int,\n    step: Int = 1\n): [[(Instant, T)]] =\n    __window_derivative(ordered_time_series(points, size, step), size, step);\n\npub fn window_integrate<T>(\n    points: [(Instant, T)],\n    size: Int,\n    step: Int = 1\n): [T?] =\n    __window_integrate(ordered_time_series(points, size, step), size, step);\n\n// Produces consecutive nonempty groups; each matching item starts a new group.\npub fn split_when<T>(values: [T], predicate: fn(T): Bool): [[T]] =\n    std.collection.split_when(values, predicate);\n\npub fn rank<T, K>(values: [T], key: fn(T): K): [(T, Int)] =\n    std.collection.rank(values, key);\n\npub fn asof_join<T, Time, Key>(\n    left: [T], right: [T], time: fn(T): Time, by: fn(T): Key\n): [(T, T?)] = std.collection.asof_join(left, right, time, by);\n\npub fn bucket_by<T, P>(rows: [T], period: P, zone: Str): [[T]] =\n    std.collection.bucket_by(rows, period, zone);\n\n// Section 9 does not prescribe a query-plan hint API. This profile exposes the\n// planner's structured, snapshot-pinned plan so callers can inspect its chosen\n// operators and estimate assumptions without parsing rendered explain text.\npub fn plan_hint<T>(query: Query<T>): sys.Plan = sys.explain(query);\n" }
