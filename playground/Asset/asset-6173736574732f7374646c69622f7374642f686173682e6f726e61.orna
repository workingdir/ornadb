{ id: "asset-6173736574732f7374646c69622f7374642f686173682e6f726e61", path: "assets/stdlib/std/hash.orna", media_type: "text/plain; charset=utf-8", content: "// Hash helpers operate on exact input bytes and return the core nominal Digest\n// type. Digests are fingerprints, not equality proofs: callers must still\n// compare the original typed values when a collision could change semantics.\n// Hashes of low-entropy secret values are sensitive and must not be published\n// as public identifiers; domain separation does not prevent dictionary attacks.\n//\n// The pinned runtime binds the recursive primitive calls below to its SHA-256\n// implementation. The public functions remain ordinary, captured module\n// exports; an absent optional std snapshot never supplies these operations.\n//\n// SHA-256 over the complete Blob, returning the 32-byte digest value.\npub fn sha256(input: Blob): Digest = __sha256(input);\nfn __sha256(input: Blob): Digest = sha256(input);\n\n// Encode text as its exact UTF-8 bytes before hashing. No Unicode\n// normalisation, case folding or locale conversion is applied.\npub fn sha256_text(input: Str): Digest = __sha256_text(input);\nfn __sha256_text(input: Str): Digest = sha256_text(input);\n\n// Compute SHA256(ASCII(domain) || 00 || payload). Domain must be nonempty\n// ASCII without an embedded zero byte. The separator is exactly one zero byte;\n// payload bytes are not interpreted, normalised or re-encoded.\npub fn domain_sha256(domain: Str, payload: Blob): Digest = __domain_sha256(domain, payload);\nfn __domain_sha256(domain: Str, payload: Blob): Digest = domain_sha256(domain, payload);\n\n// Render a Digest as exactly 64 lowercase hexadecimal characters. Digest has\n// no implicit conversion to Str; this is an explicit presentation helper.\npub fn to_hex(digest: Digest): Str = __to_hex(digest);\nfn __to_hex(digest: Digest): Str = to_hex(digest);\n\n// Parse exactly 64 lowercase hexadecimal characters. Return null for uppercase,\n// whitespace, invalid characters or any other length; do not trim or repair.\npub fn from_hex(value: Str): Digest? = __from_hex(value);\nfn __from_hex(value: Str): Digest? = from_hex(value);\n" }
