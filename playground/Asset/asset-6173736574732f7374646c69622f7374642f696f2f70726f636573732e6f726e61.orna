{ id: "asset-6173736574732f7374646c69622f7374642f696f2f70726f636573732e6f726e61", path: "assets/stdlib/std/io/process.orna", media_type: "text/plain; charset=utf-8", content: "// Process launch is an explicit host effect. Executable and argument strings\n// stay separate, and callers provide the working directory and complete child\n// environment. A null stdin closes immediately; a positive output bound\n// applies to stdout plus stderr. Timeouts terminate and join the child before\n// reporting failure. No shell, CWD, or ambient environment is inherited.\n\npub fn run(\n    executable: Str,\n    arguments: [Str],\n    working_directory: Str,\n    environment: [(Str, Str)],\n    input: Blob?,\n    timeout: Duration?,\n    max_output_bytes: Int,\n): (Int?, Blob, Blob) = __run(\n    executable, arguments, working_directory, environment, input, timeout, max_output_bytes\n);\n\nfn __run(\n    executable: Str,\n    arguments: [Str],\n    working_directory: Str,\n    environment: [(Str, Str)],\n    input: Blob?,\n    timeout: Duration?,\n    max_output_bytes: Int,\n): (Int?, Blob, Blob) = std.io.process.run(\n    executable, arguments, working_directory, environment, input, timeout, max_output_bytes\n);\n" }
