{ id: "asset-6173736574732f7374646c69622f7374642f636f6c6c656374696f6e2f61646170746572732e6f726e61", path: "assets/stdlib/std/collection/adapters.orna", media_type: "text/plain; charset=utf-8", content: "// Shape adapters for finite collections. All results preserve source order;\n// indexing starts at zero, and pairwise adapters stop at the shorter input.\n\nfn enumerate_from<T>(values: [T], index: Int, end: Int, output: [(Int, T)]): [(Int, T)] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        enumerate_from(values, index + 1, end, std.collection.union(output, [(index, values[index])]))\n    \u{7d};\n\n// Adds each value's zero-based source position without changing its order.\npub fn enumerate<T>(values: [T]): [(Int, T)] =\n    enumerate_from(values, 0, std.collection.count(values), []);\n\nfn map_indexed_from<T, U>(\n    values: [T], transform: fn(Int, T): U, index: Int, end: Int, output: [U]\n): [U] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        map_indexed_from(\n            values,\n            transform,\n            index + 1,\n            end,\n            std.collection.union(output, [transform(index, values[index])]),\n        )\n    \u{7d};\n\n// Calls transform once per value, from left to right, with its zero-based index.\npub fn map_indexed<T, U>(values: [T], transform: fn(Int, T): U): [U] =\n    map_indexed_from(values, transform, 0, std.collection.count(values), []);\n\nfn zip_with_from<T, U, V>(\n    left: [T], right: [U], combine: fn(T, U): V, index: Int, end: Int, output: [V]\n): [V] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        zip_with_from(\n            left,\n            right,\n            combine,\n            index + 1,\n            end,\n            std.collection.union(output, [combine(left[index], right[index])]),\n        )\n    \u{7d};\n\n// Combines aligned values in order and stops at the shorter input. The\n// callback is called only for pairs that appear in the result.\nfn shorter_length(left: Int, right: Int): Int =\n    if left < right \u{7b} left \u{7d} else \u{7b} right \u{7d};\n\npub fn zip_with<T, U, V>(left: [T], right: [U], combine: fn(T, U): V): [V] =\n    zip_with_from(\n        left,\n        right,\n        combine,\n        0,\n        shorter_length(std.collection.count(left), std.collection.count(right)),\n        [],\n    );\n\nfn unzip_from<T, U>(\n    pairs: [(T, U)], index: Int, end: Int, left: [T], right: [U]\n): ([T], [U]) =\n    if index >= end \u{7b}\n        (left, right)\n    \u{7d} else \u{7b}\n        let (left_value, right_value) = pairs[index];\n        unzip_from(\n            pairs,\n            index + 1,\n            end,\n            std.collection.union(left, [left_value]),\n            std.collection.union(right, [right_value]),\n        )\n    \u{7d};\n\n// Splits pairs into parallel lists, retaining each component's source order.\npub fn unzip<T, U>(pairs: [(T, U)]): ([T], [U]) =\n    unzip_from(pairs, 0, std.collection.count(pairs), [], []);\n" }
