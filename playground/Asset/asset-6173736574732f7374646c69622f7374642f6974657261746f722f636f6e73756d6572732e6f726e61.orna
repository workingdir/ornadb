{ id: "asset-6173736574732f7374646c69622f7374642f6974657261746f722f636f6e73756d6572732e6f726e61", path: "assets/stdlib/std/iterator/consumers.orna", media_type: "text/plain; charset=utf-8", content: "// Terminal consumers traverse persistent pull cursors in source order. A\n// consumer only advances its local successor; the original cursor can be\n// observed again and callbacks may therefore run again on replay.\n\nfn any_from<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): Bool = case std.iterator.next(source) \u{7b}\n    (Some(value), _) if predicate(value): true,\n    (Some(_), tail): any_from(tail, predicate),\n    (null, _): false,\n\u{7d};\n\n// Stops at the first item accepted by `predicate`; an empty cursor is false.\npub fn any<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): Bool = any_from(source, predicate);\n\nfn all_from<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): Bool = case std.iterator.next(source) \u{7b}\n    (Some(value), _) if !predicate(value): false,\n    (Some(_), tail): all_from(tail, predicate),\n    (null, _): true,\n\u{7d};\n\n// Returns true for an empty cursor and stops at the first rejected item.\npub fn all<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): Bool = all_from(source, predicate);\n\nfn find_from<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): T? = case std.iterator.next(source) \u{7b}\n    (Some(value), _) if predicate(value): Some(value),\n    (Some(_), tail): find_from(tail, predicate),\n    (null, _): null,\n\u{7d};\n\n// Returns the first matching item, or null after a finite cursor is exhausted.\npub fn find<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): T? = find_from(source, predicate);\n\nfn find_map_from<T, U>(\n    source: std.iterator.Iterator<T>,\n    transform: fn(T): U?,\n): U? = case std.iterator.next(source) \u{7b}\n    (Some(value), tail): case transform(value) \u{7b}\n        Some(mapped): Some(mapped),\n        null: find_map_from(tail, transform),\n    \u{7d},\n    (null, _): null,\n\u{7d};\n\n// Skips null transform results and returns the first Some result.\npub fn find_map<T, U>(\n    source: std.iterator.Iterator<T>,\n    transform: fn(T): U?,\n): U? = find_map_from(source, transform);\n\nfn position_from<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n    index: Int,\n): Int? = case std.iterator.next(source) \u{7b}\n    (Some(value), _) if predicate(value): Some(index),\n    (Some(_), tail): position_from(tail, predicate, index + 1),\n    (null, _): null,\n\u{7d};\n\n// Returns the zero-based position of the first match, or null when absent.\npub fn position<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): Int? = position_from(source, predicate, 0);\n\nfn count_from<T>(source: std.iterator.Iterator<T>): Int =\n    case std.iterator.next(source) \u{7b}\n        (Some(_), tail): 1 + count_from(tail),\n        (null, _): 0,\n    \u{7d};\n\n// Counts a finite cursor; an infinite cursor does not terminate.\npub fn count<T>(source: std.iterator.Iterator<T>): Int = count_from(source);\n\nfn count_by_from<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): Int = case std.iterator.next(source) \u{7b}\n    (Some(value), tail) if predicate(value): 1 + count_by_from(tail, predicate),\n    (Some(_), tail): count_by_from(tail, predicate),\n    (null, _): 0,\n\u{7d};\n\n// Counts the items accepted by `predicate` in a finite cursor.\npub fn count_by<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): Int = count_by_from(source, predicate);\n\nfn partition_from<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n    accepted: [T],\n    rejected: [T],\n): ([T], [T]) = case std.iterator.next(source) \u{7b}\n    (Some(value), tail) if predicate(value):\n        partition_from(tail, predicate, std.collection.union(accepted, [value]), rejected),\n    (Some(value), tail):\n        partition_from(tail, predicate, accepted, std.collection.union(rejected, [value])),\n    (null, _): (accepted, rejected),\n\u{7d};\n\n// Partitions a finite cursor into stable accepted and rejected lists.\npub fn partition<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): ([T], [T]) = partition_from(source, predicate, [], []);\n\nfn reduce_from<T>(\n    source: std.iterator.Iterator<T>,\n    accumulated: T,\n    combine: fn(T, T): T,\n): T? = case std.iterator.next(source) \u{7b}\n    (Some(value), tail): reduce_from(tail, combine(accumulated, value), combine),\n    (null, _): Some(accumulated),\n\u{7d};\n\n// Reduces a nonempty finite cursor from left to right; empty input returns null.\npub fn reduce<T>(\n    source: std.iterator.Iterator<T>,\n    combine: fn(T, T): T,\n): T? = case std.iterator.next(source) \u{7b}\n    (Some(value), tail): reduce_from(tail, value, combine),\n    (null, _): null,\n\u{7d};\n" }
