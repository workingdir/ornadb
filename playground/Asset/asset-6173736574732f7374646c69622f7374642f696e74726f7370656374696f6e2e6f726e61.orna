{ id: "asset-6173736574732f7374646c69622f7374642f696e74726f7370656374696f6e2e6f726e61", path: "assets/stdlib/std/introspection.orna", media_type: "text/plain; charset=utf-8", content: "// Read-only helpers over the mandatory typed `sys` catalogue and observation\n// APIs. These wrappers preserve the caller's explicit snapshot and reference;\n// they do not evaluate source text or substitute missing retained data.\n\n// Return safe metadata for the value's exact static type. No dynamic Any\n// conversion or private-field disclosure is introduced by this helper.\npub fn metadata<T>(value: T): sys.ValueMetadata<T> = sys.meta(value);\n\n// Resolve with the system's normal visibility and import rules at one pinned\n// snapshot. `from` supplies the optional calling module context.\npub fn resolve_object(\n    name: Str,\n    kind: sys.ObjectKind? = null,\n    at: sys.SnapshotRef = sys.current.snapshot,\n    from: sys.ModuleRef? = null\n): sys.ObjectRef = sys.resolve(name, kind, at, from);\n\npub fn resolve_function(\n    name: Str,\n    at: sys.SnapshotRef = sys.current.snapshot,\n    from: sys.ModuleRef? = null\n): sys.FunctionRef = sys.resolve_function(name, at, from);\n\n// Structured descriptions and retained source keep the system API's pin and\n// redaction rules. Unavailable or redacted source remains an ordinary result\n// or failure from `sys`; this module never invents replacement text.\npub fn describe(object: sys.ObjectRef): sys.ObjectDescription = sys.describe(object);\n\npub fn source(object: sys.ObjectRef): sys.SourceDocument = sys.source(object);\n\npub fn file_source(file: sys.FileRef): sys.SourceDocument = sys.source(file);\n\npub fn history(object: sys.ObjectRef): Relation<sys.Revision> = sys.history(object);\n\npub fn file_history(file: sys.FileRef): Relation<sys.FileVersion> = sys.history(file);\n\n// Dependency traversal is cycle-safe and deterministic according to the\n// pinned `sys` contract; callers choose direct or transitive edges explicitly.\npub fn dependencies(\n    object: sys.ObjectRef,\n    transitive: Bool = false,\n    kinds: [sys.DependencyKind]? = null\n): Relation<sys.Dependency> = sys.dependencies(object, transitive, kinds);\n\npub fn dependents(\n    object: sys.ObjectRef,\n    transitive: Bool = false,\n    kinds: [sys.DependencyKind]? = null\n): Relation<sys.Dependency> = sys.dependents(object, transitive, kinds);\n\npub fn explain_function(function: sys.FunctionRef): sys.Plan = sys.explain(function);\n\npub fn explain_query<T>(query: Query<T>): sys.Plan = sys.explain(query);\n\npub fn explain_diagnostic(diagnostic: sys.Diagnostic): sys.Explanation =\n    sys.explain(diagnostic);\n" }
