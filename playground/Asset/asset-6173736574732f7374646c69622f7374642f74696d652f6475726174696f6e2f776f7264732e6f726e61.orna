{ id: "asset-6173736574732f7374646c69622f7374642f74696d652f6475726174696f6e2f776f7264732e6f726e61", path: "assets/stdlib/std/time/duration/words.orna", media_type: "text/plain; charset=utf-8", content: "pub fn format(\n    duration: Duration,\n    context: \u{7b} locale: Str, time_zone: Str \u{7d} = \u{7b} locale: \"en\", time_zone: \"UTC\" \u{7d}\n): Str = __format(duration, context);\nfn __format(\n    duration: Duration,\n    context: \u{7b} locale: Str, time_zone: Str \u{7d}\n): Str = format(duration, context);\n" }
