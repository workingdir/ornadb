{ id: "asset-6173736574732f7374646c69622f7374642f6c6973742e6f726e61", path: "assets/stdlib/std/list.orna", media_type: "text/plain; charset=utf-8", content: "// Finite-list helpers over Orna's immutable [T] value type. Positional\n// operations preserve duplicates and input order; unique is the explicit\n// duplicate-removing operation. Generic transforms remain in std.collection.\nuse collection;\n\npub fn singleton<T>(value: T): [T] = [value];\n\npub fn length<T>(values: [T]): Int = std.collection.count(values);\n\npub fn is_empty<T>(values: [T]): Bool = length(values) == 0;\n\npub fn append<T>(values: [T], value: T): [T] =\n    std.collection.union(values, [value]);\n\npub fn prepend<T>(values: [T], value: T): [T] =\n    std.collection.union([value], values);\n\npub fn concat<T>(left: [T], right: [T]): [T] =\n    std.collection.union(left, right);\n\npub fn first<T>(values: [T]): T? = std.collection.first(values);\n\npub fn last<T>(values: [T]): T? =\n    if is_empty(values) \u{7b}\n        null\n    \u{7d} else \u{7b}\n        first(std.collection.drop(values, length(values) - 1))\n    \u{7d};\n\npub fn contains<T>(values: [T], value: T): Bool =\n    std.collection.exists(values, item => item == value);\n\npub fn take<T>(values: [T], count: Int): [T] = std.collection.take(values, count);\n\npub fn drop<T>(values: [T], count: Int): [T] = std.collection.drop(values, count);\n\npub fn unique<T>(values: [T]): [T] = std.collection.unique(values);\n\nfn reverse_into<T>(remaining: [T], reversed: [T]): [T] =\n    case std.collection.first(remaining) \u{7b}\n        Some(value): reverse_into(\n            std.collection.drop(remaining, 1),\n            std.collection.union([value], reversed)\n        ),\n        null: reversed,\n    \u{7d};\n\npub fn reverse<T>(values: [T]): [T] = reverse_into(values, []);\n" }
