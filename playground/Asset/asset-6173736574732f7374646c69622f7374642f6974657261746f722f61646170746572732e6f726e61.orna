{ id: "asset-6173736574732f7374646c69622f7374642f6974657261746f722f61646170746572732e6f726e61", path: "assets/stdlib/std/iterator/adapters.orna", media_type: "text/plain; charset=utf-8", content: "// The reference pins iterator cursors but does not prescribe a separate\n// adapter catalogue. These adapters follow std.iterator's persistent pull\n// contract: callbacks run only as output is requested, source order is kept,\n// and replaying an input cursor recomputes the same pure traversal.\n\nfn filter_map_pull<T, U>(\n    source: std.iterator.Iterator<T>,\n    transform: fn(T): U?,\n): (U?, std.iterator.Iterator<U>) =\n    case std.iterator.next(source) \u{7b}\n        (Some(value), tail): case transform(value) \u{7b}\n            Some(mapped): (\n                Some(mapped),\n                std.iterator.Iterator \u{7b}\n                    pull: () => filter_map_pull(tail, transform),\n                \u{7d},\n            ),\n            null: filter_map_pull(tail, transform),\n        \u{7d},\n        (null, _): (null, std.iterator.empty()),\n    \u{7d};\n\n// Maps each requested source item to an optional value, skipping only null\n// results. Some(null) remains an emitted value distinct from null itself.\npub fn filter_map<T, U>(\n    source: std.iterator.Iterator<T>,\n    transform: fn(T): U?,\n): std.iterator.Iterator<U> = std.iterator.Iterator \u{7b}\n    pull: () => filter_map_pull(source, transform),\n\u{7d};\n\nfn flat_map_cursor<T, U>(\n    source: std.iterator.Iterator<T>,\n    transform: fn(T): std.iterator.Iterator<U>,\n): std.iterator.Iterator<U> = std.iterator.Iterator \u{7b}\n    pull: () => case std.iterator.next(source) \u{7b}\n        (Some(value), tail): std.iterator.next(\n            std.iterator.chain(\n                transform(value),\n                flat_map_cursor(tail, transform),\n            )\n        ),\n        (null, _): (null, std.iterator.empty()),\n    \u{7d},\n\u{7d};\n\n// Drains each mapped cursor before requesting the next source item.\npub fn flat_map<T, U>(\n    source: std.iterator.Iterator<T>,\n    transform: fn(T): std.iterator.Iterator<U>,\n): std.iterator.Iterator<U> = flat_map_cursor(source, transform);\n\n// Concatenates one level of nested cursors in outer order, then inner order.\npub fn flatten<T>(\n    source: std.iterator.Iterator<std.iterator.Iterator<T>>,\n): std.iterator.Iterator<T> =\n    flat_map(source, inner => inner);\n\nfn skip_while_pull<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): (T?, std.iterator.Iterator<T>) =\n    case std.iterator.next(source) \u{7b}\n        (Some(value), tail) if predicate(value): skip_while_pull(tail, predicate),\n        (Some(value), tail): (Some(value), tail),\n        (null, _): (null, std.iterator.empty()),\n    \u{7d};\n\n// Drops the matching prefix only; after the first rejected item, the original\n// persistent tail is returned untouched and no later predicate calls occur.\npub fn skip_while<T>(\n    source: std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): std.iterator.Iterator<T> = std.iterator.Iterator \u{7b}\n    pull: () => skip_while_pull(source, predicate),\n\u{7d};\n" }
