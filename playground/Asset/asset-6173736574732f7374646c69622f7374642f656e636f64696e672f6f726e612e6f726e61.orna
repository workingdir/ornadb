{ id: "asset-6173736574732f7374646c69622f7374642f656e636f64696e672f6f726e612e6f726e61", path: "assets/stdlib/std/encoding/orna.orna", media_type: "text/plain; charset=utf-8", content: "// Canonical Orna text is schema directed. Decoding accepts the data subset\n// for the supplied type only; it never executes declarations, imports,\n// interpolations or arbitrary functions. Refinements are revalidated before\n// a value is returned. Unsupported or private data fails instead of being\n// omitted or converted through a presentation string.\n//\n// Encoded output is UTF-8 without a BOM, uses LF, two-space record indentation,\n// one space after `:`, comma-separated array and tuple items, a trailing comma\n// after each record field, and exactly one final LF. Record order follows the\n// primary-key order followed by stable field-ID order for rows, and NFC field\n// name order for structural records. Arrays and tuples retain value order.\n// Int uses minimal decimal digits; Decimal uses its normalised coefficient\n// and exponent; finite Float uses 17 significant digits and preserves signed\n// zero. String controls use the canonical escapes. Blob values use quoted,\n// padded standard Base64. Locale formatting is never a serialization form.\n// Decode calls supply the required static type witness using the call form\n// `decode(input, as: T)`; `as` selects T and is not a runtime value argument.\n\npub fn encode<T>(value: T): Str = __encode(value);\nfn __encode<T>(value: T): Str = encode(value);\n\npub fn decode<T>(input: Str): T = __decode(input);\nfn __decode<T>(input: Str): T = decode(input);\n" }
