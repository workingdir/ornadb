{ id: "asset-6173736574732f7374646c69622f7374642f696f2f706174682e6f726e61", path: "assets/stdlib/std/io/path.orna", media_type: "text/plain; charset=utf-8", content: "// Portable filesystem paths use `/` as the only separator and are always\n// relative to an explicit filesystem root. Empty components and `.` are\n// removed. `..` removes one prior component and fails when it would escape\n// the root. Backslashes are rejected so a path cannot change meaning when a\n// snapshot moves between hosts. The empty path and the root itself normalize\n// to `.`; this value names the authorized root and never the process CWD.\n// `components` returns normalized non-root segments. `basename` returns the\n// final segment and `dirname` returns the normalized parent (`.` for a direct\n// child); both return null for the root. `extension` ignores a leading dot\n// on a dotfile, and `stem` keeps earlier dots while removing the last suffix.\nuse std.text;\nuse std.collection;\n\nfn normalize_segments(remaining: [Str], normalized: [Str]): [Str] =\n    case std.collection.first(remaining) \u{7b}\n        Some(segment):\n            if segment == \"\" || segment == \".\" \u{7b}\n                normalize_segments(std.collection.drop(remaining, 1), normalized)\n            \u{7d} else if segment == \"..\" \u{7b}\n                if std.collection.count(normalized) == 0 \u{7b}\n                    fail(error(\n                        code: \"std.io.path.root_escape\",\n                        message: \"relative filesystem path escapes its authorized root\"\n                    ))\n                \u{7d} else \u{7b}\n                    normalize_segments(\n                        std.collection.drop(remaining, 1),\n                        std.collection.take(normalized, std.collection.count(normalized) - 1)\n                    )\n                \u{7d}\n            \u{7d} else \u{7b}\n                normalize_segments(\n                    std.collection.drop(remaining, 1),\n                    std.collection.union(normalized, [segment])\n                )\n            \u{7d},\n        null: normalized,\n    \u{7d};\n\npub fn is_absolute(path: Str): Bool = std.text.starts_with(path, \"/\");\n\npub fn normalize(path: Str): Str =\n    if is_absolute(path) \u{7b}\n        fail(error(\n            code: \"std.io.path.absolute\",\n            message: \"filesystem paths must be relative to an authorized root\"\n        ))\n    \u{7d} else if std.text.contains(path, \"\\\\\") \u{7b}\n        fail(error(\n            code: \"std.io.path.ambiguous_separator\",\n            message: \"portable filesystem paths use `/` and reject backslashes\"\n        ))\n    \u{7d} else \u{7b}\n        let segments = normalize_segments(std.text.split(path, \"/\"), []);\n        if std.collection.count(segments) == 0 \u{7b}\n            \".\"\n        \u{7d} else \u{7b}\n            std.text.join(segments, \"/\")\n        \u{7d}\n    \u{7d};\n\npub fn normalise(path: Str): Str = normalize(path);\n\npub fn components(path: Str): [Str] \u{7b}\n    let normalized = normalize(path);\n    if normalized == \".\" \u{7b} [] \u{7d} else \u{7b} std.text.split(normalized, \"/\") \u{7d}\n\u{7d}\n\npub fn join(prefix_path: Str, child: Str): Str =\n    if is_absolute(child) \u{7b}\n        fail(error(\n            code: \"std.io.path.absolute\",\n            message: \"a joined filesystem path must remain relative to its root\"\n        ))\n    \u{7d} else if prefix_path == \"\" || prefix_path == \".\" \u{7b}\n        normalize(child)\n    \u{7d} else if child == \"\" || child == \".\" \u{7b}\n        normalize(prefix_path)\n    \u{7d} else \u{7b}\n        normalize(std.text.join([prefix_path, child], \"/\"))\n    \u{7d};\n\npub fn basename(path: Str): Str? \u{7b}\n    let parts = components(path);\n    let count = std.collection.count(parts);\n    if count == 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        std.collection.first(std.collection.drop(parts, count - 1))\n    \u{7d}\n\u{7d}\n\nfn take_prefix(remaining: [Str], wanted: Int, collected: [Str]): [Str] =\n    if wanted <= 0 \u{7b}\n        collected\n    \u{7d} else \u{7b}\n        case std.collection.first(remaining) \u{7b}\n            Some(segment): take_prefix(\n                std.collection.drop(remaining, 1),\n                wanted - 1,\n                std.collection.union(collected, [segment])\n            ),\n            null: collected,\n        \u{7d}\n    \u{7d};\n\npub fn dirname(path: Str): Str? \u{7b}\n    let parts = components(path);\n    if std.collection.count(parts) == 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        let prefix = take_prefix(parts, std.collection.count(parts) - 1, []);\n        if std.collection.count(prefix) == 0 \u{7b}\n            std.collection.first([\".\"])\n        \u{7d} else \u{7b}\n            std.collection.first([std.text.join(prefix, \"/\")])\n        \u{7d}\n    \u{7d}\n\u{7d}\n\nfn extension_from_name(name: Str): Str? \u{7b}\n    let parts = std.text.split(name, \".\");\n    let count = std.collection.count(parts);\n    let suffix = if count == 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        std.collection.first(std.collection.drop(parts, count - 1))\n    \u{7d};\n    if count <= 1 || suffix == null || suffix == std.collection.first([\"\"]) \u{7b}\n        null\n    \u{7d} else if std.text.starts_with(name, \".\") && count == 2 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        suffix\n    \u{7d}\n\u{7d}\n\npub fn extension(path: Str): Str? =\n    case basename(path) \u{7b}\n        Some(name): extension_from_name(name),\n        null: null,\n    \u{7d};\n\nfn stem_from_name(name: Str): Str \u{7b}\n    let parts = std.text.split(name, \".\");\n    std.text.join(take_prefix(parts, std.collection.count(parts) - 1, []), \".\")\n\u{7d}\n\npub fn stem(path: Str): Str? = case basename(path) \u{7b}\n    Some(name):\n        if extension_from_name(name) == null \u{7b}\n            std.collection.first([name])\n        \u{7d} else \u{7b}\n            std.collection.first([stem_from_name(name)])\n        \u{7d},\n    null: null,\n\u{7d};\n" }
