{ id: "asset-6173736574732f7374646c69622f7374642f75692e6f726e61", path: "assets/stdlib/std/ui.orna", media_type: "text/plain; charset=utf-8", content: "// Renderer-neutral presentation helpers. Values stay typed in properties;\n// renderers may use their Inspect fallback whenever they do not recognize a\n// node contract. These constructors never execute action descriptors.\n\nfn __node<P, A>(\n    kind: Str,\n    properties: P,\n    children: [UI],\n    actions: [(Str, A)],\n    property_types: [(Str, Str)],\n): UI = __node(kind, properties, children, actions, property_types);\n\n// A Field retains the original value and its runtime type. Details therefore\n// accepts homogeneous UI nodes rather than coercing mixed values to text.\npub fn Field<T>(label: Str, value: T): UI =\n    __node(\"field\", \u{7b} label: label, value: value \u{7d}, [], [], []);\n\npub fn Text(value: Str): UI =\n    __node(\"text\", \u{7b} value: value \u{7d}, [], [], []);\n\npub fn Rows(children: [UI]): UI = __node(\"rows\", \u{7b}\u{7d}, children, [], []);\npub fn Cols(children: [UI]): UI = __node(\"cols\", \u{7b}\u{7d}, children, [], []);\npub fn Stack(children: [UI]): UI = __node(\"stack\", \u{7b}\u{7d}, children, [], []);\npub fn Details(fields: [UI]): UI = __node(\"details\", \u{7b}\u{7d}, fields, [], []);\n\n// Table and Tree retain typed source values instead of rendering them while\n// the plan is being evaluated. Columns are stable labels in input order.\npub fn Table<T>(rows: T, columns: [Str] = []): UI =\n    __node(\"table\", \u{7b} rows: rows, columns: columns \u{7d}, [], [], []);\n\npub fn Tree<T>(root: T): UI = __node(\"tree\", \u{7b} root: root \u{7d}, [], [], []);\n\npub fn Code(source: Str, language: Str? = null): UI =\n    __node(\n        \"code\",\n        \u{7b} source: source, language: language \u{7d},\n        [],\n        [],\n        [(\"language\", \"std.option<std.text>\")],\n    );\n\npub fn Diff<T>(change: T): UI = __node(\"diff\", \u{7b} change: change \u{7d}, [], [], []);\n\npub fn Chart<T>(series: T, title: Str? = null): UI =\n    __node(\n        \"chart\",\n        \u{7b} series: series, title: title \u{7d},\n        [],\n        [],\n        [(\"title\", \"std.option<std.text>\")],\n    );\n\n// Only the host-issued Action descriptor is retained. This helper does not\n// invoke it or synthesize an executable handle.\npub fn Button<A>(label: Str, action: A): UI =\n    __node(\"button\", \u{7b} label: label \u{7d}, [], [(\"activate\", action)], []);\n\npub fn Form<A>(fields: [UI], submit: A? = null): UI =\n    __node(\n        \"form\",\n        \u{7b}\u{7d},\n        fields,\n        case submit \u{7b}\n            Some(action): [(\"submit\", action)],\n            null: [],\n        \u{7d},\n        [],\n    );\n\n// Input takes the option value itself: wrapping T in T? would turn an already\n// typed Option<T> into Option<Option<T>> and leave a bare null uninferable.\n// Its Action supplies the type for an absent value and the server checks that\n// a present value agrees with the event handle.\npub fn Input<T, A>(\n    name: Str,\n    label: Str,\n    value: T,\n    action: A,\n    placeholder: Str? = null,\n): UI = __node(\n    \"input\",\n    \u{7b}\n        name: name,\n        label: label,\n        value: value,\n        placeholder: placeholder,\n    \u{7d},\n    [],\n    [(\"change\", action)],\n    [],\n);\n" }
