{ id: "asset-6173736574732f7374646c69622f7374642f7072656c7564652e6f726e61", path: "assets/stdlib/std/prelude.orna", media_type: "text/plain; charset=utf-8", content: "// Curated, pure entry points for common standard-library work. The source\n// snapshot records which public names are imported by `use std.prelude as _`.\nuse std.collection as collection;\nuse std.option as option;\nuse std.text as text;\n\npub fn api_version(): Str = \"orna.std.prelude/1\";\n\npub fn version(): Str = \"1.0.0\";\n\npub fn count<T>(values: [T]): Int = collection.count(values);\n\npub fn first<T>(values: [T]): T? = collection.first(values);\n\npub fn unique<T>(values: [T]): [T] = collection.unique(values);\n\npub fn trim(value: Str): Str = text.trim(value);\n\npub fn split(value: Str, separator: Str): [Str] = text.split(value, separator);\n\npub fn is_some<T>(value: T?): Bool = option.is_some(value);\n\npub fn is_none<T>(value: T?): Bool = option.is_none(value);\n" }
