{ id: "asset-6578616d706c65732e637373", path: "examples.css", media_type: "text/css; charset=utf-8", content: "body \u{7b} max-width: 72ch; margin: 1.5rem auto; padding: 0 1rem; color: #202122; font: 1rem/1.5 Georgia, \"Times New Roman\", serif; \u{7d}\na \u{7b} color: #0645ad; \u{7d}\n.page-header \u{7b} border-bottom: 1px solid #a2a9b1; margin-bottom: 1rem; \u{7d}\n.page-header h1 \u{7b} margin-bottom: 0; font-size: 1.6rem; font-weight: 400; \u{7d}\n.catalog-list \u{7b} padding-left: 1.5rem; \u{7d}\n.catalog-item \u{7b} border-bottom: 1px solid #a2a9b1; padding: .75rem 0; \u{7d}\n.catalog-item h2 \u{7b} margin: 0; font-size: 1.15rem; font-weight: 500; \u{7d}\n.catalog-path, .catalog-links \u{7b} margin: .25rem 0; \u{7d}\n.catalog-item pre \u{7b} overflow: auto; padding: .75rem; background: #f8f9fa; font: .9rem/1.5 ui-monospace, SFMono-Regular, Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; \u{7d}\n#example-filter \u{7b} width: 100%; max-width: 34rem; font: inherit; \u{7d}\n#catalog-status \u{7b} color: #54595d; \u{7d}\n" }
