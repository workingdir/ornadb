{ id: "asset-6173736574732f7374646c69622f7374642f73747265616d2f61646170746572732e6f726e61", path: "assets/stdlib/std/stream/adapters.orna", media_type: "text/plain; charset=utf-8", content: "// Finite cursor adapters materialize a persistent iterator once, then pin the\n// resulting list as a replayable stream source. These helpers require finite\n// input; they do not make an unbounded iterator safe to consume.\n\n// Adapt a finite iterator into a replayable stream in pull order. The source\n// identity is still combined with the typed digest of the collected values.\npub fn from_iterator<T>(\n    source: std.iterator.Iterator<T>,\n    source_identity: Str\n): Stream<T> = std.stream.from_list(\n    std.iterator.collect(source),\n    source_identity\n);\n\n// Invoke a sequence factory once, then adapt its finite iterator. This keeps\n// the source thunk boundary explicit while the returned stream is replayable.\npub fn from_sequence<T>(\n    source: fn(): std.iterator.Iterator<T>,\n    source_identity: Str\n): Stream<T> = from_iterator(source(), source_identity);\n\n// Collect a finite iterator in source order and emit positive-size batches.\n// The final short batch is retained by std.stream.from_list_batches.\npub fn from_iterator_batches<T>(\n    source: std.iterator.Iterator<T>,\n    source_identity: Str,\n    batch_size: Int\n): Stream<[T]> = std.stream.from_list_batches(\n    std.iterator.collect(source),\n    source_identity,\n    batch_size\n);\n\n// Invoke a sequence factory once before adapting and batching its finite\n// iterator. Batch validation and source identity remain owned by std.stream.\npub fn from_sequence_batches<T>(\n    source: fn(): std.iterator.Iterator<T>,\n    source_identity: Str,\n    batch_size: Int\n): Stream<[T]> = from_iterator_batches(source(), source_identity, batch_size);\n\n// Batch first, then add the bounded backpressure adapter to each emitted\n// group. Item order and the final short batch are preserved.\npub fn buffered_batches<T>(\n    source: Stream<T>,\n    batch_size: Int,\n    capacity: Int\n): Stream<[T]> = std.stream.buffer(\n    std.stream.batch(source, batch_size),\n    capacity\n);\n" }
