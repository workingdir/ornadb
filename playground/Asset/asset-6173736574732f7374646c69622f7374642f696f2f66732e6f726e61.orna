{ id: "asset-6173736574732f7374646c69622f7374642f696f2f66732e6f726e61", path: "assets/stdlib/std/io/fs.orna", media_type: "text/plain; charset=utf-8", content: "// These functions cross the evaluator's registered filesystem effect\n// boundary. The root and path are explicit, and each operation receives a\n// host-installed provider with canonical containment and resource limits.\n// Writes never create parent directories implicitly; overwrite behavior is an\n// explicit argument. Effects are unavailable to assertions, read-only\n// watches, presenters, and historical evaluation.\n\npub fn read_text(root: Str, path: Str): Str = __read_text(root, path);\nfn __read_text(root: Str, path: Str): Str = std.io.fs.read_text(root, path);\n\n// An empty file contains no lines. For nonempty files, split on LF and\n// preserve blank fields, including the final empty field after a terminal LF.\npub fn read_lines(root: Str, path: Str): [Str] \u{7b}\n    let contents = read_text(root, path);\n    if contents == \"\" \u{7b}\n        []\n    \u{7d} else \u{7b}\n        std.text.split(contents, \"\\n\")\n    \u{7d}\n\u{7d}\n\npub fn write_text(root: Str, path: Str, contents: Str, overwrite: Bool): Unit =\n    __write_text(root, path, contents, overwrite);\nfn __write_text(root: Str, path: Str, contents: Str, overwrite: Bool): Unit =\n    std.io.fs.write_text(root, path, contents, overwrite);\n\npub fn append_text(root: Str, path: Str, contents: Str): Unit =\n    __append_text(root, path, contents);\nfn __append_text(root: Str, path: Str, contents: Str): Unit =\n    std.io.fs.append_text(root, path, contents);\n\npub fn exists(root: Str, path: Str): Bool = __exists(root, path);\nfn __exists(root: Str, path: Str): Bool = std.io.fs.exists(root, path);\n\npub fn is_directory(root: Str, path: Str): Bool = __is_directory(root, path);\nfn __is_directory(root: Str, path: Str): Bool = std.io.fs.is_directory(root, path);\n\npub fn metadata(root: Str, path: Str): (Str, Int?, Instant?, Instant?) = __metadata(root, path);\nfn __metadata(root: Str, path: Str): (Str, Int?, Instant?, Instant?) = std.io.fs.metadata(root, path);\n\npub fn symlink_metadata(root: Str, path: Str): (Str, Int?, Instant?, Instant?) =\n    __symlink_metadata(root, path);\nfn __symlink_metadata(root: Str, path: Str): (Str, Int?, Instant?, Instant?) =\n    std.io.fs.symlink_metadata(root, path);\n\npub fn list(root: Str, path: Str): [Str] = __list(root, path);\nfn __list(root: Str, path: Str): [Str] = std.io.fs.list(root, path);\n\npub fn create_dir(root: Str, path: Str, parents: Bool, exist_ok: Bool): Unit =\n    __create_dir(root, path, parents, exist_ok);\nfn __create_dir(root: Str, path: Str, parents: Bool, exist_ok: Bool): Unit =\n    std.io.fs.create_dir(root, path, parents, exist_ok);\n\npub fn remove_file(root: Str, path: Str): Unit = __remove_file(root, path);\nfn __remove_file(root: Str, path: Str): Unit = std.io.fs.remove_file(root, path);\n\npub fn copy_file(root: Str, source_path: Str, destination_path: Str, overwrite: Bool): Unit =\n    __copy_file(root, source_path, destination_path, overwrite);\nfn __copy_file(root: Str, source_path: Str, destination_path: Str, overwrite: Bool): Unit =\n    std.io.fs.copy_file(root, source_path, destination_path, overwrite);\n\npub fn move_file(root: Str, source_path: Str, destination_path: Str, overwrite: Bool): Unit =\n    __move_file(root, source_path, destination_path, overwrite);\nfn __move_file(root: Str, source_path: Str, destination_path: Str, overwrite: Bool): Unit =\n    std.io.fs.move_file(root, source_path, destination_path, overwrite);\n" }
