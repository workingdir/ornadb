{ id: "asset-6173736574732f7374646c69622f7374642f6e65742f6d61696e2e6f726e61", path: "assets/stdlib/std/net/main.orna", media_type: "text/plain; charset=utf-8", content: "// std.net groups explicit host-effect networking APIs. Importing this\n// namespace only names child modules; it never opens a connection. Network\n// results are external observations and are not undone by a database rollback.\nuse http;\nuse websocket;\n" }
