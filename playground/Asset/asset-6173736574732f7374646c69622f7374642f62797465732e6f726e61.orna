{ id: "asset-6173736574732f7374646c69622f7374642f62797465732e6f726e61", path: "assets/stdlib/std/bytes.orna", media_type: "text/plain; charset=utf-8", content: "// Byte buffers are immutable lists of unsigned octets, each in 0...255.\n// Every operation that consumes a buffer validates all elements first.\n// Buffer-producing functions return null for invalid bytes, sizes, ranges,\n// byte orders, or values that do not fit the requested width.\nfn all_bytes(values: [Int]): Bool \u{7b}\n    let index = 0;\n    let valid = true;\n    while index < std.collection.count(values) && valid \u{7b}\n        if !std.bits.is_byte(values[index]) \u{7b}\n            valid = false;\n        \u{7d};\n        index = index + 1;\n    \u{7d};\n    valid\n\u{7d}\n\nfn zero_bytes(length: Int): [Int] \u{7b}\n    let index = 0;\n    let output = [];\n    while index < length \u{7b}\n        output = std.collection.union(output, [0]);\n        index = index + 1;\n    \u{7d};\n    output\n\u{7d}\n\n/// Reports whether an integer is an unsigned octet.\npub fn is_byte(value: Int): Bool = std.bits.is_byte(value);\n\n/// Reports whether every item is an unsigned octet. The empty buffer is valid.\npub fn is_buffer(values: [Int]): Bool = all_bytes(values);\n\n/// Returns the buffer's byte length, or null if an element is outside 0...255.\npub fn buffer_length(values: [Int]): Int? =\n    if is_buffer(values) \u{7b} Some(std.collection.count(values)) \u{7d} else \u{7b} null \u{7d};\n\n/// Allocates a zero-filled byte buffer. Negative lengths return null.\npub fn new_buffer(length: Int): [Int]? =\n    if length < 0 \u{7b} null \u{7d} else \u{7b} Some(zero_bytes(length)) \u{7d};\n\n/// Appends one byte, returning null for an invalid buffer or byte.\npub fn append_byte(values: [Int], value: Int): [Int]? =\n    if !is_buffer(values) || !is_byte(value) \u{7b}\n        null\n    \u{7d} else \u{7b}\n        Some(std.collection.union(values, [value]))\n    \u{7d};\n\n/// Concatenates two valid byte buffers without changing their order.\npub fn concat(left: [Int], right: [Int]): [Int]? =\n    if !is_buffer(left) || !is_buffer(right) \u{7b}\n        null\n    \u{7d} else \u{7b}\n        Some(std.collection.union(left, right))\n    \u{7d};\n\n/// Returns `count` bytes starting at `offset`; invalid or out-of-range bounds\n/// return null. A zero-length slice at the buffer end is valid.\npub fn slice(values: [Int], start: Int, count: Int): [Int]? =\n    if !is_buffer(values)\n        || start < 0\n        || count < 0\n        || start + count > std.collection.count(values)\n    \u{7b}\n        null\n    \u{7d} else \u{7b}\n        Some(std.collection.take(std.collection.drop(values, start), count))\n    \u{7d};\n\n/// Splits a valid byte buffer into ordered chunks. Chunk sizes must be positive;\n/// an empty buffer produces no chunks.\npub fn chunks(values: [Int], size: Int): [[Int]]? =\n    if !is_buffer(values) || size <= 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        Some(std.collection.chunk(values, size))\n    \u{7d};\n\n/// Reads an unsigned integer from `width` bytes at `offset` in `little` or\n/// `big` byte order. Invalid buffers, ranges, widths, or orders return null.\npub fn read_unsigned(values: [Int], start: Int, width: Int, order: Str): Int? =\n    if !is_buffer(values)\n        || start < 0\n        || width <= 0\n        || start + width > std.collection.count(values)\n    \u{7b}\n        null\n    \u{7d} else \u{7b}\n        std.bits.unsigned_from_bytes(\n            std.collection.take(std.collection.drop(values, start), width),\n            order\n        )\n    \u{7d};\n\n/// Replaces exactly `width` bytes at `offset` with an unsigned integer in\n/// `little` or `big` order. The write never grows the buffer; invalid ranges,\n/// orders, buffers, or values too large for the width return null.\npub fn write_unsigned(\n    values: [Int],\n    start: Int,\n    value: Int,\n    width: Int,\n    order: Str\n): [Int]? =\n    if !is_buffer(values)\n        || start < 0\n        || width <= 0\n        || start + width > std.collection.count(values)\n    \u{7b}\n        null\n    \u{7d} else \u{7b}\n        case std.bits.unsigned_to_bytes(value, width, order) \u{7b}\n            Some(encoded): Some(\n                std.collection.union(\n                    std.collection.union(\n                        std.collection.take(values, start),\n                        encoded\n                    ),\n                    std.collection.drop(values, start + width)\n                )\n            ),\n            null: null,\n        \u{7d}\n    \u{7d};\n" }
