{ id: "asset-6173736574732f7374646c69622f7374642f67656e65726963732e6f726e61", path: "assets/stdlib/std/generics.orna", media_type: "text/plain; charset=utf-8", content: "// Statically typed function combinators. These helpers preserve Orna's\n// inferred concrete types; they do not box values or add runtime reflection.\n// Callback failures propagate through the ordinary language failure channel.\n\npub fn identity<T>(value: T): T = value;\n\n// Both arguments are evaluated by the normal left-to-right call rule. The\n// second value is ignored after evaluation; this helper is not lazy.\npub fn constant<T, U>(value: T, ignored: U): T = value;\n\npub fn apply<T, U>(value: T, transform: fn(T): U): U = transform(value);\n\n// Composition applies `first` before `then`, exactly once each.\npub fn compose<T, U, V>(first: fn(T): U, then: fn(U): V): fn(T): V =\n    value => then(first(value));\n\n// The callback order is explicit: transform_left runs before transform_right.\npub fn both<T, U, V>(\n    value: T,\n    transform_left: fn(T): U,\n    transform_right: fn(T): V,\n): (U, V) = (transform_left(value), transform_right(value));\n\n// Apply two unary transforms in sequence without allocating a composed value.\npub fn pipe<T, U, V>(value: T, first: fn(T): U, then: fn(U): V): V =\n    then(first(value));\n" }
