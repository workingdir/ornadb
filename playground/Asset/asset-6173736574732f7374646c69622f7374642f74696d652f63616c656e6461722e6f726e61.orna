{ id: "asset-6173736574732f7374646c69622f7374642f74696d652f63616c656e6461722e6f726e61", path: "assets/stdlib/std/time/calendar.orna", media_type: "text/plain; charset=utf-8", content: "// Pure proleptic-Gregorian calendar arithmetic. Years are 1 through 9999;\n// dates are (year, month, day) tuples and never imply a zone or elapsed time.\n// Day numbers count from 0001-01-01 as zero. Weekdays use ISO numbering:\n// Monday is 1 and Sunday is 7.\npub fn is_leap_year(year: Int): Bool =\n    year >= 1 && year <= 9999 && year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);\n\nfn month_length(year: Int, month: Int): Int =\n    if month == 2 \u{7b}\n        if is_leap_year(year) \u{7b} 29 \u{7d} else \u{7b} 28 \u{7d}\n    \u{7d} else if month == 4 || month == 6 || month == 9 || month == 11 \u{7b}\n        30\n    \u{7d} else \u{7b}\n        31\n    \u{7d};\n\npub fn days_in_month(year: Int, month: Int): Int? =\n    if year >= 1 && year <= 9999 && month >= 1 && month <= 12 \u{7b}\n        first([month_length(year, month)])\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\npub fn days_in_year(year: Int): Int? =\n    if year >= 1 && year <= 9999 \u{7b}\n        if is_leap_year(year) \u{7b}\n            first([366])\n        \u{7d} else \u{7b}\n            first([365])\n        \u{7d}\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\npub fn is_valid_date(year: Int, month: Int, day: Int): Bool =\n    year >= 1 && year <= 9999 && month >= 1 && month <= 12 &&\n        day >= 1 && day <= month_length(year, month);\n\n// Month/year boundary helpers return civil date tuples. They do not create a\n// local midnight or imply any time zone; invalid components return null.\npub fn month_start(year: Int, month: Int): (Int, Int, Int)? =\n    if year >= 1 && year <= 9999 && month >= 1 && month <= 12 \u{7b}\n        first([(year, month, 1)])\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\npub fn month_end(year: Int, month: Int): (Int, Int, Int)? =\n    if year >= 1 && year <= 9999 && month >= 1 && month <= 12 \u{7b}\n        first([(year, month, month_length(year, month))])\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\npub fn year_start(year: Int): (Int, Int, Int)? =\n    if year >= 1 && year <= 9999 \u{7b}\n        first([(year, 1, 1)])\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\npub fn year_end(year: Int): (Int, Int, Int)? =\n    if year >= 1 && year <= 9999 \u{7b}\n        first([(year, 12, 31)])\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\nfn days_before_year(year: Int): Int \u{7b}\n    let previous = year - 1;\n    previous * 365 + previous / 4 - previous / 100 + previous / 400\n\u{7d}\n\nfn days_before_month(year: Int, month: Int): Int =\n    if month <= 1 \u{7b}\n        0\n    \u{7d} else \u{7b}\n        let common_days = (275 * month) / 9 - 30;\n        if month <= 2 \u{7b}\n            common_days\n        \u{7d} else if is_leap_year(year) \u{7b}\n            common_days - 1\n        \u{7d} else \u{7b}\n            common_days - 2\n        \u{7d}\n    \u{7d};\n\n// `day_number` and `from_day_number` are inverses over the supported range.\npub fn day_number(year: Int, month: Int, day: Int): Int? =\n    if is_valid_date(year, month, day) \u{7b}\n        first([days_before_year(year) + days_before_month(year, month) + day - 1])\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\nfn month_at_day(year: Int, ordinal: Int): Int =\n    if ordinal < days_before_month(year, 2) \u{7b}\n        1\n    \u{7d} else if ordinal < days_before_month(year, 3) \u{7b}\n        2\n    \u{7d} else if ordinal < days_before_month(year, 4) \u{7b}\n        3\n    \u{7d} else if ordinal < days_before_month(year, 5) \u{7b}\n        4\n    \u{7d} else if ordinal < days_before_month(year, 6) \u{7b}\n        5\n    \u{7d} else if ordinal < days_before_month(year, 7) \u{7b}\n        6\n    \u{7d} else if ordinal < days_before_month(year, 8) \u{7b}\n        7\n    \u{7d} else if ordinal < days_before_month(year, 9) \u{7b}\n        8\n    \u{7d} else if ordinal < days_before_month(year, 10) \u{7b}\n        9\n    \u{7d} else if ordinal < days_before_month(year, 11) \u{7b}\n        10\n    \u{7d} else if ordinal < days_before_month(year, 12) \u{7b}\n        11\n    \u{7d} else \u{7b}\n        12\n    \u{7d};\n\npub fn from_day_number(day: Int): (Int, Int, Int)? =\n    if day >= 0 && day < days_before_year(10000) \u{7b}\n        let era = day / 146097;\n        let day_in_era = day % 146097;\n        let year_in_era =\n            (day_in_era - day_in_era / 1460 + day_in_era / 36524 - day_in_era / 146096) / 365;\n        let year = era * 400 + year_in_era + 1;\n        let ordinal = day - days_before_year(year);\n        let month = month_at_day(year, ordinal);\n        first([(year, month, ordinal - days_before_month(year, month) + 1)])\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\npub fn weekday(year: Int, month: Int, day: Int): Int? = case day_number(year, month, day) \u{7b}\n    Some(index): first([index % 7 + 1]),\n    null: null,\n\u{7d};\n\n// Signed result is target minus source. Invalid dates return null.\npub fn days_between(\n    from_year: Int,\n    from_month: Int,\n    from_day: Int,\n    to_year: Int,\n    to_month: Int,\n    to_day: Int\n): Int? = case day_number(from_year, from_month, from_day) \u{7b}\n    Some(from_index): case day_number(to_year, to_month, to_day) \u{7b}\n        Some(to_index): first([to_index - from_index]),\n        null: null,\n    \u{7d},\n    null: null,\n\u{7d};\n\n// Add civil calendar days, crossing month and year boundaries without\n// converting a local day to a fixed elapsed duration. Out-of-range results\n// return null.\npub fn add_days(year: Int, month: Int, day: Int, amount: Int): (Int, Int, Int)? =\n    case day_number(year, month, day) \u{7b}\n        Some(index): from_day_number(index + amount),\n        null: null,\n    \u{7d};\n\n// Move by whole civil weeks. This scales calendar days rather than elapsed\n// seconds, so the operation remains independent of daylight-saving changes.\npub fn add_weeks(year: Int, month: Int, day: Int, weeks: Int): (Int, Int, Int)? =\n    add_days(year, month, day, weeks * 7);\n\nfn shift_months(year: Int, month: Int, day: Int, amount: Int, clamp: Bool): (Int, Int, Int)? =\n    if is_valid_date(year, month, day) \u{7b}\n        let target_index = (year - 1) * 12 + month - 1 + amount;\n        if target_index >= 0 && target_index < 9999 * 12 \u{7b}\n            let target_year = target_index / 12 + 1;\n            let target_month = target_index % 12 + 1;\n            let last_day = month_length(target_year, target_month);\n            if day <= last_day \u{7b}\n                first([(target_year, target_month, day)])\n            \u{7d} else if clamp \u{7b}\n                first([(target_year, target_month, last_day)])\n            \u{7d} else \u{7b}\n                null\n            \u{7d}\n        \u{7d} else \u{7b}\n            null\n        \u{7d}\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\n// Reject month shifts whose target month has no corresponding day. For\n// example, January 31 shifted one month returns null.\npub fn add_months(year: Int, month: Int, day: Int, amount: Int): (Int, Int, Int)? =\n    shift_months(year, month, day, amount, false);\n\n// Clamp only the day-of-month to the target month's final day. The year range\n// and invalid-input rules are the same as `add_months`.\npub fn add_months_clamped(\n    year: Int,\n    month: Int,\n    day: Int,\n    amount: Int\n): (Int, Int, Int)? = shift_months(year, month, day, amount, true);\n\npub fn day_of_year(year: Int, month: Int, day: Int): Int? =\n    if is_valid_date(year, month, day) \u{7b}\n        first([days_before_month(year, month) + day])\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n" }
