{ id: "asset-6173736574732f7374646c69622f7374642f6d61702e6f726e61", path: "assets/stdlib/std/map.orna", media_type: "text/plain; charset=utf-8", content: "// A map value is an immutable [ (K, V) ] list with at most one entry per key.\n// Constructors and updates keep first-insertion order; an update replaces the\n// old value in place, and a new key is appended. Lookup is linear and uses\n// Orna equality, so keys must have a lawful equality relation. There is no\n// host hash table or ambient key ordering. from_entries keeps the first key\n// position and the last value for duplicates; merge lets right-hand values\n// replace left-hand values while preserving left-hand key positions.\nuse collection;\n\npub fn size<K, V>(entries: [(K, V)]): Int =\n    std.collection.count(from_entries(entries));\n\npub fn is_empty<K, V>(entries: [(K, V)]): Bool = size(entries) == 0;\n\npub fn to_entries<K, V>(entries: [(K, V)]): [(K, V)] = from_entries(entries);\n\n// Return a canonical-key view for callers that need deterministic encoded\n// map order. Ordinary map iteration remains in first-insertion order; OVB-1\n// ordering compares the complete encoded key bytes and does not rewrite the\n// map's retained entry positions.\npub fn entries_by_ovb_key<K, V>(entries: [(K, V)]): [(K, V)] =\n    std.collection.sort_by(\n        from_entries(entries),\n        entry => case entry \u{7b}\n            (key, _): std.encoding.ovb.encode(key),\n        \u{7d}\n    );\n\n// Return ordered encoded key/value pairs for an OVB map encoder. Each key is\n// encoded once, and its value bytes stay attached while pairs are sorted by\n// unsigned lexicographic order of the complete encoded key. The result is a\n// list of pairs, not a map encoding. Duplicate logical keys retain\n// from_entries' first-position/last-value rule.\npub fn encoded_entries_by_ovb_key<K, V>(entries: [(K, V)]): [(Blob, Blob)] \u{7b}\n    let normalized = from_entries(entries);\n    let projected = [];\n    let index = 0;\n    while index < std.collection.count(normalized) \u{7b}\n        let (key, value) = normalized[index];\n        projected = std.collection.union(projected, [(\n            std.encoding.ovb.encode(key),\n            std.encoding.ovb.encode(value),\n        )]);\n        index += 1;\n    \u{7d};\n    std.collection.sort_by(projected, pair => case pair \u{7b}\n        (key_bytes, _): key_bytes,\n    \u{7d})\n\u{7d}\n\npub fn keys<K, V>(entries: [(K, V)]): [K] =\n    if std.collection.count(entries) == 0 \u{7b}\n        []\n    \u{7d} else \u{7b}\n        let normalized = from_entries(entries);\n        let output = [];\n        let index = 0;\n        while index < std.collection.count(normalized) \u{7b}\n            let (key, _) = normalized[index];\n            output = std.collection.union(output, [key]);\n            index += 1;\n        \u{7d}\n        output\n    \u{7d};\n\npub fn values<K, V>(entries: [(K, V)]): [V] =\n    if std.collection.count(entries) == 0 \u{7b}\n        []\n    \u{7d} else \u{7b}\n        let normalized = from_entries(entries);\n        let output = [];\n        let index = 0;\n        while index < std.collection.count(normalized) \u{7b}\n            let (_, value) = normalized[index];\n            output = std.collection.union(output, [value]);\n            index += 1;\n        \u{7d}\n        output\n    \u{7d};\n\nfn contains_in<K, V>(entries: [(K, V)], key: K): Bool =\n    if std.collection.count(entries) == 0 \u{7b}\n        false\n    \u{7d} else \u{7b}\n        let found = false;\n        let index = 0;\n        while index < std.collection.count(entries) \u{7b}\n            let (entry_key, _) = entries[index];\n            found = if entry_key == key \u{7b} true \u{7d} else \u{7b} found \u{7d};\n            index += 1;\n        \u{7d}\n        found\n    \u{7d};\n\nfn replace_entries<K, V>(entries: [(K, V)], key: K, value: V): [(K, V)] =\n    if std.collection.count(entries) == 0 \u{7b}\n        []\n    \u{7d} else \u{7b}\n        let output = [];\n        let index = 0;\n        while index < std.collection.count(entries) \u{7b}\n            let entry = entries[index];\n            output = std.collection.union(output, [replace_entry(entry, key, value)]);\n            index += 1;\n        \u{7d}\n        output\n    \u{7d};\n\npub fn contains_key<K, V>(entries: [(K, V)], key: K): Bool =\n    contains_in(from_entries(entries), key);\n\nfn find_value<K, V>(entries: [(K, V)], key: K): V? =\n    if std.collection.count(entries) == 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        let result = null;\n        let index = 0;\n        while index < std.collection.count(entries) \u{7b}\n            let (entry_key, value) = entries[index];\n            result = if entry_key == key \u{7b} Some(value) \u{7d} else \u{7b} result \u{7d};\n            index += 1;\n        \u{7d}\n        result\n    \u{7d};\n\npub fn get<K, V>(entries: [(K, V)], key: K): V? =\n    find_value(from_entries(entries), key);\n\nfn replace_entry<K, V>(entry: (K, V), key: K, value: V): (K, V) = case entry \u{7b}\n    (existing_key, _): if existing_key == key \u{7b} (existing_key, value) \u{7d} else \u{7b} entry \u{7d},\n\u{7d};\n\nfn insert_unique<K, V>(entries: [(K, V)], key: K, value: V): [(K, V)] =\n    if contains_in(entries, key) \u{7b}\n        replace_entries(entries, key, value)\n    \u{7d} else \u{7b}\n        std.collection.union(entries, [(key, value)])\n    \u{7d};\n\npub fn insert<K, V>(entries: [(K, V)], key: K, value: V): [(K, V)] =\n    insert_unique(from_entries(entries), key, value);\n\npub fn remove<K, V>(entries: [(K, V)], key: K): [(K, V)] =\n    if std.collection.count(entries) == 0 \u{7b}\n        []\n    \u{7d} else \u{7b}\n        let normalized = from_entries(entries);\n        let output = [];\n        let index = 0;\n        while index < std.collection.count(normalized) \u{7b}\n            let entry = normalized[index];\n            let (entry_key, _) = entry;\n            if entry_key != key \u{7b}\n                output = std.collection.union(output, [entry]);\n            \u{7d};\n            index += 1;\n        \u{7d}\n        output\n    \u{7d};\n\npub fn from_entries<K, V>(entries: [(K, V)]): [(K, V)] =\n    if std.collection.count(entries) == 0 \u{7b}\n        []\n    \u{7d} else \u{7b}\n        let normalized = [];\n        let index = 0;\n        while index < std.collection.count(entries) \u{7b}\n            let (key, value) = entries[index];\n            normalized = if contains_in(normalized, key) \u{7b}\n                replace_entries(normalized, key, value)\n            \u{7d} else \u{7b}\n                std.collection.union(normalized, [(key, value)])\n            \u{7d};\n            index += 1;\n        \u{7d}\n        normalized\n    \u{7d};\n\npub fn merge<K, V>(left: [(K, V)], right: [(K, V)]): [(K, V)] =\n    from_entries(std.collection.union(left, right));\n" }
