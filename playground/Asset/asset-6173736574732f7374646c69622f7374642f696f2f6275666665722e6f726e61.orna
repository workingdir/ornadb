{ id: "asset-6173736574732f7374646c69622f7374642f696f2f6275666665722e6f726e61", path: "assets/stdlib/std/io/buffer.orna", media_type: "text/plain; charset=utf-8", content: "// Buffered line adapters build deterministic batches over the explicit\n// filesystem and stream capabilities. Reading snapshots the complete UTF-8\n// file once through std.io.reader before constructing a replayable list-backed\n// stream; `batch_size` bounds each emitted group, not the host read itself.\n\n// Read ordered line batches from one authorized file snapshot. Empty files\n// emit no batches, blank and terminal lines are preserved, and a positive\n// batch size is required by std.stream.batch.\npub fn read_line_batches(\n    root: Str,\n    path: Str,\n    source_identity: Str,\n    batch_size: Int\n): Stream<[Str]> = std.stream.from_list_batches(\n    std.io.reader.read_lines(root, path),\n    source_identity,\n    batch_size\n);\n\n// Flatten batches in order and write their lines separated by LF. Empty\n// batches contribute no lines; an empty final line writes a terminal LF.\n// The filesystem root and overwrite choice stay explicit at the effect edge.\npub fn write_line_batches(\n    root: Str,\n    path: Str,\n    batches: [[Str]],\n    overwrite: Bool\n): Unit = std.io.writer.write_all_text(\n    root,\n    path,\n    std.text.join(std.collection.flatten(batches), \"\\n\"),\n    overwrite\n);\n" }
