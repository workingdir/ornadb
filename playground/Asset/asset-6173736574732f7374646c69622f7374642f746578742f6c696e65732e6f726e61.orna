{ id: "asset-6173736574732f7374646c69622f7374642f746578742f6c696e65732e6f726e61", path: "assets/stdlib/std/text/lines.orna", media_type: "text/plain; charset=utf-8", content: "// Line positions are based on Unicode scalar values. Split accepts LF, CRLF,\n// and lone CR; blank lines and the empty line after a terminal break survive.\n// Joining uses LF, so normalise preserves line boundaries while standardizing\n// every recognized separator to one LF.\nuse std.collection as collection;\nuse std.text as text;\n\n/// Splits text into logical lines. Empty text has no lines; terminal line\n/// breaks produce a final empty line.\npub fn split(value: Str): [Str] \u{7b}\n    if value == \"\" \u{7b}\n        []\n    \u{7d} else \u{7b}\n        let scalars = text.split(value, \"\");\n        let scalar_count = collection.count(scalars);\n        let lines = [];\n        let current = [];\n        let index = 0;\n        while index < scalar_count \u{7b}\n            let scalar = scalars[index];\n            if scalar == \"\\n\" \u{7b}\n                lines = collection.union(lines, [text.join(current, \"\")]);\n                current = [];\n            \u{7d} else if scalar == \"\\r\" \u{7b}\n                lines = collection.union(lines, [text.join(current, \"\")]);\n                current = [];\n                if index + 1 < scalar_count \u{7b}\n                    if scalars[index + 1] == \"\\n\" \u{7b}\n                        index = index + 1;\n                    \u{7d};\n                \u{7d};\n            \u{7d} else \u{7b}\n                current = collection.union(current, [scalar]);\n            \u{7d};\n            index = index + 1;\n        \u{7d};\n        collection.union(lines, [text.join(current, \"\")])\n    \u{7d}\n\u{7d}\n\n/// Joins logical lines with LF. Any original CR or CRLF separators are\n/// normalized by split followed by join.\npub fn join(lines: [Str]): Str = text.join(lines, \"\\n\");\n\n/// Counts logical lines using the same LF, CRLF, and CR boundaries as split.\npub fn count(value: Str): Int = collection.count(split(value));\n\n/// Rewrites every recognized line separator as LF while retaining blank and\n/// terminal lines.\npub fn normalise(value: Str): Str = join(split(value));\n" }
