{ id: "asset-6173736574732f7374646c69622f7374642f6d656d6f2e6f726e61", path: "assets/stdlib/std/memo.orna", media_type: "text/plain; charset=utf-8", content: "// Pure, explicitly threaded memoization helpers. Orna's standard collections\n// are immutable, so each call returns the updated cache beside its value; pass\n// that cache to the next call to reuse prior results. Cache keys must have a\n// lawful equality relation, as required by std.map.\nuse map;\n\n// Reuse a cached zero-argument computation or evaluate it once and retain its\n// result. The optional wrapper distinguishes an empty cache from a cached null.\npub fn memoize_thunk<T>(cached: T?, computation: fn(): T): (T?, T) =\n    case cached \u{7b}\n        Some(value): (cached, value),\n        null: \u{7b}\n            let value = computation();\n            (Some(value), value)\n        \u{7d},\n    \u{7d};\n\n// Return the prior result for key, or compute and insert a result on a miss.\n// Map insertion replaces an equal key without changing its first position.\npub fn memoize<K, V>(\n    cache: [(K, V)],\n    key: K,\n    computation: fn(K): V,\n): ([(K, V)], V) = case std.map.get(cache, key) \u{7b}\n    Some(value): (cache, value),\n    null: \u{7b}\n        let value = computation(key);\n        (std.map.insert(cache, key, value), value)\n    \u{7d},\n\u{7d};\n\npub fn get<K, V>(cache: [(K, V)], key: K): V? = std.map.get(cache, key);\n\npub fn remove<K, V>(cache: [(K, V)], key: K): [(K, V)] =\n    std.map.remove(cache, key);\n\npub fn clear<K, V>(cache: [(K, V)]): [(K, V)] = [];\n" }
