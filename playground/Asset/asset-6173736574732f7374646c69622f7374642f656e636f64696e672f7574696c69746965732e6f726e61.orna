{ id: "asset-6173736574732f7374646c69622f7374642f656e636f64696e672f7574696c69746965732e6f726e61", path: "assets/stdlib/std/encoding/utilities.orna", media_type: "text/plain; charset=utf-8", content: "// Unicode helpers count and slice Unicode scalar values. They do not treat\n// grapheme clusters as single units: combining marks and joiners stay separate.\n// Base64url follows RFC 4648's URL-safe alphabet and omits padding. Decoding\n// accepts only canonical unpadded Base64url; malformed input fails like the\n// underlying strict standard Base64 decoder.\n\npub fn unicode_scalars(value: Str): [Str] = std.text.split(value, \"\");\n\npub fn unicode_scalar_length(value: Str): Int =\n    std.collection.count(unicode_scalars(value));\n\n/// Reverses Unicode scalar values while preserving each scalar's UTF-8 bytes.\n/// Combining sequences and joined emoji are reversed by scalar, not grapheme.\npub fn unicode_reverse(value: Str): Str \u{7b}\n    let scalars = unicode_scalars(value);\n    let index = std.collection.count(scalars) - 1;\n    let reversed = [];\n    while index >= 0 \u{7b}\n        reversed = std.collection.union(reversed, [scalars[index]]);\n        index = index - 1;\n    \u{7d};\n    std.text.join(reversed, \"\")\n\u{7d}\n\n/// Returns the Unicode scalar slice `[start, end)`. Negative or inverted\n/// bounds return the empty string; bounds past the string clamp to its length.\npub fn unicode_slice(value: Str, start: Int, end: Int): Str =\n    if start < 0 || end < start \u{7b}\n        \"\"\n    \u{7d} else \u{7b}\n        std.text.join(\n            std.collection.take(\n                std.collection.drop(unicode_scalars(value), start),\n                end - start\n            ),\n            \"\"\n        )\n    \u{7d};\n\n/// Encodes bytes as unpadded URL-safe Base64 (the `-` and `_` alphabet).\npub fn base64url_encode(input: Blob): Str =\n    std.text.replace(\n        std.text.replace(\n            std.text.replace(std.encoding.base64.encode(input), \"+\", \"-\"),\n            \"/\",\n            \"_\"\n        ),\n        \"=\",\n        \"\"\n    );\n\n/// Decodes canonical unpadded URL-safe Base64. Explicit padding, the standard\n/// `+` and `/` alphabet, invalid characters, and nonzero unused trailing bits\n/// are rejected by canonical re-encoding or the strict Base64 decoder.\npub fn base64url_decode(input: Str): Blob \u{7b}\n    let length = std.collection.count(std.text.split(input, \"\"));\n    let remainder = length - (length / 4) * 4;\n    let padded = if remainder == 2 \u{7b}\n        std.text.join([input, \"==\"], \"\")\n    \u{7d} else if remainder == 3 \u{7b}\n        std.text.join([input, \"=\"], \"\")\n    \u{7d} else \u{7b}\n        input\n    \u{7d};\n    let decoded = std.encoding.base64.decode(\n        std.text.replace(\n            std.text.replace(padded, \"-\", \"+\"),\n            \"_\",\n            \"/\"\n        )\n    );\n    if base64url_encode(decoded) == input \u{7b}\n        decoded\n    \u{7d} else \u{7b}\n        fail(error(\n            code: \"std.encoding.base64url.noncanonical\",\n            message: \"input is not canonical unpadded URL-safe Base64\"\n        ))\n    \u{7d}\n\u{7d}\n" }
