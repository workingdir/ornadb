{ id: "asset-6173736574732f7374646c69622f7374642f656e636f64696e672f6261736536342e6f726e61", path: "assets/stdlib/std/encoding/base64.orna", media_type: "text/plain; charset=utf-8", content: "// Standard Base64 uses the RFC 4648 alphabet with required `=` padding and no\n// inserted whitespace. Decoding rejects invalid characters, noncanonical\n// padding, and nonzero unused trailing bits. URL-safe Base64 is a separate\n// profile and is not silently accepted here.\n\npub fn encode(input: Blob): Str = __encode(input);\nfn __encode(input: Blob): Str = encode(input);\n\npub fn decode(input: Str): Blob = __decode(input);\nfn __decode(input: Str): Blob = decode(input);\n" }
