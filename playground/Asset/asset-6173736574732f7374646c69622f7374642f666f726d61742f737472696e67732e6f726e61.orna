{ id: "asset-6173736574732f7374646c69622f7374642f666f726d61742f737472696e67732e6f726e61", path: "assets/stdlib/std/format/strings.orna", media_type: "text/plain; charset=utf-8", content: "// String layout helpers count Unicode scalar values, not UTF-8 bytes or\n// grapheme clusters. A multi-scalar fill string repeats as a scalar pattern.\nuse text;\nuse collection;\n\nfn scalar_count(value: Str): Int = collection.count(text.split(value, \"\"));\n\nfn repeat_fill(fill: Str, count: Int): Str \u{7b}\n    let scalars = text.split(fill, \"\");\n    let scalar_total = collection.count(scalars);\n    if count <= 0 || scalar_total == 0 \u{7b}\n        \"\"\n    \u{7d} else \u{7b}\n        let output = [];\n        let index = 0;\n        while index < count \u{7b}\n            output = collection.union(output, [scalars[index % scalar_total]]);\n            index = index + 1;\n        \u{7d}\n        text.join(output, \"\")\n    \u{7d}\n\u{7d}\n\nfn pad_left_by(value: Str, count: Int, fill: Str): Str =\n    text.join([repeat_fill(fill, count), value], \"\");\n\nfn pad_right_by(value: Str, count: Int, fill: Str): Str =\n    text.join([value, repeat_fill(fill, count)], \"\");\n\n/// Repeats the string `count` times. Nonpositive counts return the empty string.\npub fn repeat(value: Str, count: Int): Str \u{7b}\n    if count <= 0 || value == \"\" \u{7b}\n        \"\"\n    \u{7d} else \u{7b}\n        let output = [];\n        let remaining = count;\n        while remaining > 0 \u{7b}\n            output = collection.union(output, [value]);\n            remaining = remaining - 1;\n        \u{7d}\n        text.join(output, \"\")\n    \u{7d}\n\u{7d}\n\n/// Pads to at least `width` Unicode scalar values on the left. `fill` is a\n/// repeating scalar pattern; an empty fill string leaves the value unchanged.\npub fn pad_left(value: Str, width: Int, fill: Str = \" \"): Str =\n    pad_left_by(value, width - scalar_count(value), fill);\n\n/// Pads to at least `width` Unicode scalar values on the right.\npub fn pad_right(value: Str, width: Int, fill: Str = \" \"): Str =\n    pad_right_by(value, width - scalar_count(value), fill);\n\n/// Centers a string in at least `width` Unicode scalar values. An odd extra\n/// padding scalar goes on the right; an empty fill leaves the value unchanged.\npub fn center(value: Str, width: Int, fill: Str = \" \"): Str \u{7b}\n    let padding = width - scalar_count(value);\n    if padding <= 0 \u{7b}\n        value\n    \u{7d} else \u{7b}\n        let left = padding / 2;\n        let right = padding - left;\n        text.join([repeat_fill(fill, left), value, repeat_fill(fill, right)], \"\")\n    \u{7d}\n\u{7d}\n\n/// Truncates to at most `width` Unicode scalar values, reserving room for the\n/// first scalars of `suffix` when truncation is needed. Nonpositive widths\n/// return the empty string.\npub fn truncate(value: Str, width: Int, suffix: Str = \"…\"): Str \u{7b}\n    if width <= 0 \u{7b}\n        \"\"\n    \u{7d} else \u{7b}\n        let scalars = text.split(value, \"\");\n        if collection.count(scalars) <= width \u{7b}\n            value\n        \u{7d} else \u{7b}\n            let suffix_scalars = text.split(suffix, \"\");\n            let kept_suffix = collection.take(suffix_scalars, width);\n            let prefix_width = width - collection.count(kept_suffix);\n            text.join(\n                [text.join(collection.take(scalars, prefix_width), \"\"), text.join(kept_suffix, \"\")],\n                \"\"\n            )\n        \u{7d}\n    \u{7d}\n\u{7d}\n\n/// Prefixes every line, preserving empty lines and a final trailing newline.\npub fn indent(value: Str, prefix: Str): Str =\n    text.join(\n        collection.map(text.split(value, \"\\n\"), line => text.join([prefix, line], \"\")),\n        \"\\n\"\n    );\n" }
