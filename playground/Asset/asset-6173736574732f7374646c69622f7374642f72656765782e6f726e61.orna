{ id: "asset-6173736574732f7374646c69622f7374642f72656765782e6f726e61", path: "assets/stdlib/std/regex.orna", media_type: "text/plain; charset=utf-8", content: "// std.regex implements the explicitly versioned `orna.regex/1` dialect.\n// Matching is over Unicode scalar positions using Unicode 16.0.0 properties;\n// it is independent of locale, host regex syntax, and host Unicode settings.\n// The dialect includes literals and escaped metacharacters, `.`, `^`/`$`,\n// bracket classes and ranges, alternation, capturing and noncapturing groups,\n// `*`, `+`, `?`, `\u{7b}m\u{7d}`, `\u{7b}m,\u{7d}`, `\u{7b}m,n\u{7d}` (including lazy suffix `?`), and the\n// escapes `\\d`, `\\s`, `\\w`, `\\b`, `\\n`, `\\r`, and `\\t`. `\\d` is Unicode\n// General_Category Nd, `\\s` is Unicode White_Space, and `\\w` is Alphabetic,\n// Mark, Number, or Connector_Punctuation. Look-around, backreferences,\n// recursion, conditionals, and locale-dependent constructs are rejected.\n// Engines must implement this dialect exactly; no host-default dialect is\n// selected. Compilation and operations are bounded; limit exhaustion fails\n// instead of returning partial matches or rewritten text.\n//\n// `Regex.Compiled` carries the exact source pattern. Its public constructor is\n// data, not proof of validity: every operation validates the source under this\n// dialect, including values constructed directly by a caller.\npub enum Regex \u{7b}\n    Compiled \u{7b} pattern: Str \u{7d},\n\u{7d}\n\n// Match offsets are zero-based Unicode scalar positions with a half-open end.\n// `captures[0]` is the complete match; later entries follow opening-group\n// order and are null when that group did not participate. The whole match is\n// leftmost-longest. At the same start, alternation and subexpression choices\n// follow source order; quantifiers are greedy unless suffixed by `?`.\npub enum Match \u{7b}\n    Found \u{7b} text: Str, start: Int, end: Int, captures: [Str?] \u{7d},\n\u{7d}\n\n// Return the stable grammar identity for manifests and diagnostics.\npub fn dialect_version(): Str = \"orna.regex/1\";\n\n// Invalid syntax and unsupported constructs fail with a regex syntax error\n// that identifies the scalar position. The returned source is immutable.\npub fn compile(pattern: Str): Regex = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.regex.compile requires its orna.regex/1 evaluator binding\"\n));\n\n// A directly constructed Regex is validated just like one returned by compile.\npub fn is_match(regex: Regex, text: Str): Bool = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.regex.is_match requires its orna.regex/1 evaluator binding\"\n));\n\n// Return the earliest-starting match, choosing the longest end at that start.\n// A nonparticipating capture remains null; no match returns null.\npub fn find(regex: Regex, text: Str): Match? = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.regex.find requires its orna.regex/1 evaluator binding\"\n));\n\n// Return non-overlapping matches in scalar order. After a positive-width\n// match, scanning resumes at its end. After a zero-width match, scanning\n// advances one scalar; a zero-width match at end-of-input is included once.\n// The list is complete or the configured work bound fails; it is never\n// silently truncated.\npub fn find_all(regex: Regex, text: Str): [Match] = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.regex.find_all requires its orna.regex/1 evaluator binding\"\n));\n\n// Count the complete ordered match list. Resource exhaustion propagates from\n// find_all; this helper never reports a count for a truncated scan.\npub fn count_matches(regex: Regex, text: Str): Int =\n    std.collection.count(find_all(regex, text));\n\npub fn matched_text(value: Match): Str = case value \u{7b}\n    Match.Found \u{7b} text, start: _, end: _, captures: _ \u{7d}: text,\n\u{7d};\n\npub fn start(value: Match): Int = case value \u{7b}\n    Match.Found \u{7b} text: _, start, end: _, captures: _ \u{7d}: start,\n\u{7d};\n\npub fn end(value: Match): Int = case value \u{7b}\n    Match.Found \u{7b} text: _, start: _, end, captures: _ \u{7d}: end,\n\u{7d};\n\npub fn captures(value: Match): [Str?] = case value \u{7b}\n    Match.Found \u{7b} text: _, start: _, end: _, captures \u{7d}: captures,\n\u{7d};\n\n// Replacement references use `$0` for the full match, `$1` onward for capture\n// groups, and `$$` for a literal dollar. An unknown capture reference fails.\n// Replacements are non-overlapping, left to right. Zero-width matches advance\n// by one scalar and the terminal boundary is considered at most once.\npub fn replace_all(regex: Regex, text: Str, replacement: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.regex.replace_all requires its orna.regex/1 evaluator binding\"\n));\n\n// Split on non-overlapping positive-width matches and preserve empty fields,\n// including leading and trailing fields. Zero-width matches are ignored; an\n// empty-matching expression therefore returns the original text as one field.\npub fn split(regex: Regex, text: Str): [Str] = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.regex.split requires its orna.regex/1 evaluator binding\"\n));\n\n// Escape every scalar that has syntax in orna.regex/1 so the result matches\n// the supplied text literally when used as a complete expression.\npub fn escape_literal(text: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.regex.escape_literal requires its orna.regex/1 evaluator binding\"\n));\n" }
