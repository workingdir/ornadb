{ id: "asset-6173736574732f7374646c69622f7374642f6572726f722f636f6d62696e61746f72732e6f726e61", path: "assets/stdlib/std/error/combinators.orna", media_type: "text/plain; charset=utf-8", content: "// The reference defines Error values and the language's `|?` recovery\n// boundary, but not a separate combinator API. These helpers operate only on\n// ordinary Error values and preserve cause structure.\n// The helpers never catch, replace, or convert a language failure.\n\n// Add one outer diagnostic while keeping the complete previous error as its\n// first cause. This is data composition, not recovery from a thrown failure.\npub fn with_context(value: Error, code: Str, message: Str): Error =\n    std.error.caused_by(code, message, value);\n\nfn with_contexts_from(\n    value: Error,\n    contexts: [(Str, Str)],\n    index: Int,\n): Error =\n    if index < 0 \u{7b}\n        value\n    \u{7d} else \u{7b}\n        case contexts[index] \u{7b}\n            (code, message): with_contexts_from(\n                with_context(value, code, message),\n                contexts,\n                index - 1,\n            ),\n        \u{7d}\n    \u{7d};\n\n// Contexts are listed outermost first. Applying them from the end keeps that\n// order above the original error and preserves each original nested cause.\n// An empty list returns the input Error unchanged.\npub fn with_contexts(value: Error, contexts: [(Str, Str)]): Error =\n    with_contexts_from(value, contexts, std.collection.count(contexts) - 1);\n\n// Search the root code and every cause code in std.error.code_chain's\n// breadth-first order.\npub fn contains_code(value: Error, expected: Str): Bool =\n    std.collection.exists(\n        std.error.code_chain(value),\n        actual => actual == expected,\n    );\n\npub fn contains_any_code(value: Error, expected: [Str]): Bool =\n    std.collection.exists(\n        expected,\n        code => contains_code(value, code),\n    );\n\n// The empty expected list matches vacuously, as with std.collection.every.\npub fn contains_all_codes(value: Error, expected: [Str]): Bool =\n    std.collection.every(\n        expected,\n        code => contains_code(value, code),\n    );\n\n// Compare the complete breadth-first chain, including its order and length.\npub fn matches_code_chain(value: Error, expected: [Str]): Bool =\n    std.error.code_chain(value) == expected;\n" }
