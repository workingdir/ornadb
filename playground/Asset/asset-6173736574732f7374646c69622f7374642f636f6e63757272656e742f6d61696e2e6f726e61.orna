{ id: "asset-6173736574732f7374646c69622f7374642f636f6e63757272656e742f6d61696e2e6f726e61", path: "assets/stdlib/std/concurrent/main.orna", media_type: "text/plain; charset=utf-8", content: "// Structured concurrency helpers. Every callback is a child task owned by\n// the caller's activation or session; retaining or discarding a callback\n// result never detaches that child. Runtime bindings implement the scheduling\n// and cancellation boundary while this pinned module fixes the portable API.\n//\n// Callback arrays use one common successful result type. `parallel` preserves\n// input order in its result list even when children finish in another order;\n// an empty callback array returns an empty list.\n// Each child is a separate activation: a sibling failure does not undo writes\n// already committed by another child. The first observed failure cancels\n// unfinished siblings; after joining, the lowest input-index ordinary failure\n// is primary and remaining failures are ordered causes.\npub fn parallel<T>(callbacks: [fn(): T]): [T] = std.concurrent.parallel(callbacks);\n\n// Apply one transformation in an owned child activation per input. Results\n// are joined in input order even when child completion order differs. An\n// empty input starts no children and returns an empty list. Each transformed\n// callback has the same transaction, failure and cancellation rules as\n// `parallel` itself.\npub fn parallel_map<T, U>(values: [T], transform: fn(T): U): [U] =\n    parallel(std.collection.map(values, value => () => transform(value)));\n\n// Return the first observed successful result, then cancel and join every\n// losing child. If all children fail, report the lowest input-index ordinary\n// failure. Simultaneous successes are resolved by recorded completion order;\n// no wall-clock order is promised. An empty callback array fails without\n// scheduling work.\npub fn race<T>(callbacks: [fn(): T]): T = std.concurrent.race(callbacks);\n\n// Run one zero-argument callback as an owned child. The duration is elapsed\n// time: a negative value is an argument error. On expiry, request cancellation\n// and join the child before raising the timeout diagnostic; no partial result\n// is returned. Zero duration checks for an already-terminal result before it\n// cancels unfinished work. A timeout does not detach or transfer the child.\npub fn timeout<T>(callback: fn(): T, duration: Duration): T =\n    std.concurrent.timeout(callback, duration);\n\n// Wait for a nonnegative elapsed duration and return null on success. Even a\n// zero-duration wait requires an explicitly admitted clock provider; with one,\n// it checks cancellation and returns without waiting. Waiting is\n// cancellation-aware and has a clock/waiting effect, so this operation is\n// unavailable to declaration assertions. The requested instant is a\n// lower-bound target, not an exact scheduling guarantee.\npub fn sleep(duration: Duration): Null = std.concurrent.sleep(duration);\n" }
