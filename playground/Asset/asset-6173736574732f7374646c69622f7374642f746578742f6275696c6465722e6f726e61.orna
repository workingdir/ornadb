{ id: "asset-6173736574732f7374646c69622f7374642f746578742f6275696c6465722e6f726e61", path: "assets/stdlib/std/text/builder.orna", media_type: "text/plain; charset=utf-8", content: "// Immutable string builders are ordered [Str] chunks until build joins them.\n// Appending returns a new chunk list and leaves the original reusable.\nuse std.collection as collection;\nuse std.text as text;\n\npub fn new(): [Str] = [];\n\npub fn from_text(value: Str): [Str] = [value];\n\npub fn append(builder: [Str], value: Str): [Str] =\n    collection.union(builder, [value]);\n\npub fn append_all(builder: [Str], values: [Str]): [Str] =\n    collection.union(builder, values);\n\n// Adds one line followed by LF, including when `value` is empty.\npub fn append_line(builder: [Str], value: Str): [Str] = append_all(\n    builder,\n    [value, \"\\n\"]\n);\n\npub fn build(builder: [Str]): Str = text.join(builder, \"\");\n\n// Emptiness describes the built text, so appending empty chunks stays empty.\npub fn is_empty(builder: [Str]): Bool = build(builder) == \"\";\n" }
