{ id: "asset-6173736574732f7374646c69622f7374642f73747265616d2e6f726e61", path: "assets/stdlib/std/stream.orna", media_type: "text/plain; charset=utf-8", content: "// Stream values may wait, checkpoint or perform provider work. Importing this\n// module is inert. These declarations pin the standard API; the admitted\n// runtime supplies each operator's waiting, ownership and checkpoint binding.\n\n// Construct a finite replayable source without I/O. The captured source\n// identity combines this label with the canonical typed digest of all values,\n// so reusing a label for different contents cannot resume an old position.\npub fn from_list<T>(values: [T], source_identity: Str): Stream<T> =\n    Stream.from_list(values, source_identity);\n\n// Construct a replayable finite source and emit ordered positive-size batches.\n// The source identity remains bound to the complete typed value list, and a\n// final short batch is retained rather than dropped.\npub fn from_list_batches<T>(\n    values: [T],\n    source_identity: Str,\n    batch_size: Int\n): Stream<[T]> = std.stream.batch(\n    std.stream.from_list(values, source_identity),\n    batch_size\n);\n\n// Process one item at a time. Each callback and checkpoint movement is one\n// activation; exhaustion returns Unit. Callback failure and cancellation\n// propagate without advancing past an uncommitted item.\npub fn for_each<T>(stream: Stream<T>, action: fn(T): Unit): Unit =\n    std.stream.for_each(stream, action);\n\n// Emit ordered groups of at most `size`; size must be positive. The final\n// group may be shorter, and its checkpoint commits with the whole batch.\npub fn batch<T>(stream: Stream<T>, size: Int): Stream<[T]> = std.stream.batch(stream, size);\n\n// Use a bounded queue with positive capacity and default backpressure. This\n// operator never drops an item to make room.\npub fn buffer<T>(stream: Stream<T>, capacity: Int): Stream<T> =\n    std.stream.buffer(stream, capacity);\n\n// Interleave by observed arrival order while preserving each input's order.\n// Order between independent sources is nondeterministic and not assertable.\npub fn merge<T>(streams: [Stream<T>]): Stream<T> = std.stream.merge(streams);\n\n// Emit at most one item per positive elapsed interval. The caller records an\n// explicit policy for dropping deliveries before admitting a nonreplayable\n// source; no implicit policy is selected.\npub fn throttle<T>(stream: Stream<T>, duration: Duration, drop_policy: Str): Stream<T> =\n    std.stream.throttle(stream, duration, drop_policy);\n\n// Retain the latest item until a positive quiet interval elapses. The caller\n// records the delivery policy because intermediate items are intentionally\n// coalesced and are not durable processing of every input.\npub fn debounce<T>(stream: Stream<T>, duration: Duration, delivery_policy: Str): Stream<T> =\n    std.stream.debounce(stream, duration, delivery_policy);\n\n// Retry the same blocked delivery under its provider contract with bounded\n// attempts and delays. Exhaustion fails without advancing the checkpoint.\npub fn retry<T>(\n    stream: Stream<T>,\n    policy: \u{7b} max_attempts: Int, initial_delay: Duration, max_delay: Duration \u{7d}\n): Stream<T> = std.stream.retry(stream, policy);\n\n// Replace a permitted source/decoding failure with one explicit value. This\n// API cannot acknowledge an ordered delivery by silently skipping it.\npub fn recover<T>(stream: Stream<T>, handler: fn(Error): T): Stream<T> =\n    std.stream.recover(stream, handler);\n" }
