{ id: "asset-6173736574732f7374646c69622f7374642f6c617a792f61646170746572732e6f726e61", path: "assets/stdlib/std/lazy/adapters.orna", media_type: "text/plain; charset=utf-8", content: "// A lazy sequence is a repeatable thunk that creates an initial persistent\n// iterator. Building a pipeline does not call its source thunk; forcing a\n// pipeline creates its cursor, and cursor adapters run only when pulled.\n\npub fn from_iterator<T>(source: std.iterator.Iterator<T>): fn(): std.iterator.Iterator<T> =\n    () => source;\n\npub fn from_list<T>(values: [T]): fn(): std.iterator.Iterator<T> =\n    () => std.iterator.from_list(values);\n\npub fn map<T, U>(\n    source: fn(): std.iterator.Iterator<T>,\n    transform: fn(T): U,\n): fn(): std.iterator.Iterator<U> =\n    () => std.iterator.map(source(), transform);\n\npub fn filter<T>(\n    source: fn(): std.iterator.Iterator<T>,\n    predicate: fn(T): Bool,\n): fn(): std.iterator.Iterator<T> =\n    () => std.iterator.filter(source(), predicate);\n\npub fn flat_map<T, U>(\n    source: fn(): std.iterator.Iterator<T>,\n    transform: fn(T): fn(): std.iterator.Iterator<U>,\n): fn(): std.iterator.Iterator<U> =\n    () => std.iterator.adapters.flat_map(source(), value => transform(value)());\n\npub fn chain<T>(\n    left: fn(): std.iterator.Iterator<T>,\n    right: fn(): std.iterator.Iterator<T>,\n): fn(): std.iterator.Iterator<T> =\n    () => std.iterator.chain(left(), right());\n\npub fn zip_with<T, U, V>(\n    left: fn(): std.iterator.Iterator<T>,\n    right: fn(): std.iterator.Iterator<U>,\n    combine: fn(T, U): V,\n): fn(): std.iterator.Iterator<V> =\n    () => std.iterator.zip_with(left(), right(), combine);\n\npub fn take<T>(\n    source: fn(): std.iterator.Iterator<T>,\n    count: Int,\n): fn(): std.iterator.Iterator<T> =\n    () => std.iterator.take(source(), count);\n\npub fn drop<T>(\n    source: fn(): std.iterator.Iterator<T>,\n    count: Int,\n): fn(): std.iterator.Iterator<T> =\n    () => std.iterator.drop(source(), count);\n\n// Collect is a delayed terminal operation and requires a finite cursor. For\n// infinite sources, bound with `take` before forcing the resulting list thunk.\npub fn collect<T>(source: fn(): std.iterator.Iterator<T>): fn(): [T] =\n    () => std.iterator.collect(source());\n" }
