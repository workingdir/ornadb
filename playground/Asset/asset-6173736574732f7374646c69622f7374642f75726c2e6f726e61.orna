{ id: "asset-6173736574732f7374646c69622f7374642f75726c2e6f726e61", path: "assets/stdlib/std/url.orna", media_type: "text/plain; charset=utf-8", content: "// std.url is the pinned Orna URL profile. It accepts absolute http, https,\n// ws, and wss URLs and relative references only through resolve. User-info,\n// control characters, malformed percent escapes, invalid ports, and\n// non-ASCII host labels are rejected; callers must convert international\n// domain names to an ASCII IDNA form explicitly. Hosts and schemes are\n// canonical lower-case ASCII, IPv6 literals are stored without brackets and\n// formatted with brackets, default ports are omitted, and an empty network\n// path is represented by \"/\". Path, query, and fragment case and ordering are\n// preserved. A URL value is the canonical absolute URL string returned by\n// parse; every operation validates its input instead of trusting a\n// caller-built record. Non-ASCII path, query, and fragment scalars are UTF-8\n// percent encoded. Percent escapes are validated and emitted with uppercase\n// hex; reserved path/query delimiters are not decoded during parsing.\n//\n// Query parameters preserve source order and duplicates. A missing value is\n// distinct from an explicit empty value. Component decoding uses strict UTF-8;\n// '+' is a literal plus and is never treated as a form-space alias.\npub fn parse(input: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.parse requires its pinned URL evaluator binding\"\n));\n\n// Resolve follows RFC 3986 reference resolution and dot-segment removal.\n// The result is revalidated under this module's supported network schemes.\npub fn resolve(base_url: Str, reference: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.resolve requires its pinned URL evaluator binding\"\n));\n\n// Format emits the canonical network URL, including its fragment. HTTP and\n// WebSocket request adapters never transmit a fragment to the peer.\npub fn format(value: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.format requires its pinned URL evaluator binding\"\n));\n\npub fn scheme(value: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.scheme requires its pinned URL evaluator binding\"\n));\n\npub fn host(value: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.host requires its pinned URL evaluator binding\"\n));\n\npub fn port(value: Str): Int? = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.port requires its pinned URL evaluator binding\"\n));\n\npub fn path(value: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.path requires its pinned URL evaluator binding\"\n));\n\npub fn query(value: Str): Str? = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.query requires its pinned URL evaluator binding\"\n));\n\npub fn fragment(value: Str): Str? = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.fragment requires its pinned URL evaluator binding\"\n));\n\n// Encode only RFC 3986 unreserved scalars literally. Every other scalar is\n// UTF-8 encoded and each resulting byte is emitted as %HH.\npub fn encode_component(value: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.encode_component requires its pinned URL evaluator binding\"\n));\n\n// Reject malformed escapes and invalid UTF-8. Literal '+' remains '+' and\n// encoded reserved bytes remain data rather than becoming delimiters.\npub fn decode_component(value: Str): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.decode_component requires its pinned URL evaluator binding\"\n));\n\npub fn query_parameters(value: Str): [(Str, Str?)] = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.query_parameters requires its pinned URL evaluator binding\"\n));\n\n// Append one parameter without reordering or collapsing existing pairs. A\n// null value emits a key without '=', while an empty string emits key=.\npub fn with_query_parameter(value: Str, name: Str, parameter: Str?): Str = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.url.with_query_parameter requires its pinned URL evaluator binding\"\n));\n" }
