{ id: "asset-6173736574732f7374646c69622f7374642f74696d652f7574696c69746965732e6f726e61", path: "assets/stdlib/std/time/utilities.orna", media_type: "text/plain; charset=utf-8", content: "// Date and instant conveniences composed from the pinned Gregorian calendar\n// and exact elapsed-time operations. Calendar days are never treated as fixed\n// seconds, and instants never inherit a process-local time zone.\n\n// Weekdays use ISO numbering: Monday is 1 and Sunday is 7. Invalid civil\n// dates return null so callers can distinguish invalid input from a weekday.\npub fn is_weekend(year: Int, month: Int, day: Int): Bool? =\n    case std.time.calendar.weekday(year, month, day) \u{7b}\n        Some(weekday): Some(weekday >= 6),\n        null: null,\n    \u{7d};\n\npub fn is_business_day(year: Int, month: Int, day: Int): Bool? =\n    case std.time.calendar.weekday(year, month, day) \u{7b}\n        Some(weekday): Some(weekday < 6),\n        null: null,\n    \u{7d};\n\n// Return the Monday and Sunday of the ISO week containing a valid date.\n// Results cross month and year boundaries using civil calendar arithmetic.\npub fn week_start(year: Int, month: Int, day: Int): (Int, Int, Int)? =\n    case std.time.calendar.weekday(year, month, day) \u{7b}\n        Some(weekday): std.time.calendar.add_days(year, month, day, 1 - weekday),\n        null: null,\n    \u{7d};\n\npub fn week_end(year: Int, month: Int, day: Int): (Int, Int, Int)? =\n    case std.time.calendar.weekday(year, month, day) \u{7b}\n        Some(weekday): std.time.calendar.add_days(year, month, day, 7 - weekday),\n        null: null,\n    \u{7d};\n\n// Quarters are numbered 1 through 4. Invalid years or months return null.\npub fn quarter_of(year: Int, month: Int): Int? =\n    if year >= 1 && year <= 9999 && month >= 1 && month <= 12 \u{7b}\n        Some((month - 1) / 3 + 1)\n    \u{7d} else \u{7b}\n        null\n    \u{7d};\n\n// Quarter boundaries are inclusive civil dates and do not imply a time zone.\npub fn quarter_start(year: Int, month: Int): (Int, Int, Int)? =\n    case quarter_of(year, month) \u{7b}\n        Some(quarter): std.time.calendar.month_start(year, (quarter - 1) * 3 + 1),\n        null: null,\n    \u{7d};\n\npub fn quarter_end(year: Int, month: Int): (Int, Int, Int)? =\n    case quarter_of(year, month) \u{7b}\n        Some(quarter): std.time.calendar.month_end(year, quarter * 3),\n        null: null,\n    \u{7d};\n\n// Test membership in a closed instant interval. Reversed endpoints are\n// normalized, and equality with either endpoint is included.\npub fn instant_in_closed_range(value: Instant, left: Instant, right: Instant): Bool =\n    value >= std.time.instant_min(left, right) && value <= std.time.instant_max(left, right);\n\n// Return the nonnegative, exact elapsed distance between two instants.\npub fn instant_distance(left: Instant, right: Instant): Duration =\n    std.time.duration_abs(std.time.elapsed_between(left, right));\n" }
