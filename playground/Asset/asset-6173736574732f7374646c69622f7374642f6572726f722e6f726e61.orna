{ id: "asset-6173736574732f7374646c69622f7374642f6572726f722e6f726e61", path: "assets/stdlib/std/error.orna", media_type: "text/plain; charset=utf-8", content: "// Language failures use the core Error channel and `|?` recovery boundary.\n// These optional helpers construct Error values for explicit failure paths;\n// they do not convert a failure into a Result or catch cancellation.\nuse std.collection;\n\n// Preserve the supplied code and message exactly. A newly made Error has no\n// causes; callers opt into causal context with `caused_by`.\npub fn make(code: Str, message: Str): Error = error(code: code, message: message);\n\n// Keep the caller's stable top-level code/message and attach exactly the\n// supplied Error as the first ordered cause. Its own cause chain stays intact.\npub fn caused_by(code: Str, message: Str, cause: Error): Error = error(\n    code: code,\n    message: message,\n    cause: cause,\n);\n\n// Match the stable machine-readable identity. Messages are descriptive and\n// may change without changing the error's code.\npub fn matches_code(value: Error, expected: Str): Bool = value.code == expected;\n\n// Return the top-level code followed by cause codes breadth-first, preserving\n// the recorded order at each level. This keeps aggregate failures inspectable\n// without changing failure propagation or treating Error as a Result value.\nfn append_cause_codes(remaining: [Error], collected: [Str]): [Str] =\n    case std.collection.first(remaining) \u{7b}\n        Some(current): append_cause_codes(\n            std.collection.union(\n                std.collection.drop(remaining, 1),\n                current.causes\n            ),\n            std.collection.union(collected, [current.code])\n        ),\n        null: collected,\n    \u{7d};\n\npub fn code_chain(value: Error): [Str] =\n    append_cause_codes(value.causes, [value.code]);\n" }
