{ id: "asset-6173736574732f7374646c69622f7374642f746573742e6f726e61", path: "assets/stdlib/std/test.orna", media_type: "text/plain; charset=utf-8", content: "// Test helpers are ordinary optional library code. Core `assert` remains\n// available without importing std; this module adds expectations, deterministic\n// property cases, explicit fixtures, and isolated database execution.\n\npub enum ExpectedOutcome \u{7b}\n    Success,\n    // A null code accepts any ordinary failure; a string requires that code.\n    Failure \u{7b} code: Str? \u{7d},\n\u{7d}\n\n// Deny is the default-safe choice. ReplayRecorded and Mocked require their\n// named, immutable cassette/profile and never resolve credentials or contact\n// a live service.\npub enum ExternalEffectPolicy \u{7b}\n    Deny,\n    ReplayRecorded \u{7b} cassette: Str \u{7d},\n    Mocked \u{7b} profile: Str \u{7d},\n\u{7d}\n\n// Fixture inputs are carried as one explicit argument group: `source` is the\n// root Orna source text; each snapshot pair is (logical repository name,\n// immutable commit ID); `inputs[i]` is submitted after loading the source; and\n// `expected[i]` is its required success or failure. The input and outcome\n// lists must have the same length.\n\n// Expectations are pure predicates so they remain usable by the core `assert`\n// statement without making that statement depend on this optional module.\n// They never stringify values, including values whose safe presentation is\n// redacted.\npub fn expect(condition: Bool): Bool = condition;\npub fn expect_true(value: Bool): Bool = value;\npub fn expect_false(value: Bool): Bool = !value;\npub fn expect_equal<T>(actual: T, expected: T): Bool = actual == expected;\npub fn expect_not_equal<T>(actual: T, unexpected: T): Bool = actual != unexpected;\n\npub fn expect_some<T>(value: T?): Bool = case value \u{7b}\n    Some(_): true,\n    null: false,\n\u{7d};\n\npub fn expect_none<T>(value: T?): Bool = case value \u{7b}\n    Some(_): false,\n    null: true,\n\u{7d};\n\n// Should-style forms use the same pure Boolean contract as `expect_*`. They\n// compose with core `assert` and do not log, throw, or make the core assertion\n// statement depend on the optional test library.\npub fn should(condition: Bool): Bool = expect(condition);\n\npub fn should_be_true(value: Bool): Bool = expect_true(value);\n\npub fn should_be_false(value: Bool): Bool = expect_false(value);\n\npub fn should_equal<T>(actual: T, expected: T): Bool = expect_equal(actual, expected);\n\npub fn should_not_equal<T>(actual: T, unexpected: T): Bool =\n    expect_not_equal(actual, unexpected);\n\npub fn should_be_some<T>(value: T?): Bool = expect_some(value);\n\npub fn should_be_none<T>(value: T?): Bool = expect_none(value);\n\npub fn should_satisfy<T>(value: T, predicate: fn(T): Bool): Bool = predicate(value);\n\n// The runner catches the callback's ordinary failure, compares its optional\n// stable code, and fails if it returns normally. This operation is local to a\n// test runner and is never a production failure-recovery primitive.\npub fn expect_failure<T>(action: fn(): T, code: Str?): Bool = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.test.expect_failure requires the isolated test-runner binding\"\n));\n\n// Generators receive the captured seed and zero-based case index. The same\n// seed/index pair always produces the same value under this pinned snapshot.\n// `for_all` evaluates exactly `cases` values in index order; cases must be\n// positive. On failure it reports the seed, case index and safely presented\n// counterexample, and any shrinking is deterministic and bounded.\npub fn for_all<T>(\n    name: Str,\n    cases: Int,\n    seed: Int,\n    generate: fn(Int, Int): T,\n    property: fn(T): Bool,\n): Bool = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.test.for_all requires the isolated property-runner binding\"\n));\n\n// The generator binding maps the same seed/index pair to the same value and\n// uses a deterministic bounded-integer schedule. Bounds are lower-inclusive,\n// upper-exclusive, and must form a nonempty range.\npub fn integer_range(lower_inclusive: Int, upper_exclusive: Int): fn(Int, Int): Int = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.test.integer_range requires the pinned generator binding\"\n));\n\n// Finite-list generators preserve their source order and use this same seed / index schedule.\n// Their runner binding validates nonempty sources and nonnegative maximum lengths.\npub fn elements<T>(values: [T]): fn(Int, Int): T = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.test.elements requires the pinned generator binding\"\n));\n\npub fn list_of<T>(element: fn(Int, Int): T, maximum_length: Int): fn(Int, Int): [T] = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.test.list_of requires the pinned generator binding\"\n));\n\n// A fixture runner validates equal input/outcome lengths before execution,\n// mounts only the named immutable snapshots, and denies unlisted effects. A\n// recorded cassette or mock profile is explicit; developer credentials, local\n// databases, and live services are never implicit fixture dependencies. It\n// returns true only when every input matches its declared outcome.\npub fn run_fixture(\n    source: Str,\n    initial_snapshots: [(Str, Str)],\n    inputs: [Str],\n    expected: [ExpectedOutcome],\n    external_effects: ExternalEffectPolicy,\n): Bool = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.test.run_fixture requires isolated worktree and runtime ownership\"\n));\n\n// Create a fresh worktree-local CWD and runtime owner from the fixture's exact\n// initial snapshots, run the callback, and remove the isolated state on every\n// terminal path. A temporary branch alone does not provide this isolation.\npub fn with_isolated_database<T>(\n    source: Str,\n    initial_snapshots: [(Str, Str)],\n    inputs: [Str],\n    expected: [ExpectedOutcome],\n    external_effects: ExternalEffectPolicy,\n    action: fn(): T,\n): T = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.test.with_isolated_database requires isolated worktree and runtime ownership\"\n));\n" }
