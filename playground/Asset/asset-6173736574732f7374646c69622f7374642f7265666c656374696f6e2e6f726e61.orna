{ id: "asset-6173736574732f7374646c69622f7374642f7265666c656374696f6e2e6f726e61", path: "assets/stdlib/std/reflection.orna", media_type: "text/plain; charset=utf-8", content: "// Typed reflective operations delegate to the mandatory `sys` boundary.\n// They accept only pinned FunctionRefs and explicit ArgumentMaps. The\n// wrappers do not evaluate source text or implicitly retype records.\n\n// The result witness is explicit and checked before target effects. A null\n// `at` uses the FunctionRef's captured snapshot; transaction and idempotency\n// semantics are those of `sys.invoke`.\npub fn invoke_as<T>(\n    function: sys.FunctionRef,\n    arguments: sys.ArgumentMap,\n    at: sys.SnapshotRef? = null,\n    transaction: sys.InvokeTransaction = sys.InvokeTransaction.inherit,\n    idempotency_key: Str? = null\n): T = sys.invoke<T>(\n    function,\n    arguments,\n    as: T,\n    at: at,\n    transaction: transaction,\n    idempotency_key: idempotency_key\n);\n\n// Explicitly erased invocation retains the sys.Value type envelope; callers\n// must not treat it as an implicit conversion or failed-inference fallback.\npub fn invoke_value(\n    function: sys.FunctionRef,\n    arguments: sys.ArgumentMap,\n    at: sys.SnapshotRef? = null,\n    transaction: sys.InvokeTransaction = sys.InvokeTransaction.inherit,\n    idempotency_key: Str? = null\n): sys.Value = sys.invoke(\n    function,\n    arguments,\n    at: at,\n    transaction: transaction,\n    idempotency_key: idempotency_key\n);\n\n// Asynchronous starts use a separate transaction by default. Their handles\n// stay owned by the current operation/session and cannot be resumed elsewhere.\npub fn start_as<T>(\n    function: sys.FunctionRef,\n    arguments: sys.ArgumentMap,\n    at: sys.SnapshotRef? = null,\n    transaction: sys.InvokeTransaction = sys.InvokeTransaction.separate,\n    idempotency_key: Str? = null\n): sys.InvocationHandle<T> = sys.start<T>(\n    function,\n    arguments,\n    as: T,\n    at: at,\n    transaction: transaction,\n    idempotency_key: idempotency_key\n);\n\npub fn start_value(\n    function: sys.FunctionRef,\n    arguments: sys.ArgumentMap,\n    at: sys.SnapshotRef? = null,\n    transaction: sys.InvokeTransaction = sys.InvokeTransaction.separate,\n    idempotency_key: Str? = null\n): sys.InvocationHandle<sys.Value> = sys.start(\n    function,\n    arguments,\n    at: at,\n    transaction: transaction,\n    idempotency_key: idempotency_key\n);\n\n// Await returns one complete terminal result. A timeout does not cancel the\n// child; cancellation remains an explicit idempotent operation on its handle.\npub fn await_result<T>(\n    invocation: sys.InvocationHandle<T>,\n    timeout: Duration? = null\n): sys.InvocationResult<T> = sys.await(invocation, timeout);\n\npub fn cancel<T>(invocation: sys.InvocationHandle<T>, reason: Str? = null): Bool =\n    sys.cancel(invocation, reason);\n" }
