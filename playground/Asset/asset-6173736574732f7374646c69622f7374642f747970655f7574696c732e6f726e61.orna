{ id: "asset-6173736574732f7374646c69622f7374642f747970655f7574696c732e6f726e61", path: "assets/stdlib/std/type_utils.orna", media_type: "text/plain; charset=utf-8", content: "// Generic, static value-shape helpers. They operate on declared tuple and\n// Option<T> types and preserve each component's inferred type. Runtime type\n// names, implicit coercion, and dynamic Any are not introduced.\n\npub fn pair<A, B>(first: A, second: B): (A, B) = (first, second);\n\npub fn first_of<A, B>(value: (A, B)): A = case value \u{7b}\n    (first_value, _): first_value,\n\u{7d};\n\npub fn second_of<A, B>(value: (A, B)): B = case value \u{7b}\n    (_, second_value): second_value,\n\u{7d};\n\npub fn swap_pair<A, B>(value: (A, B)): (B, A) = case value \u{7b}\n    (first_value, second_value): (second_value, first_value),\n\u{7d};\n\npub fn map_first<A, B, C>(\n    value: (A, B),\n    transform: fn(A): C,\n): (C, B) = case value \u{7b}\n    (first_value, second_value): (transform(first_value), second_value),\n\u{7d};\n\npub fn map_second<A, B, C>(\n    value: (A, B),\n    transform: fn(B): C,\n): (A, C) = case value \u{7b}\n    (first_value, second_value): (first_value, transform(second_value)),\n\u{7d};\n\n// Transform the first component before the second, once each.\npub fn map_pair<A, B, C, D>(\n    value: (A, B),\n    transform_first: fn(A): C,\n    transform_second: fn(B): D,\n): (C, D) = case value \u{7b}\n    (first_value, second_value): (\n        transform_first(first_value),\n        transform_second(second_value),\n    ),\n\u{7d};\n\npub fn some<T>(value: T): T? = first([value]);\n\npub fn map_option<T, U>(value: T?, transform: fn(T): U): U? = case value \u{7b}\n    Some(inner): first([transform(inner)]),\n    null: null,\n\u{7d};\n" }
