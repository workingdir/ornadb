{ id: "asset-6578616d706c65732e6d6a73", path: "examples.mjs", media_type: "text/javascript; charset=utf-8", content: "const catalog = document.querySelector('#example-catalog');\nconst filter = document.querySelector('#example-filter');\nconst list = document.querySelector('#example-list');\nconst status = document.querySelector('#catalog-status');\n\nfunction isRecord(value) \u{7b}\n  return typeof value === 'object' && value !== null && !Array.isArray(value);\n\u{7d}\n\nfunction isExample(value) \u{7b}\n  return isRecord(value)\n    && typeof value.name === 'string'\n    && typeof value.path === 'string'\n    && typeof value.source === 'string';\n\u{7d}\n\nfunction sourceRecordUrl(revision, path) \u{7b}\n  const segments = path.split('/').map((segment) => encodeURIComponent(segment));\n  return `/blob/$\u{7b}revision\u{7d}/$\u{7b}segments.join('/')\u{7d}`;\n\u{7d}\n\nfunction renderExample(example, revision) \u{7b}\n  const item = document.createElement('li');\n  item.className = 'catalog-item';\n  item.dataset.search = `$\u{7b}example.name\u{7d} $\u{7b}example.path\u{7d}`.toLocaleLowerCase();\n\n  const heading = document.createElement('h2');\n  heading.textContent = example.name;\n  const path = document.createElement('p');\n  path.className = 'catalog-path';\n  const pathLabel = document.createElement('code');\n  pathLabel.textContent = example.path;\n  path.append(pathLabel);\n\n  const source = document.createElement('pre');\n  const code = document.createElement('code');\n  code.textContent = example.source;\n  source.append(code);\n\n  const links = document.createElement('p');\n  links.className = 'catalog-links';\n  const edit = document.createElement('a');\n  edit.href = `/playground/?example=$\u{7b}encodeURIComponent(example.path)\u{7d}`;\n  edit.textContent = 'Open in editor';\n  const record = document.createElement('a');\n  record.href = sourceRecordUrl(revision, example.path);\n  record.textContent = 'View committed record';\n  links.append(edit, document.createTextNode(' · '), record);\n\n  item.append(heading, path, source, links);\n  return item;\n\u{7d}\n\nfunction applyFilter() \u{7b}\n  const query = filter.value.trim().toLocaleLowerCase();\n  for (const item of list.children) \u{7b}\n    item.hidden = !item.dataset.search.includes(query);\n  \u{7d}\n\u{7d}\n\nfilter.addEventListener('input', applyFilter);\n\ntry \u{7b}\n  const response = await fetch('/api/examples');\n  if (!response.ok) throw new Error(`Examples request failed ($\u{7b}response.status\u{7d}).`);\n  const payload = await response.json();\n  if (!isRecord(payload) || !/^[0-9a-f]\u{7b}40\u{7d}$/.test(payload.revision ?? '')) \u{7b}\n    throw new Error('The examples response has no committed database revision.');\n  \u{7d}\n  const examples = Array.isArray(payload.examples) ? payload.examples.filter(isExample) : [];\n  if (examples.length === 0) \u{7b}\n    status.textContent = 'No committed examples are available.';\n  \u{7d} else \u{7b}\n    list.replaceChildren(...examples.map((example) => renderExample(example, payload.revision)));\n    status.textContent = `$\u{7b}examples.length\u{7d} committed $\u{7b}examples.length === 1 ? 'example' : 'examples'\u{7d} from revision $\u{7b}payload.revision.slice(0, 12)\u{7d}.`;\n  \u{7d}\n\u{7d} catch (error) \u{7b}\n  status.textContent = error instanceof Error ? error.message : 'The examples could not be loaded.';\n\u{7d} finally \u{7b}\n  catalog.setAttribute('aria-busy', 'false');\n\u{7d}\n" }
