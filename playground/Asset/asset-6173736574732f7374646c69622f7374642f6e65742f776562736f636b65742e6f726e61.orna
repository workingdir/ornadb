{ id: "asset-6173736574732f7374646c69622f7374642f6e65742f776562736f636b65742e6f726e61", path: "assets/stdlib/std/net/websocket.orna", media_type: "text/plain; charset=utf-8", content: "// A WebSocket connection is a host-minted UUID identifier scoped to the\n// creating activation/session; serializing it grants no access to another\n// owner. Operations are cancellation-aware; an owner ending cancels pending\n// I/O and joins or fences transport cleanup.\n// These external operations are unavailable to assertions, read-only watches,\n// presenters, and historical evaluation. Closing or cancelling the transport\n// cannot undo messages already delivered to the peer.\n// `connect` returns a host-minted UUID bound to the owner. It is an identifier,\n// not authority; every operation checks the active owner. Only ws/wss URLs are\n// accepted. The `url` must be a canonical std.url.parse result and is\n// revalidated before connecting; wss validates the peer certificate and host.\n// The server must select one offered subprotocol, or none when none were offered. Header\n// validation matches std.net.http. Extensions and compression are not\n// negotiated implicitly. timeout is null for no deadline or nonnegative;\n// max_handshake_bytes and max_message_bytes must be positive. The URL fragment\n// is never sent to the peer. Success returns (connection, status, ordered\n// handshake headers); status is 101 and repeated headers are preserved.\npub fn connect(\n    url: Str,\n    headers: [(Str, Str)],\n    subprotocols: [Str],\n    timeout: Duration?,\n    max_handshake_bytes: Int,\n    max_message_bytes: Int,\n): (Uuid, Int, [(Str, Str)]) = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.websocket.connect requires its cancellable WebSocket evaluator binding\"\n));\n\n// `kind` is exactly \"text\" or \"binary\". A text payload must be valid UTF-8;\n// binary payload bytes are unchanged. Sending a message larger than the\n// connection's max_message_bytes fails.\npub fn send(connection: Uuid, kind: Str, payload: Blob): Unit = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.websocket.send requires its cancellable WebSocket evaluator binding\"\n));\n\n// Wait for one complete message. Fragmentation is reassembled within the\n// configured byte bound. Return null only after an orderly peer close; an\n// oversized message fails without returning a prefix.\npub fn receive(connection: Uuid): (Str, Blob)? = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.websocket.receive requires its cancellable WebSocket evaluator binding\"\n));\n\npub fn selected_subprotocol(connection: Uuid): Str? = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.websocket.selected_subprotocol requires its WebSocket evaluator binding\"\n));\n\n// Graceful close validates the RFC close-code range and a UTF-8 reason within\n// the 123-byte control-frame payload bound. It is idempotent after closure.\npub fn close(connection: Uuid, code: Int, reason: Str): Unit = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.websocket.close requires its cancellable WebSocket evaluator binding\"\n));\n\n// Immediate cancellation aborts pending reads/writes and invalidates the\n// connection. It cannot retract an application message already sent.\npub fn cancel(connection: Uuid): Bool = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.websocket.cancel requires its cancellable WebSocket evaluator binding\"\n));\n" }
