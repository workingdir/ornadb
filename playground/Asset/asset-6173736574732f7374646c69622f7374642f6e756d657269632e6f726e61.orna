{ id: "asset-6173736574732f7374646c69622f7374642f6e756d657269632e6f726e61", path: "assets/stdlib/std/numeric.orna", media_type: "text/plain; charset=utf-8", content: "use std.collection;\nuse std.format;\nuse std.parse;\nuse std.text;\n\n// Numeric conversions are locale independent. Exact conversions stay in\n// base-ten arithmetic and never pass through binary Float.\n\n/// Parses the canonical signed Int spelling. Invalid or noncanonical input\n/// returns null; accepted values contain no plus sign, whitespace,\n/// separators, redundant leading zeroes, or negative zero.\npub fn integer_from_text(input: Str): Int? = std.parse.integer(input);\n\n/// Formats an Int as minimal signed base-ten text. Parsing that text with\n/// `integer_from_text` recovers the original integer exactly.\npub fn integer_to_text(value: Int): Str = std.format.integer(value);\n\n/// Converts an Int to Decimal exactly by preserving its integer value in\n/// base-ten arithmetic, without a binary Float intermediate.\npub fn decimal_from_integer(value: Int): Decimal = value.decimal;\n\nfn digit_value(character: Str): Int? = case character \u{7b}\n    \"0\": Some(0),\n    \"1\": Some(1),\n    \"2\": Some(2),\n    \"3\": Some(3),\n    \"4\": Some(4),\n    \"5\": Some(5),\n    \"6\": Some(6),\n    \"7\": Some(7),\n    \"8\": Some(8),\n    \"9\": Some(9),\n    _: null,\n\u{7d};\n\n/// Parses canonical fixed-point base-ten text into an exact Decimal. A minus\n/// sign is optional; a fractional part must contain digits and cannot end in\n/// zero. Plus signs, exponent notation, separators, whitespace, redundant\n/// leading zeroes, and negative zero return null. No rounding is performed.\n/// Inputs beyond evaluator resource limits propagate its bounded limit error.\npub fn decimal_from_text(input: Str): Decimal? \u{7b}\n    let characters = std.text.split(input, \"\");\n    let length = std.collection.count(characters);\n    if length == 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        let negative = characters[0] == \"-\";\n        let sign_offset = if negative \u{7b} 1 \u{7d} else \u{7b} 0 \u{7d};\n        let point = -1;\n        let scan = sign_offset;\n        while scan < length && point < 0 \u{7b}\n            if characters[scan] == \".\" \u{7b}\n                point = scan;\n            \u{7d} else \u{7b}\n                scan += 1;\n            \u{7d};\n        \u{7d};\n        let integer_end = if point < 0 \u{7b} length \u{7d} else \u{7b} point \u{7d};\n        let fraction_start = if point < 0 \u{7b} length \u{7d} else \u{7b} point + 1 \u{7d};\n        let integer_text = std.text.join(\n            std.collection.take(\n                std.collection.drop(characters, sign_offset),\n                integer_end - sign_offset\n            ),\n            \"\"\n        );\n        let integer_part = std.parse.integer(integer_text);\n        let has_fraction = point >= 0;\n        let valid = integer_end > sign_offset\n            && integer_part != null\n            && (!has_fraction || fraction_start < length)\n            && (!has_fraction || characters[length - 1] != \"0\");\n        let fraction_numerator = 0;\n        let denominator = 1;\n        let index = fraction_start;\n        while index < length && valid \u{7b}\n            let digit = case digit_value(characters[index]) \u{7b}\n                Some(value): value,\n                null: -1,\n            \u{7d};\n            if digit < 0 \u{7b}\n                valid = false;\n            \u{7d} else \u{7b}\n                fraction_numerator = fraction_numerator * 10 + digit;\n                denominator = denominator * 10;\n            \u{7d};\n            index += 1;\n        \u{7d};\n        let integer_value = case integer_part \u{7b}\n            Some(value): value,\n            null: 0,\n        \u{7d};\n        let fraction = fraction_numerator.decimal / denominator.decimal;\n        let magnitude = integer_value.decimal + fraction;\n        if valid && !(negative && magnitude == 0.decimal) \u{7b}\n            Some(if negative \u{7b} -magnitude \u{7d} else \u{7b} magnitude \u{7d})\n        \u{7d} else \u{7b}\n            null\n        \u{7d}\n    \u{7d}\n\u{7d}\n// Numeric capabilities are explicit protocols. They do not coerce values or\n// route through Float; an implementation owns the arithmetic of its type.\n// `Compare.compare` returns a negative value, zero, or a positive value.\n// `Integer.div_rem` uses Euclidean division: the remainder is non-negative\n// and smaller than the divisor's magnitude. Division by zero fails.\n\npub protocol Zero \u{7b}\n    fn is_zero(self): Bool;\n\u{7d}\n\npub protocol One \u{7b}\n    fn is_one(self): Bool;\n\u{7d}\n\npub protocol Add \u{7b}\n    fn add(self, right: Self): Self;\n\u{7d}\n\npub protocol Sub \u{7b}\n    fn sub(self, right: Self): Self;\n\u{7d}\n\npub protocol Mul \u{7b}\n    fn mul(self, right: Self): Self;\n\u{7d}\n\npub protocol Div \u{7b}\n    fn div(self, right: Self): Self;\n\u{7d}\n\npub protocol Rem \u{7b}\n    fn rem(self, right: Self): Self;\n\u{7d}\n\npub protocol Neg \u{7b}\n    fn neg(self): Self;\n\u{7d}\n\npub protocol Signed \u{7b}\n    fn abs(self): Self;\n    fn signum(self): Self;\n    fn is_positive(self): Bool;\n    fn is_negative(self): Bool;\n\u{7d}\n\npub protocol Integer \u{7b}\n    fn div_rem(self, divisor: Self): (Self, Self);\n\u{7d}\n\npub protocol Compare \u{7b}\n    fn compare(self, right: Self): Int;\n\u{7d}\n\npub fn is_zero<T impl Zero>(value: T): Bool = value.is_zero();\n\npub fn is_one<T impl One>(value: T): Bool = value.is_one();\n\npub fn add<T impl Add>(left: T, right: T): T = left.add(right);\n\npub fn sub<T impl Sub>(left: T, right: T): T = left.sub(right);\n\npub fn mul<T impl Mul>(left: T, right: T): T = left.mul(right);\n\npub fn div<T impl Div>(left: T, right: T): T = left.div(right);\n\npub fn rem<T impl Rem>(left: T, right: T): T = left.rem(right);\n\npub fn neg<T impl Neg>(value: T): T = value.neg();\n\npub fn abs<T impl Signed>(value: T): T = value.abs();\n\npub fn signum<T impl Signed>(value: T): T = value.signum();\n\npub fn is_positive<T impl Signed>(value: T): Bool = value.is_positive();\n\npub fn is_negative<T impl Signed>(value: T): Bool = value.is_negative();\n\npub fn div_rem<T impl Integer>(left: T, right: T): (T, T) = left.div_rem(right);\n\nfn gcd_euclidean<T impl Integer + Zero + Signed>(left: T, right: T): T \u{7b}\n    if right.is_zero() \u{7b}\n        left.abs()\n    \u{7d} else \u{7b}\n        let (_, remainder) = left.div_rem(right);\n        gcd_euclidean(right, remainder)\n    \u{7d}\n\u{7d}\n\n/// Returns the non-negative greatest common divisor. Both-zero inputs return\n/// zero. Integer implementations must provide Euclidean remainders through\n/// `div_rem`; division by zero is avoided by the terminating zero check.\npub fn gcd<T impl Integer + Zero + Signed>(left: T, right: T): T =\n    gcd_euclidean(left, right);\n\n/// Returns the least common multiple of the absolute input magnitudes, or\n/// zero when either input is zero. Division is exact and nonzero; bounded\n/// implementations inherit their `Div` and `Mul` overflow behavior.\npub fn lcm<T impl Integer + Zero + Signed + Div + Mul>(left: T, right: T): T =\n    if left.is_zero() \u{7b}\n        left\n    \u{7d} else \u{7b}\n        if right.is_zero() \u{7b}\n            right\n        \u{7d} else \u{7b}\n            (left.abs().div(gcd(left, right))).mul(right.abs())\n        \u{7d}\n    \u{7d};\n\npub fn min<T impl Compare>(left: T, right: T): T =\n    if left.compare(right) <= 0 \u{7b} left \u{7d} else \u{7b} right \u{7d};\n\npub fn max<T impl Compare>(left: T, right: T): T =\n    if left.compare(right) >= 0 \u{7b} left \u{7d} else \u{7b} right \u{7d};\n\npub fn clamp<T impl Compare>(value: T, lower: T, upper: T): T =\n    if value.compare(lower) < 0 \u{7b}\n        lower\n    \u{7d} else \u{7b}\n        if value.compare(upper) > 0 \u{7b} upper \u{7d} else \u{7b} value \u{7d}\n    \u{7d};\n" }
