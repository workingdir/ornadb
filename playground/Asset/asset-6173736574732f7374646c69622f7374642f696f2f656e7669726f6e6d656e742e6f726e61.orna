{ id: "asset-6173736574732f7374646c69622f7374642f696f2f656e7669726f6e6d656e742e6f726e61", path: "assets/stdlib/std/io/environment.orna", media_type: "text/plain; charset=utf-8", content: "// Environment access is an explicit host effect and requires a per-name\n// allowlist. Names use [A-Z_][A-Z0-9_]*. `get` returns null only for an\n// approved unset variable; `require` reports an ordinary missing-variable\n// error. No enumeration or mutation API is exposed, and secret material uses\n// a separate secret-reference capability.\n\npub fn get(name: Str): Str? = __get(name);\nfn __get(name: Str): Str? = std.io.environment.get(name);\n\npub fn require(name: Str): Str = __require(name);\nfn __require(name: Str): Str = std.io.environment.require(name);\n" }
