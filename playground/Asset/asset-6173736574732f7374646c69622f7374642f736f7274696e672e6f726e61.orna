{ id: "asset-6173736574732f7374646c69622f7374642f736f7274696e672e6f726e61", path: "assets/stdlib/std/sorting.orna", media_type: "text/plain; charset=utf-8", content: "// Stable finite-list ordering helpers. Keys must provide a lawful total\n// order. Sort operations evaluate the key once for each input value.\n\n// Return a three-way comparison result: -1, 0, or 1.\npub fn compare<K>(left: K, right: K): Int =\n    if left < right \u{7b}\n        -1\n    \u{7d} else if right < left \u{7b}\n        1\n    \u{7d} else \u{7b}\n        0\n    \u{7d};\n\nfn precedes<K>(left: K, right: K, descending: Bool): Bool =\n    if descending \u{7b} right < left \u{7d} else \u{7b} left < right \u{7d};\n\nfn decorate_from<T, K>(\n    values: [T], key: fn(T): K, index: Int, end: Int, output: [(K, T)]\n): [(K, T)] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        let value = values[index];\n        decorate_from(\n            values,\n            key,\n            index + 1,\n            end,\n            std.collection.union(output, [(key(value), value)]),\n        )\n    \u{7d};\n\nfn insertion_sort_pairs<K, T>(values: [(K, T)], descending: Bool): [(K, T)] \u{7b}\n    let sorted = [];\n    let value_index = 0;\n    let end = std.collection.count(values);\n    while value_index < end \u{7b}\n        let candidate = values[value_index];\n        let (candidate_key, _) = candidate;\n        let sorted_end = std.collection.count(sorted);\n        let insert_index = 0;\n        let searching = true;\n        while insert_index < sorted_end && searching \u{7b}\n            let (current_key, _) = sorted[insert_index];\n            if precedes(candidate_key, current_key, descending) \u{7b}\n                searching = false;\n            \u{7d} else \u{7b}\n                insert_index += 1;\n            \u{7d};\n        \u{7d};\n        let updated = [];\n        let copy_index = 0;\n        while copy_index < insert_index \u{7b}\n            updated = std.collection.union(updated, [sorted[copy_index]]);\n            copy_index += 1;\n        \u{7d};\n        updated = std.collection.union(updated, [candidate]);\n        copy_index = insert_index;\n        while copy_index < sorted_end \u{7b}\n            updated = std.collection.union(updated, [sorted[copy_index]]);\n            copy_index += 1;\n        \u{7d};\n        sorted = updated;\n        value_index += 1;\n    \u{7d};\n    sorted\n\u{7d}\n\nfn values_from_pairs<K, T>(\n    values: [(K, T)], index: Int, end: Int, output: [T]\n): [T] =\n    if index >= end \u{7b}\n        output\n    \u{7d} else \u{7b}\n        let (_, value) = values[index];\n        values_from_pairs(\n            values,\n            index + 1,\n            end,\n            std.collection.union(output, [value]),\n        )\n    \u{7d};\n\nfn sort_by_direction<T, K>(values: [T], key: fn(T): K, descending: Bool): [T] \u{7b}\n    if descending \u{7b}\n        let decorated = decorate_from(values, key, 0, std.collection.count(values), []);\n        let ordered = insertion_sort_pairs(decorated, true);\n        values_from_pairs(ordered, 0, std.collection.count(ordered), [])\n    \u{7d} else \u{7b}\n        std.collection.sort_by(values, key)\n    \u{7d}\n\u{7d}\n\n// Sort by ascending key while preserving the source order of equal keys.\npub fn sort_by<T, K>(values: [T], key: fn(T): K): [T] =\n    sort_by_direction(values, key, false);\n\n// Sort by descending key while preserving the source order of equal keys.\npub fn sort_by_descending<T, K>(values: [T], key: fn(T): K): [T] =\n    sort_by_direction(values, key, true);\n\n// Sort values in ascending natural order.\npub fn sort<T>(values: [T]): [T] = sort_by(values, value => value);\n\n// Sort values in descending natural order.\npub fn sort_descending<T>(values: [T]): [T] = sort_by_descending(values, value => value);\n\nfn sorted_from<T, K>(\n    values: [T], key: fn(T): K, descending: Bool, index: Int, end: Int\n): Bool =\n    if index + 1 >= end \u{7b}\n        true\n    \u{7d} else \u{7b}\n        !precedes(key(values[index + 1]), key(values[index]), descending) &&\n            sorted_from(values, key, descending, index + 1, end)\n    \u{7d};\n\n// Check ascending order; equal adjacent keys are allowed.\npub fn is_sorted_by<T, K>(values: [T], key: fn(T): K): Bool =\n    sorted_from(values, key, false, 0, std.collection.count(values));\n\n// Check descending order; equal adjacent keys are allowed.\npub fn is_sorted_by_descending<T, K>(values: [T], key: fn(T): K): Bool =\n    sorted_from(values, key, true, 0, std.collection.count(values));\n\npub fn is_sorted<T>(values: [T]): Bool = is_sorted_by(values, value => value);\n\npub fn is_sorted_descending<T>(values: [T]): Bool =\n    is_sorted_by_descending(values, value => value);\n\nfn extreme_pair_from<T, K>(\n    values: [T], key: fn(T): K, descending: Bool, index: Int, end: Int, best: (K, T)\n): (K, T) =\n    if index >= end \u{7b}\n        best\n    \u{7d} else \u{7b}\n        let value = values[index];\n        let candidate = (key(value), value);\n        let (candidate_key, _) = candidate;\n        let (best_key, _) = best;\n        extreme_pair_from(\n            values,\n            key,\n            descending,\n            index + 1,\n            end,\n            if precedes(candidate_key, best_key, descending) \u{7b} candidate \u{7d} else \u{7b} best \u{7d},\n        )\n    \u{7d};\n\n// Return the first value with the minimum key, or null for an empty list.\npub fn min_by<T, K>(values: [T], key: fn(T): K): T? =\n    if std.collection.count(values) == 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        let (_, value) = extreme_pair_from(\n            values,\n            key,\n            false,\n            1,\n            std.collection.count(values),\n            (key(values[0]), values[0]),\n        );\n        Some(value)\n    \u{7d};\n\n// Return the first value with the maximum key, or null for an empty list.\npub fn max_by<T, K>(values: [T], key: fn(T): K): T? =\n    if std.collection.count(values) == 0 \u{7b}\n        null\n    \u{7d} else \u{7b}\n        let (_, value) = extreme_pair_from(\n            values,\n            key,\n            true,\n            1,\n            std.collection.count(values),\n            (key(values[0]), values[0]),\n        );\n        Some(value)\n    \u{7d};\n" }
