{ id: "asset-696e6465782e68746d6c", path: "index.html", media_type: "text/html; charset=utf-8", content: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta name=\"description\" content=\"Edit and run Orna source in the browser.\" />\n    <title>Orna playground</title>\n    <script type=\"module\" crossorigin src=\"/playground/assets/index.js\"></script>\n    <link rel=\"modulepreload\" crossorigin href=\"/playground/assets/monaco-base.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/playground/assets/monaco-editor.js\">\n    <link rel=\"stylesheet\" crossorigin href=\"/playground/assets/monaco-base.css\">\n    <link rel=\"stylesheet\" crossorigin href=\"/playground/assets/monaco-editor.css\">\n    <link rel=\"stylesheet\" crossorigin href=\"/playground/assets/index.css\">\n  </head>\n  <body>\n    <header class=\"page-header\" data-page-header>\n      <h1>Orna playground</h1>\n      <p><a href=\"/\">Database</a> · <a href=\"/playground/examples/\">Browse examples</a> · Choose a committed example or write Orna source.</p>\n    </header>\n\n    <main>\n      <div class=\"workspace\">\n        <section class=\"editor-pane\" aria-labelledby=\"source-title\">\n          <div class=\"pane-heading\">\n            <h2 id=\"source-title\">Source</h2>\n            <div class=\"example-feed\">\n              <label for=\"examples\">Example</label>\n              <select id=\"examples\" aria-describedby=\"example-key-help\" aria-controls=\"source-editor\" disabled>\n                <option>Loading examples…</option>\n              </select>\n              <p class=\"example-feed-help\" id=\"example-key-help\">\n                Use ↑/↓ to browse, Home/End to jump, Page Up/Down to skip five, or type a name.\n              </p>\n              <span class=\"visually-hidden\" id=\"example-status\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></span>\n            </div>\n          </div>\n          <div id=\"source-editor\" aria-label=\"Orna source editor\"></div>\n          <div class=\"actions\">\n            <button id=\"run-button\" type=\"button\" disabled>Run</button>\n            <span id=\"editor-status\" role=\"status\">Loading examples</span>\n          </div>\n        </section>\n\n        <section class=\"output-pane\" aria-labelledby=\"results-title\">\n          <div class=\"pane-heading\">\n            <h2 id=\"results-title\">Results</h2>\n            <span id=\"execution-state\" role=\"status\">Waiting</span>\n          </div>\n          <div class=\"tabs\" role=\"tablist\" aria-label=\"Execution result views\">\n            <button type=\"button\" role=\"tab\" id=\"tab-output\" aria-controls=\"panel-output\" aria-selected=\"true\" tabindex=\"0\" data-output-tab=\"output\">Output</button>\n            <button type=\"button\" role=\"tab\" id=\"tab-values\" aria-controls=\"panel-values\" aria-selected=\"false\" tabindex=\"-1\" data-output-tab=\"values\">Values</button>\n            <button type=\"button\" role=\"tab\" id=\"tab-errors\" aria-controls=\"panel-errors\" aria-selected=\"false\" tabindex=\"-1\" data-output-tab=\"errors\">Errors</button>\n            <button type=\"button\" role=\"tab\" id=\"tab-ast\" aria-controls=\"panel-ast\" aria-selected=\"false\" tabindex=\"-1\" data-output-tab=\"ast\">AST</button>\n          </div>\n          <div class=\"panels\" aria-live=\"polite\" aria-atomic=\"false\">\n            <section id=\"panel-output\" role=\"tabpanel\" aria-labelledby=\"tab-output\" data-output-panel=\"output\">\n              <h3>Stdout</h3>\n              <pre id=\"stdout-output\">Run source to see output.</pre>\n            </section>\n            <section id=\"panel-values\" role=\"tabpanel\" aria-labelledby=\"tab-values\" data-output-panel=\"values\" hidden>\n              <h3>Returned values</h3>\n              <pre id=\"values-output\">Returned values appear here.</pre>\n            </section>\n            <section id=\"panel-errors\" role=\"tabpanel\" aria-labelledby=\"tab-errors\" data-output-panel=\"errors\" hidden>\n              <h3>Errors</h3>\n              <pre id=\"errors-output\">Diagnostics appear here.</pre>\n            </section>\n            <section id=\"panel-ast\" role=\"tabpanel\" aria-labelledby=\"tab-ast\" data-output-panel=\"ast\" hidden>\n              <h3>Syntax tree</h3>\n              <pre id=\"ast-output\">The parsed syntax tree appears here.</pre>\n            </section>\n          </div>\n          <p class=\"output-status\" id=\"output-status\">Run source to view its results.</p>\n        </section>\n      </div>\n    </main>\n  </body>\n</html>\n" }
