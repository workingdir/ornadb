{ id: "asset-6173736574732f7374646c69622f7374642f7365742e6f726e61", path: "assets/stdlib/std/set.orna", media_type: "text/plain; charset=utf-8", content: "// A set value is an immutable [T] list with duplicates removed by\n// std.collection's lawful-equality semantics. The first equal value is kept,\n// so traversal and set-operation results have deterministic insertion order.\n// Membership is linear and does not use host hashing or ordering.\nuse collection;\n\npub fn from_list<T>(values: [T]): [T] = std.collection.unique(values);\n\npub fn size<T>(values: [T]): Int = std.collection.count(from_list(values));\n\npub fn is_empty<T>(values: [T]): Bool = size(values) == 0;\n\npub fn contains<T>(values: [T], value: T): Bool =\n    std.collection.exists(from_list(values), item => item == value);\n\npub fn insert<T>(values: [T], value: T): [T] =\n    from_list(std.collection.union(from_list(values), [value]));\n\npub fn remove<T>(values: [T], value: T): [T] =\n    std.collection.filter(from_list(values), item => item != value);\n\npub fn union<T>(left: [T], right: [T]): [T] =\n    from_list(std.collection.union(from_list(left), from_list(right)));\n\npub fn intersection<T>(left: [T], right: [T]): [T] =\n    std.collection.filter(\n        from_list(left),\n        item => contains(right, item)\n    );\n\npub fn difference<T>(left: [T], right: [T]): [T] =\n    std.collection.filter(\n        from_list(left),\n        item => !contains(right, item)\n    );\n\npub fn to_list<T>(values: [T]): [T] = from_list(values);\n" }
