{ id: "asset-6173736574732f7374646c69622f7374642f6f7074696f6e2e6f726e61", path: "assets/stdlib/std/option.orna", media_type: "text/plain; charset=utf-8", content: "// `T?` is the language's built-in Option<T>, represented by Some(value) or\n// null. This module adds ordinary helpers without changing that core type or\n// turning language failures into optional values. Combinators select branches;\n// they never catch failures raised by callbacks.\npub fn is_some<T>(value: T?): Bool = case value \u{7b}\n    Some(_): true,\n    null: false,\n\u{7d};\n\npub fn is_none<T>(value: T?): Bool = case value \u{7b}\n    Some(_): false,\n    null: true,\n\u{7d};\n\npub fn map<T, U>(value: T?, transform: fn(T): U): U? = case value \u{7b}\n    Some(inner): first([transform(inner)]),\n    null: null,\n\u{7d};\n\npub fn and_then<T, U>(value: T?, transform: fn(T): U?): U? = case value \u{7b}\n    Some(inner): transform(inner),\n    null: null,\n\u{7d};\n\npub fn filter<T>(value: T?, predicate: fn(T): Bool): T? = case value \u{7b}\n    Some(inner) if predicate(inner): value,\n    Some(_): null,\n    null: null,\n\u{7d};\n\npub fn unwrap_or<T>(value: T?, fallback: T): T = case value \u{7b}\n    Some(inner): inner,\n    null: fallback,\n\u{7d};\n\npub fn or_else<T>(value: T?, fallback: fn(): T?): T? = case value \u{7b}\n    Some(_): value,\n    null: fallback(),\n\u{7d};\n\npub fn zip<T, U>(left: T?, right: U?): (T, U)? = case left \u{7b}\n    Some(left_value): case right \u{7b}\n        Some(right_value): first([(left_value, right_value)]),\n        null: null,\n    \u{7d},\n    null: null,\n\u{7d};\n\n/// Collapses one nested optional layer. `Some(null)` becomes null.\npub fn flatten<T>(value: T? ?): T? = case value \u{7b}\n    Some(inner): inner,\n    null: null,\n\u{7d};\n\n/// Returns the right option when the left is present, otherwise null. Both\n/// arguments are evaluated before this function is called; use `and_then` when\n/// constructing the right option must be conditional.\npub fn and<T, U>(left: T?, right: U?): U? = case left \u{7b}\n    Some(_): right,\n    null: null,\n\u{7d};\n\n/// Returns the left option when present, otherwise the right option. Both\n/// arguments are evaluated before this function is called; use `or_else` for a\n/// deferred fallback.\npub fn or<T>(left: T?, right: T?): T? = case left \u{7b}\n    Some(_): left,\n    null: right,\n\u{7d};\n\n/// Returns the present option only when exactly one input is present.\npub fn xor<T>(left: T?, right: T?): T? = case left \u{7b}\n    Some(_): case right \u{7b}\n        Some(_): null,\n        null: left,\n    \u{7d},\n    null: right,\n\u{7d};\n\n/// Applies `transform` to a present value, otherwise returns the already\n/// evaluated fallback.\npub fn map_or<T, U>(value: T?, fallback: U, transform: fn(T): U): U = case value \u{7b}\n    Some(inner): transform(inner),\n    null: fallback,\n\u{7d};\n\n/// Applies `transform` to a present value or calls `fallback` only for null.\npub fn map_or_else<T, U>(\n    value: T?, fallback: fn(): U, transform: fn(T): U\n): U = case value \u{7b}\n    Some(inner): transform(inner),\n    null: fallback(),\n\u{7d};\n\n/// Returns the value when present or calls `fallback` only for null.\npub fn unwrap_or_else<T>(value: T?, fallback: fn(): T): T = case value \u{7b}\n    Some(inner): inner,\n    null: fallback(),\n\u{7d};\n\n/// Tests whether the optional value is equal to `expected`.\npub fn contains<T>(value: T?, expected: T): Bool = case value \u{7b}\n    Some(inner): inner == expected,\n    null: false,\n\u{7d};\n\n/// Combines two present values and returns null when either input is absent.\n/// The callback runs only when both options contain values.\npub fn zip_with<T, U, V>(left: T?, right: U?, combine: fn(T, U): V): V? = case left \u{7b}\n    Some(left_value): case right \u{7b}\n        Some(right_value): first([combine(left_value, right_value)]),\n        null: null,\n    \u{7d},\n    null: null,\n\u{7d};\n" }
