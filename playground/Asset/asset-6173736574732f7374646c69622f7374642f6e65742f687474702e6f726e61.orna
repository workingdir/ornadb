{ id: "asset-6173736574732f7374646c69622f7374642f6e65742f687474702e6f726e61", path: "assets/stdlib/std/net/http.orna", media_type: "text/plain; charset=utf-8", content: "// HTTP headers remain an ordered list of name/value pairs so repeated fields\n// such as Set-Cookie are not collapsed. Field names use the ASCII token\n// grammar; values reject CR, LF, NUL, and disallowed controls. The transport\n// preserves duplicate-field order and does not synthesize cookies, auth, or\n// redirects from ambient process state.\n// `start` accepts one request and returns a host-minted UUID handle bound to\n// the current activation/session owner. The UUID is an identifier, not an\n// authority: every operation checks that it belongs to the caller. Owner\n// termination requests cancellation and joins/fences the transport. Only\n// http/https URLs are accepted. The `url` must be a canonical std.url.parse\n// result and is revalidated before connecting. HTTPS always validates the peer\n// certificate and host. timeout is null for no deadline or nonnegative;\n// max_header_bytes must be positive and max_body_bytes is nonnegative (zero\n// admits an empty entity).\n// Method tokens are validated and preserved exactly. The URL fragment is\n// omitted on the wire. No redirect is followed and no retry is implicit.\n// These external operations are unavailable to assertions, read-only watches,\n// presenters, and historical evaluation; database rollback cannot undo a\n// request that reached its peer.\npub fn start(\n    method: Str,\n    url: Str,\n    headers: [(Str, Str)],\n    request_body: Blob?,\n    timeout: Duration?,\n    max_header_bytes: Int,\n    max_body_bytes: Int,\n): Uuid = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.http.start requires its cancellable HTTP evaluator binding\"\n));\n\n// Return (status, ordered headers, body) for the complete response, including\n// non-2xx status values. Interim 1xx protocol responses are consumed by the\n// adapter. If the final headers exceed max_header_bytes or the entity exceeds\n// max_body_bytes, fail without exposing a truncated response. Transfer\n// framing is removed, but Content-Encoding is\n// not transparently decompressed. A timeout fails this wait without cancelling\n// the request; the caller may cancel explicitly.\npub fn wait(handle: Uuid, timeout: Duration?): (Int, [(Str, Str)], Blob) = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.http.wait requires its cancellable HTTP evaluator binding\"\n));\n\n// Return true only when this call first requested cancellation. Cancellation\n// cannot retract bytes already sent or undo a request already received by the\n// peer. No partial response is returned after cancellation is acknowledged.\npub fn cancel(handle: Uuid): Bool = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.http.cancel requires its cancellable HTTP evaluator binding\"\n));\n\n// Synchronous convenience call with the same validation and bounded response\n// behavior as start + wait. The timeout and cancellation are owned by the\n// caller's activation.\npub fn send(\n    method: Str,\n    url: Str,\n    headers: [(Str, Str)],\n    request_body: Blob?,\n    timeout: Duration?,\n    max_header_bytes: Int,\n    max_body_bytes: Int,\n): (Int, [(Str, Str)], Blob) = fail(error(\n    code: \"ORNA-EVAL-UNSUPPORTED\",\n    message: \"std.net.http.send requires its cancellable HTTP evaluator binding\"\n));\n" }
