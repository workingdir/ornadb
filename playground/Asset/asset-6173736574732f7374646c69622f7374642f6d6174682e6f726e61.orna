{ id: "asset-6173736574732f7374646c69622f7374642f6d6174682e6f726e61", path: "assets/stdlib/std/math.orna", media_type: "text/plain; charset=utf-8", content: "// Integer utilities keep their inputs and outputs in exact core Int arithmetic.\n// They do not convert through Float or select ambient decimal precision, so\n// values remain exact beyond machine-word and binary-float precision limits.\n///\n/// Returns the exact successor of `value`; integer overflow is not possible.\n/// Example: `std.math.increment(41)` returns `42`.\npub fn increment(value: Int): Int = value + 1;\n/// Returns the exact predecessor of `value`; integer underflow is not possible.\n/// Example: `std.math.decrement(1)` returns `0`.\npub fn decrement(value: Int): Int = value - 1;\n/// Reports whether `value` is exactly zero.\n/// Example: `std.math.is_zero(0)` returns `true`.\npub fn is_zero(value: Int): Bool = value == 0;\n/// Returns the non-negative magnitude of `value` using exact integer arithmetic.\n/// Example: `std.math.abs(-7)` returns `7`.\npub fn abs(value: Int): Int = if value < 0 \u{7b} -value \u{7d} else \u{7b} value \u{7d};\n/// Returns `-1`, `0`, or `1` according as `value` is negative, zero, or positive.\n/// Example: `std.math.signum(-12)` returns `-1`.\npub fn signum(value: Int): Int =\n    if value < 0 \u{7b} -1 \u{7d} else \u{7b} if value > 0 \u{7b} 1 \u{7d} else \u{7b} 0 \u{7d} \u{7d};\n/// Reports whether `value` is greater than zero.\n/// Zero is not positive. Example: `std.math.is_positive(3)` returns `true`.\npub fn is_positive(value: Int): Bool = value > 0;\n/// Reports whether `value` is less than zero.\n/// Zero is not negative. Example: `std.math.is_negative(-3)` returns `true`.\npub fn is_negative(value: Int): Bool = value < 0;\n/// Reports whether `value` is divisible by two with no remainder.\n/// Negative even integers are included; `std.math.is_even(-4)` returns `true`.\npub fn is_even(value: Int): Bool = value % 2 == 0;\n/// Reports whether `value` is not divisible by two with no remainder.\n/// Negative odd integers are included; `std.math.is_odd(-3)` returns `true`.\npub fn is_odd(value: Int): Bool = value % 2 != 0;\n/// Returns the lesser of `left` and `right`; equal inputs return that value.\n/// Example: `std.math.min(8, 3)` returns `3`.\npub fn min(left: Int, right: Int): Int = if left < right \u{7b} left \u{7d} else \u{7b} right \u{7d};\n/// Returns the greater of `left` and `right`; equal inputs return that value.\n/// Example: `std.math.max(8, 3)` returns `8`.\npub fn max(left: Int, right: Int): Int = if left > right \u{7b} left \u{7d} else \u{7b} right \u{7d};\n/// Bounds `value` to the inclusive interval from `lower` to `upper`.\n/// The caller should supply `lower <= upper`; reversed bounds return `lower`.\n/// Example: `std.math.clamp(12, 0, 10)` returns `10`.\npub fn clamp(value: Int, lower: Int, upper: Int): Int = max(lower, min(value, upper));\n/// Returns `value` multiplied by itself with exact integer arithmetic.\n/// Example: `std.math.square(-4)` returns `16`.\npub fn square(value: Int): Int = value * value;\n/// Returns `value` multiplied by itself three times with exact integer arithmetic.\n/// Example: `std.math.cube(-3)` returns `-27`.\npub fn cube(value: Int): Int = value * value * value;\n\nfn gcd_nonnegative(left: Int, right: Int): Int =\n    if right == 0 \u{7b} left \u{7d} else \u{7b} gcd_nonnegative(right, left % right) \u{7d};\n\n/// Returns the non-negative greatest common divisor of `left` and `right`.\n/// Either input may be negative; `gcd(0, 0)` is defined as `0`.\n/// Example: `std.math.gcd(-18, 12)` returns `6`.\npub fn gcd(left: Int, right: Int): Int = gcd_nonnegative(abs(left), abs(right));\n\n/// Returns the least common multiple of the absolute input magnitudes.\n/// Returns `0` when either input is `0`; the result is always non-negative.\n/// Example: `std.math.lcm(-6, 8)` returns `24`.\npub fn lcm(left: Int, right: Int): Int =\n    if is_zero(left) || is_zero(right) \u{7b}\n        0\n    \u{7d} else \u{7b}\n        (abs(left) / gcd(left, right)) * abs(right)\n    \u{7d};\n\n/// Computes an exact integer power when `exponent` is non-negative.\n/// A negative exponent returns `null` because its result may not be an `Int`.\n/// Exponent zero returns `1`, including `0^0`; this follows the power identity.\n/// Example: `std.math.pow_nonnegative(3, 4)` returns `81`.\npub fn pow_nonnegative(value: Int, exponent: Int): Int? =\n    if exponent < 0 \u{7b} null \u{7d} else \u{7b} first([value ^ exponent]) \u{7d};\n" }
