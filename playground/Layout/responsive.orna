{ id: "responsive", name: "Responsive layout", css: "\n* \u{7b} box-sizing: border-box; \u{7d}\nbody \u{7b} margin: 0; \u{7d}\nmain, .page-header \u{7b} max-width: var(--page-width); margin: 1rem auto; padding: 0 1rem; \u{7d}\na \u{7b} color: var(--link); \u{7d}\na:visited \u{7b} color: var(--visited); \u{7d}\nbutton, select, textarea \u{7b} color: inherit; font: inherit; \u{7d}\nbutton \u{7b} cursor: pointer; \u{7d}\nbutton:disabled, select:disabled \u{7b} cursor: default; \u{7d}\n.page-header \u{7b} border-bottom: 1px solid var(--border); \u{7d}\n.page-header h1 \u{7b} margin: 0; font-size: 1.6rem; font-weight: 400; \u{7d}\n.page-header p \u{7b} margin: .25rem 0 .75rem; \u{7d}\n.workspace \u{7b} display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .9fr); gap: 1rem; align-items: start; \u{7d}\n.editor-pane, .output-pane \u{7b} min-width: 0; \u{7d}\n.pane-heading \u{7b} display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; min-height: 2.5rem; \u{7d}\n.pane-heading h2 \u{7b} margin: 0 auto 0 0; font-size: 1.15rem; font-weight: 400; \u{7d}\n.example-feed \u{7b} display: grid; grid-template-columns: auto minmax(10rem, 16rem); align-items: center; gap: .1rem .5rem; min-width: 0; \u{7d}\n.example-feed label \u{7b} white-space: nowrap; \u{7d}\n.example-feed select \u{7b} min-width: 0; max-width: 100%; \u{7d}\n.example-feed-help \u{7b} grid-column: 2; margin: 0; color: var(--muted); font-size: .75rem; line-height: 1.25; \u{7d}\n#source \u{7b} display: block; width: 100%; height: clamp(20rem, 68vh, 52rem); min-height: 20rem; padding: .65rem; border: 1px solid var(--border); border-radius: 0; background: var(--background); font: .9rem/1.5 var(--code-font); resize: vertical; tab-size: 4; \u{7d}\n.actions \u{7b} display: flex; align-items: center; gap: .75rem; margin-top: .4rem; \u{7d}\n#run-button \u{7b} min-height: 2.25rem; padding: .2rem .8rem; \u{7d}\n#editor-status, .output-status \u{7b} color: var(--muted); font-size: .875rem; margin: .35rem 0; \u{7d}\n.tabs \u{7b} display: flex; gap: .25rem; overflow-x: auto; border-bottom: 1px solid var(--border); margin-top: .5rem; \u{7d}\n.tabs button \u{7b} flex: 0 0 auto; min-height: 2.5rem; padding: .3rem .7rem; border: 0; background: transparent; \u{7d}\n.tabs button[aria-selected=\"true\"] \u{7b} border-bottom: 2px solid var(--link); color: var(--link); \u{7d}\n.panels \u{7b} min-height: clamp(12rem, 32vh, 20rem); padding: .25rem .5rem; border: 1px solid var(--border); border-top: 0; background: var(--surface); \u{7d}\n.panels h3 \u{7b} margin: .5rem 0; font-size: 1rem; font-weight: 600; \u{7d}\npre \u{7b} min-height: 8rem; margin: 0; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font: .9rem/1.5 var(--code-font); \u{7d}\n.visually-hidden \u{7b} position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; \u{7d}\n[hidden] \u{7b} display: none !important; \u{7d}\n\n@media (max-width: 64rem) \u{7b}\n  .workspace \u{7b} grid-template-columns: minmax(0, 1fr); \u{7d}\n  #source \u{7b} height: clamp(18rem, 56vh, 40rem); \u{7d}\n  .panels \u{7b} min-height: 14rem; \u{7d}\n\u{7d}\n\n@media (max-width: 40rem) \u{7b}\n  main, .page-header \u{7b} margin: .75rem auto; padding: 0 .75rem; \u{7d}\n  .editor-pane .pane-heading \u{7b} display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .5rem; \u{7d}\n  .editor-pane .pane-heading h2 \u{7b} grid-column: 1 / -1; margin: 0; \u{7d}\n  .example-feed \u{7b} grid-column: 1 / -1; grid-template-columns: auto minmax(0, 1fr); width: 100%; \u{7d}\n  .example-feed select \u{7b} width: 100%; \u{7d}\n  .example-feed-help \u{7b} grid-column: 2; \u{7d}\n  .actions \u{7b} align-items: flex-start; flex-direction: column; gap: .25rem; \u{7d}\n  #run-button \u{7b} width: 100%; \u{7d}\n  .tabs button \u{7b} padding-inline: .55rem; \u{7d}\n  .panels \u{7b} padding-inline: .35rem; \u{7d}\n\u{7d}\n" }
