{ id: "responsive", name: "Responsive layout", css: "main, .page-header { max-width: var(--page-width); margin: 1rem auto; padding: 0 1rem; }\n.workspace { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .9fr); gap: 1rem; align-items: start; }\n.editor-pane, .output-pane { min-width: 0; }\n.pane-heading { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; min-height: 2.5rem; }\n.pane-heading h2 { margin: 0 auto 0 0; font-size: 1.15rem; font-weight: 400; }\n.example-feed { display: grid; grid-template-columns: auto minmax(10rem, 16rem); align-items: center; gap: .1rem .5rem; min-width: 0; }\n.example-feed label { white-space: nowrap; }\n.example-feed select { min-width: 0; max-width: 100%; }\n.example-feed-help { grid-column: 2; margin: 0; color: var(--muted); font-size: .75rem; line-height: 1.25; }\n#source { display: block; width: 100%; height: clamp(20rem, 68vh, 52rem); min-height: 20rem; padding: .65rem; border: 1px solid var(--border); border-radius: 0; background: var(--background); font: .9rem/1.5 var(--code-font); resize: vertical; tab-size: 4; }\n.actions { display: flex; align-items: center; gap: .75rem; margin-top: .4rem; }\n#run-button { min-height: 2.25rem; padding: .2rem .8rem; }\n#editor-status, .output-status { color: var(--muted); font-size: .875rem; margin: .35rem 0; }\n.tabs { display: flex; gap: .25rem; overflow-x: auto; border-bottom: 1px solid var(--border); margin-top: .5rem; }\n.tabs button { flex: 0 0 auto; min-height: 2.5rem; padding: .3rem .7rem; border: 0; border-bottom: 2px solid transparent; background: transparent; }\n.panels { min-height: clamp(12rem, 32vh, 20rem); padding: .25rem .5rem; border: 1px solid var(--border); border-top: 0; }\n.panels h3 { margin: .5rem 0; font-size: 1rem; font-weight: 600; }\npre { min-height: 8rem; margin: 0; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; font: .9rem/1.5 var(--code-font); }\n\n@media (max-width: 64rem) {\n  .workspace { grid-template-columns: minmax(0, 1fr); }\n  #source { height: clamp(18rem, 56vh, 40rem); }\n  .panels { min-height: 14rem; }\n}\n\n@media (max-width: 40rem) {\n  main, .page-header { margin: .75rem auto; padding: 0 .75rem; }\n  .editor-pane .pane-heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .5rem; }\n  .editor-pane .pane-heading h2 { grid-column: 1 / -1; margin: 0; }\n  .example-feed { grid-column: 1 / -1; grid-template-columns: auto minmax(0, 1fr); width: 100%; }\n  .example-feed select { width: 100%; }\n  .example-feed-help { grid-column: 2; }\n  .actions { align-items: flex-start; flex-direction: column; gap: .25rem; }\n  #run-button { width: 100%; }\n  .tabs button { padding-inline: .55rem; }\n  .panels { padding-inline: .35rem; }\n}\n" }
