{ id: "wiki-basic", name: "Wiki basic", css: ":root \u{7b}\n  color-scheme: light;\n  --page-width: 120rem;\n  --text: #202122;\n  --background: #fff;\n  --surface: #f8f9fa;\n  --border: #a2a9b1;\n  --muted: #54595d;\n  --link: #0645ad;\n  --visited: #0b0080;\n  --code-font: ui-monospace, SFMono-Regular, Consolas, monospace;\n  color: var(--text);\n  background: var(--background);\n  font: 1rem/1.5 Georgia, \"Times New Roman\", serif;\n\u{7d}\n" }
