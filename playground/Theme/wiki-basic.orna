{ id: "wiki-basic", name: "Wiki basic", css: ":root {\n  color-scheme: light;\n  --page-width: 120rem;\n  --text: #202122;\n  --background: #fff;\n  --surface: #f8f9fa;\n  --border: #a2a9b1;\n  --muted: #54595d;\n  --link: #0645ad;\n  --visited: #0b0080;\n  --code-font: ui-monospace, SFMono-Regular, Consolas, monospace;\n  color: var(--text);\n  background: var(--background);\n  font: 1rem/1.5 Georgia, \"Times New Roman\", serif;\n}\n\n* { box-sizing: border-box; }\nbody { margin: 0; color: var(--text); background: var(--background); }\na { color: var(--link); }\na:visited { color: var(--visited); }\nbutton, select, textarea { color: inherit; font: inherit; }\nbutton { cursor: pointer; }\nbutton:disabled, select:disabled { cursor: default; }\n.page-header { border-bottom: 1px solid var(--border); }\n.page-header h1 { margin: 0; font-size: 1.6rem; font-weight: 400; }\n.page-header p { margin: .25rem 0 .75rem; }\n.panels { background: var(--surface); }\n.tabs button[aria-selected=\"true\"] { border-bottom-color: var(--link); color: var(--link); }\n.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }\n[hidden] { display: none !important; }\n" }
