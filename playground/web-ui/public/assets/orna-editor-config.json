{
  "language": { "id": "orna", "extensions": [".orna"], "aliases": ["Orna", "orna"] },
  "languageConfiguration": {
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ]
}
,
  "monarchLanguage": {
    "defaultToken": "",
    "tokenPostfix": ".orna",
    "keywords": ["as", "assert", "base", "break", "case", "continue", "dim", "else", "enum", "false", "fn", "for", "if", "impl", "in", "let", "loop", "null", "offset", "affine", "protocol", "pub", "return", "self", "static", "table", "true", "type", "unit", "use", "while"],
    "operators": ["..=", "=>", "==", "!=", "<=", ">=", "??", "|?", "&&", "||", "+=", "-=", "*=", "/=", "..", "|", "!", "=", "<", ">", "+", "-", "*", "/", "%", "^", "?"],
    "tokenizer": {
      "root": [
        ["\\s+", "white"],
        ["//.*$", "comment"],
        ["/\\*", { "token": "comment", "next": "@comment" }],
        ["\"", { "token": "string.quote", "next": "@string" }],
        ["\\b(?:continue|protocol|assert|offset|affine|return|static|break|false|table|while|base|case|else|enum|impl|loop|null|self|true|type|unit|dim|for|let|pub|use|as|fn|if|in)\\b", "keyword"],
        ["(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]*)?(?:Z|[+-][0-9]{2}:[0-9]{2})|[0-9]{4}-[0-9]{2}-[0-9]{2}|0x[0-9A-Fa-f_]*|0b[01_]*|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]*)?f?)", "number"],
        [{ "pattern": "[\\p{L}_$][\\p{L}\\p{N}_$]*(?=\\s*\\()", "flags": "u" }, "function"],
        [{ "pattern": "[\\p{L}_$][\\p{L}\\p{N}_$]*", "flags": "u" }, "identifier"],
        ["(?:\\.\\.=|=>|==|!=|<=|>=|\\?\\?|\\|\\?|&&|\\|\\||\\+=|-=|\\*=|/=|\\.\\.|\\||!|=|<|>|\\+|-|\\*|/|%|\\^|\\?)", "operator"],
        ["(?:\\{|\\}|\\(|\\)|\\[|\\]|,|;|:|\\.)", "delimiter"]
      ],
      "comment": [
        ["[^*/]+", "comment"],
        ["\\*/", { "token": "comment", "next": "@pop" }],
        ["[*/]", "comment"]
      ],
      "string": [
        ["[^\\\\\"]+", "string"],
        ["\\\\.", "string.escape"],
        ["\"", { "token": "string.quote", "next": "@pop" }]
      ]
    }
  },
  "editorOptions": { "theme": "vs", "fontSize": 14, "tabSize": 4, "insertSpaces": true, "lineNumbers": "on", "minimap": { "enabled": false }, "scrollBeyondLastLine": false, "wordWrap": "off" }
}
