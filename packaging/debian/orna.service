[Unit]
Description=OrnaDB embedded database service
After=local-fs.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
User=orna
Group=orna
ExecStart=/usr/bin/orna server run
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=90s
SendSIGKILL=yes
Restart=on-failure
RestartSec=5s
RuntimeDirectory=orna/default
RuntimeDirectoryMode=0711
UMask=0077

[Install]
WantedBy=multi-user.target
