#!/usr/bin/make -f

SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c
.DEFAULT_GOAL := package
.NOTPARALLEL:

REPOSITORY_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
CHANGELOG := $(REPOSITORY_ROOT)/packaging/debian/changelog
TARGET_ROOT ?= $(REPOSITORY_ROOT)/target/debian-package
PAYLOAD_ROOT := $(TARGET_ROOT)/payload
PACKAGE_ROOT := $(TARGET_ROOT)/root
BUILD_ONE := $(TARGET_ROOT)/build-one
BUILD_TWO := $(TARGET_ROOT)/build-two
SOURCE_DATE_EPOCH := 1778528675
RUST_PATH_REMAP := /usr/src/orna
RUST_LINK_FLAGS := -C link-arg=-Wl,--build-id=none
RUSTFLAGS := --remap-path-prefix=/workspace=$(RUST_PATH_REMAP) $(RUST_LINK_FLAGS)
ENGINE_IMAGE := orna-postgresql-engine:debian12-amd64-1

.PHONY: development-package release-package validate-development-identity \
	build assemble-package verify clean package

package:
	@printf '%s\n' '[debian] error: select development-package or release-package explicitly' >&2; \
	exit 1

development-package: validate-development-identity build assemble-package verify

release-package:
	@printf '%s\n' '[debian] error: release-package is closed until the accepted 1.0 product baseline permits 1.0.0-1' >&2; \
	exit 1

validate-development-identity:
	+@command -v dpkg-parsechangelog >/dev/null || { \
		printf '%s\n' '[debian] error: dpkg-parsechangelog is required to read the package identity' >&2; exit 1; }; \
	[[ -f "$(CHANGELOG)" && ! -L "$(CHANGELOG)" ]] || { \
		printf '%s\n' '[debian] error: changelog is absent or symbolic' >&2; exit 1; }; \
	source="$$(dpkg-parsechangelog -l"$(CHANGELOG)" -S Source)"; \
	version="$$(dpkg-parsechangelog -l"$(CHANGELOG)" -S Version)"; \
	suite="$$(dpkg-parsechangelog -l"$(CHANGELOG)" -S Distribution)"; \
	upstream_version="$${version%-*}"; debian_revision="$${version##*-}"; \
	architecture="$$(dpkg --print-architecture)"; \
	workspace_version="$$(sed -n '/^\[workspace.package\]/,/^\[/ { s/^version = "\([^"\]*\)"/\1/p }' "$(REPOSITORY_ROOT)/Cargo.toml")"; \
	[[ "$${source}" == 'orna' && "$${version}" == '0.1.0-1' \
		&& "$${upstream_version}" == '0.1.0' && "$${debian_revision}" == '1' \
		&& "$${suite}" == 'UNRELEASED' && "$${architecture}" == 'amd64' \
		&& "$${workspace_version}" == "$${upstream_version}" ]] || { \
		printf '%s\n' '[debian] error: development-package requires orna (0.1.0-1) UNRELEASED' >&2; exit 1; }; \
	grep -Fx 'Package: @PACKAGE@' "$(REPOSITORY_ROOT)/packaging/debian/control" >/dev/null \
		&& grep -Fx 'Version: @VERSION@' "$(REPOSITORY_ROOT)/packaging/debian/control" >/dev/null \
		&& grep -Fx 'Architecture: @ARCHITECTURE@' "$(REPOSITORY_ROOT)/packaging/debian/control" >/dev/null || { \
		printf '%s\n' '[debian] error: control identity placeholders are not exact' >&2; exit 1; }

build:
	@target_name='$(notdir $(TARGET_ROOT))'; \
	[[ "$(dir $(TARGET_ROOT))" == "$(REPOSITORY_ROOT)/target/" \
		&& "$${target_name}" =~ ^[a-z0-9][a-z0-9.-]*$$ ]] || { \
		printf '%s\n' '[debian] error: TARGET_ROOT must be one safe direct child of the repository target directory' >&2; exit 1; }; \
	rm -rf -- "$(TARGET_ROOT)"; \
	mkdir -m 0700 -p -- "$(TARGET_ROOT)"; \
	for build_root in "$(BUILD_ONE)" "$(BUILD_TWO)"; do \
		make -C "$(REPOSITORY_ROOT)/postgresql" manifest \
			TARGET_ROOT="$${build_root}/postgresql"; \
		mkdir -m 0700 -p -- "$${build_root}/cargo-home" "$${build_root}/cargo"; \
		docker run --rm --network=none --platform linux/amd64 \
			--user "$$(id -u):$$(id -g)" \
			--volume "$(REPOSITORY_ROOT):/workspace:ro" \
			--volume "$${build_root}/cargo:/target:rw" \
			--volume "$${build_root}/cargo-home:/cargo-home:rw" \
			--volume "$${HOME}/.cargo/registry:/cargo-home/registry:ro" \
			--volume "$${build_root}/postgresql/output:/engine:ro" \
			--workdir /workspace \
			"$(ENGINE_IMAGE)" \
			env -i PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
				HOME=/cargo-home CARGO_HOME=/cargo-home \
				CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=/target \
				LANG=C.UTF-8 LC_ALL=C.UTF-8 \
				ORNA_POSTGRES_ENGINE_OUTPUT=/engine \
				RUSTFLAGS='$(RUSTFLAGS)' \
				SOURCE_DATE_EPOCH='$(SOURCE_DATE_EPOCH)' TZ=UTC0 \
				cargo build --frozen --offline --release \
					--manifest-path /workspace/Cargo.toml \
					--package orna-server --bin orna; \
		docker run --rm --network=none --platform linux/amd64 \
			--user "$$(id -u):$$(id -g)" \
			--volume "$${build_root}/cargo:/target:rw" \
			"$(ENGINE_IMAGE)" \
			strip --strip-debug -- /target/release/orna; \
	done; \
	cmp -- "$(BUILD_ONE)/cargo/release/orna" "$(BUILD_TWO)/cargo/release/orna"; \
	engine_one="$(BUILD_ONE)/postgresql/output/embedded-engine-manifest.json"; \
	engine_two="$(BUILD_TWO)/postgresql/output/embedded-engine-manifest.json"; \
	licence_one="$(BUILD_ONE)/postgresql/output/POSTGRESQL-LICENSE"; \
	licence_two="$(BUILD_TWO)/postgresql/output/POSTGRESQL-LICENSE"; \
	cmp -- "$${engine_one}" "$${engine_two}"; \
	cmp -- "$${licence_one}" "$${licence_two}"; \
	install -D -m 0755 -- "$(BUILD_ONE)/cargo/release/orna" "$(PAYLOAD_ROOT)/usr/bin/orna"; \
	install -D -m 0644 -- "$${engine_one}" \
		"$(PAYLOAD_ROOT)/usr/share/orna/embedded-engine-manifest.json"; \
	install -D -m 0644 -- "$${licence_one}" \
		"$(PAYLOAD_ROOT)/usr/share/doc/orna/POSTGRESQL-LICENSE"; \
	install -D -m 0644 -- "$(REPOSITORY_ROOT)/packaging/debian/orna.service" \
		"$(PAYLOAD_ROOT)/usr/lib/systemd/system/orna.service"; \
	install -D -m 0644 -- "$(REPOSITORY_ROOT)/packaging/debian/orna.sysusers" \
		"$(PAYLOAD_ROOT)/usr/lib/sysusers.d/orna.conf"; \
	install -D -m 0644 -- "$(REPOSITORY_ROOT)/packaging/debian/orna.tmpfiles" \
		"$(PAYLOAD_ROOT)/usr/lib/tmpfiles.d/orna.conf"; \
	install -D -m 0644 -- "$(REPOSITORY_ROOT)/packaging/debian/default.toml" \
		"$(PAYLOAD_ROOT)/etc/orna/instances/default.toml"; \
	rustc_version="$$(docker run --rm --network=none "$(ENGINE_IMAGE)" rustc --version)"; \
	cargo_version="$$(docker run --rm --network=none "$(ENGINE_IMAGE)" cargo --version)"; \
	image_digest="$$(docker image inspect "$(ENGINE_IMAGE)" --format '{{.Id}}')"; \
	lock_sha="$$(sha256sum "$(REPOSITORY_ROOT)/Cargo.lock" | awk '{ print $$1 }')"; \
	engine_sha="$$(sha256sum "$${engine_one}" | awk '{ print $$1 }')"; \
	executable_sha="$$(sha256sum "$(PAYLOAD_ROOT)/usr/bin/orna" | awk '{ print $$1 }')"; \
	install -D -m 0644 /dev/null \
		"$(PAYLOAD_ROOT)/usr/share/orna/distribution-manifest.toml"; \
	printf '%s\n' \
		'format = 1' \
		"rustc = \"$${rustc_version}\"" \
		"cargo = \"$${cargo_version}\"" \
		"builder_image = \"$${image_digest}\"" \
		"cargo_lock_sha256 = \"$${lock_sha}\"" \
		'rust_path_remap = "<repository>=$(RUST_PATH_REMAP)"' \
		'rust_link_flags = "$(RUST_LINK_FLAGS)"' \
		"embedded_engine_manifest_sha256 = \"$${engine_sha}\"" \
		'accepted_predecessor_engines = []' \
		'supported_forward_edges = []' \
		"executable_sha256 = \"$${executable_sha}\"" \
		>"$(PAYLOAD_ROOT)/usr/share/orna/distribution-manifest.toml"; \
	find "$(PAYLOAD_ROOT)" -exec touch -h -d '@$(SOURCE_DATE_EPOCH)' -- {} +

assemble-package:
	@source="$$(dpkg-parsechangelog -l"$(CHANGELOG)" -S Source)"; \
	version="$$(dpkg-parsechangelog -l"$(CHANGELOG)" -S Version)"; \
	architecture="$$(dpkg --print-architecture)"; \
	package="$(TARGET_ROOT)/$${source}_$${version}_$${architecture}.deb"; \
	[[ "$${architecture}" == 'amd64' ]] || { \
		printf '%s\n' '[debian] error: Debian package assembly requires amd64' >&2; exit 1; }; \
	mkdir -m 0755 -p -- "$(PACKAGE_ROOT)/DEBIAN"; \
	sed -e "s/@PACKAGE@/$${source}/g" -e "s/@VERSION@/$${version}/g" \
		-e "s/@ARCHITECTURE@/$${architecture}/g" \
		"$(REPOSITORY_ROOT)/packaging/debian/control" >"$(PACKAGE_ROOT)/DEBIAN/control"; \
	! grep -q '@[A-Z][A-Z_]*@' "$(PACKAGE_ROOT)/DEBIAN/control" || { \
		printf '%s\n' '[debian] error: rendered control contains an identity placeholder' >&2; exit 1; }; \
	grep -Fx "Package: $${source}" "$(PACKAGE_ROOT)/DEBIAN/control" >/dev/null \
		&& grep -Fx "Version: $${version}" "$(PACKAGE_ROOT)/DEBIAN/control" >/dev/null \
		&& grep -Fx "Architecture: $${architecture}" "$(PACKAGE_ROOT)/DEBIAN/control" >/dev/null || { \
		printf '%s\n' '[debian] error: rendered control identity does not match the changelog' >&2; exit 1; }; \
	printf '%s\n' '/etc/orna/instances/default.toml' \
		>"$(PACKAGE_ROOT)/DEBIAN/conffiles"; \
	for script in preinst prerm postinst; do \
		install -m 0755 -- "$(REPOSITORY_ROOT)/packaging/debian/$${script}" \
			"$(PACKAGE_ROOT)/DEBIAN/$${script}"; \
	done; \
	while IFS= read -r relative; do \
		[[ -n "$${relative}" && "$${relative}" != \#* ]] || continue; \
		source="$(PAYLOAD_ROOT)/$${relative}"; destination="$(PACKAGE_ROOT)/$${relative}"; \
		[[ -f "$${source}" && ! -L "$${source}" ]] || { \
			printf '%s\n' "[debian] error: missing payload input: $${relative}" >&2; exit 1; }; \
		install -D -m "$$(stat -c '%a' "$${source}")" -- "$${source}" "$${destination}"; \
	done <"$(REPOSITORY_ROOT)/packaging/debian/orna.install"; \
	find "$(PACKAGE_ROOT)" -exec touch -h -d '@$(SOURCE_DATE_EPOCH)' -- {} +; \
	SOURCE_DATE_EPOCH='$(SOURCE_DATE_EPOCH)' dpkg-deb --root-owner-group \
		--build "$(PACKAGE_ROOT)" "$${package}"

verify:
	@source="$$(dpkg-parsechangelog -l"$(CHANGELOG)" -S Source)"; \
	version="$$(dpkg-parsechangelog -l"$(CHANGELOG)" -S Version)"; \
	architecture="$$(dpkg --print-architecture)"; \
	package="$(TARGET_ROOT)/$${source}_$${version}_$${architecture}.deb"; \
	[[ -f "$${package}" ]] || { printf '%s\n' '[debian] error: package is absent' >&2; exit 1; }; \
	mapfile -t control_files < <(find "$(PACKAGE_ROOT)/DEBIAN" -maxdepth 1 \
		-type f -printf '%f\n' | LC_ALL=C sort); \
	[[ "$${control_files[*]}" == 'conffiles control postinst preinst prerm' ]] || { \
		printf '%s\n' '[debian] error: package control inventory is not exact' >&2; exit 1; }; \
	mapfile -t control_scripts < <(find "$(PACKAGE_ROOT)/DEBIAN" -maxdepth 1 \
		-type f -perm /111 -printf '%f\n' | LC_ALL=C sort); \
	[[ "$${control_scripts[*]}" == 'postinst preinst prerm' ]] || { \
		printf '%s\n' '[debian] error: package control-script inventory is not exact' >&2; exit 1; }; \
	mapfile -t installed < <(find "$(PACKAGE_ROOT)" -type f \
		! -path '*/DEBIAN/*' -printf '%P\n' | LC_ALL=C sort); \
	mapfile -t expected < <(sed '/^$$/d; /^#/d' \
		"$(REPOSITORY_ROOT)/packaging/debian/orna.install" | LC_ALL=C sort); \
	[[ "$${installed[*]}" == "$${expected[*]}" ]] || { \
		printf '%s\n' '[debian] error: package payload inventory is not exact' >&2; exit 1; }; \
	mapfile -t executable_payload < <(find "$(PACKAGE_ROOT)" -type f -perm /111 \
		! -path '*/DEBIAN/*' -printf '%P\n'); \
	[[ "$${#executable_payload[@]}" -eq 1 \
		&& "$${executable_payload[0]}" == 'usr/bin/orna' ]] || { \
		printf '%s\n' '[debian] error: product payload is not one executable' >&2; exit 1; }; \
	[[ -z "$$(find "$(PACKAGE_ROOT)" -type f \
		\( -name '*.so' -o -name '*.so.*' -o -name '*.a' -o -name '*.o' \
		-o -name postgres -o -name initdb -o -name psql -o -name pg_upgrade \) -print -quit)" ]] || { \
		printf '%s\n' '[debian] error: PostgreSQL runtime artefact entered the package' >&2; exit 1; }; \
	readelf --dynamic "$(PACKAGE_ROOT)/usr/bin/orna" >"$(TARGET_ROOT)/orna.dynamic"; \
	! grep -Eqi 'NEEDED.*(libpq|libz|postgres)' "$(TARGET_ROOT)/orna.dynamic" || { \
		printf '%s\n' '[debian] error: Orna has a dynamic PostgreSQL dependency' >&2; exit 1; }; \
	printf '%s\n' "[debian] verified one-executable package $${package}"

clean:
	@target_name='$(notdir $(TARGET_ROOT))'; \
	[[ "$(dir $(TARGET_ROOT))" == "$(REPOSITORY_ROOT)/target/" \
		&& "$${target_name}" =~ ^[a-z0-9][a-z0-9.-]*$$ ]] || exit 1
	@rm -rf -- "$(TARGET_ROOT)"
