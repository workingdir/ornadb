+
+int
+orna_postgres18_initdb_entry(const char *data_directory)
+{
+	char	   *argv[] = {
+		"/usr/bin/orna", "--pgdata", (char *) data_directory,
+		"--username=orna_kernel", "--encoding=UTF8", "--locale=C",
+		"--locale-provider=builtin", "--builtin-locale=PG_UNICODE_FAST",
+		"--data-checksums", "--auth-local=peer", "--auth-host=reject",
+		"--no-instructions", NULL
+	};
+
+	if (data_directory == NULL || data_directory[0] != '/' ||
+		orna_postgres18_support_root() == NULL ||
+		orna_postgres18_install_exec_filter() != 0)
+		return 1;
+	optind = 1;
+#ifdef HAVE_INT_OPTRESET
+	optreset = 1;
+#endif
+	return orna_postgres18_initdb_main(lengthof(argv) - 1, argv);
+}
+
+#ifndef ORNA_EMBEDDED_INITDB_ENTRY
+int
+main(int argc, char *argv[])
+{
+	return orna_postgres18_initdb_main(argc, argv);
+}
+#endif
+
+/*
+ * libpq's static members use its public encoding names, while initdb links
+ * libpgcommon.a's private encoding implementation.  Keep that tiny public
+ * closure inside the initialiser relocatable before its symbol-prefix pass.
+ */
+#undef pg_char_to_encoding
+#undef pg_encoding_to_char
+#undef pg_valid_server_encoding_id
+int
+pg_char_to_encoding(const char *name)
+{
+	return pg_char_to_encoding_private(name);
+}
+
+const char *
+pg_encoding_to_char(int encoding)
+{
+	return pg_encoding_to_char_private(encoding);
+}
+
+int
+pg_valid_server_encoding_id(int encoding)
+{
+	return pg_valid_server_encoding_id_private(encoding);
