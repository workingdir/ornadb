diff -U0 -Nr a/src/backend/Makefile b/src/backend/Makefile
--- a/src/backend/Makefile	2026-05-11 20:44:35.000000000 +0100
+++ b/src/backend/Makefile	2026-08-11 18:59:06.632774310 +0100
@@ -59,0 +60,90 @@
+# Build deterministic flattened backend and initialiser link inputs.  PostgreSQL
+# normally puts server archives in OBJS; flatten them with whole-archive before
+# ar so neither final archive contains a nested archive member.
+ORNA_EMBEDDED_ARCHIVE = liborna_postgres18_backend.a
+ORNA_EMBEDDED_RELOCATABLE_OBJECT = liborna_postgres18_backend.o
+ORNA_EMBEDDED_ENTRY_OBJECT = main/orna_embedded_entry.o
+ORNA_EMBEDDED_RUNTIME_OBJECT = main/orna_embedded.o
+ORNA_EMBEDDED_BACKEND_OBJECTS = \
+	$(filter %.o,$(filter-out main/main.o,$(call expand_subsys,$(OBJS)))) \
+	$(ORNA_EMBEDDED_ENTRY_OBJECT) \
+	$(ORNA_EMBEDDED_RUNTIME_OBJECT)
+ORNA_EMBEDDED_SERVER_ARCHIVES = \
+	$(top_builddir)/src/common/libpgcommon_srv.a \
+	$(top_builddir)/src/port/libpgport_srv.a
+ORNA_EMBEDDED_ZLIB_ARCHIVE ?= /build/zlib/lib/libz.a
+ORNA_EMBEDDED_STATIC_ARCHIVES = $(ORNA_EMBEDDED_SERVER_ARCHIVES) $(ORNA_EMBEDDED_ZLIB_ARCHIVE)
+NM := $(if $(NM),$(NM),nm)
+OBJCOPY := $(if $(OBJCOPY),$(OBJCOPY),objcopy)
+
+ORNA_EMBEDDED_INITDB_ARCHIVE = $(top_builddir)/src/bin/initdb/liborna_postgres18_initdb.a
+ORNA_EMBEDDED_INITDB_RELOCATABLE_OBJECT = $(top_builddir)/src/bin/initdb/liborna_postgres18_initdb.relocatable.o
+ORNA_EMBEDDED_INITDB_OBJECT = $(top_builddir)/src/bin/initdb/liborna_postgres18_initdb.o
+ORNA_EMBEDDED_INITDB_RENAME_MAP = $(top_builddir)/src/bin/initdb/initdb-redefine-symbols.txt
+ORNA_EMBEDDED_INITDB_DEFINED_SYMBOLS = $(top_builddir)/src/bin/initdb/initdb-defined-symbols.txt
+ORNA_EMBEDDED_INITDB_UNDEFINED_SYMBOLS = $(top_builddir)/src/bin/initdb/initdb-undefined-symbols.txt
+ORNA_EMBEDDED_INITDB_OBJECTS = \
+	$(top_builddir)/src/bin/initdb/orna_embedded_initdb.o \
+	$(top_builddir)/src/bin/initdb/findtimezone.o \
+	$(top_builddir)/src/bin/initdb/localtime.o
+ORNA_EMBEDDED_INITDB_ARCHIVES = \
+	$(top_builddir)/src/fe_utils/libpgfeutils.a \
+	$(top_builddir)/src/interfaces/libpq/libpq.a \
+	$(top_builddir)/src/common/libpgcommon.a \
+	$(top_builddir)/src/port/libpgport.a \
+	$(ORNA_EMBEDDED_ZLIB_ARCHIVE)
+
+$(ORNA_EMBEDDED_ENTRY_OBJECT): $(srcdir)/main/main.c generated-headers
+	$(CC) $(CFLAGS) $(CPPFLAGS) -DORNA_EMBEDDED_ENTRY -c $(srcdir)/main/main.c -o $@
+
+$(ORNA_EMBEDDED_RUNTIME_OBJECT): $(srcdir)/main/orna_embedded.c generated-headers
+	$(CC) $(CFLAGS) $(CPPFLAGS) -c $(srcdir)/main/orna_embedded.c -o $@
+
+$(ORNA_EMBEDDED_RELOCATABLE_OBJECT): submake-libpgport generated-headers $(OBJS) \
+	$(ORNA_EMBEDDED_ENTRY_OBJECT) \
+	$(ORNA_EMBEDDED_RUNTIME_OBJECT)
+	$(CC) $(CFLAGS) $(LDFLAGS) -r -o $@ $(ORNA_EMBEDDED_BACKEND_OBJECTS) \
+		-Wl,--whole-archive $(ORNA_EMBEDDED_STATIC_ARCHIVES) -Wl,--no-whole-archive
+
+$(ORNA_EMBEDDED_ARCHIVE): $(ORNA_EMBEDDED_RELOCATABLE_OBJECT)
+	$(AR) rcD $@ $<
+	$(RANLIB) -D $@
+
+$(ORNA_EMBEDDED_INITDB_RELOCATABLE_OBJECT): generated-headers submake-libpgport
+	$(MAKE) -C $(top_builddir)/src/bin/initdb orna_embedded_initdb.o findtimezone.o localtime.o
+	$(MAKE) -C $(top_builddir)/src/common libpgcommon.a
+	$(MAKE) -C $(top_builddir)/src/port libpgport.a
+	$(MAKE) -C $(top_builddir)/src/interfaces/libpq libpq.a
+	$(MAKE) -C $(top_builddir)/src/fe_utils libpgfeutils.a
+	$(CC) $(CFLAGS) $(LDFLAGS) -r -o $@ $(ORNA_EMBEDDED_INITDB_OBJECTS) \
+		-Wl,--whole-archive $(ORNA_EMBEDDED_INITDB_ARCHIVES) -Wl,--no-whole-archive
+
+$(ORNA_EMBEDDED_INITDB_OBJECT): $(ORNA_EMBEDDED_INITDB_RELOCATABLE_OBJECT)
+	$(NM) --format=posix --extern-only --defined-only $< | \
+		awk -v entry="orna_postgres18_initdb_entry" \
+			-v prefix="orna_postgres18_initdb_" \
+			'$$2 ~ /^[A-Za-z]$$/ && $$1 != entry { print $$1 " " prefix $$1 }' | \
+		LC_ALL=C sort > $(ORNA_EMBEDDED_INITDB_RENAME_MAP)
+	$(OBJCOPY) --redefine-syms=$(ORNA_EMBEDDED_INITDB_RENAME_MAP) $< $@
+	$(NM) --format=posix --extern-only --defined-only $@ | LC_ALL=C sort > $(ORNA_EMBEDDED_INITDB_DEFINED_SYMBOLS)
+	$(NM) --format=posix --extern-only --undefined-only $@ | LC_ALL=C sort > $(ORNA_EMBEDDED_INITDB_UNDEFINED_SYMBOLS)
+
+$(ORNA_EMBEDDED_INITDB_ARCHIVE): $(ORNA_EMBEDDED_INITDB_OBJECT)
+	$(AR) rcD $@ $<
+	$(RANLIB) -D $@
+
+.PHONY: orna_postgres18_entry_probe
+orna_postgres18_entry_probe: $(ORNA_EMBEDDED_ARCHIVE)
+	test -n "$(ORNA_EMBEDDED_PROBE_SOURCE)" -a -n "$(ORNA_EMBEDDED_PROBE_OUTPUT)"
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $(ORNA_EMBEDDED_PROBE_OUTPUT) \
+		$(ORNA_EMBEDDED_PROBE_SOURCE) $(ORNA_EMBEDDED_ARCHIVE) $(LIBS)
+
+.PHONY: orna_postgres18_lifecycle_archives
+orna_postgres18_lifecycle_archives: $(ORNA_EMBEDDED_ARCHIVE) $(ORNA_EMBEDDED_INITDB_ARCHIVE)
+
+.PHONY: orna_postgres18_lifecycle_probe
+orna_postgres18_lifecycle_probe: orna_postgres18_lifecycle_archives
+	test -n "$(ORNA_EMBEDDED_LIFECYCLE_PROBE_SOURCE)" -a -n "$(ORNA_EMBEDDED_LIFECYCLE_PROBE_OUTPUT)"
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $(ORNA_EMBEDDED_LIFECYCLE_PROBE_OUTPUT) \
+		$(ORNA_EMBEDDED_LIFECYCLE_PROBE_SOURCE) $(ORNA_EMBEDDED_INITDB_ARCHIVE) $(ORNA_EMBEDDED_ARCHIVE) $(LIBS)
+
