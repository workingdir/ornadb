---
import Brand from "./Brand.astro";
---

<header class="site-header">
    <div class="site-header__inner">
        <a class="site-header__brand" href="/" aria-label="OrnaDB frontpage">
            <Brand />
            <span class="site-header__expansion">Object-Relational Native Applications</span>
        </a>
        <nav class="site-header__nav" aria-label="Primary navigation">
            <a href="#model">Model</a>
            <a href="#use-cases">Use cases</a>
            <a href="#status">Status</a>
            <a href="/docs/">Docs</a>
            <a href="https://github.com/workingdir/ornadb">Source</a>
        </nav>
    </div>
</header>

<style>
    .site-header {
        position: relative;
        z-index: 10;
        border-bottom: 1px solid var(--colour-line);
        background: var(--colour-bg);
    }

    .site-header__inner {
        display: flex;
        width: min(100% - 2rem, var(--content-width));
        min-height: 4.5rem;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        margin-inline: auto;
    }

    .site-header__brand {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
    }

    .site-header__expansion {
        overflow: hidden;
        color: var(--colour-muted);
        font-family: var(--font-mono);
        font-size: 0.625rem;
        letter-spacing: 0.02em;
        line-height: 1.4;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .site-header__nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: clamp(0.75rem, 2vw, 1.5rem);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 500;
    }

    .site-header__nav a {
        padding-block: 0.35rem;
        text-decoration: none;
    }

    .site-header__nav a:hover {
        text-decoration: underline;
        text-decoration-thickness: 0.1em;
    }

    @media (max-width: 52rem) {
        .site-header__inner {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.75rem;
            padding-block: 1rem;
        }

        .site-header__nav {
            width: 100%;
            justify-content: flex-start;
            flex-wrap: wrap;
        }
    }

    @media (max-width: 34rem) {
        .site-header__expansion {
            display: none;
        }
    }
</style>
