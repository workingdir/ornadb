---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/home.css";

const heroSource = `CREATE TYPE tasks.task AS OBJECT (
    title      TEXT NOT NULL,
    assignee   REF people.person,
    due_at     TIMESTAMP,
    completed BOOL NOT NULL DEFAULT FALSE
);

CREATE SERVER FUNCTION tasks.overdue()
RETURNS TABLE (
    task   REF tasks.task,
    title  TEXT,
    due_at TIMESTAMP
)
AS
    SELECT REF(t), t.title, t.due_at
      FROM tasks.task t
     WHERE t.completed = FALSE
       AND t.due_at < sys.time.now();`;

const heroTerminal = `$ orna invoke tasks.overdue
TASK                  TITLE                 DUE_AT
@tasks.task/01K...    Review migration      2026-08-09 09:00
@tasks.task/01M...    Ship runtime probe    2026-08-10 14:30

$ orna invoke tasks.overdue --output json
[{"task":{"$ref":"orna://...","$type":"tasks.task"}, ...}]`;

const catalogueQuery = `SELECT
    qualified_name,
    domain,
    return_type
FROM sys.functions
ORDER BY qualified_name;`;

const referenceQuery = `SELECT
    c.person.name,
    c.organisation.name
FROM crm.contact c
WHERE c.person.email ILIKE '%@example.com';`;

const renameSource = `ALTER TYPE people.person
    RENAME FIELD email TO primary_email;

SELECT source_definition, source_span
FROM sys.definition_references
WHERE target_definition =
    OBJECT_ID('people.person.primary_email');`;

const clientSource = `CREATE CLIENT FUNCTION tasks.overdue_window()
RETURNS std.ui.UI
AS
    std.ui.window(
        title   => 'Overdue Tasks',
        content => std.ui.data_grid(
            source => std.data.resource(tasks.overdue)
        )
    );`;

const modelItems = [
    {
        term: "DATA",
        title: "Durable objects with typed identity",
        body: "Object types keep stable identity and can be linked with REF<T>. Familiar SQL remains the query language.",
        detail: "TypeId / FieldId / ObjectId / REF<T>",
    },
    {
        term: "FUNCTIONS",
        title: "One executable definition",
        body: "Queries, mutations, client programs, presenters, and gateways are functions with an explicit SERVER or CLIENT domain.",
        detail: "CREATE SERVER FUNCTION / CREATE CLIENT FUNCTION",
    },
    {
        term: "INVOCATIONS",
        title: "Programs start at a function call",
        body: "A running program is the graph rooted at an invocation, including nested calls, state, resources, results, and presentation.",
        detail: "orna invoke / sys.invoke / InvocationId",
    },
    {
        term: "RUNTIMES",
        title: "The client materialises the result",
        body: "The local client selects an installed TTY or graphical runtime after typed result and presenter negotiation.",
        detail: "std.terminal.Document / std.ui.UI / ByteStream",
    },
];

const useCases = [
    {
        name: "Database-native development tools",
        root: "studio.main()",
        description: "Build catalogue browsers, editors, result grids, migration tools, and DBA surfaces against public system functions.",
    },
    {
        name: "Typed command-line automation",
        root: "reports.month_end()",
        description: "Invoke the same SERVER function for a human terminal view or require JSON, CSV, or another registered output for a script.",
    },
    {
        name: "Native client programs",
        root: "tasks.overdue_window()",
        description: "Return std.ui.UI from a sandboxed CLIENT function and let an explicitly installed local runtime materialise it.",
    },
    {
        name: "Explicit protocol gateways",
        root: "std.mcp.call_tool()",
        description: "Reflect function signatures through versioned exposure records, convert typed arguments, and dispatch through sys.invoke.",
    },
];

const implementedWork = [
    "Rust parser, compiler, catalogue, artefact, client, server, and PostgreSQL kernel crates.",
    "Accepted SERVER query and mutation slices, including select, insert, update, and delete constraints.",
    "Stable catalogue value-type and binding identities with source and revision checks.",
    "An accepted one-executable embedded PostgreSQL boundary, with the native entry proof in progress.",
];

const roadmapWork = [
    "Complete the public offline orna source check path and exact diagnostics.",
    "Add public invocation, authentication, authorisation, and typed protocol slices.",
    "Build the CLIENT VM, resources, state, presenters, and orna-runtime-tty.",
    "Implement std.ui.UI, one graphical runtime, the Inspector, and then Studio.",
];
---

<BaseLayout
    title="OrnaDB - Programs, data, and tools in one object-relational system"
    description="OrnaDB is an object-relational database designed to store and run the programs which work with its data. Read the language, invocation, runtime, and security model."
>
    <SiteHeader />

    <main id="main-content">
        <section class="hero" aria-labelledby="hero-title">
            <div class="shell hero__layout">
                <div class="hero__copy">
                    <p class="development-status">
                        <span class="development-status__marker" aria-hidden="true"></span>
                        <strong>Under active development</strong>
                        <span>Rust + embedded PostgreSQL</span>
                    </p>
                    <h1 id="hero-title">The database stores programs, not only their data.</h1>
                    <p class="hero__summary">
                        OrnaDB is an object-relational database designed to store typed objects, function source,
                        revisions, permissions, program state, and the tools used to inspect them.
                    </p>
                    <div class="hero__actions">
                        <a class="button button--light" href="/docs/">Read the technical guide</a>
                        <a class="text-link text-link--on-brand" href="https://github.com/workingdir/ornadb">
                            Browse the source
                            <span aria-hidden="true">-&gt;</span>
                        </a>
                    </div>
                    <ul class="hero__facts" aria-label="Project facts">
                        <li>SQL-family language</li>
                        <li>Apache-2.0</li>
                        <li>Static technical docs</li>
                    </ul>
                </div>

                <figure class="source-window source-window--hero">
                    <figcaption>
                        <span>tasks.orna</span>
                        <span>LOCKED MODEL / ILLUSTRATIVE SYNTAX</span>
                    </figcaption>
                    <pre><code>{heroSource}</code></pre>
                    <div class="source-window__terminal">
                        <span class="source-window__terminal-label">invocation</span>
                        <pre><code>{heroTerminal}</code></pre>
                    </div>
                </figure>
            </div>
        </section>

        <section class="section section--model" id="model" aria-labelledby="model-title">
            <div class="shell">
                <div class="section-heading section-heading--split">
                    <h2 id="model-title">A database-sized programming environment.</h2>
                    <p>
                        Types describe values and durable objects. Functions describe every executable definition.
                        Invocations create programs. The local client decides how root results reach the user.
                    </p>
                </div>

                <dl class="model-list">
                    {modelItems.map((item) => (
                        <div class="model-list__item">
                            <dt>
                                <span>{item.term}</span>
                                <strong>{item.title}</strong>
                            </dt>
                            <dd>
                                <p>{item.body}</p>
                                <code>{item.detail}</code>
                            </dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        <section class="section section--presentation" aria-labelledby="presentation-title">
            <div class="shell presentation-layout">
                <div class="presentation-copy">
                    <h2 id="presentation-title">One typed function. Different callers and surfaces.</h2>
                    <p>
                        A target returns its canonical typed value. For a root invocation, <code>sys.invoke</code> finds
                        a typed presenter path to a sink offered by the client. The target does not contain format or
                        toolkit branches.
                    </p>
                    <a class="text-link" href="/docs/invocation/">
                        Follow an invocation
                        <span aria-hidden="true">-&gt;</span>
                    </a>
                </div>

                <figure class="presentation-map" aria-label="A table result reaches terminal, JSON, and native UI surfaces">
                    <figcaption>Automatic presentation plan</figcaption>
                    <div class="presentation-map__source">
                        <span>SERVER FUNCTION</span>
                        <code>tasks.overdue()</code>
                        <strong>TABLE(task, title, due_at)</strong>
                    </div>
                    <div class="presentation-map__junction">
                        <span>canonical result</span>
                    </div>
                    <div class="presentation-map__branches">
                        <div class="presentation-map__branch">
                            <code>std.terminal.present_table</code>
                            <span>std.terminal.Document</span>
                            <strong>TTY</strong>
                        </div>
                        <div class="presentation-map__branch">
                            <code>std.json.encode</code>
                            <span>ByteStream(application/json)</span>
                            <strong>JSON</strong>
                        </div>
                        <div class="presentation-map__branch">
                            <code>std.ui.present_table</code>
                            <span>std.ui.UI</span>
                            <strong>NATIVE UI</strong>
                        </div>
                    </div>
                </figure>
            </div>
        </section>

        <section class="section section--features" aria-labelledby="features-title">
            <div class="shell">
                <div class="section-heading">
                    <h2 id="features-title">The executable system is queryable.</h2>
                    <p>
                        OrnaDB joins data, source, stable semantic identity, invocation plans, and security decisions in
                        one inspectable model.
                    </p>
                </div>

                <article class="feature-record">
                    <div class="feature-record__copy">
                        <span class="status-label">LOCKED</span>
                        <h3>Everything executable is a function.</h3>
                        <p>
                            A SQL query is a SERVER function. A native interface is a CLIENT function returning a typed
                            value. Presenters and gateways are functions plus ordinary metadata.
                        </p>
                    </div>
                    <figure class="source-window source-window--light">
                        <figcaption><span>query the program</span><span>sys.functions</span></figcaption>
                        <pre><code>{catalogueQuery}</code></pre>
                    </figure>
                </article>

                <article class="feature-record feature-record--reverse">
                    <div class="feature-record__copy">
                        <span class="status-label">LOCKED LOGICAL MODEL</span>
                        <h3>Object identity without leaving SQL.</h3>
                        <p>
                            <code>REF people.person</code> is a typed identity-bearing reference. Path dereference
                            resolves through stable field and type IDs instead of preserving fragile strings at runtime.
                        </p>
                    </div>
                    <figure class="source-window source-window--light">
                        <figcaption><span>typed path dereference</span><span>crm.contact</span></figcaption>
                        <pre><code>{referenceQuery}</code></pre>
                    </figure>
                </article>

                <article class="feature-record">
                    <div class="feature-record__copy">
                        <span class="status-label">ACCEPTED DIRECTION</span>
                        <h3>Referential integrity for software.</h3>
                        <p>
                            Human source stays reviewable. Resolved definitions use stable IDs. A semantic rename can
                            preserve references, source locations, and state identity across revisions.
                        </p>
                    </div>
                    <figure class="source-window source-window--light">
                        <figcaption><span>semantic rename</span><span>stable FieldId</span></figcaption>
                        <pre><code>{renameSource}</code></pre>
                    </figure>
                </article>
            </div>
        </section>

        <section class="section section--use-cases" id="use-cases" aria-labelledby="use-cases-title">
            <div class="shell">
                <div class="section-heading section-heading--split">
                    <h2 id="use-cases-title">Use the database as the system boundary.</h2>
                    <p>
                        The same function model can support direct commands, database-native tools, local native
                        interfaces, and explicit protocol projections.
                    </p>
                </div>

                <div class="use-case-list">
                    <div class="use-case-list__header" aria-hidden="true">
                        <span>Use case</span>
                        <span>Root</span>
                        <span>System role</span>
                    </div>
                    {useCases.map((useCase) => (
                        <article class="use-case-list__item">
                            <h3>{useCase.name}</h3>
                            <code>{useCase.root}</code>
                            <p>{useCase.description}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="section section--architecture" aria-labelledby="architecture-title">
            <div class="shell">
                <div class="section-heading section-heading--split">
                    <h2 id="architecture-title">Meaning stays in OrnaDB. Native code stays local.</h2>
                    <p>
                        The server owns data, transactions, source, revisions, security, and SERVER execution. The local
                        <code>orna</code> process owns CLIENT execution, capabilities, presentation, state coordination,
                        and runtime selection.
                    </p>
                </div>

                <figure class="architecture-map">
                    <figcaption>Process and trust boundary</figcaption>
                    <div class="architecture-map__node">
                        <span>CLIENT MACHINE</span>
                        <h3><code>orna</code></h3>
                        <ul>
                            <li>authenticated session</li>
                            <li>CLIENT function VM</li>
                            <li>resources and state</li>
                            <li>presenter and runtime manager</li>
                        </ul>
                        <code>tty / qt / gtk / swiftui / imgui / web</code>
                    </div>
                    <div class="architecture-map__link">
                        <strong>TYPED PROTOCOL</strong>
                        <span>local socket or TCP/TLS</span>
                    </div>
                    <div class="architecture-map__node">
                        <span>ORNADB SERVER</span>
                        <h3>trusted kernel</h3>
                        <ul>
                            <li>object-relational SQL</li>
                            <li>transactions and stable IDs</li>
                            <li>SERVER function execution</li>
                            <li><code>sys.invoke</code>, security, inspection</li>
                        </ul>
                        <code>current prototype: embedded PostgreSQL</code>
                    </div>
                </figure>
                <p class="architecture-note">
                    A runtime never authenticates, speaks the database protocol, executes SQL, or writes USER state
                    directly. A remote database cannot require the client to load an arbitrary native library.
                </p>
            </div>
        </section>

        <section class="section section--dogfood" aria-labelledby="dogfood-title">
            <div class="shell dogfood-layout">
                <div>
                    <span class="status-label status-label--dark">LOCKED PRODUCT REQUIREMENT / ROADMAP</span>
                    <h2 id="dogfood-title">The Inspector is built with the thing it inspects.</h2>
                    <p>
                        The intended Inspector is an ordinary CLIENT function which uses public
                        <code>sys.inspect.*</code> APIs, normal USER state, <code>std.ui.UI</code>, and the same runtime
                        negotiation as every other program.
                    </p>
                    <a class="text-link text-link--on-dark" href="/docs/security-and-inspection/">
                        Read the inspection model
                        <span aria-hidden="true">-&gt;</span>
                    </a>
                </div>
                <figure class="inspection-stack">
                    <figcaption>Immutable snapshot epochs prevent observer loops</figcaption>
                    <ol>
                        <li><code>inv:100</code><span>studio.main()</span></li>
                        <li><code>inv:101</code><span>devtools.inspector(inv:100)</span></li>
                        <li><code>inv:102</code><span>devtools.inspector(inv:101)</span></li>
                        <li><code>inv:103</code><span>devtools.inspector(inv:102)</span></li>
                    </ol>
                </figure>
            </div>
        </section>

        <section class="section section--example" aria-labelledby="example-title">
            <div class="shell example-layout">
                <div class="example-copy">
                    <h2 id="example-title">A native interface is still a function.</h2>
                    <p>
                        <code>std.ui.UI</code> is a standard-library transient value type, not a core language keyword or
                        a toolkit object. CLIENT functions compose it through typed runtime contracts.
                    </p>
                    <ul>
                        <li>No <code>CREATE APPLICATION</code>.</li>
                        <li>No <code>CREATE COMPONENT</code>.</li>
                        <li>No Qt, GTK, DOM, or CSS objects in portable source.</li>
                    </ul>
                    <a class="text-link" href="/docs/ui-and-runtimes/">
                        Read UI and runtime details
                        <span aria-hidden="true">-&gt;</span>
                    </a>
                </div>
                <figure class="source-window source-window--example">
                    <figcaption><span>overdue_window.orna</span><span>CURRENT PROPOSAL</span></figcaption>
                    <pre><code>{clientSource}</code></pre>
                    <div class="source-window__terminal source-window__terminal--single">
                        <pre><code>$ orna invoke tasks.overdue_window
# local client selects a compatible installed runtime</code></pre>
                    </div>
                </figure>
            </div>
        </section>

        <section class="section section--status" id="status" aria-labelledby="status-title">
            <div class="shell">
                <div class="section-heading section-heading--split">
                    <h2 id="status-title">The design is further ahead than the implementation.</h2>
                    <p>
                        OrnaDB is not a finished database release. The repository is building the vertical spine from
                        source and semantic identity through an embedded PostgreSQL kernel. Later runtime and dogfooding
                        work remains explicit roadmap work.
                    </p>
                </div>

                <div class="status-columns">
                    <article>
                        <div class="status-columns__heading">
                            <span class="status-label">IN REPOSITORY</span>
                            <h3>Implemented foundations</h3>
                        </div>
                        <ul>
                            {implementedWork.map((item) => <li>{item}</li>)}
                        </ul>
                    </article>
                    <article>
                        <div class="status-columns__heading">
                            <span class="status-label status-label--open">NEXT SLICES</span>
                            <h3>Active roadmap</h3>
                        </div>
                        <ul>
                            {roadmapWork.map((item) => <li>{item}</li>)}
                        </ul>
                    </article>
                </div>

                <div class="status-actions">
                    <a class="button button--brand" href="/docs/status/">Read the status guide</a>
                    <a class="text-link" href="https://github.com/workingdir/ornadb">
                        Inspect the repository
                        <span aria-hidden="true">-&gt;</span>
                    </a>
                </div>
            </div>
        </section>

        <section class="closing" aria-labelledby="closing-title">
            <div class="shell closing__inner">
                <h2 id="closing-title">Read the model. Challenge the boundaries.</h2>
                <p>
                    Start with the ten-minute technical path, then inspect the language, invocation, runtime, security,
                    and implementation status in the Sourcey documentation.
                </p>
                <div>
                    <a class="button button--ink" href="/docs/getting-started/">Start with the guide</a>
                    <a class="text-link" href="/docs/examples/">
                        Browse examples
                        <span aria-hidden="true">-&gt;</span>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <SiteFooter />
</BaseLayout>
