---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="OrnaDB - Object-Relational Native Applications"
    description="OrnaDB is an object-relational database that stores and runs the programs which work with its data."
>
    <main id="main-content" style="max-width: 72rem; margin: 0 auto; padding: 6rem 1.5rem;">
        <p style="font-family: var(--font-mono);">OrnaDB / website foundation</p>
        <h1 style="font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1; margin-top: 1rem;">
            The database stores programs, not only their data.
        </h1>
        <p style="max-width: 60ch; margin-top: 1.5rem; font-size: 1.125rem;">
            The full technical frontpage is in progress. The Sourcey documentation is available at
            <a href="/docs/">/docs</a>.
        </p>
    </main>
</BaseLayout>
