+ * Open a linked backend child with suitable error messaging
+ */
+static unsigned int orna_backend_capture_sequence = 0;
+static char orna_backend_capture_path[MAXPGPATH];
+
+static bool
+orna_close_fd(int fd)
+{
+	return close(fd) == 0;
+}
+
+static bool
+orna_unlink_backend_capture(void)
+{
+	return unlink(orna_backend_capture_path) == 0;
+}
+
+static bool
+orna_wait_backend(pid_t child_pid, int *status)
+{
+	pid_t		waited;
+
+	do
+	{
+		waited = waitpid(child_pid, status, 0);
+	} while (waited < 0 && errno == EINTR);
+	return waited == child_pid;
+}
+
+static bool
+orna_discard_backend_child(pid_t child_pid, int writefd)
+{
+	int			status;
+	bool		ok = true;
+
+	if (!orna_close_fd(writefd))
+		ok = false;
+	if (!orna_wait_backend(child_pid, &status))
+		ok = false;
+	if (!orna_unlink_backend_capture())
+		ok = false;
+	return ok;
+}
+
+static FILE *
+orna_start_backend(char **argv, pid_t *child_pid)
+{
+	int			pipefd[2];
+	int			capturefd;
+	pid_t		pid;
+	FILE	   *cmdfd;
+	int			argc = 0;
+
+	while (argv[argc] != NULL)
+		argc++;
+	if (snprintf(orna_backend_capture_path, sizeof(orna_backend_capture_path),
+				 "%s/.orna-postgres18-initdb-output-%ld-%u", pg_data,
+				 (long) getpid(), ++orna_backend_capture_sequence) >=
+		sizeof(orna_backend_capture_path))
+		return NULL;
+	capturefd = open(orna_backend_capture_path,
+					 O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, S_IRUSR | S_IWUSR);
+	if (capturefd < 0)
+		return NULL;
+	if (pipe(pipefd) != 0)
+	{
+		bool		cleanup_ok = orna_close_fd(capturefd);
+
+		if (!orna_unlink_backend_capture())
+			cleanup_ok = false;
+		if (!cleanup_ok)
+			pg_fatal("could not clean up linked PostgreSQL child resources");
+		return NULL;
+	}
+	fflush(NULL);
+	pid = fork();
+	if (pid < 0)
+	{
+		bool		cleanup_ok = orna_close_fd(pipefd[0]);
+
+		if (!orna_close_fd(pipefd[1]))
+			cleanup_ok = false;
+		if (!orna_close_fd(capturefd))
+			cleanup_ok = false;
+		if (!orna_unlink_backend_capture())
+			cleanup_ok = false;
+		if (!cleanup_ok)
+			pg_fatal("could not clean up linked PostgreSQL child resources");
+		return NULL;
+	}
+	if (pid == 0)
+	{
+		if (!orna_close_fd(pipefd[1]))
+			_exit(127);
+		if (dup2(pipefd[0], STDIN_FILENO) < 0)
+			_exit(127);
+		if (!orna_close_fd(pipefd[0]))
+			_exit(127);
+		if (dup2(capturefd, STDOUT_FILENO) < 0 ||
+			dup2(capturefd, STDERR_FILENO) < 0)
+			_exit(127);
+		if (capturefd > STDERR_FILENO && !orna_close_fd(capturefd))
+			_exit(127);
+		orna_postgres18_set_initialisation_child_capability(true);
+		success = true;
+		optind = 1;
+#ifdef HAVE_INT_OPTRESET
+		optreset = 1;
+#endif
+		(void) orna_postgres18_entry(argc, argv);
+		_exit(127);
+	}
+	{
+		bool		parent_cleanup_ok = orna_close_fd(pipefd[0]);
+
+		if (!orna_close_fd(capturefd))
+			parent_cleanup_ok = false;
+		if (!parent_cleanup_ok)
+		{
+			if (!orna_discard_backend_child(pid, pipefd[1]))
+				pg_fatal("could not clean up linked PostgreSQL child resources");
+			pg_fatal("could not close linked PostgreSQL child resources");
+		}
+	}
+	cmdfd = fdopen(pipefd[1], "w");
+	if (cmdfd == NULL)
+	{
+		if (!orna_discard_backend_child(pid, pipefd[1]))
+			pg_fatal("could not clean up linked PostgreSQL child resources");
+		return NULL;
+	}
+	*child_pid = pid;
+	return cmdfd;
+}
+
+static OrnaBackendResult
+orna_finish_backend(FILE *cmdfd, pid_t child_pid)
+{
+	int			status;
+	struct stat capture_stat;
+	OrnaBackendResult result = ORNA_BACKEND_OK;
+
+	if (fclose(cmdfd) != 0)
+		result = ORNA_BACKEND_ERROR;
+	if (!orna_wait_backend(child_pid, &status))
+		result = ORNA_BACKEND_ERROR;
+	if (result == ORNA_BACKEND_OK && !WIFEXITED(status))
+		result = ORNA_BACKEND_ERROR;
+	else if (result == ORNA_BACKEND_OK && WEXITSTATUS(status) == 127)
+		result = ORNA_BACKEND_ERROR;
+	else if (result == ORNA_BACKEND_OK && WEXITSTATUS(status) != 0)
+		result = ORNA_BACKEND_REJECTED;
+	if (lstat(orna_backend_capture_path, &capture_stat) != 0 ||
+		!S_ISREG(capture_stat.st_mode) || capture_stat.st_nlink != 1 ||
+		(capture_stat.st_mode & 0777) != (S_IRUSR | S_IWUSR))
+		result = ORNA_BACKEND_ERROR;
+	else if (result == ORNA_BACKEND_OK && capture_stat.st_size != 0)
+		result = ORNA_BACKEND_ERROR;
+	if (!orna_unlink_backend_capture())
+		result = ORNA_BACKEND_ERROR;
+	return result;
+}
