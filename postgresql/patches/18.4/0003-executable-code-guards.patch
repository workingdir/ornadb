+static pg_noreturn void
+orna_reject_executable_sql(const char *message)
+{
+	ereport(ERROR,
+			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+			 errmsg("%s", message)));
+}
+
+void
+orna_postgres18_reject_executable_utility(Node *parsetree)
+{
+	switch (nodeTag(parsetree))
+	{
+		case T_LoadStmt:
+			orna_reject_executable_sql("Orna does not permit SQL LOAD");
+			break;
+		case T_CopyStmt:
+			if (((CopyStmt *) parsetree)->is_program)
+				orna_reject_executable_sql("Orna does not permit COPY PROGRAM");
+			break;
+		case T_CreateExtensionStmt:
+		case T_AlterExtensionStmt:
+		case T_AlterExtensionContentsStmt:
+		case T_AlterObjectDependsStmt:
+			orna_reject_executable_sql("Orna does not permit PostgreSQL extension management");
+			break;
+		case T_CreatePLangStmt:
+			orna_reject_executable_sql("Orna does not permit procedural language creation");
+			break;
+		case T_DoStmt:
+			orna_reject_executable_sql("Orna does not permit anonymous procedural blocks");
+			break;
+		case T_DropStmt:
+			if (((DropStmt *) parsetree)->removeType == OBJECT_EXTENSION)
+				orna_reject_executable_sql("Orna does not permit PostgreSQL extension management");
+			break;
+		case T_RenameStmt:
+			if (((RenameStmt *) parsetree)->renameType == OBJECT_EXTENSION)
+				orna_reject_executable_sql("Orna does not permit PostgreSQL extension management");
+			break;
+		case T_AlterOwnerStmt:
+			if (((AlterOwnerStmt *) parsetree)->objectType == OBJECT_EXTENSION)
+				orna_reject_executable_sql("Orna does not permit PostgreSQL extension management");
+			break;
+		case T_AlterObjectSchemaStmt:
+			if (((AlterObjectSchemaStmt *) parsetree)->objectType == OBJECT_EXTENSION)
+				orna_reject_executable_sql("Orna does not permit PostgreSQL extension management");
+			break;
+		case T_CommentStmt:
+			if (((CommentStmt *) parsetree)->objtype == OBJECT_EXTENSION)
+				orna_reject_executable_sql("Orna does not permit PostgreSQL extension management");
+			break;
+		case T_SecLabelStmt:
+			if (((SecLabelStmt *) parsetree)->objtype == OBJECT_EXTENSION)
+				orna_reject_executable_sql("Orna does not permit PostgreSQL extension management");
+			break;
+		default:
+			break;
+	}
+}
+
+void
+orna_postgres18_reject_external_function_language(Oid language_oid)
+{
+	if (language_oid == ClanguageId ||
+		(language_oid == INTERNALlanguageId &&
+		 !orna_postgres18_has_system_functions_initialisation_capability()))
+		orna_reject_executable_sql("Orna does not permit C or internal language function or procedure definitions");
+}
+
