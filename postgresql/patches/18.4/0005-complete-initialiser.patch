+ * Render each standalone SQL phase before its child exists.  Support-file
+ * reads and allocations can fail, but must never strand a linked child.
+ */
+static FILE *
+orna_open_backend_sql(char **sql, size_t *length)
+{
+	FILE	   *cmdfd;
+
+	output_failed = false;
+	output_errno = 0;
+	*sql = NULL;
+	*length = 0;
+	cmdfd = open_memstream(sql, length);
+	if (cmdfd == NULL)
+		pg_fatal("could not prepare linked PostgreSQL child input: %m");
+	return cmdfd;
+}
+
+static void
+orna_close_backend_sql(FILE *cmdfd, char **sql)
+{
+	if (fclose(cmdfd) != 0 || output_failed)
+	{
+		if (output_failed)
+			errno = output_errno;
+		free(*sql);
+		*sql = NULL;
+		pg_fatal("could not prepare linked PostgreSQL child input: %m");
+	}
+}
+
+static void
+orna_run_backend_sql(char **argv, char *sql, size_t length,
+					 bool system_functions_initialisation)
+{
+	FILE	   *cmdfd;
+	pid_t		child_pid;
+	OrnaBackendResult result;
+	bool		write_failed;
+
+	cmdfd = orna_start_backend(argv, &child_pid,
+							 system_functions_initialisation);
+	if (cmdfd == NULL)
+	{
+		free(sql);
+		pg_fatal("could not start linked PostgreSQL child");
+	}
+	write_failed = fwrite(sql, 1, length, cmdfd) != length ||
+		fflush(cmdfd) != 0;
+	result = orna_finish_backend(cmdfd, child_pid);
+	free(sql);
+	if (result != ORNA_BACKEND_OK)
+		pg_fatal("linked PostgreSQL child did not complete successfully");
+	if (write_failed)
+		pg_fatal("could not write to linked PostgreSQL child");
+}
