+int
+orna_postgres18_initdb_entry(const char *data_directory)
+{
+	char	   *argv[] = {
+		"/usr/bin/orna", "--pgdata", (char *) data_directory,
+		"--username=orna_kernel", "--encoding=UTF8", "--locale=C",
+		"--locale-provider=builtin", "--builtin-locale=PG_UNICODE_FAST",
+		"--data-checksums", "--auth-local=peer", "--auth-host=reject",
+		"--no-instructions", NULL
+	};
+	int			clear_pglocaledir_result;
+	int			clear_pgsysconfdir_result;
+
+	clear_pgsysconfdir_result = unsetenv("PGSYSCONFDIR");
+	clear_pglocaledir_result = unsetenv("PGLOCALEDIR");
+	if (clear_pgsysconfdir_result != 0 ||
+		clear_pglocaledir_result != 0 ||
+		setlocale(LC_ALL, "C") == NULL ||
+		data_directory == NULL || data_directory[0] != '/' ||
+		orna_postgres18_support_root() == NULL ||
+		orna_postgres18_install_exec_filter() != 0)
+		return 1;
+	optind = 1;
+#ifdef HAVE_INT_OPTRESET
+	optreset = 1;
+#endif
+	return orna_postgres18_initdb_main(lengthof(argv) - 1, argv);
+}
+
+#ifndef ORNA_EMBEDDED_INITDB_ENTRY
+int
+main(int argc, char *argv[])
+{
+	return orna_postgres18_initdb_main(argc, argv);
+}
+#endif
