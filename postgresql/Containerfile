FROM docker.io/library/debian@sha256:a1363ada3b45cb3ebc74c78943558f8b0c2b59aaa194d8224e1b02cfd5d78583

RUN printf '%s\n' \
        'deb http://snapshot.debian.org/archive/debian/20251229T000000Z bookworm main' \
        'deb http://snapshot.debian.org/archive/debian/20251229T000000Z bookworm-updates main' \
        'deb http://snapshot.debian.org/archive/debian-security/20251229T000000Z bookworm-security main' \
        > /etc/apt/sources.list \
    && find /etc/apt/sources.list.d -mindepth 1 -maxdepth 1 -type f -delete \
    && apt-get update -o Acquire::Check-Valid-Until=false \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        binutils=2.40-2 \
        bison=2:3.8.2+dfsg-1+b1 \
        ca-certificates=20230311+deb12u1 \
        file=1:5.44-3 \
        flex=2.6.4-8.2 \
        gcc=4:12.2.0-3 \
        libc6-dev=2.36-9+deb12u13 \
        make=4.3-4.1 \
        patch=2.7.6-7 \
        perl=5.36.0-7+deb12u3 \
        pkg-config=1.8.1-1 \
        python3=3.11.2-1+b1 \
        strace=6.1-0.1 \
        zlib1g-dev=1:1.2.13.dfsg-1 \
    && apt-get clean \
    && find /var/lib/apt/lists -mindepth 1 -delete

ADD --checksum=sha256:bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16 \
    https://zlib.net/zlib-1.3.2.tar.gz /build/zlib-source.tar.gz

ADD --checksum=sha256:a47ac940abd12399d59ad15c877e7113fa35f2b9ec7e6a8a045d4fd8b9741dea \
    https://static.rust-lang.org/dist/2026-04-16/rust-1.95.0-x86_64-unknown-linux-gnu.tar.gz \
    /build/rust-toolchain.tar.gz

RUN mkdir -p /build/tmp /build/zlib-source \
    && tar --extract --gzip --file=/build/zlib-source.tar.gz \
        --strip-components=1 --directory=/build/zlib-source \
    && cd /build/zlib-source \
    && env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        SOURCE_DATE_EPOCH=1778528675 \
        AR=ar ARFLAGS=rcD CC=gcc \
        CFLAGS='-O2 -g0 -fPIC -ffile-prefix-map=/build=. -fdebug-prefix-map=/build=. -Wdate-time' \
        CONFIG_SITE=/dev/null CPPFLAGS=-I/build/zlib/include \
        LANG=C.UTF-8 LC_ALL=C.UTF-8 \
        LDFLAGS='-L/build/zlib/lib -Wl,--build-id=none' \
        PKG_CONFIG_LIBDIR=/nonexistent RANLIB=ranlib TMPDIR=/build/tmp TZ=UTC0 \
        ./configure --static --prefix=/build/zlib \
    && env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin SOURCE_DATE_EPOCH=1778528675 \
        AR=ar ARFLAGS=rcD CC=gcc \
        CFLAGS='-O2 -g0 -fPIC -ffile-prefix-map=/build=. -fdebug-prefix-map=/build=. -Wdate-time' \
        CONFIG_SITE=/dev/null CPPFLAGS=-I/build/zlib/include \
        LANG=C.UTF-8 LC_ALL=C.UTF-8 \
        LDFLAGS='-L/build/zlib/lib -Wl,--build-id=none' \
        PKG_CONFIG_LIBDIR=/nonexistent RANLIB=ranlib TMPDIR=/build/tmp TZ=UTC0 \
        make -j1 install \
    && test -f /build/zlib/lib/libz.a \
    && rm -rf /build/zlib-source

RUN mkdir -p /build/rust-toolchain \
    && tar --extract --gzip --file=/build/rust-toolchain.tar.gz \
        --strip-components=1 --directory=/build/rust-toolchain \
    && /build/rust-toolchain/install.sh \
        --prefix=/usr/local --disable-ldconfig --without=rust-docs \
    && rustc --version | grep -Fx 'rustc 1.95.0 (59807616e 2026-04-14)' \
    && cargo --version | grep -Fx 'cargo 1.95.0 (f2d3ce0bd 2026-03-21)' \
    && rm -rf /build/rust-toolchain /build/rust-toolchain.tar.gz

WORKDIR /build
