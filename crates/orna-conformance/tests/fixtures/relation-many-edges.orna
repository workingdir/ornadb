pub table Edge(id: Int) { from: Int, to: Int, }

fn main() {
    Edge.insert({ id: 1, from: 1, to: 2 });
    Edge.insert({ id: 2, from: 2, to: 3 });
    Edge.insert({ id: 3, from: 3, to: 4 });
    Edge.insert({ id: 4, from: 4, to: 5 });
    Edge.insert({ id: 5, from: 5, to: 6 });
    Edge.insert({ id: 6, from: 6, to: 7 });
}
