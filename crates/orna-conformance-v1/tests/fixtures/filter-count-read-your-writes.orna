pub table Note(id: Int) { text: Str, }
fn child() { Note.insert({ id: 7, text: "nested" }); }
fn parent() {
    child();
    Note.insert({ id: 8, text: "second" });
    assert Note | filter(note => note.text == "nested") | count == 1;
    assert Note | filter(note => note.text == "second") | count() == 1;
}
