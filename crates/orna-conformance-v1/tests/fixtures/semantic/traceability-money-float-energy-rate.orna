pub protocol Currency {
    static code: Str;
    static minor_digits: Int;
}

pub type GBP {
    impl Currency {
        static code = "GBP";
        static minor_digits = 2;
    }
}

pub dim Energy;
pub unit kWh : Energy base;

pub fn cost(energy: Float<kWh>, rate: Money<GBP> / kWh) = energy * rate;
