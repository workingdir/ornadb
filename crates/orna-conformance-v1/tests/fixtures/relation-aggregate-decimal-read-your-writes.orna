pub table Reading(id: Int) { value: Decimal, }
fn total(): Decimal = Reading | map(reading => reading.value) | sum;
fn parent() {

            Reading.insert({ id: 2, value: 2.003 });
            assert total() == 2.003;
            Reading.insert({ id: 1, value: 1.20 });
            assert total() == 3.203;

}
