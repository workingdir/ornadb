// SOURCE_BLOCK source/06-expressions.md 16
fn parse_port(raw: Str): Port =
    raw
        | Int.parse
        | Port.from
        |? (failure => {
            log.warn(failure);
            8080 | Port.from
        });

// SOURCE_BLOCK source/06-expressions.md 17
fn require_message(raw: Str): Message =
    raw
        | std.encoding.json.decode(as: Message)
        |? (failure => fail(error(
            code: "message.invalid",
            message: "could not decode message",
            cause: failure,
        )));

