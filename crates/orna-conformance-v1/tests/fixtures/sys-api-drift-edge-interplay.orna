pub fn null_filtered_unknown_exact_count_inside_key_column_callback(tables: Relation<sys.Table>): Relation<Int?> = optional_reference_target_tables(tables) | flat_map(target_handle => sys.catalog.tables | filter(target_table => target_table.reference == target_handle && target_table.row_count_exact) | flat_map(exact_target => exact_target.references | filter(reference => reference.from_table == exact_target.reference) | flat_map(reference => sys.catalog.keys | filter(target_key => target_key.reference == reference.to_key) | flat_map(target_key => target_key.columns | filter(key_column => key_column.table == target_key.table && exact_target.row_count == null) | map(key_column => exact_target.row_count)))));
pub fn null_filtered_unknown_exact_count_inside_reference_callback(tables: Relation<sys.Table>): Relation<Int?> = optional_reference_target_tables(tables) | flat_map(target_handle => sys.catalog.tables | filter(target_table => target_table.reference == target_handle && target_table.row_count_exact) | flat_map(exact_target => exact_target.references | filter(reference => reference.from_table == exact_target.reference && exact_target.row_count == null) | flat_map(reference => sys.catalog.keys | filter(target_key => target_key.reference == reference.to_key) | flat_map(target_key => target_key.columns | filter(key_column => key_column.table == target_key.table) | map(key_column => exact_target.row_count)))));
pub fn unknown_inexact_target_tables_after_reference_handoff(tables: Relation<sys.Table>): Relation<sys.Table> = optional_reference_target_tables(tables) | flat_map(target_handle => sys.catalog.tables | filter(target_table => target_table.reference == target_handle && target_table.row_count == null && target_table.row_count_exact == false) | flat_map(unknown_inexact_target => unknown_inexact_target.references | filter(reference => reference.from_table == unknown_inexact_target.reference) | map(reference => unknown_inexact_target)));
pub fn retained_unknown_inexact_reference_target_row_counts(tables: Relation<sys.Table>): Relation<Int?> = unknown_inexact_target_tables_after_reference_handoff(tables) | map(retained_target => retained_target.row_count);
pub fn chained_unknown_inexact_reference_target_row_counts(tables: Relation<sys.Table>): Relation<Int?> = optional_reference_target_tables(tables) | flat_map(target_handle => sys.catalog.tables | filter(inexact_target => inexact_target.reference == target_handle && inexact_target.row_count_exact == false) | filter(unknown_target => unknown_target.row_count == null) | map(unknown_inexact_table => unknown_inexact_table.row_count));
pub fn null_filtered_unknown_inexact_reference_target_row_counts(tables: Relation<sys.Table>): Relation<Int?> = unknown_inexact_reference_target_row_counts(tables) | flat_map(projected_count => [projected_count]) | filter(retained_count => retained_count == null);
pub fn inexact_reference_target_row_counts(tables: Relation<sys.Table>): Relation<Int?> = optional_reference_target_tables(tables) | flat_map(target_handle => sys.catalog.tables | filter(target_table => target_table.reference == target_handle && target_table.row_count != null && target_table.row_count_exact == false) | map(inexact_table => inexact_table.row_count));
