pub fn diff_change_area(entry: sys.DiffEntry): sys.ChangeArea = entry.change.area;
pub fn diff_change_target(entry: sys.DiffEntry): sys.ChangeTarget = entry.change.target;
pub fn diff_change_target_kind(entry: sys.DiffEntry): sys.ChangeTargetKind = entry.change.target.kind;
pub fn diff_rows(from: sys.SnapshotRef, to: sys.SnapshotRef): Relation<sys.DiffEntry> = sys.diff(from, to);
pub fn dependency_rows(object: sys.ObjectRef): Relation<sys.Dependency> = sys.dependencies(object);
pub fn source_map_rows(document: sys.SourceDocument): Relation<sys.SourceMapEntry> = document.maps;
pub fn generated_source_byte_offsets(document: sys.SourceDocument): Relation<Int> = document.maps | map(entry => entry.generated.start_byte);
pub fn projected_source_byte_offsets(document: sys.SourceDocument): Relation<Int> = document.maps | map(entry => entry.generated) | map(span => span.start_byte);
pub fn original_source_names(document: sys.SourceDocument): Relation<Str?> = document.maps | map(entry => entry.original_name);
pub fn named_source_byte_offsets(document: sys.SourceDocument): Relation<Int> = document.maps | filter(entry => entry.original_name != null) | map(entry => entry.generated.start_byte);
pub fn document_source_byte_offsets(document: sys.SourceDocument): Relation<Int> = document.maps | filter(entry => entry.generated.file == document.file) | map(entry => entry.generated.start_byte);
pub fn source_map_files_with_document_file(document: sys.SourceDocument): Relation<sys.FileRef> = document.maps | flat_map(entry => [entry.generated.file, document.file]);
pub fn metadata_rows(rows: Relation<sys.ValueMetadata<sys.Value>>): Relation<sys.ValueMetadata<sys.Value>> = rows;
pub fn generic_metadata_rows<T>(rows: Relation<sys.ValueMetadata<T>>): Relation<sys.ValueMetadata<T>> = rows;
pub fn metadata_protocols<T>(metadata: sys.ValueMetadata<T>): Relation<sys.Protocol> = metadata.protocols;
pub fn invocation_result_value<T>(result: sys.InvocationResult<T>): T? = result.value;
pub fn generic_metadata_protocols<T>(rows: Relation<sys.ValueMetadata<T>>): Relation<sys.Protocol> = rows | flat_map(row => row.protocols);
pub fn protocol_member_rows(protocols: Relation<sys.Protocol>): Relation<sys.ProtocolMember> = protocols | flat_map(candidate => candidate.members);
pub fn generic_metadata_protocol_members<T>(rows: Relation<sys.ValueMetadata<T>>): Relation<sys.ProtocolMember> = generic_metadata_protocols(rows) | flat_map(candidate => candidate.members);
pub fn type_parameters_from_types(types: Relation<sys.Type>): Relation<sys.TypeParameter> = types | flat_map(definition => definition.parameters);
pub fn bounded_protocols_from_types(types: Relation<sys.Type>): Relation<sys.Protocol> = type_parameters_from_types(types) | flat_map(parameter => parameter.bounds);
pub fn bounded_protocol_members_from_types(types: Relation<sys.Type>): Relation<sys.ProtocolMember> = bounded_protocols_from_types(types) | flat_map(bound => bound.members);
pub fn function_failure_protocol_members(functions: Relation<sys.Function>): Relation<sys.ProtocolMember> = functions | flat_map(source => source.failure_types) | flat_map(definition => definition.parameters) | flat_map(parameter => parameter.bounds) | flat_map(bound => bound.members);
pub fn called_function_failure_protocol_members(functions: Relation<sys.Function>): Relation<sys.ProtocolMember> = functions | flat_map(caller => caller.calls) | flat_map(source => source.failure_types) | flat_map(definition => definition.parameters) | flat_map(parameter => parameter.bounds) | flat_map(bound => bound.members);
pub fn direct_function_calls(functions: Relation<sys.Function>): Relation<sys.Function> = functions | flat_map(caller => caller.calls);
pub fn second_level_function_calls(functions: Relation<sys.Function>): Relation<sys.Function> = direct_function_calls(functions) | flat_map(callee => callee.calls);
pub fn third_level_function_calls(functions: Relation<sys.Function>): Relation<sys.Function> = second_level_function_calls(functions) | flat_map(descendant => descendant.calls);
pub fn recursive_function_capture_rows(functions: Relation<sys.Function>): Relation<sys.Function> = functions | flat_map(root => root.calls | flat_map(child => child.calls | flat_map(descendant => [root, child, descendant])));
pub fn inferred_recursive_function_grandchildren(functions: Relation<sys.Function>): Relation<sys.Function> = direct_function_calls(functions) | filter(callee => callee.inferred_signature) | flat_map(inferred => inferred.calls);
pub fn called_function_effects(functions: Relation<sys.Function>): Relation<sys.Effect> = functions | flat_map(caller => caller.calls) | flat_map(callee => callee.effects);
pub fn targeted_called_function_effects(functions: Relation<sys.Function>): Relation<sys.Effect> = called_function_effects(functions) | filter(effect => effect.target != null);
pub fn called_function_read_column_names(functions: Relation<sys.Function>): Relation<Str> = functions | flat_map(caller => caller.calls) | flat_map(callee => callee.reads) | filter(read_table => read_table.row_count != null) | flat_map(kept_table => kept_table.columns) | map(read_column => read_column.name);
pub fn table_reference_handles(tables: Relation<sys.Table>): Relation<sys.TableRef> = tables | flat_map(source_table => source_table.references | filter(optional_reference => optional_reference.optional) | flat_map(kept_reference => [source_table.reference, kept_reference.from_table, kept_reference.to_table]));
pub fn table_reference_rows(tables: Relation<sys.Table>): Relation<sys.Reference> = tables | flat_map(source_table => source_table.references);
pub fn optional_reference_source_columns(tables: Relation<sys.Table>): Relation<sys.ColumnRef> = table_reference_rows(tables) | filter(optional_reference => optional_reference.optional) | map(kept_reference => kept_reference.from_column);
pub fn non_restrict_optional_reference_actions(tables: Relation<sys.Table>): Relation<sys.ReferenceAction> = table_reference_rows(tables) | filter(optional_reference => optional_reference.optional) | map(kept_reference => kept_reference.on_delete) | filter(delete_action => delete_action != sys.ReferenceAction.restrict);
pub fn optional_reference_source_column_names(tables: Relation<sys.Table>): Relation<Str> = optional_reference_source_columns(tables) | flat_map(source_column => sys.catalog.columns | filter(candidate_column => candidate_column.reference == source_column) | map(matched_column => matched_column.name));
pub fn optional_reference_source_tables(tables: Relation<sys.Table>): Relation<sys.TableRef> = optional_reference_source_columns(tables) | flat_map(source_column => sys.catalog.columns | filter(candidate_column => candidate_column.reference == source_column) | flat_map(matched_column => sys.catalog.tables | filter(candidate_table => candidate_table.reference == matched_column.table) | map(matched_table => matched_table.reference)));
pub fn optional_reference_source_table_columns(tables: Relation<sys.Table>): Relation<sys.ColumnRef> = optional_reference_source_tables(tables) | flat_map(source_table => sys.catalog.tables | filter(candidate_table => candidate_table.reference == source_table) | flat_map(matched_table => matched_table.columns | filter(column => column.table == matched_table.reference) | map(column => column.reference)));
pub fn optional_reference_source_table_references(tables: Relation<sys.Table>): Relation<sys.ReferenceRef> = optional_reference_source_tables(tables) | flat_map(source_table => sys.catalog.tables | filter(candidate_table => candidate_table.reference == source_table) | flat_map(matched_table => matched_table.references | filter(reference => reference.from_table == matched_table.reference) | map(reference => reference.reference)));
pub fn optional_reference_target_tables(tables: Relation<sys.Table>): Relation<sys.TableRef> = optional_reference_source_tables(tables) | flat_map(source_table => sys.catalog.tables | filter(candidate_table => candidate_table.reference == source_table) | flat_map(matched_table => matched_table.references | filter(reference => reference.from_table == matched_table.reference) | flat_map(matched_reference => sys.catalog.tables | filter(target_table => target_table.reference == matched_reference.to_table) | map(target_table => target_table.reference))));
pub fn optional_reference_target_columns(tables: Relation<sys.Table>): Relation<sys.Column> = optional_reference_target_tables(tables) | flat_map(target_handle => sys.catalog.tables | filter(target_table => target_table.reference == target_handle && target_table.row_count != null) | flat_map(kept_target_table => kept_target_table.columns | filter(column => column.table == kept_target_table.reference)));
pub fn optional_reference_target_column_names(tables: Relation<sys.Table>): Relation<Str> = optional_reference_target_columns(tables) | map(column => column.name);
pub fn optional_keyed_reference_target_columns(tables: Relation<sys.Table>): Relation<sys.Column> = optional_reference_target_columns(tables) | filter(optional_column => optional_column.optional) | filter(keyed_column => keyed_column.key_position != null);
pub fn optional_keyed_reference_target_column_names(tables: Relation<sys.Table>): Relation<Str> = optional_keyed_reference_target_columns(tables) | map(column => column.name);
pub fn computed_column_rows(columns: Relation<sys.Column>): Relation<sys.Column> = columns | filter(column => column.computed_expression != null);
pub fn computed_optional_keyed_reference_target_column_names(tables: Relation<sys.Table>): Relation<Str> = computed_column_rows(optional_keyed_reference_target_columns(tables)) | map(column => column.name);
pub fn documented_computed_target_column_names(tables: Relation<sys.Table>): Relation<Str> = computed_column_rows(optional_keyed_reference_target_columns(tables)) | filter(column => column.default_expression == null && column.docs != null) | map(column => column.name);
pub fn unkeyed_or_defaulted_computed_target_column_names(tables: Relation<sys.Table>): Relation<Str> = computed_column_rows(optional_reference_target_columns(tables)) | filter(column => column.key_position == null || column.default_expression != null) | map(column => column.name);
pub fn nullable_expression_documentation(tables: Relation<sys.Table>): Relation<Str?> = optional_reference_target_columns(tables) | filter(column => (column.default_expression == null && column.computed_expression != null) || column.docs == null) | map(column => column.docs);
pub fn documented_default_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | filter(column => column.docs != null) | map(column => column.default_expression);
pub fn defaulted_column_documentation(tables: Relation<sys.Table>): Relation<Str?> = optional_reference_target_columns(tables) | filter(column => column.default_expression != null) | map(column => column.docs);
pub fn unkeyed_documented_computed_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | filter(column => column.key_position == null && column.docs != null) | map(column => column.computed_expression);
pub fn documented_column_rows(columns: Relation<sys.Column>): Relation<sys.Column> = columns | filter(column => column.docs != null);
pub fn documented_column_default_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = documented_column_rows(optional_reference_target_columns(tables)) | map(column => column.default_expression);
pub fn documented_sibling_default_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | flat_map(anchor => sys.catalog.columns | filter(sibling => sibling.table == anchor.table && sibling.reference != anchor.reference && sibling.docs != null) | map(sibling => sibling.default_expression));
pub fn unkeyed_documented_sibling_computed_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | filter(anchor => anchor.key_position == null) | flat_map(anchor => sys.catalog.columns | filter(sibling => sibling.table == anchor.table && sibling.reference != anchor.reference && sibling.docs != null) | map(sibling => sibling.computed_expression));
pub fn defaulted_anchor_documented_sibling_computed_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | flat_map(anchor => sys.catalog.columns | filter(sibling => sibling.table == anchor.table && sibling.reference != anchor.reference && anchor.default_expression != null && sibling.docs != null) | map(sibling => sibling.computed_expression));
pub fn documented_sibling_anchor_default_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | flat_map(anchor => sys.catalog.columns | filter(sibling => sibling.table == anchor.table && sibling.reference != anchor.reference && sibling.docs != null) | map(sibling => anchor.default_expression));
pub fn nested_sibling_anchor_default_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | flat_map(anchor => sys.catalog.columns | filter(first_sibling => first_sibling.table == anchor.table && first_sibling.reference != anchor.reference) | flat_map(second_sibling => sys.catalog.columns | filter(candidate => candidate.table == second_sibling.table && candidate.reference != second_sibling.reference && candidate.reference != anchor.reference && candidate.docs != null) | map(documented_candidate => anchor.default_expression)));
