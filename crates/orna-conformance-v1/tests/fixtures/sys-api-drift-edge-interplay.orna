pub fn documented_sibling_anchor_default_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | flat_map(anchor => sys.catalog.columns | filter(sibling => sibling.table == anchor.table && sibling.reference != anchor.reference && sibling.docs != null) | map(sibling => anchor.default_expression));
pub fn nested_sibling_anchor_default_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | flat_map(anchor => sys.catalog.columns | filter(first_sibling => first_sibling.table == anchor.table && first_sibling.reference != anchor.reference) | flat_map(second_sibling => sys.catalog.columns | filter(candidate => candidate.table == second_sibling.table && candidate.reference != second_sibling.reference && candidate.reference != anchor.reference && candidate.docs != null) | map(documented_candidate => anchor.default_expression)));
pub fn nested_nullable_candidate_computed_expressions(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = optional_reference_target_columns(tables) | flat_map(anchor => sys.catalog.columns | filter(sibling => sibling.table == anchor.table && sibling.reference != anchor.reference && anchor.default_expression != null) | flat_map(middle_sibling => sys.catalog.columns | filter(candidate => candidate.table == middle_sibling.table && candidate.reference != middle_sibling.reference && candidate.reference != anchor.reference && middle_sibling.docs != null) | map(candidate => candidate.computed_expression)));
pub fn unknown_row_count_documented_column_default_expression_refs(tables: Relation<sys.Table>): Relation<sys.ExpressionRef?> = tables | filter(row_table => row_table.row_count == null) | flat_map(unknown_table => unknown_table.columns | filter(column => column.table == unknown_table.reference && column.docs != null) | map(column => column.default_expression));
pub fn documented_column_parent_row_counts(tables: Relation<sys.Table>): Relation<Int?> = tables | flat_map(source_table => source_table.columns | filter(column => column.table == source_table.reference && column.docs != null) | map(column => source_table.row_count));
pub fn exact_reference_target_row_counts(tables: Relation<sys.Table>): Relation<Int?> = optional_reference_target_tables(tables) | flat_map(target_handle => sys.catalog.tables | filter(target_table => target_table.reference == target_handle && target_table.row_count_exact) | map(exact_table => exact_table.row_count));
