pub fn exact_then_null_region_counts_after_row_handoff(region: Relation<sys.Table>): Relation<Int?> = region | filter(exact_table => exact_table.row_count_exact) | flat_map(exact_table => [exact_table] | filter(unknown_table => unknown_table.row_count == null) | map(unknown_table => unknown_table.row_count));
