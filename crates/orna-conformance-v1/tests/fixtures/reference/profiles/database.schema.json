{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON projection of data-only database.orna, not a JSON storage file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository_format",
    "database_id"
  ],
  "properties": {
    "repository_format": {
      "const": 3
    },
    "database_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
