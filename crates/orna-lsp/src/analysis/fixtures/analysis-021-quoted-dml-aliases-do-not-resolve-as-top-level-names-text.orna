CREATE SCHEMA "app";
CREATE TYPE "app"."item" AS OBJECT ("value" BOOLEAN);
CREATE SERVER FUNCTION insert_item(p_value BOOLEAN)
RETURNS ROWS (created REF "app"."item") AS
INSERT INTO "app"."item" AS "app" ("value")
VALUES (p_value) RETURNING REF("app");
CREATE SERVER FUNCTION update_item(p_value BOOLEAN, p_item REF "app"."item")
RETURNS ROWS (updated REF "app"."item") AS
UPDATE "app"."item" AS "app" SET "value" = p_value
WHERE REF("app") = p_item RETURNING REF("app");
CREATE SERVER FUNCTION delete_item(p_item REF "app"."item")
RETURNS ROWS (deleted BOOLEAN) AS
DELETE FROM "app"."item" AS "app" WHERE REF("app") = p_item
RETURNING TRUE;
