--| Data presented by the account picker.
CREATE TYPE app.Account AS OBJECT (
    --| Display name shown in the picker.
    display_name TEXT
);

--| Find one account by its stable identifier.
CREATE CLIENT FUNCTION app.find_account(
    --| Identifier to search for.
    account_id INTEGER
) RETURNS app.Account AS account_id;

CREATE CLIENT FUNCTION app.account_label(account app.Account)
RETURNS TEXT AS account.display_name;
