CREATE SCHEMA resource_fixture;
CREATE SCHEMA stream_fixture;
CREATE SCHEMA action_fixture;
CREATE TYPE resource_fixture.row AS OBJECT (title TEXT, value INTEGER);
CREATE SERVER FUNCTION resource_fixture.scalar() RETURNS INTEGER AS
    SELECT r.value FROM resource_fixture.row r;
CREATE SERVER FUNCTION stream_fixture.stream() RETURNS STREAM<TEXT> AS
    SELECT r.title FROM resource_fixture.row r;
CREATE SERVER FUNCTION stream_fixture.unsupported() RETURNS STREAM<UUID> AS
    SELECT r.value FROM resource_fixture.row r;
CREATE CLIENT FUNCTION action_fixture.client() RETURNS INTEGER AS 1;
CREATE CLIENT FUNCTION resource_fixture.resource_probe() RETURNS INTEGER IS
BEGIN
    RETURN AWAIT std.data.resource(
        target => resource_fixture.scalar,
        arguments => std.call.args()
    );
END;
CREATE CLIENT FUNCTION stream_fixture.stream_probe() RETURNS STREAM<TEXT> IS
BEGIN
    RETURN AWAIT std.data.stream_resource(
        target => stream_fixture.stream,
        arguments => std.call.args()
    );
END;
CREATE CLIENT FUNCTION action_fixture.action_probe() RETURNS std.Action AS
    std.action.call(
        target => action_fixture.client,
        arguments => std.call.args()
    );
CREATE CLIENT FUNCTION action_fixture.shadowed() RETURNS std.Action IS
    LET std INTEGER := 1;
BEGIN
    RETURN std.action.call(
        target => std.foo,
        arguments => std.call.args()
    );
END;
CREATE CLIENT FUNCTION resource_fixture.field_probe(p_item REF resource_fixture.row)
RETURNS TEXT AS p_item.title;
