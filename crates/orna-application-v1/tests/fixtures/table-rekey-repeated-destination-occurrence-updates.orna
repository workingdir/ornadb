pub table Note(id: Int) {
    text: Str,
    quantity: Int,
}

fn main() {
    Note.rekey(1, 2) |? (failure => {
        Note.rekey(2, 3);
        Note.insert({ id: 2, text: "replacement", quantity: 30 })
    });
    Note.update(3, { quantity: 21 });
    Note.rekey(1, 2) |? (failure => {
        Note.rekey(2, 4);
        Note.rekey(3, 2);
        Note.update(2, { quantity: 22 })
    });
    Note.rekey(1, 2) |? (failure => {
        Note.rekey(2, 5);
        Note.update(5, { quantity: 23 })
    });
    Note.rekey(1, 2);
    Note.update(2, { quantity: 11 });
    Note.update(4, { quantity: 31 });
    Note.update(5, { quantity: 24 });
}
