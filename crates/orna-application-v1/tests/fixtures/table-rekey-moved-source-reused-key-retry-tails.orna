pub table Note(id: Int) {
    text: Str,
    quantity: Int,
}

fn main() {
    Note.rekey(1, 2) |? (failure => {
        Note.rekey(2, 4);
        Note.rekey(1, 2);
        Note.insert({ id: 1, text: "replacement", quantity: 30 });
        Note.update(2, { quantity: 11 });
        Note.update(1, { quantity: 31 })
    });
    Note.rekey(3, 2) |? (failure => {
        Note.update(2, { quantity: 12 });
        Note.update(1, { quantity: 32 });
        Note.rekey(2, 6);
        Note.update(6, { quantity: 13 });
        Note.rekey(6, 2);
        Note.update(2, { quantity: 14 })
    });
    Note.rekey(3, 2) |? (failure => {
        Note.update(2, { quantity: 15 });
        Note.update(1, { quantity: 33 });
        Note.rekey(2, 7);
        Note.update(7, { quantity: 16 });
        Note.rekey(3, 2);
        Note.update(2, { quantity: 31 })
    });
    Note.update(7, { quantity: 17 });
    Note.update(1, { quantity: 34 });
    Note.update(2, { quantity: 32 });
    Note.rekey(7, 9);
    Note.rekey(1, 8);
    Note.rekey(2, 5);
}
