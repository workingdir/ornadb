pub table Note(id: Int) {
    text: Str,
    quantity: Int,
}

fn continue_after_eleventh_handoff() {
    Note.rekey(3, 2) |? (competitor_retries_after_twelfth_handoff => {
        Note.update(2, { quantity: 35 });
        Note.rekey(2, 6);
        Note.rekey(3, 2);
        Note.rekey(6, 3);
        Note.update(3, { quantity: 36 })
    });
    continue_after_twelfth_handoff()
}

fn continue_after_twelfth_handoff() {
    Note.rekey(3, 2) |? (owner_retries_after_thirteenth_handoff => {
        Note.update(3, { quantity: 37 });
        Note.rekey(2, 6);
        Note.rekey(3, 2);
        Note.rekey(6, 3);
        Note.update(3, { quantity: 34 })
    })
}

fn main() {
    Note.rekey(1, 2) |? (owner_retry_after_handoff => {
        Note.rekey(2, 3) |? (competitor_waits_on_blocker => {
            Note.delete(3);
            Note.rekey(2, 3);
            Note.rekey(1, 2);
            Note.update(2, { quantity: 11 });
            Note.rekey(3, 4);
            Note.update(4, { quantity: 21 });
            Note.rekey(2, 3);
            Note.rekey(4, 2);
            Note.rekey(3, 2) |? (owner_retries_after_competitor_reclaims_key => {
                Note.update(2, { quantity: 22 });
                Note.rekey(2, 4);
                Note.rekey(3, 2);
                Note.update(2, { quantity: 12 });
                Note.rekey(4, 3);
                Note.update(3, { quantity: 23 });
                Note.rekey(3, 2) |? (competitor_retries_after_owner_reclaims_key => {
                    Note.rekey(2, 4);
                    Note.rekey(3, 2);
                    Note.rekey(4, 3);
                    Note.update(3, { quantity: 13 });
                    Note.rekey(3, 2) |? (owner_retries_after_second_competitor_reuse => {
                        Note.rekey(2, 4);
                        Note.rekey(3, 2);
                        Note.rekey(4, 3);
                        Note.update(3, { quantity: 24 });
                        Note.rekey(2, 3) |? (owner_retries_after_third_handoff => {
                            Note.rekey(3, 5);
                            Note.rekey(2, 3);
                            Note.rekey(5, 2);
                            Note.update(2, { quantity: 25 });
                            Note.rekey(3, 2) |? (owner_retries_after_reused_handoff_target => {
                                Note.update(2, { quantity: 26 });
                                Note.rekey(2, 5);
                                Note.rekey(3, 2);
                                Note.rekey(5, 3);
                                Note.update(3, { quantity: 27 });
                                Note.rekey(3, 2) |? (competitor_retries_after_owner_reuses_handoff => {
                                    Note.rekey(2, 5);
                                    Note.rekey(3, 2);
                                    Note.rekey(5, 3);
                                    Note.update(3, { quantity: 14 });
                                    Note.rekey(3, 2) |? (owner_retries_after_repeated_competitor_handoff => {
                                        Note.update(2, { quantity: 28 });
                                        Note.rekey(2, 5);
                                        Note.rekey(3, 2);
                                        Note.rekey(5, 3);
                                        Note.update(3, { quantity: 29 });
                                        Note.rekey(3, 2) |? (competitor_retries_after_seventh_handoff => {
                                            Note.update(2, { quantity: 15 });
                                            Note.rekey(2, 5);
                                            Note.rekey(3, 2);
                                            Note.rekey(5, 3);
                                            Note.update(3, { quantity: 16 });
                                            Note.rekey(3, 2) |? (owner_retries_after_seventh_handoff => {
                                                Note.update(2, { quantity: 30 });
                                                Note.rekey(2, 6);
                                                Note.rekey(3, 2);
                                                Note.rekey(6, 3);
                                                Note.update(3, { quantity: 31 });
                                                Note.rekey(3, 2) |? (competitor_retries_after_eighth_handoff => {
                                                    Note.update(2, { quantity: 17 });
                                                    Note.rekey(2, 6);
                                                    Note.rekey(3, 2);
                                                    Note.rekey(6, 3);
                                                    Note.update(3, { quantity: 18 });
                                                    Note.rekey(3, 2) |? (owner_retries_after_ninth_handoff => {
                                                        Note.update(3, { quantity: 19 });
                                                        Note.rekey(2, 6);
                                                        Note.rekey(3, 2);
                                                        Note.rekey(6, 3);
                                                        Note.update(3, { quantity: 32 });
                                                        Note.rekey(3, 2) |? (competitor_retries_after_tenth_handoff => {
                                                            Note.update(2, { quantity: 20 });
                                                            Note.rekey(2, 6);
                                                            Note.rekey(3, 2);
                                                            Note.rekey(6, 3);
                                                            Note.update(3, { quantity: 33 });
                                                            Note.rekey(3, 2) |? (owner_retries_after_eleventh_handoff => {
                                                                Note.update(3, { quantity: 34 });
                                                                Note.rekey(2, 6);
                                                                Note.rekey(3, 2);
                                                                Note.rekey(6, 3);
                                                                Note.update(3, { quantity: 33 });
                                                                continue_after_eleventh_handoff()
                                                            })
                                                        })
                                                    })
                                                })
                                            })
                                        })
                                    })
                                })
                            })
                        })
                    })
                })
            })
        })
    })
}
