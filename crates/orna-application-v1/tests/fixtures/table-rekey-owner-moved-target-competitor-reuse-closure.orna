                        })
                    })
                });
                Note.rekey(2, 9) |? (competitor_reuses_moved_insert_target => {
                    Note.update(9, { quantity: 93 });
                    Note.rekey(9, 10);
                    Note.update(10, { quantity: 94 });
                    Note.rekey(2, 9);
                    Note.update(9, { quantity: 46 });
                    Note.rekey(9, 10) |? (competitor_reuses_second_moved_target => {
                        Note.update(10, { quantity: 95 });
                        Note.rekey(10, 11);
                        Note.update(11, { quantity: 96 });
                        Note.rekey(9, 10);
                        Note.update(10, { quantity: 47 });
                        Note.rekey(11, 10) |? (inserted_reclaims_competitor_target => {
                            Note.update(10, { quantity: 48 });
