                                            Note.rekey(8, 9) |? (inserted_move_failure => {
                                                Note.update(9, { quantity: 91 });
                                                Note.delete(9);
                                                Note.insert({ id: 9, text: "replacement move target", quantity: 100 });
                                                Note.update(9, { quantity: 101 });
                                                Note.rekey(8, 9) |? (inserted_move_reuse_failure => {
                                                    Note.update(9, { quantity: 102 });
