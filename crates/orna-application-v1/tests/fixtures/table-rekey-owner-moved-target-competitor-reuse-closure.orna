                            Note.rekey(11, 10);
                            Note.update(10, { quantity: 97 });
                            Note.rekey(12, 11);
                            Note.update(11, { quantity: 50 });
                            Note.rekey(10, 11) |? (inserted_reclaims_reused_competitor_target => {
