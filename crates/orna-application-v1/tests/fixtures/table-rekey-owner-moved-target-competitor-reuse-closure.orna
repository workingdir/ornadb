                                Note.rekey(11, 13);
                                Note.update(13, { quantity: 52 });
                                Note.rekey(10, 11);
                                Note.update(11, { quantity: 98 });
                                Note.rekey(13, 10);
                                Note.update(10, { quantity: 53 });
                                Note.rekey(10, 11) |? (competitor_reclaims_inserted_reused_target => {
                                    Note.update(11, { quantity: 99 });
                                    Note.rekey(11, 14);
                                    Note.update(14, { quantity: 100 });
                                    Note.rekey(10, 11);
                                    Note.update(11, { quantity: 54 });
                                    Note.rekey(14, 10);
