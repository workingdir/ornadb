                                            Note.update(10, { quantity: 105 });
                                            Note.rekey(10, 11) |? (inserted_reuses_repeated_competitor_target => {
                                                Note.update(11, { quantity: 59 });
                                                Note.rekey(11, 13);
                                                Note.update(13, { quantity: 60 });
                                                Note.rekey(10, 11);
                                                Note.update(11, { quantity: 106 });
                                                Note.rekey(13, 10);
