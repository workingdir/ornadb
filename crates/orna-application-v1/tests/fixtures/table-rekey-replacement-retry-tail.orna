pub table Note(id: Int) {
    text: Str,
    quantity: Int,
}

fn main() {
    Note.rekey(1, 2) |? (failure => {
        Note.delete(2);
        Note.insert({ id: 2, text: "replacement", quantity: 20 })
    });
    Note.rekey(1, 2) |? (failure => Note.update(1, { quantity: 11 }));
    Note.update(2, { quantity: 21 });
}
