std.lazy.force(std.lazy.adapters.collect(std.lazy.adapters.flat_map(std.lazy.adapters.from_list([1, 2]), value => std.lazy.adapters.from_list([value, value * 10])))) == [1, 10, 2, 20] && std.lazy.force(std.lazy.adapters.collect(std.lazy.adapters.chain(std.lazy.adapters.from_list([1, 2]), std.lazy.adapters.from_list([3])))) == [1, 2, 3] && std.lazy.force(std.lazy.adapters.collect(std.lazy.adapters.zip_with(std.lazy.adapters.from_list([1, 2, 3]), std.lazy.adapters.from_list([10]), (left, right) => left + right))) == [11]
