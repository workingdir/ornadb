pub fn set_edge_contract(): Bool {
    let all_same = set.from_list([7, 7, 7]);
    let empty: [Int] = [];
    set.size([7, 7, 7]) == 1
        && set.to_list([5, 5]) == [5]
        && set.remove([3, 1], 9) == [3, 1]
        && set.insert([3, 1], 3) == [3, 1]
        && set.union(empty, [2, 2]) == [2]
        && set.union([2, 2], empty) == [2]
        && set.intersection(empty, [2]) == empty
        && set.intersection([2], empty) == empty
        && set.difference([2, 2], [2]) == empty
        && set.difference(empty, [2]) == empty
        && set.contains(all_same, 7)
        && set.is_empty(set.remove([4], 4))
}
