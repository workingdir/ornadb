[
    case calendar.add_days(2024, 2, 28, 1) {
        Some(date): date == (2024, 2, 29),
        null: false,
    },
    case calendar.add_days(2023, 12, 31, 1) {
        Some(date): date == (2024, 1, 1),
        null: false,
    },
    case calendar.add_days(2024, 3, 1, -1) {
        Some(date): date == (2024, 2, 29),
        null: false,
    },
    case calendar.add_weeks(2024, 2, 28, 1) {
        Some(date): date == (2024, 3, 6),
        null: false,
    },
    case calendar.add_weeks(2024, 3, 1, -1) {
        Some(date): date == (2024, 2, 23),
        null: false,
    },
    case calendar.days_between(2024, 2, 28, 2024, 3, 1) {
        Some(days): days == 2,
        null: false,
    },
    case calendar.days_between(2024, 3, 1, 2024, 2, 28) {
        Some(days): days == -2,
        null: false,
    },
    calendar.day_number(2024, 2, 30) == null,
    calendar.add_days(1, 1, 1, -1) == null,
    calendar.add_days(9999, 12, 31, 1) == null,
    calendar.add_weeks(9999, 12, 31, 1) == null,
]
