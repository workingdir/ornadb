(
    query_ops.recursive_cte(
        filter(
            flat_map(
                [10, 0, 20],
                parent => [parent * 10 + 1, parent * 10 + 1]
            ),
            value => value > 1
        ),
        row => [row, row]
    ),
    query_ops.recursive_cte(
        filter(
            flat_map(
                [30, 0, 20],
                parent => [parent * 10 + 1, parent * 10 + 1]
            ),
            value => value > 1
        ),
        row => [row, row]
    )
)
