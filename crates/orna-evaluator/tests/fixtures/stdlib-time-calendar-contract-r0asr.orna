[
    calendar.is_leap_year(2000),
    !calendar.is_leap_year(1900),
    !calendar.is_leap_year(0),
    case calendar.days_in_month(2024, 2) {
        Some(days): days == 29,
        null: false,
    },
    case calendar.days_in_month(1900, 2) {
        Some(days): days == 28,
        null: false,
    },
    calendar.days_in_month(2024, 13) == null,
    calendar.is_valid_date(2000, 2, 29),
    !calendar.is_valid_date(1900, 2, 29),
    case calendar.day_of_year(2024, 2, 29) {
        Some(day): day == 60,
        null: false,
    },
    case calendar.day_of_year(2023, 12, 31) {
        Some(day): day == 365,
        null: false,
    },
    calendar.day_of_year(2024, 4, 31) == null,
]
