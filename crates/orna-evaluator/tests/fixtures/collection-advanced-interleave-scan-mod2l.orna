advanced.intersperse(empty_ints, 0) == empty_ints
&& advanced.intersperse([8], 0) == [8]
&& advanced.intersperse([1, 2, 3], 0) == [1, 0, 2, 0, 3]
&& advanced.scan([1, 2, 3], 0, (total, value) => total + value) == [1, 3, 6]
&& advanced.scan(empty_ints, 10, (total, value) => total + value) == empty_ints
