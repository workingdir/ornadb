if true {
    let filtered = filter([5, 2, 4, 3], value => value % 2 == 0);
    let mapped = map([1, 2], value => value * 10);
    let flattened = flat_map([2, 1], value => [value, value + 10]);
    let sorted = sort_by([3, 1, 2], value => value);
    let taken = take([1, 2, 3], 2);
    let dropped = drop([1, 2, 3], 1);
    let distinct = distinct([2, 1, 2]);
    let unioned = union([1, 2], [2, 3]);
    let unique_row = one([1, 2, 3], value => value == 2);
    let first_value = case first([8, 9]) {
        Some(value): value == 8,
        null: false,
    };
    let minimum = case min([3, 1, 2]) {
        Some(value): value == 1,
        null: false,
    };
    let maximum = case max([3, 1, 2]) {
        Some(value): value == 3,
        null: false,
    };
    [
        filtered == [2, 4],
        mapped == [10, 20],
        flattened == [2, 12, 1, 11],
        sorted == [1, 2, 3],
        taken == [1, 2],
        dropped == [2, 3],
        distinct == [2, 1],
        unioned == [1, 2, 2, 3],
        count([4, 5, 6]) == 3,
        first_value,
        unique_row == 2,
        sum([2, 3, 4]) == 9,
        minimum,
        maximum,
        every([1, 2, 3], value => value > 0),
        exists([1, 2, 3], value => value == 2),
    ]
} else {
    [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false]
}
