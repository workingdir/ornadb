pub fn bad(flag: Bool): Int { case flag {
true: "prefix {outer => { let outer_saved = outer; case outer {
true: inner => { let inner_saved = inner; case inner {
true: first => { case first {
true: 1,
false: 2
} },
false: "second {second => { case second {
true: 3,
false: 4
} }} end",
false 0 { value: 5 },
true 1 { other_value: 6 },
false 2 { third_value: 7 },
true 3 { fourth_value: 8 }
};
middle => { let middle_saved = middle; case middle {
true: third => { case third {
true: 9,
false: 10
} },
false 4 { fifth_value: 11 },
true 5 { sixth_value: 12 },
false 6 { seventh_value: 13 },
true 7 { eighth_value: 14 }
};
finish => { case finish {
true: middle_saved,
false: "finish {flag} tail"
} }
} },
false: outer_finish => { case outer_finish {
true: outer_saved,
false: "outer {flag} tail"
} }
};
root_finish => { case root_finish {
true: outer_saved,
false: "root {flag} tail"
} }
}} suffix",
false: "fallback {flag} done"
}}
