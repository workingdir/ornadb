pub fn bad(flag: Bool): Int { case flag {
true: "outer {root => { let saved = root; case root {
true: first => { case first {
true: 1,
false: 2
} },
false: "middle {second => { case second {
true: 3,
false: 4
} }} suffix",
true: third => { case third {
true: 5,
false: 6
} },
false: "deep {fourth => { let nested = inner => { case inner {
true: 7,
false: 8
} }; case fourth {
true: 9,
false: 10
} }} end",
false 0 { value: 11 },
true 1 { other_value: 12 },
false 2 { third_value: 13 },
true 3 { fourth_value: 14 }
};
finish => { let final_saved = finish; case finish {
true: final_saved,
false: "finish {flag} done"
} }
}} after",
false: "fallback {flag} done"
}}
