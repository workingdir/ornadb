pub fn bad(flag: Bool): Int { case flag {
true: "outer {root => { let saved = root; case root {
true: first => { case first {
true: 1,
false: 2
} },
false: "interpolated {second => { case second {
true: 3,
false: 4
} }} suffix",
true: third => { case third {
true: 5,
false: 6
} },
false 0 { value: 8 },
true 1 { other_value: 9 },
false 2 { third_value: 10 },
true 3 { fourth_value: 11 }
};
finish => { let final_saved = finish; case finish {
true: final_saved,
false: "finish {flag} done"
} }
}} after",
false: "fallback {flag} done"
}}
