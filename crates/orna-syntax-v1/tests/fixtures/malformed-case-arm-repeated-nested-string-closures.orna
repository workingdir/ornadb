pub fn bad(flag: Bool): Int { case flag {
1: 2 3 { value: 4 },
true: 5,
false: outer => { case outer {
true: "outer {outer} remains",
false: inner => { case flag {
true: "middle {inner} stays",
false: last => { case last {
true: "deep {last} before",
false: "first {probe => { case probe {
true: "inner {outer} first end",
false: "inner {flag} first final"
} }} between {other => { case other {
true: "inner {flag} second end",
false: "inner {outer} second final"
} }} remainder"
} }
} }
} }
} }
