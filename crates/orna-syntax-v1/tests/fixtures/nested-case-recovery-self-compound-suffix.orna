pub fn nested(flag: Bool): String {
    "before {case flag {
        true: {
            case flag {
                true 0
                self: "self arm"
                Geo.Packet{payload: [false, true], point: Geo.Point{x: false}} if flag: "packet {case flag {
                    true: "deep true"
                    false: "deep false"
                }}"
            }
        },
        false: "fallback"
    }} after"
}
