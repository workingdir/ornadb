// Natives of std.encoding.json (language-defined, hir.md section 4).

// std.encoding.json.encode
pub native fn encode<T>(value: T): Str effect none;

// std.encoding.json.decode
pub native fn decode<T>(input: Str): T effect none;

// std.encoding.json.decode_with_options
pub native fn decode_with_options<T>(input: Str, ignore_unknown_fields: Bool = false): T effect none;
