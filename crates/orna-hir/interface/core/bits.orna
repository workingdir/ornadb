// Natives of std.bits (language-defined, hir.md section 4).

// std.bits.bit_or
pub native fn bit_or(left: Int, right: Int): Int effect none;

// std.bits.bit_and
pub native fn bit_and(left: Int, right: Int): Int effect none;

// std.bits.bit_xor
pub native fn bit_xor(left: Int, right: Int): Int effect none;

// std.bits.bit_not
pub native fn bit_not(value: Int): Int effect none;

// std.bits.shift_left
pub native fn shift_left(value: Int, count: Int): Int effect none;

// std.bits.shift_right
pub native fn shift_right(value: Int, count: Int): Int effect none;
