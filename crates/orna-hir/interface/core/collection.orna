// Natives of std.collection (language-defined, hir.md section 4).

// std.collection.filter
pub native fn filter<T>(rows: [T], predicate: fn(T): Bool): [T] effect none;

// std.collection.map
pub native fn map<T, U>(rows: [T], transform: fn(T): U): [U] effect none;

// std.collection.flat_map
pub native fn flat_map<T, U>(rows: [T], transform: fn(T): [U]): [U] effect none;

// std.collection.sort_by
pub native fn sort_by<T, K>(rows: [T], key: fn(T): K): [T] effect none;

// std.collection.take
pub native fn take<T>(rows: [T], count: Int): [T] effect none;

// std.collection.drop
pub native fn drop<T>(rows: [T], count: Int): [T] effect none;

// std.collection.distinct
pub native fn distinct<T>(rows: [T]): [T] effect none;

// std.collection.union
pub native fn union<T>(left: [T], right: [T]): [T] effect none;

// std.collection.count
pub native fn count<T>(rows: [T]): Int effect none;

// std.collection.first
pub native fn first<T>(rows: [T]): T? effect none;

// std.collection.last
pub native fn last<T>(rows: [T]): T? effect none;

// std.collection.one
pub native fn one<T>(rows: [T], predicate: fn(T): Bool = value => true): T effect none;

// std.collection.sum
pub native fn sum<T>(rows: [T]): T effect none;

// std.collection.min
pub native fn min<T>(rows: [T]): T? effect none;

// std.collection.max
pub native fn max<T>(rows: [T]): T? effect none;

// std.collection.every
pub native fn every<T>(rows: [T], predicate: fn(T): Bool): Bool effect none;

// std.collection.exists
pub native fn exists<T>(rows: [T], predicate: fn(T): Bool): Bool effect none;

// std.collection.rank
pub native fn rank<T, K>(values: [T], key: fn(T): K): [(T, Int)] effect none;

// std.collection.group_by
pub native fn group_by<T, K>(values: [T], key: fn(T): K): [(K, [T])] effect none;

// std.collection.bucket_by
pub native fn bucket_by<T, P>(rows: [T], period: P, zone: Str): [[T]] effect none;

// std.collection.asof_join
pub native fn asof_join<T, Time, Key>(left: [T], right: [T], time: fn(T): Time, by: fn(T): Key): [(T, T?)] effect none;

// std.collection.__list_length
pub native fn __list_length<T>(values: [T]): Int effect none;

// std.collection.__list_concat
pub native fn __list_concat<T>(left: [T], right: [T]): [T] effect none;

// std.collection.__numeric_sum
pub native fn __numeric_sum<T>(values: [T]): T effect none;

// std.collection.__stable_sort
pub native fn __stable_sort<T, K>(values: [T], key: fn(T): K): [T] effect none;

// std.collection.__minimum
pub native fn __minimum<T>(values: [T]): T? effect none;

// std.collection.__maximum
pub native fn __maximum<T>(values: [T]): T? effect none;

// std.query.__strictly_ordered_time_series
pub native fn __strictly_ordered_time_series<T>(points: [(Instant, T)]): Bool effect none;

// std.query.__window_rate
pub native fn __window_rate<T>(points: [(Instant, T)], size: Int, step: Int): [T?] effect none;

// std.query.__window_rate_integrate
pub native fn __window_rate_integrate<T>(points: [(Instant, T)], size: Int, step: Int): [(T?, T?)] effect none;

// std.query.__window_derivative
pub native fn __window_derivative<T>(points: [(Instant, T)], size: Int, step: Int): [[(Instant, T)]] effect none;

// std.query.__window_integrate
pub native fn __window_integrate<T>(points: [(Instant, T)], size: Int, step: Int): [T?] effect none;
