// Hand-written Orna source, not generated. See README.md in this directory.
//
// core.units: the built-in data-size family (units.md section 8.2). Ordinary unit declarations with no natives. The
// time family (units.md section 8.1) is not declared here yet: its names are the built-in postfix table of
// lower/literals.rs, and declaring them would retype `1.hour` before the kernel maps a time-keyed quantity to
// TyKind::Duration (see the gap list in the change that added this file).

// core.units: data size. Embedded; ordinary Orna.
pub enum Data {
    byte,
    bit = 0.125 byte,
    kB = 1000 byte,
    MB = 1000000 byte,
    GB = 1000000000 byte,
    KiB = 1024 byte,
    MiB = 1048576 byte,
    GiB = 1073741824 byte,
    impl Unit {}
}

// core.units: the affine temperature and energy units the differential corpus uses (units.md sections 2 and 8.5).
// Values are those of the checker's observer catalogue (orna-check FIXTURE_UNIT_SUPPORT): `C` is the affine
// Celsius scale over kelvin with offset 273.15, `kWh` is 3.6e6 joules. The derived values are kept as written;
// their factors are evaluated by the checker, not here. `days` is the 86400-second day, and `m`, `kg`, `s` are the
// base units that `J` and `kWh` are written over. The time family beyond `days` stays in lower/literals.rs.
pub dim Length;
pub dim Mass;
pub dim Time;
pub dim Temperature;
pub dim Energy;
pub unit m : Length base;
pub unit kg : Mass base;
pub unit s : Time base;
pub unit days : Time = 86400.s;
pub unit K : Temperature base;
pub unit C : Temperature = K offset 273.15 affine;
pub unit J : Energy = kg * m * m / (s * s);
pub unit kWh : Energy = 3.6e6.J;
