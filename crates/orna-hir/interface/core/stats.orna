// Natives of std.stats (language-defined, hir.md section 4).

// std.stats.mean
pub native fn mean<T>(rows: [T], scale: Int? = null, rounding: Str? = null): T? effect none;

// std.stats.median
pub native fn median<T>(rows: [T], scale: Int? = null, rounding: Str? = null): T? effect none;

// std.stats.percentile
pub native fn percentile<T, P>(rows: [T], p: P, interpolation: Str, scale: Int? = null, rounding: Str? = null): T? effect none;

// std.stats.sum
pub native fn sum<T>(rows: [T]): T effect none;

// std.stats.min
pub native fn min<T>(rows: [T]): T? effect none;

// std.stats.max
pub native fn max<T>(rows: [T]): T? effect none;

// std.stats.range
pub native fn range<T>(rows: [T]): T? effect none;

// std.stats.mode
pub native fn mode<T>(rows: [T]): [T] effect none;

// std.stats.variance
pub native fn variance<T>(rows: [T], scale: Int? = null, rounding: Str? = null): T? effect none;

// std.stats.standard_deviation
pub native fn standard_deviation<T>(rows: [T], scale: Int? = null, rounding: Str? = null): T? effect none;

// std.stats.histogram
pub native fn histogram<T>(rows: [T], bins: [(T, T)], include_final_upper: Bool = false): [Int] effect none;

// std.stats.rate
pub native fn rate<T>(points: [(Instant, T)]): T? effect none;

// std.stats.derivative
pub native fn derivative<T>(points: [(Instant, T)]): [(Instant, T)] effect none;

// std.stats.integrate
pub native fn integrate<T>(points: [(Instant, T)]): T? effect none;
