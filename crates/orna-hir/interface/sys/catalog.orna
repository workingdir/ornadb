// Engine-embedded module `sys.catalog`, hand-maintained (decision D19, sys-as-native section 2.2). It holds the 32
// catalogue relation handles. Each handle is a `table_read` native static whose row type is declared in `sys.orna`;
// its full path is `sys.catalog.<name>`. The structural equivalence test in orna-check compares these declarations
// with the `grouped_handle` entries of the JSON catalogue.

pub native static databases: Relation<sys.Database> effect table_read;
pub native static namespaces: Relation<sys.Namespace> effect table_read;
pub native static modules: Relation<sys.Module> effect table_read;
pub native static imports: Relation<sys.Import> effect table_read;
pub native static files: Relation<sys.File> effect table_read;
pub native static objects: Relation<sys.Object> effect table_read;
pub native static revisions: Relation<sys.Revision> effect table_read;
pub native static definitions: Relation<sys.Definition> effect table_read;
pub native static types: Relation<sys.Type> effect table_read;
pub native static type_parameters: Relation<sys.TypeParameter> effect table_read;
pub native static fields: Relation<sys.Field> effect table_read;
pub native static variants: Relation<sys.Variant> effect table_read;
pub native static protocols: Relation<sys.Protocol> effect table_read;
pub native static protocol_members: Relation<sys.ProtocolMember> effect table_read;
pub native static implementations: Relation<sys.Implementation> effect table_read;
pub native static functions: Relation<sys.Function> effect table_read;
pub native static parameters: Relation<sys.Parameter> effect table_read;
pub native static effects: Relation<sys.Effect> effect table_read;
pub native static tables: Relation<sys.Table> effect table_read;
pub native static columns: Relation<sys.Column> effect table_read;
pub native static keys: Relation<sys.Key> effect table_read;
pub native static assertions: Relation<sys.Assertion> effect table_read;
pub native static references: Relation<sys.Reference> effect table_read;
pub native static pages: Relation<sys.Page> effect table_read;
pub native static dimensions: Relation<sys.Dimension> effect table_read;
pub native static units: Relation<sys.Unit> effect table_read;
pub native static currencies: Relation<sys.Currency> effect table_read;
pub native static secret_requirements: Relation<sys.SecretRequirement> effect table_read;
pub native static extensions: Relation<sys.Extension> effect table_read;
pub native static dependencies: Relation<sys.Dependency> effect table_read;
pub native static secrets: Relation<sys.Secret> effect table_read;
pub native static settings: Relation<sys.Setting> effect table_read;
