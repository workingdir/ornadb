// Engine-embedded module `sys.engine`, hand-maintained (decision D19). It holds the failure codes that this engine
// adds to the 1.1.0 set (sys-as-native section 3.4, decision F1). These codes are not part of the portable `sys`
// vocabulary, so the enum is private and stays out of the user-visible surface. Each variant spells its code:
// `sys.host.filesystem.not_found` is `host__filesystem__not_found`. The parity test in orna-sys-id reads this file
// with orna-syntax and compares it with `catalogue/engine-1.1.0.json`.

enum FailureCode {
    abi__argument_count_mismatch,
    abi__argument_type_mismatch,
    abi__duplicate_role_contract,
    abi__duplicate_role_provider,
    abi__effect_incompatible,
    abi__precondition_failed,
    abi__provider_failed,
    abi__provider_not_executable,
    abi__provider_not_selected,
    abi__result_type_mismatch,
    abi__role_unavailable,
    abi__role_version_mismatch,
    abi__unavailable,
    abi__undeclared_failure,
    abi__unknown_operation,
    abi__unknown_role,
    database__missing,
    dependencies__conflicting_duplicate,
    dependencies__invalid_object,
    dependencies__invalid_snapshot,
    dependencies__invalid_span,
    dependencies__limit,
    dependencies__object_unavailable,
    dependencies__unknown_endpoint,
    failure__not_declared,
    host__clock__cancelled,
    host__clock__denied,
    host__environment__denied,
    host__environment__invalid_name,
    host__environment__unavailable,
    host__environment__unset,
    host__filesystem__already_exists,
    host__filesystem__denied,
    host__filesystem__invalid_request,
    host__filesystem__invalid_utf8,
    host__filesystem__not_directory,
    host__filesystem__not_file,
    host__filesystem__not_found,
    host__filesystem__output_limit,
    host__filesystem__unavailable,
    host__http__body_limit,
    host__http__cancelled,
    host__http__denied,
    host__http__header_limit,
    host__http__invalid_request,
    host__http__timeout,
    host__http__unavailable,
    host__process__denied,
    host__process__invalid_request,
    host__process__output_limit,
    host__process__timeout,
    host__process__unavailable,
    invoke__cancelled,
    invoke__malformed_completion,
    invoke__orphaned,
    invoke__source_mismatch,
    invoke__start_mode,
    invoke__target,
    meta__invalid_metadata,
    meta__type_unavailable,
    runtime__unavailable,
}
