// Root environment natives (hir.md 2.6, D12). Host-implemented; effects per EFFECT_CLASS.
// Engine-embedded `core` (D12): body-less `native fn` declarations are admitted only here
// and in `core/*.orna`. Re-exported by std where stable paths are wanted.

// core.Error: the failure value (language reference 04-effects-and-failure.md).
pub type Error {
    pub code: Str,
    pub message: Str,
    pub cause: Error?,
}

// core.Ordering: Result of `Order.compare` (kernel-and-library.md listing 5).
pub enum Ordering {
    less,
    equal,
    greater,
}

// core.Rounding: Decimal rounding modes (kernel-and-library.md candidate 8); replaces the name-based rounding words.
pub enum Rounding {
    half_even,
    half_up,
    toward_zero,
    away_from_zero,
    floor,
    ceil,
}

// core.Some
pub native fn Some<T>(value: T): T? effect none;

// core.now
pub native fn now(): Instant effect clock;

// core.uuid7
pub native fn uuid7(): Uuid effect randomness;

// core.error
pub native fn error(code: Str, message: Str, cause: Error? = null): Error effect none;

// core.CWD and core.HEAD: the context-bound snapshot selectors (language reference section 9). Host-supplied from the
// activation context; they are not wall-clock values. `HEAD` fails in an unborn repository (sys.git.unborn_head).
pub native static CWD: sys.SnapshotRef effect none;
pub native static HEAD: sys.SnapshotRef effect none;
