// sys.blob.annotate
pub native fn blob_annotate(value: Blob, media_type: Str, suffix: Str? = null): Blob effect table_read;

// sys.blob.same_content
pub native fn blob_same_content(left: Blob, right: Blob): Bool effect table_read;
