// The 67 portable failure codes of sys-1.1.0, in catalogue order (sys-as-native section 3.4, decision F1). Each
// variant spells its code: `sys.object.not_found` is `object__not_found`. The enum is private, so it stays out of the
// user-visible surface; the parity test in orna-sys-id reads it with orna-syntax.
enum FailureCode {
    version__incompatible,
    context__repl_unavailable,
    object__not_found,
    object__ambiguous,
    object__wrong_kind,
    snapshot__not_found,
    snapshot__incomplete,
    source__unavailable,
    source__redacted,
    handle__foreign_runtime,
    handle__expired,
    invoke__argument_missing,
    invoke__argument_unknown,
