// sys.invoke(Value)
/// Reflectively invoke and return an explicitly erased value envelope.
///
/// Snapshot rule: An omitted at selects the FunctionRef pin; an explicit different database or snapshot
/// fails sys.invoke.snapshot_mismatch. Historical snapshots permit read-only table access.
pub native fn invoke_value(function: FunctionRef, arguments: ArgumentMap, at: SnapshotRef? = null, transaction: InvokeTransaction = InvokeTransaction.inherit, idempotency_key: Str? = null): Value effect runtime_admin spelling "sys.invoke(Value)";

// sys.invoke<T>
/// Reflectively invoke after validating the declared result against an explicit type witness.
///
/// Snapshot rule: An omitted at selects the FunctionRef pin; an explicit different database or snapshot
/// fails sys.invoke.snapshot_mismatch. Historical snapshots permit read-only table access.
pub native fn invoke_t<T>(function: FunctionRef, arguments: ArgumentMap, as: T, at: SnapshotRef? = null, transaction: InvokeTransaction = InvokeTransaction.inherit, idempotency_key: Str? = null): T effect runtime_admin spelling "sys.invoke<T>";

// sys.start(Value)
/// Start an awaitable invocation with an explicitly erased result.
///
/// Ownership: Current operation owns the child, except a direct REPL sys.start expression/binding is
/// session-owned. Inherit transaction mode is rejected; separate/read_only are permitted.
///
/// Snapshot rule: An omitted at selects the FunctionRef pin; an explicit different database or snapshot
/// fails sys.invoke.snapshot_mismatch. Historical snapshots permit read-only table access.
pub native fn start_value(function: FunctionRef, arguments: ArgumentMap, at: SnapshotRef? = null, transaction: InvokeTransaction = InvokeTransaction.separate, idempotency_key: Str? = null): InvocationHandle<Value> effect runtime_admin spelling "sys.start(Value)";

// sys.start<T>
/// Start an awaitable invocation after validating an explicit result type witness.
///
/// Ownership: Current operation owns the child, except a direct REPL sys.start expression/binding is
/// session-owned. Inherit transaction mode is rejected; separate/read_only are permitted.
///
/// Snapshot rule: An omitted at selects the FunctionRef pin; an explicit different database or snapshot
/// fails sys.invoke.snapshot_mismatch. Historical snapshots permit read-only table access.
pub native fn start_t<T>(function: FunctionRef, arguments: ArgumentMap, as: T, at: SnapshotRef? = null, transaction: InvokeTransaction = InvokeTransaction.separate, idempotency_key: Str? = null): InvocationHandle<T> effect runtime_admin spelling "sys.start<T>";

// sys.await
/// Wait for a terminal result; timeout does not cancel.
pub native fn await<T>(invocation: InvocationHandle<T>, timeout: Duration? = null): InvocationResult<T> effect runtime_admin;

// sys.cancel
/// Idempotently request invocation cancellation.
pub native fn cancel<T>(invocation: InvocationHandle<T>, reason: Str? = null): Bool effect runtime_admin;

