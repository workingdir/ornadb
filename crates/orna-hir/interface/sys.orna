/// One durable blocked or preserved delivery; repeated attempts update this record.
///
/// Invariants:
/// - attempt_count starts at one after the first failure and is monotonic
/// - version changes on every committed state transition
/// - position digest accelerates lookup but does not substitute for canonical position equality
/// - retry failure updates this record without creating a successor record
/// - only one retry or replay may hold this delivery lease
/// - payload is redacted unless the explicit privileged payload-access boundary permits disclosure
pub type Failure key consumer_identity, source_identity, partition, position_format, position availability "local-durable" {
    pub reference: FailureRef,
    pub consumer: FunctionRef,
    pub consumer_identity: ConsumerIdentity,
    pub source_identity: Str,
    pub partition: Str?,
    pub position_format: Str,
    pub position: CheckpointPosition,
    pub position_digest: Digest,
    pub version: FailureVersion,
    pub attempt_count: Int,
    pub last_attempt_at: Instant?,
    pub payload: Blob?,
    pub payload_reference: Str?,
    pub payload_digest: Digest?,
    pub error: Diagnostic,
    pub created: Instant,
    pub status: FailureStatus,
    pub status_changed: Instant,
    pub reason: Str?,
    pub replayed_at: Instant?,
    pub replacement_invocation: InvocationRef?,
    pub checkpoint_before: CheckpointPosition,
    pub checkpoint_after: CheckpointPosition?,
    pub checkpoint_version_before: CheckpointVersion,
}

