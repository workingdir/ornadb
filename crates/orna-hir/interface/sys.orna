/// Snapshot/runtime-pinned reference to one canonical system-relation row.
///
/// Kind: opaque-generic
///
/// Invariants:
/// - preserves the row natural key and resolution context
/// - does not grant authority
/// - live references are runtime-generation-bound
pub type RowRef<T> {}

/// Explicit existential envelope for a value crossing a reflective system boundary.
///
/// Kind: opaque
///
/// Invariants:
/// - is not a dynamic Any fallback
/// - retains the exact originating static type
/// - cannot be implicitly unboxed or converted
pub type Value {
    type: TypeRef,
    redacted: Bool,
    canonical_digest: Digest?,
}

/// One named typed reflective-call argument.
///
/// Kind: record
pub type Argument {
    pub name: Str,
    pub value: Value,
}

/// Immutable ordered collection of uniquely named reflective-call arguments.
///
/// Kind: record
///
/// Invariants:
/// - names are unique
/// - canonical order is Unicode scalar-value order by name
/// - record literals are boxed only under an ArgumentMap expected type
pub type ArgumentMap {
    pub entries: [Argument],
}

/// Safe type, protocol and codec metadata for a value without private-field disclosure.
///
/// Kind: record-generic
pub type ValueMetadata<T> {
    pub static_type: TypeRef,
    pub nominal_type: TypeRef?,
    pub protocols: Relation<Protocol>,
    pub codecs: [Str],
    pub redacted: Bool,
}

/// Operational handle for one accepted invocation in one runtime generation.
///
/// Kind: opaque-generic
///
/// Invariants:
/// - resumable is false in 1.0
/// - usable only by sys.await and sys.cancel
/// - descriptive decoding never revives operational authority
pub type InvocationHandle<T> {
    invocation: InvocationRef,
    runtime: RuntimeId,
    result_type: TypeRef,
    resumable: Bool,
}

/// Complete terminal result returned by sys.await.
///
/// Kind: record-generic
///
/// Invariants:
/// - status is terminal
/// - succeeded has value and no failure
/// - failed has failure and no value
/// - cancelled/orphaned have no value and may carry a diagnostic
pub type InvocationResult<T> {
    pub invocation: InvocationRef,
    pub status: InvocationStatus,
    pub value: T?,
    pub failure: Diagnostic?,
    pub started: Instant?,
    pub ended: Instant,
    pub duration: Duration?,
}

/// Snapshot-pinned reference to a resolved expression in a definition.
///
/// Kind: opaque
pub type ExpressionRef {
    owner: ObjectRef,
    definition: DefinitionRef,
    span: SourceSpan,
    semantic_hash: Digest,
}

/// Half-open canonical UTF-8 source range with one-based human coordinates.
///
/// Kind: record
///
/// Invariants:
/// - 0 <= start_byte <= end_byte
/// - line and column values are one-based
pub type SourceSpan {
    pub file: FileRef,
    pub start_byte: Int,
    pub end_byte: Int,
    pub start_line: Int,
    pub start_column: Int,
    pub end_line: Int,
    pub end_column: Int,
}

/// Mapping from a generated span to an authored span and optional original name.
///
/// Kind: record
pub type SourceMapEntry {
    pub generated: SourceSpan,
    pub original: SourceSpan?,
    pub original_name: Str?,
}

/// One source label attached to a structured diagnostic.
///
/// Kind: record
pub type DiagnosticLabel {
    pub span: SourceSpan,
    pub message: Str,
    pub primary: Bool,
}

/// Exact retained source plus source maps and explicit unavailability state.
///
/// Kind: record
///
/// Invariants:
/// - text and unavailable_reason are not both absent
/// - text hashes to exact_hash after canonical decoding
pub type SourceDocument {
    pub file: FileRef,
    pub snapshot: SnapshotRef,
    pub text: Str?,
    pub exact_hash: Digest,
    pub encoding: Str,
    pub generated: Bool,
    pub maps: Relation<SourceMapEntry>,
    pub unavailable_reason: Str?,
}

/// Source or semantic blame attribution for one exact target range.
///
/// Kind: record
pub type Attribution {
    pub file: FileRef,
    pub span: SourceSpan,
    pub snapshot: SnapshotRef,
    pub commit: CommitRef?,
    pub author: PersonIdentity?,
    pub authored_at: Instant?,
    pub object: ObjectRef?,
    pub semantic: Bool,
}

/// Git-compatible authored identity without signing or authorization semantics.
///
/// Kind: record
pub type PersonIdentity {
    pub name: Str,
    pub email: Str?,
}

/// Structured summary of one semantic object at its pinned revision.
///
/// Kind: record
pub type ObjectDescription {
    pub object: ObjectRef,
    pub revision: RevisionRef,
    pub kind: ObjectKind,
    pub qualified_name: Str,
    pub definition: DefinitionRef?,
    pub docs: Str?,
    pub signature: Str?,
    pub metadata: Value,
}

/// Structured causal explanation of a diagnostic.
///
/// Kind: record
pub type Explanation {
    pub diagnostic: Diagnostic,
    pub summary: Str,
    pub causes: [Diagnostic],
    pub suggestions: [Str],
    pub related_objects: [ObjectRef],
    pub plan: PlanRef?,
}

/// Provider-specific replay position with portable equality and canonical encoding.
///
/// Kind: opaque
///
/// Invariants:
/// - payload is not generically orderable
/// - equality includes format and canonical payload
/// - provider APIs own construction and comparison beyond equality
pub type CheckpointPosition {
    format: Str,
    digest: Digest,
}

/// Compatibility tuple embedded in builds and artifacts.
///
/// Kind: record
pub type CompatibilityInfo {
    pub language_version: Str,
    pub sys_version: Str,
    pub canonical_orna_codec_version: Str,
    pub repository_layout_version: Str,
    pub storage_manifest_version: Str,
    pub presentation_protocol_version: Str,
    pub supported_profiles: [Str],
}

/// Exact language, sys, storage, presentation and implementation coordinates for the current runtime.
///
/// Kind: record
pub type RuntimeInfo {
    pub language_version: Str,
    pub sys_version: Str,
    pub canonical_orna_codec_version: Str,
    pub repository_layout_version: Str,
    pub storage_manifest_version: Str,
    pub presentation_protocol_version: Str,
    pub implementation_name: Str,
    pub implementation_version: Str,
    pub build_id: Str,
    pub supported_profiles: [Str],
    pub runtime: RuntimeId,
    pub mode: RuntimeMode,
    pub read_only: Bool,
    pub std_snapshot: SnapshotRef?,
    pub unicode_version: Str,
    pub timezone_database_version: Str?,
}

/// Result of sealing durable pending rows without a logical data change.
///
/// Kind: record
///
/// Invariants:
/// - semantic_changes is zero
pub type FlushResult {
    pub tables: [TableRef],
    pub rows: Int,
    pub segments: [SegmentRef],
    pub bytes: Int,
    pub generation: Int,
    pub semantic_changes: Int,
}

/// Physical maintenance result for the one indexed profile; segment-named fields refer to observed
/// bounded storage pages.
///
/// Kind: record
///
/// Invariants:
/// - semantic_changes is zero
pub type CompactionResult {
    pub tables: [TableRef],
    pub input_segments: [SegmentRef],
    pub output_segments: [SegmentRef],
    pub rows: Int,
    pub bytes_before: Int,
    pub bytes_after: Int,
    pub generation: Int,
    pub semantic_changes: Int,
}

/// Structured integrity-verification outcome.
///
/// Kind: record
///
/// Invariants:
/// - invalid has at least one error/fatal diagnostic
/// - valid has no error/fatal diagnostic
pub type VerificationReport {
    pub scope: VerifyScope,
    pub status: VerificationStatus,
    pub started: Instant,
    pub ended: Instant,
    pub checked: Value,
    pub diagnostics: Relation<Diagnostic>,
}

/// Immutable activation-local cancellation observation.
///
/// Kind: record
pub type CancellationView {
    pub requested: Bool,
    pub reason: Str?,
    pub requested_at: Instant?,
}

/// Session-local presentation selection for one type.
///
/// Kind: record
pub type PresentationOverride {
    pub type: TypeRef,
    pub renderer: Str?,
    pub mode: Str,
    pub formatter: FunctionRef?,
}

/// REPL watch expression and its most recent safe observation.
///
/// Kind: record
pub type Watch {
    pub expression: ExpressionRef,
    pub label: Str?,
    pub last_value: Value?,
    pub last_diagnostic: Diagnostic?,
    pub updated: Instant?,
}

/// Current attached database/worktree descriptor exposed by sys.database.
///
/// Kind: record
pub type DatabaseView {
    pub id: DatabaseId,
    pub name: Str,
    pub root: Path,
    pub root_module: ModuleRef,
    pub cwd: SnapshotRef,
    pub head: SnapshotRef?,
    pub branch: BranchRef?,
    pub writable: Bool,
    pub attached_as: Str?,
    pub repository_layout_version: Str,
    pub storage_manifest_version: Str,
}

/// Immutable context of the current activation exposed by sys.current.
///
/// Kind: record
pub type CurrentContext {
    pub snapshot: SnapshotRef,
    pub transaction: TransactionRef?,
    pub invocation: InvocationRef?,
    pub run: RunRef?,
    pub session: SessionRef?,
    pub client: ClientRef?,
    pub logical_cwd: Path,
    pub locale: Locale,
    pub timezone: TimeZone,
    pub trace: TraceRef?,
    pub cancellation: CancellationView,
    pub present_context: PresentContext,
}

/// Current live runtime owner and live relation handles exposed by sys.rt.
///
/// Kind: record
pub type RuntimeView {
    pub id: RuntimeId,
    pub mode: RuntimeMode,
    pub started: Instant,
    pub owner_pid: Int?,
    pub owner_endpoint: Str?,
    pub read_only: Bool,
    pub runs: Relation<Run>,
    pub streams: Relation<Stream>,
    pub transactions: Relation<Transaction>,
    pub invocations: Relation<Invocation>,
    pub queries: Relation<Query>,
    pub sessions: Relation<Session>,
    pub clients: Relation<Client>,
    pub traces: Relation<Trace>,
    pub failures: Relation<Failure>,
    pub diagnostics: Relation<Diagnostic>,
    pub leases: Relation<Lease>,
    pub listeners: Relation<Listener>,
    pub plans: Relation<Plan>,
    pub plan_nodes: Relation<PlanNode>,
    pub invocation_arguments: Relation<InvocationArgument>,
    pub spans: Relation<Span>,
    pub events: Relation<TraceEvent>,
    pub checkpoints: Relation<Checkpoint>,
    pub checkpoint_updates: Relation<CheckpointUpdate>,
}

/// Interactive session presentation and watch state exposed by sys.repl.
///
/// Kind: record
pub type ReplView {
    pub session: SessionRef,
    pub renderer: Str,
    pub width: Int?,
    pub height: Int?,
    pub locale: Locale,
    pub timezone: TimeZone,
    pub presentation_overrides: Relation<PresentationOverride>,
    pub watched_expressions: Relation<Watch>,
}

/// Availability: always while a database is attached
pub native static database: DatabaseView effect none;
/// Availability: every activation
pub native static current: CurrentContext effect none;
/// Availability: every command/runtime owner
pub native static rt: RuntimeView effect none formerly "sys.runtime" diagnostic "ORNA100-E-SYS-RUNTIME";
/// Availability: REPL only; otherwise sys.context.repl_unavailable
pub native static repl: ReplView effect none;

/// Discriminated identity of one changed semantic object, source file or table row.
///
/// Kind: record
///
/// Invariants:
/// - object: only object is present; file: only file is present; row: only table and row_key are present
/// - row_key retains a non-secret key type and canonical value
/// - equality includes kind and all populated identity fields
pub type ChangeTarget {
    pub kind: ChangeTargetKind,
    pub object: ObjectId?,
    pub file: FileId?,
    pub table: ObjectId?,
    pub row_key: Value?,
}

/// A three-way merge conflict between incomparable or divergent checkpoint positions.
///
/// Kind: record
///
/// Invariants:
/// - reason is divergent_position, incompatible_format, or delete_update
/// - opaque positions are never numerically ordered
pub type CheckpointConflict {
    pub consumer_identity: ConsumerIdentity,
    pub source_identity: Str,
    pub partition: Str?,
    pub base: CheckpointPosition?,
    pub left: CheckpointPosition?,
    pub right: CheckpointPosition?,
    pub left_snapshot: SnapshotRef,
    pub right_snapshot: SnapshotRef,
    pub reason: Str,
}

/// A three-way merge conflict at one stable table identity and primary key.
///
/// Kind: record
///
/// Invariants:
/// - absence means no row, not a row with null fields
/// - reason is update_update, delete_update, key_collision, or assertion_failure
pub type RowConflict {
    pub table: TableRef,
    pub key: Value,
    pub base: Value?,
    pub left: Value?,
    pub right: Value?,
    pub reason: Str,
}

/// Read-only preview bound to the exact target and local worktree state.
///
/// Kind: record
///
/// Invariants:
/// - token is a domain-separated digest of all plan inputs in canonical order
/// - the plan performs no mutation
/// - force is not permission to accept a stale token
pub type CheckoutPlan {
    pub token: Digest,
    pub target: SnapshotRef,
    pub target_branch: Str?,
    pub base_head: GitOid?,
    pub cwd: SnapshotRef,
    pub index_digest: Digest,
    pub worktree_digest: Digest,
    pub pending_generation: Int,
    pub would_discard: [ChangeTarget],
    pub active_consumers: [ConsumerIdentity],
    pub conflicts: [Diagnostic],
}

/// Nonserialisable owner/runtime-bound incremental Blob capture.
///
/// Kind: opaque
///
/// Invariants:
/// - states are open, finished, aborted
/// - a handle is not a stored Blob or a portable reference
/// - declared total and per-call limits are enforced before mutation
/// - finish protects and returns immutable content; no user row or branch is implicitly created
pub type BlobWriter {}

/// Non-authorising, state-bound review of the exact staged Git candidate.
///
/// Kind: record
///
/// Invariants:
/// - all fields and the exact format coordinate enter the review token
/// - supplying the record does not grant administrative authority
/// - an altered or stale review fails before ref visibility
pub type CommitReview {
    pub token: Digest,
    pub head: GitOid?,
    pub head_ref: Str?,
    pub index_tree: GitOid,
    pub index_digest: Digest,
    pub worktree_digest: Digest,
    pub cwd: SnapshotRef,
    pub pending_generation: Int,
}

/// Database/worktree attachments visible at a snapshot.
pub type Database key id availability "catalogue" {
    pub reference: DatabaseRef,
    pub id: DatabaseId,
    pub name: Str,
    pub root: Path,
    pub root_module: ModuleRef,
    pub cwd: SnapshotRef,
    pub head: SnapshotRef?,
    pub branch: BranchRef?,
    pub writable: Bool,
    pub attached_as: Str?,
    pub repository_layout_version: Str,
    pub storage_manifest_version: Str,
}

/// Resolved namespace tree.
pub type Namespace key object availability "catalogue" {
    pub reference: NamespaceRef,
    pub object: ObjectRef,
    pub database: DatabaseRef,
    pub name: Str,
    pub parent: NamespaceRef?,
    pub docs: Str?,
}

/// Resolved source module.
pub type Module key object availability "catalogue" {
    pub reference: ModuleRef,
    pub object: ObjectRef,
    pub namespace: NamespaceRef,
    pub file: FileRef,
    pub semantic_hash: Digest,
    pub reachable: Bool,
    pub diagnostics: Relation<Diagnostic>,
}

/// Resolved import edge.
pub type Import key module, position availability "catalogue" {
    pub reference: ImportRef,
    pub module: ModuleRef,
    pub position: Int,
    pub source: Str,
    pub target: ObjectRef?,
    pub alias: Str?,
    pub visibility: Visibility,
    pub span: SourceSpan,
}

/// Repository file/source unit metadata.
pub type File key id availability "catalogue" {
    pub reference: FileRef,
    pub id: FileId,
    pub database: DatabaseRef,
    pub path: Path,
    pub kind: FileKind,
    pub git_object: GitObjectRef?,
    pub exact_hash: Digest,
    pub size: Int,
    pub status: ChangeKind?,
    pub text_available: Bool,
    pub generated: Bool,
}

/// Stable semantic object identity at a snapshot.
pub type Object key id, snapshot availability "catalogue" {
    pub reference: ObjectRef,
    pub id: ObjectId,
    pub kind: ObjectKind,
    pub qualified_name: Str,
    pub current_revision: RevisionRef,
    pub definition: DefinitionRef?,
    pub visibility: Visibility,
    pub snapshot: SnapshotRef,
}

/// Immutable semantic revision of a stable object.
pub type Revision key id availability "catalogue" {
    pub reference: RevisionRef,
    pub id: RevisionId,
    pub object: ObjectRef,
    pub semantic_hash: Digest,
    pub source_hash: Digest?,
    pub introduced_in: SnapshotRef?,
    pub supersedes: RevisionRef?,
    pub definition: DefinitionRef?,
}

/// Source definition and span of an object revision.
pub type Definition key id availability "catalogue" {
    pub reference: DefinitionRef,
    pub id: DefinitionId,
    pub object: ObjectRef,
    pub module: ModuleRef,
    pub file: FileRef,
    pub span: SourceSpan,
    pub docs: Str?,
}

/// Resolved static type declaration or constructed type metadata.
pub type Type key object availability "catalogue" {
    pub reference: TypeRef,
    pub object: ObjectRef,
    pub kind: TypeKind,
    pub transparent: Bool,
    pub base: TypeRef?,
    pub parameters: Relation<TypeParameter>,
    pub fields: Relation<Field>,
    pub variants: Relation<Variant>,
    pub assertions: Relation<Assertion>,
}

/// Generic parameter and protocol bounds.
pub type TypeParameter key owner, position availability "catalogue" {
    pub reference: TypeParameterRef,
    pub owner: ObjectRef,
    pub name: Str,
    pub position: Int,
    pub bounds: Relation<Protocol>,
    pub inferred: Bool,
}

/// Nominal type field metadata.
pub type Field key object availability "catalogue" {
    pub reference: FieldRef,
    pub object: ObjectRef,
    pub owner: TypeRef,
    pub name: Str,
    pub position: Int,
    pub type: TypeRef,
    pub visibility: Visibility,
    pub docs: Str?,
}

/// Enum/sum variant metadata.
pub type Variant key object availability "catalogue" {
    pub reference: VariantRef,
    pub object: ObjectRef,
    pub owner: TypeRef,
    pub name: Str,
    pub position: Int,
    pub payload_type: TypeRef?,
    pub docs: Str?,
}

/// Protocol declaration metadata.
pub type Protocol key object availability "catalogue" {
    pub reference: ProtocolRef,
    pub object: ObjectRef,
    pub parameters: Relation<TypeParameter>,
    pub members: Relation<ProtocolMember>,
    pub docs: Str?,
}

/// Required protocol function or static property.
pub type ProtocolMember key object availability "catalogue" {
    pub reference: ProtocolMemberRef,
    pub object: ObjectRef,
    pub protocol: ProtocolRef,
    pub name: Str,
    pub kind: ProtocolMemberKind,
    pub type: TypeRef,
    pub position: Int,
}

/// Nested protocol implementation owned by its target type.
pub type Implementation key object availability "catalogue" {
    pub reference: ImplementationRef,
    pub object: ObjectRef,
    pub protocol: ProtocolRef,
    pub target: TypeRef,
    pub source_type: TypeRef?,
    pub owner: ObjectRef,
    pub members: Relation<Function>,
}

/// Resolved function signature, effects and dependency surface.
pub type Function key object availability "catalogue" {
    pub reference: FunctionRef,
    pub object: ObjectRef,
    pub definition: DefinitionRef,
    pub parameters: Relation<Parameter>,
    pub return_type: TypeRef,
    pub failure_types: Relation<Type>,
