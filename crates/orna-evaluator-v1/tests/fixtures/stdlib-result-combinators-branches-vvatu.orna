std.result.ok(std.result.and(ok_value, second_ok)) == Some(6)
&& std.result.ok(std.result.or(err_value, second_ok)) == Some(6)
&& std.result.ok(std.result.and_then(ok_value, value => second_ok)) == Some(6)
