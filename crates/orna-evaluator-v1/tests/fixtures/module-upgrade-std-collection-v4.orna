fn __list_length<T>(values: [T]): Int = 0;
fn __list_concat<T>(left: [T], right: [T]): [T] = [];
pub fn map<T, U>(rows: [T], transform: fn(T): U): [U] = fail(error(
    code: "ORNA-EVAL-UNSUPPORTED",
    message: "std.collection.map requires its evaluator binding"
));
fn append<T>(values: [T], value: T): [T] = __list_concat(values, [value]);
fn slice_range<T>(values: [T], index: Int, end: Int, output: [T]): [T] =
    if index >= end {
        output
    } else {
        slice_range(values, index + 1, end, append(output, values[index]))
    };
pub fn take<T>(rows: [T], count: Int): [T] =
    if count < 0 {
        fail(error(
            code: "std.collection.negative_count",
            message: "take count must be nonnegative"
        ))
    } else {
        slice_range(rows, 0, if count < __list_length(rows) { count } else { __list_length(rows) }, [])
    };
pub fn drop<T>(rows: [T], count: Int): [T] =
    if count < 0 {
        fail(error(
            code: "std.collection.negative_count",
            message: "drop count must be nonnegative"
        ))
    } else {
        let end = __list_length(rows);
        slice_range(rows, if count < end { count } else { end }, end, [])
    };
pub fn marker(): Int = 4;
