sorting.compare(2, 5) == -1
&& sorting.compare(4, 4) == 0
&& sorting.compare(8, 3) == 1
&& sorting.sort([4, 1, 3, 1, 2]) == [1, 1, 2, 3, 4]
&& sorting.sort_descending([4, 1, 3, 1, 2]) == [4, 3, 2, 1, 1]
&& sorting.sort_by([{id: 9, key: 2}, {id: 4, key: 1}, {id: 7, key: 2}], row => row.key) == [{id: 4, key: 1}, {id: 9, key: 2}, {id: 7, key: 2}]
&& sorting.sort_by_descending([{id: 9, key: 2}, {id: 4, key: 1}, {id: 7, key: 2}], row => row.key) == [{id: 9, key: 2}, {id: 7, key: 2}, {id: 4, key: 1}]
&& std.collection.count(sorting.sort(std.collection.take([5], 0))) == 0
&& sorting.sort_descending([5]) == [5]
&& sorting.is_sorted([1, 2, 2, 4])
&& !sorting.is_sorted([1, 3, 2, 4])
&& sorting.is_sorted_descending([4, 2, 2, 1])
&& !sorting.is_sorted_descending([4, 1, 2])
&& sorting.is_sorted_by([{id: 8, key: 1}, {id: 3, key: 2}, {id: 9, key: 2}], row => row.key)
&& sorting.is_sorted_by_descending([{id: 8, key: 2}, {id: 3, key: 2}, {id: 9, key: 1}], row => row.key)
&& sorting.min_by([{id: 8, key: 2}, {id: 3, key: 1}, {id: 9, key: 1}], row => row.key) == Some({id: 3, key: 1})
&& sorting.max_by([{id: 8, key: 2}, {id: 3, key: 1}, {id: 9, key: 2}], row => row.key) == Some({id: 8, key: 2})
&& sorting.is_sorted(std.collection.take([5], 0))
&& sorting.is_sorted_descending(std.collection.take([5], 0))
&& sorting.min_by(std.collection.take([{id: 5, key: 1}], 0), row => row.key) == null
&& sorting.max_by(std.collection.take([{id: 5, key: 1}], 0), row => row.key) == null
