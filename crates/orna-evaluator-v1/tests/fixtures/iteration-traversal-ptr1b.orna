std.iteration.depth_first(1, iteration_proof.neighbors) == [1, 2, 4, 5, 6, 3]
&& std.iteration.breadth_first(1, iteration_proof.neighbors) == [1, 2, 3, 4, 5, 6]
&& std.iteration.depth_first(9, iteration_proof.neighbors) == [9]
&& std.iteration.breadth_first(9, iteration_proof.neighbors) == [9]
&& std.iteration.reachable(1, 6, iteration_proof.neighbors)
&& !std.iteration.reachable(1, 9, iteration_proof.neighbors)
&& std.iteration.reachable(1, 2, iteration_proof.target_edges)
