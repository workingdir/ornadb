pub fn paired_rebind_depth_values() {
    let lane_at = (root: Int) => (middle: Int) => (leaf: Int) => [root, middle, leaf, root + middle + leaf];
    let paired = {
        left: lane_at(10),
        right: lane_at(20),
    };
    let saved = paired;

    // Rebind both sibling lanes, while saved retains the earlier depth labels.
    paired = {
        left: lane_at(100),
        right: lane_at(200),
    };

    // Member calls are not valid on record fields (ORNA-MEMBER-003), so each
    // field is bound to a local before its callbacks are applied.
    let saved_left = saved.left;
    let saved_right = saved.right;
    let paired_left = paired.left;
    let paired_right = paired.right;
    let saved_depth_left = saved_left(1);
    let saved_depth_right = saved_right(2);
    let rebound_depth_left = paired_left(3);
    let rebound_depth_right = paired_right(4);
    [
        saved_depth_left(5),
        saved_depth_right(6),
        rebound_depth_left(7),
        rebound_depth_right(8),
    ]
}
