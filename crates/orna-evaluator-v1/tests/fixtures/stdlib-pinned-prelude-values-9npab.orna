api_version() == "orna.std.prelude/1"
&& version() == "1.0.0"
&& count([3, 1, 3]) == 3
&& first([7, 8]) == Some(7)
&& unique([3, 1, 3]) == [3, 1]
&& trim(" \tOrna \n") == "Orna"
&& split("a,,b,", ",") == ["a", "", "b", ""]
&& is_some(Some(5))
&& !is_some(absent_integer())
&& is_none(absent_integer())
