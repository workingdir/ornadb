list.concat([1, 2, 3], empty) == [1, 2, 3]
&& list.concat(empty, [1, 2, 3]) == [1, 2, 3]
&& list.concat(empty, empty) == empty
&& list.concat(list.concat([1], [2]), [3]) == list.concat([1], list.concat([2], [3]))
&& list.concat([1, 1], [1]) == [1, 1, 1]
&& list.length(list.concat([1, 2], [3, 4, 5])) == list.length([1, 2]) + list.length([3, 4, 5])
&& list.concat([1, 2], [3]) != list.concat([3], [1, 2])
