stats.sum([1, 2, 3]) == 6
&& stats.min([3, 1, 2]) == first([1])
&& stats.max([3, 1, 2]) == first([3])
&& stats.range([3, 1, 2]) == first([2])
&& stats.mode([3, 1, 3, 2, 2]) == [3, 2]
&& stats.variance([0, 2]) == first([1])
&& stats.standard_deviation([0, 2]) == first([1])
&& stats.histogram([0, 1, 2, 3], [(0, 2), (2, 4)]) == [2, 2]
&& stats.histogram([0, 2, 4], [(0, 2), (2, 4)], include_final_upper: true) == [1, 2]
&& stats.rate([
    (2024-01-01T00:00:00Z, 1),
    (2024-01-01T00:00:02Z, 5),
]) == first([2])
&& stats.derivative([
    (2024-01-01T00:00:00Z, 1),
    (2024-01-01T00:00:02Z, 5),
]) == [(2024-01-01T00:00:02Z, 2)]
&& stats.integrate([
    (2024-01-01T00:00:00Z, 1),
    (2024-01-01T00:00:02Z, 3),
]) == first([4])
