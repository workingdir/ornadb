if true {
    let filtered = collection_ops.filter([5, 2, 4, 3], value => value % 2 == 0);
    let mapped = collection_ops.map([1, 2], value => value * 10);
    let flattened = collection_ops.flat_map([2, 1], value => [value, value + 10]);
    let sorted = collection_ops.sort_by([3, 1, 2], value => value);
    let taken = collection_ops.take([1, 2, 3], 2);
    let dropped = collection_ops.drop([1, 2, 3], 1);
    let distinct = collection_ops.distinct([2, 1, 2]);
    let unioned = collection_ops.union([1, 2], [2, 3]);
    let unique_row = collection_ops.one([1, 2, 3], value => value == 2);
    let first_value = case collection_ops.first([8, 9]) {
        Some(value): value == 8,
        null: false,
    };
    let minimum = case collection_ops.min([3, 1, 2]) {
        Some(value): value == 1,
        null: false,
    };
    let maximum = case collection_ops.max([3, 1, 2]) {
        Some(value): value == 3,
        null: false,
    };
    [
        filtered == [2, 4],
        mapped == [10, 20],
        flattened == [2, 12, 1, 11],
        sorted == [1, 2, 3],
        taken == [1, 2],
        dropped == [2, 3],
        distinct == [2, 1],
        unioned == [1, 2, 2, 3],
        collection_ops.count([4, 5, 6]) == 3,
        first_value,
        unique_row == 2,
        collection_ops.sum([2, 3, 4]) == 9,
        minimum,
        maximum,
        collection_ops.every([1, 2, 3], value => value > 0),
        collection_ops.exists([1, 2, 3], value => value == 2),
    ]
} else {
    [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false]
}
