(
    query_ops.recursive_cte(
        distinct(
            filter([0, 0], value => value > 0)
        ),
        row => [row]
    ),
    query_ops.recursive_cte(
        distinct(
            flat_map(
                filter([2, 0, 1], value => value > 0),
                value => [value * 10, value * 10]
            )
        ),
        row => if row < 30 { [row + 10, row + 10] } else { [row] }
    )
)
