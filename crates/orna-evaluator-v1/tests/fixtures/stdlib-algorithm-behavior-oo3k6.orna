algorithm.lower_bound<Int, Int>([1, 2, 2, 4], 2, (value: Int) => value) == 1
&& algorithm.upper_bound<Int, Int>([1, 2, 2, 4], 2, (value: Int) => value) == 3
&& algorithm.binary_search<Int, Int>([1, 2, 2, 4], 2, (value: Int) => value) != null
&& algorithm.binary_search<Int, Int>([1, 2, 2, 4], 3, (value: Int) => value) == null
&& algorithm.is_sorted_by<Int, Int>([1, 2, 2, 4], (value: Int) => value)
&& !algorithm.is_sorted_by<Int, Int>([1, 3, 2, 4], (value: Int) => value)
