testing.should(true)
&& !testing.should(false)
&& testing.should_be_true(true)
&& !testing.should_be_true(false)
&& testing.should_be_false(false)
&& !testing.should_be_false(true)
&& testing.should_equal(2 + 2, 4)
&& !testing.should_equal(2 + 2, 5)
&& testing.should_not_equal(2, 3)
&& !testing.should_not_equal(3, 3)
&& testing.should_be_some(Some(11))
&& !testing.should_be_some(absent_int())
&& testing.should_be_none(absent_int())
&& !testing.should_be_none(Some(11))
&& testing.should_satisfy(5, value => value > 4)
&& !testing.should_satisfy(4, value => value > 4)
