testing.expect(true)
&& !testing.expect(false)
&& testing.expect_true(true)
&& !testing.expect_true(false)
&& testing.expect_false(false)
&& !testing.expect_false(true)
&& testing.expect_equal(2 + 2, 4)
&& !testing.expect_equal(2 + 2, 5)
&& testing.expect_not_equal(2, 3)
&& !testing.expect_not_equal(3, 3)
&& testing.expect_some(Some(7))
&& !testing.expect_some(absent_int())
&& testing.expect_none(absent_int())
&& !testing.expect_none(Some(7))
