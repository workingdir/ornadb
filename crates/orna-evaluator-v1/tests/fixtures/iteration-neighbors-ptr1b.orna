fn neighbors(node: Int): [Int] =
    if node == 1 {
        [2, 3, 2]
    } else if node == 2 {
        [4, 5]
    } else if node == 3 {
        [5, 6]
    } else if node == 4 {
        [1]
    } else if node == 5 {
        [6]
    } else if node == 6 {
        [3]
    } else {
        std.collection.take([node], 0)
    };
