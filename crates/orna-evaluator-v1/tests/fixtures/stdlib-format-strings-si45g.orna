strings.indent("x", ">") == ">x"
&& strings.repeat("ha", 0) == ""
&& strings.repeat("ha", 3) == "hahaha"
&& strings.repeat("ha", -2) == ""
&& strings.repeat("🦊", 2) == "🦊🦊"
&& strings.pad_left("42", 5) == "   42"
&& strings.pad_right("42", 5, "ab") == "42aba"
&& strings.pad_left("42", 5, "ab") == "aba42"
&& strings.pad_right("42", 5, "") == "42"
&& strings.pad_left("already", 3) == "already"
&& strings.pad_right("é", 3, "🦊") == "é🦊🦊"
&& strings.center("x", 4) == " x  "
&& strings.center("xy", 6, ".") == "..xy.."
&& strings.center("wide", 2) == "wide"
&& strings.center("x", 5, "") == "x"
&& strings.truncate("abcdef", 4) == "abc…"
&& strings.truncate("é🦊abc", 4, "!") == "é🦊a!"
&& strings.truncate("abcdef", 2, "long") == "lo"
&& strings.truncate("abcdef", 3, "") == "abc"
&& strings.truncate("é🦊", 2) == "é🦊"
&& strings.truncate("abcdef", 0) == ""
&& strings.truncate("abcdef", -1) == ""
&& strings.indent("one\ntwo", "> ") == "> one\n> two"
&& strings.indent("one\n\ntwo\n", "  ") == "  one\n  \n  two\n  "
&& strings.indent("", ">") == ">"
