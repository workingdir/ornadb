if true {
    let paired = (seed: Int) => [
        math_ops.shift(seed),
        collection_ops.marker(),
        math_ops.shift(seed) + collection_ops.marker(),
        std.math.shift(seed + 1),
        std.collection.marker(),
        std.math.shift(seed + 1) + std.collection.marker(),
    ];
    paired(7)
} else {
    [0, 0, 0, 0, 0, 0]
}
