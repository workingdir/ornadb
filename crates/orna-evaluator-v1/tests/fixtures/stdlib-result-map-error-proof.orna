std.result.ok(std.result.map_error(ok_value, error => "changed")) == Some(4)
&& std.result.is_ok(std.result.map_error(ok_value, error => fail(error(code: "result.callback.failure", message: "must not run on Ok"))))
&& std.result.err(std.result.map_error(err_value, error => "changed")) == Some("changed")
&& std.result.err(std.result.map_error(err_value, error => error)) == Some("failure")
&& std.result.is_err(std.result.map_error(err_value, error => "changed"))
&& !std.result.is_ok(std.result.map_error(err_value, error => "changed"))
