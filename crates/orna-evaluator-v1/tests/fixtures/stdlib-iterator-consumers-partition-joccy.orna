case std.iterator.consumers.partition(
    std.iterator.from_list([1, 2, 3, 4, 5]),
    value => value % 2 == 0
) {
    (accepted, rejected): accepted == [2, 4] && rejected == [1, 3, 5],
}
&& case std.iterator.consumers.partition(std.iterator.empty(), value => true) {
    (accepted, rejected): accepted == [] && rejected == [],
}
