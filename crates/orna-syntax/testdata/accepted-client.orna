CREATE SCHEMA accepted_client;

CREATE CLIENT FUNCTION accepted_client.enabled()
RETURNS BOOLEAN
AS TRUE;

CREATE CLIENT FUNCTION accepted_client.stateful()
RETURNS BOOLEAN
IS
    STATE ready BOOLEAN SCOPE LOCAL DEFAULT TRUE;
BEGIN
    RETURN TRUE;
END;
CREATE CLIENT FUNCTION accepted_client.v4_stateful()
RETURNS TEXT
IS
    STATE local_value TEXT SCOPE LOCAL DEFAULT 'local';
    STATE session_value TEXT SCOPE SESSION DEFAULT 'session';
    STATE user_value TEXT SCOPE USER;
BEGIN
    RETURN local_value;
END;
