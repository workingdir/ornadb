pub fn bad(flag: Bool): Int { case flag {
true: "start {outer => { let saved = outer; case outer {
true: saved,
false: "prefix {branch => { case branch {
true: 6,
false: 7
} }} suffix",
false 0 { value: 8 },
false 1 { other_value: 9 },
false 2 { third_value: 10 },
false 3 { fourth_value: 11 }
};
finish => { let final_saved = finish; case finish {
true: final_saved,
false: "finish {flag} done"
} }
}} after",
false: "fallback {flag} done"
}}
