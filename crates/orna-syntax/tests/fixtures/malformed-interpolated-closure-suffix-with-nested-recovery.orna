pub fn bad(flag: Bool): Int { case flag {
true: "prefix {outer => { let saved = outer; case outer {
true: first => { case first {
true: 1,
false: 2
} },
false 0 { value: 3 },
true 1 { other_value: 4 },
false 2 { third_value: 5 },
true 3 { fourth_value: 6 }
};
after => { case after {
true: saved,
false: "after {outer} tail"
} }
}} middle {suffix => { let suffix_saved = suffix; case suffix {
true: second => { case second {
true: 7,
false: 8
} },
false: "inner {third => { case third {
true: 9,
false: 10
} }} tail",
false 4 { fifth_value: 11 },
true 5 { sixth_value: 12 },
false 6 { seventh_value: 13 },
true 7 { eighth_value: 14 }
};
finish => { case finish {
true: suffix_saved,
false: "finish {flag} tail"
} }
}} end",
false: "fallback {flag} done"
}}
