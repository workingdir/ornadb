CREATE SCHEMA model;
CREATE TYPE model.item AS OBJECT (value INT);
CREATE TYPE model.state AS ENUM ('ready', 'done');
CREATE TYPE model.pair AS VALUE (left INT, right INT) IMMUTABLE PERSISTABLE;
CREATE TYPE model.id AS VALUE PRIMITIVE KERNEL CONTRACT 'int@1' IMMUTABLE PERSISTABLE;
CREATE TYPE model.bytes AS VALUE OPAQUE KERNEL CONTRACT 'bytes@1' IMMUTABLE TRANSIENT;
CREATE SERVER FUNCTION model.lookup(p_value INT) RETURNS INT AS SELECT p_value;
CREATE CLIENT FUNCTION model.echo(p_value INT) RETURNS INT AS p_value;
