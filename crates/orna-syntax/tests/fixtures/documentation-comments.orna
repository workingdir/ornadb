--| Account data exchanged with the editor.
--| The description supports Markdown `code`.
CREATE TYPE app.Account AS OBJECT (
    --| Stable identity for this account.
    id INTEGER NOT NULL,
    --| Display name visible in the UI.
    display_name TEXT
);

--| Looks up an account by its stable identifier.
CREATE CLIENT FUNCTION app.find_account(
    --| The identity to resolve.
    account_id INTEGER
) RETURNS app.Account AS account_id;

-- ordinary comments are not attached as documentation.
CREATE SCHEMA app;
