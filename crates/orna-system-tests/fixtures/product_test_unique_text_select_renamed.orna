CREATE SCHEMA unique_text_select_test;

CREATE TYPE unique_text_select_test.account AS OBJECT (
    email_address TEXT UNIQUE,
    handle TEXT NOT NULL UNIQUE
);

ALTER TYPE unique_text_select_test.account
    RENAME FIELD email TO email_address;

ALTER TYPE unique_text_select_test.account
    RENAME FIELD username TO handle;

CREATE SERVER FUNCTION unique_text_select_test.create_account(
    p_email TEXT,
    p_username TEXT
)
RETURNS ROWS (created REF unique_text_select_test.account)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO unique_text_select_test.account AS made (email_address, handle)
VALUES (p_email, p_username) RETURNING REF(made);

CREATE SERVER FUNCTION unique_text_select_test.create_account_without_email(
    p_username TEXT
)
RETURNS ROWS (created REF unique_text_select_test.account)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO unique_text_select_test.account AS made (handle)
VALUES (p_username) RETURNING REF(made);

CREATE SERVER FUNCTION unique_text_select_test.find_by_email(p_email TEXT)
RETURNS ROWS (
    account REF unique_text_select_test.account,
    username TEXT
)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT REF(account), account.handle
FROM unique_text_select_test.account account
WHERE account.email_address = p_email;

CREATE SERVER FUNCTION unique_text_select_test.find_by_username(p_username TEXT)
RETURNS ROWS (
    account REF unique_text_select_test.account,
    email TEXT
)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT REF(account), account.email_address
FROM unique_text_select_test.account account
WHERE account.handle = p_username;

CREATE SERVER FUNCTION unique_text_select_test.read_accounts(
    p_account REF unique_text_select_test.account
)
RETURNS ROWS (
    account REF unique_text_select_test.account,
    email TEXT,
    username TEXT
)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT REF(account), account.email_address, account.handle
FROM unique_text_select_test.account account
WHERE REF(account) = p_account;
