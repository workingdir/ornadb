CREATE SERVER FUNCTION scalar_insert_test.read_bigints()
RETURNS ROWS (stored BIGINT)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT bigint_probe.stored FROM scalar_insert_test.bigint_probe bigint_probe;

