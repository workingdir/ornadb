CREATE SCHEMA scalar_insert_test;

CREATE TYPE scalar_insert_test.int_probe AS OBJECT (
    stored INT NOT NULL
);

CREATE SERVER FUNCTION scalar_insert_test.create_int(p_value INT)
RETURNS ROWS (created REF scalar_insert_test.int_probe)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO scalar_insert_test.int_probe AS made (stored)
VALUES (p_value) RETURNING REF(made);

CREATE SERVER FUNCTION scalar_insert_test.read_ints()
RETURNS ROWS (stored INT)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT int_probe.stored FROM scalar_insert_test.int_probe int_probe;

