CREATE SCHEMA unique_text_test;

CREATE TYPE unique_text_test.account AS OBJECT (
    email_address TEXT UNIQUE,
    handle TEXT NOT NULL UNIQUE
);

ALTER TYPE unique_text_test.account
    RENAME FIELD email TO email_address;

ALTER TYPE unique_text_test.account
    RENAME FIELD username TO handle;

CREATE SERVER FUNCTION unique_text_test.create_account(
    p_email TEXT,
    p_username TEXT
)
RETURNS ROWS (created REF unique_text_test.account)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO unique_text_test.account AS made (email_address, handle)
VALUES (p_email, p_username) RETURNING REF(made);

CREATE SERVER FUNCTION unique_text_test.update_account_email(
    p_email TEXT,
    p_account REF unique_text_test.account
)
RETURNS ROWS (updated REF unique_text_test.account)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS UPDATE unique_text_test.account AS changed
SET email_address = p_email
WHERE REF(changed) = p_account
RETURNING REF(changed);

CREATE SERVER FUNCTION unique_text_test.update_account_username(
    p_username TEXT,
    p_account REF unique_text_test.account
)
RETURNS ROWS (updated REF unique_text_test.account)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS UPDATE unique_text_test.account AS changed
SET handle = p_username
WHERE REF(changed) = p_account
RETURNING REF(changed);

CREATE SERVER FUNCTION unique_text_test.read_accounts()
RETURNS ROWS (
    account REF unique_text_test.account,
    email TEXT,
    username TEXT
)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT REF(account), account.email_address, account.handle
FROM unique_text_test.account account;
