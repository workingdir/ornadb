CREATE SCHEMA distinct_test;

CREATE TYPE distinct_test.entry AS OBJECT (
    stored BOOLEAN NOT NULL
);

CREATE SERVER FUNCTION distinct_test.create_true()
RETURNS ROWS (created REF distinct_test.entry)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO distinct_test.entry AS made (stored)
VALUES (TRUE) RETURNING REF(made);

CREATE SERVER FUNCTION distinct_test.create_false()
RETURNS ROWS (created REF distinct_test.entry)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO distinct_test.entry AS made (stored)
VALUES (FALSE) RETURNING REF(made);

CREATE SERVER FUNCTION distinct_test.read_all()
RETURNS ROWS (stored BOOLEAN)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT entry.stored FROM distinct_test.entry entry;

CREATE SERVER FUNCTION distinct_test.read_distinct()
RETURNS ROWS (stored BOOLEAN)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT DISTINCT entry.stored FROM distinct_test.entry entry;
