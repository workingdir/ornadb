CREATE SCHEMA north;

CREATE TYPE north.entry AS OBJECT (
    stored BOOLEAN NOT NULL
);

CREATE SERVER FUNCTION north.create_entry()
RETURNS ROWS (created REF north.entry)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO north.entry AS made (stored)
VALUES (TRUE) RETURNING REF(made);

CREATE SERVER FUNCTION north.read_entries()
RETURNS ROWS (stored BOOLEAN)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT entry.stored FROM north.entry entry;

CREATE SCHEMA south;

CREATE TYPE south.entry AS OBJECT (
    stored BOOLEAN NOT NULL
);

CREATE SERVER FUNCTION south.create_entry()
RETURNS ROWS (created REF south.entry)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO south.entry AS made (stored)
VALUES (FALSE) RETURNING REF(made);

CREATE SERVER FUNCTION south.read_entries()
RETURNS ROWS (stored BOOLEAN)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT entry.stored FROM south.entry entry;
