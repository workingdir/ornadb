CREATE SCHEMA nullable_update_test;

CREATE TYPE nullable_update_test.entry AS OBJECT (
    stored BOOLEAN
);

CREATE SERVER FUNCTION nullable_update_test.create_true()
RETURNS ROWS (created REF nullable_update_test.entry)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO nullable_update_test.entry AS made (stored)
VALUES (TRUE) RETURNING REF(made);

CREATE SERVER FUNCTION nullable_update_test.create_false()
RETURNS ROWS (created REF nullable_update_test.entry)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO nullable_update_test.entry AS made (stored)
VALUES (FALSE) RETURNING REF(made);

CREATE SERVER FUNCTION nullable_update_test.update_null(p_entry REF nullable_update_test.entry)
RETURNS ROWS (updated REF nullable_update_test.entry)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS UPDATE nullable_update_test.entry AS alias
SET stored = NULL
WHERE REF(alias) = p_entry
RETURNING REF(alias);

CREATE SERVER FUNCTION nullable_update_test.read_entries()
RETURNS ROWS (stored BOOLEAN)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT entry.stored FROM nullable_update_test.entry entry;
