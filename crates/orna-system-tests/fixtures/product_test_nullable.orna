CREATE SCHEMA nullable_test;

CREATE TYPE nullable_test.entry AS OBJECT (
    marker BOOLEAN NOT NULL,
    optional BOOLEAN
);

CREATE SERVER FUNCTION nullable_test.create_omitted()
RETURNS ROWS (created REF nullable_test.entry)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO nullable_test.entry AS made (marker)
VALUES (FALSE) RETURNING REF(made);

CREATE SERVER FUNCTION nullable_test.create_present()
RETURNS ROWS (created REF nullable_test.entry)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO nullable_test.entry AS made (marker, optional)
VALUES (TRUE, FALSE) RETURNING REF(made);

CREATE SERVER FUNCTION nullable_test.read_omitted()
RETURNS ROWS (optional BOOLEAN)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT entry.optional FROM nullable_test.entry entry WHERE entry.marker = FALSE;

CREATE SERVER FUNCTION nullable_test.read_present()
RETURNS ROWS (optional BOOLEAN)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT entry.optional FROM nullable_test.entry entry WHERE entry.marker = TRUE;
