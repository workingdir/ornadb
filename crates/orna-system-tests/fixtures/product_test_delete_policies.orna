CREATE SCHEMA delete_policy_test;

CREATE TYPE delete_policy_test.root AS OBJECT (
    stored BOOLEAN NOT NULL
);

CREATE TYPE delete_policy_test.no_action_child AS OBJECT (
    root REF delete_policy_test.root NOT NULL
);

CREATE TYPE delete_policy_test.restrict_child AS OBJECT (
    root REF delete_policy_test.root NOT NULL ON DELETE RESTRICT
);

CREATE TYPE delete_policy_test.set_null_child AS OBJECT (
    root REF delete_policy_test.root ON DELETE SET NULL
);

CREATE TYPE delete_policy_test.cascade_child AS OBJECT (
    root REF delete_policy_test.root NOT NULL ON DELETE CASCADE
);

CREATE SERVER FUNCTION delete_policy_test.create_root()
RETURNS ROWS (created REF delete_policy_test.root)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO delete_policy_test.root AS made (stored)
VALUES (TRUE) RETURNING REF(made);

CREATE SERVER FUNCTION delete_policy_test.create_no_action(p_root REF delete_policy_test.root)
RETURNS ROWS (created REF delete_policy_test.no_action_child)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO delete_policy_test.no_action_child AS made (root)
VALUES (p_root) RETURNING REF(made);

CREATE SERVER FUNCTION delete_policy_test.create_restrict(p_root REF delete_policy_test.root)
RETURNS ROWS (created REF delete_policy_test.restrict_child)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO delete_policy_test.restrict_child AS made (root)
VALUES (p_root) RETURNING REF(made);

CREATE SERVER FUNCTION delete_policy_test.create_set_null(p_root REF delete_policy_test.root)
RETURNS ROWS (created REF delete_policy_test.set_null_child)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO delete_policy_test.set_null_child AS made (root)
VALUES (p_root) RETURNING REF(made);

CREATE SERVER FUNCTION delete_policy_test.create_cascade(p_root REF delete_policy_test.root)
RETURNS ROWS (created REF delete_policy_test.cascade_child)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS INSERT INTO delete_policy_test.cascade_child AS made (root)
VALUES (p_root) RETURNING REF(made);

CREATE SERVER FUNCTION delete_policy_test.delete_root(p_root REF delete_policy_test.root)
RETURNS ROWS (deleted BOOLEAN)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS DELETE FROM delete_policy_test.root AS alias
WHERE REF(alias) = p_root
RETURNING TRUE;

CREATE SERVER FUNCTION delete_policy_test.delete_no_action_child(p_child REF delete_policy_test.no_action_child)
RETURNS ROWS (deleted BOOLEAN)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS DELETE FROM delete_policy_test.no_action_child AS alias
WHERE REF(alias) = p_child
RETURNING TRUE;

CREATE SERVER FUNCTION delete_policy_test.delete_restrict_child(p_child REF delete_policy_test.restrict_child)
RETURNS ROWS (deleted BOOLEAN)
SECURITY INVOKER TRANSACTION ATOMIC VOLATILITY VOLATILE
AS DELETE FROM delete_policy_test.restrict_child AS alias
WHERE REF(alias) = p_child
RETURNING TRUE;

CREATE SERVER FUNCTION delete_policy_test.read_roots()
RETURNS ROWS (root REF delete_policy_test.root)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT REF(root) FROM delete_policy_test.root root;

CREATE SERVER FUNCTION delete_policy_test.read_no_action_children()
RETURNS ROWS (root REF delete_policy_test.root)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT child.root FROM delete_policy_test.no_action_child child;

CREATE SERVER FUNCTION delete_policy_test.read_restrict_children()
RETURNS ROWS (root REF delete_policy_test.root)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT child.root FROM delete_policy_test.restrict_child child;

CREATE SERVER FUNCTION delete_policy_test.read_set_null_children()
RETURNS ROWS (root REF delete_policy_test.root)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT child.root FROM delete_policy_test.set_null_child child;

CREATE SERVER FUNCTION delete_policy_test.read_cascade_children()
RETURNS ROWS (root REF delete_policy_test.root)
SECURITY INVOKER TRANSACTION READ ONLY VOLATILITY STABLE
AS SELECT child.root FROM delete_policy_test.cascade_child child;
