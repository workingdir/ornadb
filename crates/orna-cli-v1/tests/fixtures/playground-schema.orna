pub table Sample(id: Str) {
    name: Str,
    source: Str,
}

pub table Asset(id: Str) {
    path: Str,
    media_type: Str,
    content: Str,
}

pub table Entry(id: Str) {
    asset_path: Str,
    kind: Str,
}

pub table Route(id: Str) {
    path: Str,
    entry: Str,
}

pub table Theme(id: Str) {
    name: Str,
    css: Str,
}

pub table Layout(id: Str) {
    name: Str,
    css: Str,
}
