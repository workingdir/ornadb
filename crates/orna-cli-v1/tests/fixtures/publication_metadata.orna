pub table PublicationFixture(id: Str) {
    payload: Str,
    assert every(row => row.payload != "");
}

pub fn storage_pending_rows(storage: sys.Storage): Int = storage.pending_rows;
pub fn storage_pending_bytes(storage: sys.Storage): Int = storage.pending_bytes;
pub fn storage_published_rows(storage: sys.Storage): Int = storage.published_rows;
pub fn storage_published_bytes(storage: sys.Storage): Int = storage.published_bytes;
pub fn storage_policy_visible(storage: sys.Storage): Bool = !storage.publication_policy.redacted && storage.publication_policy.canonical_digest != null;
pub fn storage_last_publication(storage: sys.Storage): Instant? = storage.last_publication;

pub fn maintenance_id(job: sys.MaintenanceJob): Str = job.id;
pub fn maintenance_started(job: sys.MaintenanceJob): Instant = job.started;
pub fn maintenance_status(job: sys.MaintenanceJob): sys.BuildStatus = job.status;


pub fn read_storage_pending_rows(): Int = sys.Storage | map(storage => storage.pending_rows) | first() ?? -1;
pub fn read_storage_pending_bytes(): Int = sys.Storage | map(storage => storage.pending_bytes) | first() ?? -1;
pub fn read_storage_published_rows(): Int = sys.Storage | map(storage => storage.published_rows) | first() ?? -1;
pub fn read_storage_policy_visible(): Bool = sys.Storage | map(storage => !storage.publication_policy.redacted && storage.publication_policy.canonical_digest != null) | first() ?? false;
pub fn read_maintenance_records_healthy(): Bool = sys.MaintenanceJob | map(job => job.id != "" && job.status != sys.BuildStatus.failed) | first() ?? true;


pub fn main(): Bool {
    let metadata_matches =
        read_storage_pending_rows() == 1 &&
        read_storage_pending_bytes() == 7 &&
        read_storage_published_rows() == 0 &&
        read_storage_policy_visible() &&
        read_maintenance_records_healthy();

    assert metadata_matches;
    metadata_matches
}
