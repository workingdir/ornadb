pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn accepts_three_way_tuple_rebind_storm() {
    let parents = [
        { pins: (factory_at(sys.snapshot("HEAD~500")), factory_at(sys.snapshot("HEAD~500"))), witness: factory_at(sys.snapshot("HEAD~501")) },
        { pins: (factory_at(sys.snapshot("HEAD~510")), factory_at(sys.snapshot("HEAD~510"))), witness: factory_at(sys.snapshot("HEAD~511")) },
        { pins: (factory_at(sys.snapshot("HEAD~520")), factory_at(sys.snapshot("HEAD~520"))), witness: factory_at(sys.snapshot("HEAD~521")) },
        { pins: (factory_at(sys.snapshot("HEAD~530")), factory_at(sys.snapshot("HEAD~530"))), witness: factory_at(sys.snapshot("HEAD~531")) },
        { pins: (factory_at(sys.snapshot("HEAD~540")), factory_at(sys.snapshot("HEAD~540"))), witness: factory_at(sys.snapshot("HEAD~541")) },
    ];
    { parent_fold: parents }
}

pub fn rejects_three_way_tuple_storm_split_without_losing_witnesses() {
    let parents = [
        { pins: (factory_at(sys.snapshot("HEAD~600")), factory_at(sys.snapshot("HEAD~600"))), witness: factory_at(sys.snapshot("HEAD~601")) },
        { pins: (factory_at(sys.snapshot("HEAD~610")), factory_at(sys.snapshot("HEAD~610"))), witness: factory_at(sys.snapshot("HEAD~611")) },
        { pins: (factory_at(sys.snapshot("HEAD~620")), factory_at(sys.snapshot("HEAD~620"))), witness: factory_at(sys.snapshot("HEAD~621")) },
        { pins: (factory_at(sys.snapshot("HEAD~630")), factory_at(sys.snapshot("HEAD~631"))), witness: factory_at(sys.snapshot("HEAD~632")) },
        { pins: (factory_at(sys.snapshot("HEAD~640")), factory_at(sys.snapshot("HEAD~640"))), witness: factory_at(sys.snapshot("HEAD~641")) },
    ];
    { parent_fold: parents }
}
