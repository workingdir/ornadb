pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn accepts_middle_sparse_pair_rebind(failure: Error) {
    let parents = [
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~10")), factory_at(sys.snapshot("HEAD~10"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~11")), factory_at(sys.snapshot("HEAD~12"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~20")), fail(failure)) },
            right: { pins: (factory_at(sys.snapshot("HEAD~21")), factory_at(sys.snapshot("HEAD~22"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~30")), factory_at(sys.snapshot("HEAD~30"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~23")), factory_at(sys.snapshot("HEAD~24"))) },
        },
    ];
    { parent_fold: parents }
}

pub fn rejects_middle_sparse_pair_split_without_losing_sibling_rebinds(failure: Error) {
    let parents = [
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~40")), factory_at(sys.snapshot("HEAD~40"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~41")), factory_at(sys.snapshot("HEAD~42"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~50")), fail(failure)) },
            right: { pins: (factory_at(sys.snapshot("HEAD~51")), factory_at(sys.snapshot("HEAD~52"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~60")), factory_at(sys.snapshot("HEAD~61"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~53")), factory_at(sys.snapshot("HEAD~54"))) },
        },
    ];
    { parent_fold: parents }
}
