pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn paired_sparse_reanchor_fold_chain(failure: Error) {
    let snapshots = [
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~1000")), factory_at(sys.snapshot("HEAD~1000"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~900")), factory_at(sys.snapshot("HEAD~900"))),
            witness: factory_at(sys.snapshot("HEAD~1001")),
        },
        { witness: factory_at(sys.snapshot("HEAD~1011")) },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~2000")), factory_at(sys.snapshot("HEAD~2000"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~1900")), factory_at(sys.snapshot("HEAD~1900"))),
            witness: factory_at(sys.snapshot("HEAD~2001")),
        },
        { witness: factory_at(sys.snapshot("HEAD~2011")) },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~3000")), factory_at(sys.snapshot("HEAD~3001"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~2900")), factory_at(sys.snapshot("HEAD~2900"))),
            witness: factory_at(sys.snapshot("HEAD~3002")),
        },
        { witness: factory_at(sys.snapshot("HEAD~3011")) },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~4000")), factory_at(sys.snapshot("HEAD~4000"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~3900")), factory_at(sys.snapshot("HEAD~3900"))),
            witness: factory_at(sys.snapshot("HEAD~4001")),
        },
    ];
    snapshots
}
