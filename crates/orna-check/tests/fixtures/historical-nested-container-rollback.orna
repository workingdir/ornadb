pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn nested_container_omission_rolls_back_one_depth(failure: Error) {
    let parents = [
        {
            left: [{ pins: ((fail(failure), fail(failure)), (fail(failure), fail(failure))) }],
            right: { pins: ((fail(failure), fail(failure)), (fail(failure), fail(failure))) },
        },
        {
            left: [{ pins: ((factory_at(sys.snapshot("HEAD~810")), factory_at(sys.snapshot("HEAD~811"))), (factory_at(sys.snapshot("HEAD~812")), factory_at(sys.snapshot("HEAD~813")))) }],
            right: { pins: ((factory_at(sys.snapshot("HEAD~910")), factory_at(sys.snapshot("HEAD~911"))), (factory_at(sys.snapshot("HEAD~912")), factory_at(sys.snapshot("HEAD~913")))) },
        },
        {
            left: [{ pins: ((factory_at(sys.snapshot("HEAD~820")), factory_at(sys.snapshot("HEAD~821"))), (factory_at(sys.snapshot("HEAD~822")), factory_at(sys.snapshot("HEAD~823")))) }],
            right: { pins: ((factory_at(sys.snapshot("HEAD~920")), factory_at(sys.snapshot("HEAD~921"))), (factory_at(sys.snapshot("HEAD~922")), factory_at(sys.snapshot("HEAD~923")))) },
        },
        {
            left: [{ pins: ((factory_at(sys.snapshot("HEAD~811")), factory_at(sys.snapshot("HEAD~810"))), (factory_at(sys.snapshot("HEAD~832")), factory_at(sys.snapshot("HEAD~833")))) }],
            right: { pins: ((factory_at(sys.snapshot("HEAD~930")), factory_at(sys.snapshot("HEAD~931"))), (factory_at(sys.snapshot("HEAD~932")), factory_at(sys.snapshot("HEAD~933")))) },
        },
        {
            left: [{ pins: ((factory_at(sys.snapshot("HEAD~840")), factory_at(sys.snapshot("HEAD~841"))), (factory_at(sys.snapshot("HEAD~842")), factory_at(sys.snapshot("HEAD~843")))) }],
            right: { pins: ((factory_at(sys.snapshot("HEAD~940")), factory_at(sys.snapshot("HEAD~941"))), (factory_at(sys.snapshot("HEAD~942")), factory_at(sys.snapshot("HEAD~943")))) },
        },
    ];
    { parent_fold: parents }
}
