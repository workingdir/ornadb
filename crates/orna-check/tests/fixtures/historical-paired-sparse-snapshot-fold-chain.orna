pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn paired_sparse_snapshot_fold_chain(failure: Error) {
    let snapshots = [
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~9100")), fail(failure)),
            right_checkpoint: (fail(failure), factory_at(sys.snapshot("HEAD~9100"))),
            other_checkpoint: (factory_at(sys.snapshot("HEAD~8900")), fail(failure)),
            witness: factory_at(sys.snapshot("HEAD~9110")),
        },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~9200")), factory_at(sys.snapshot("HEAD~9200"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~9200")), factory_at(sys.snapshot("HEAD~9200"))),
            other_checkpoint: (factory_at(sys.snapshot("HEAD~8900")), fail(failure)),
            witness: factory_at(sys.snapshot("HEAD~9215")),
        },
        { witness: factory_at(sys.snapshot("HEAD~9220")) },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~9300")), factory_at(sys.snapshot("HEAD~9301"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~9300")), factory_at(sys.snapshot("HEAD~9300"))),
            other_checkpoint: (factory_at(sys.snapshot("HEAD~8900")), fail(failure)),
            witness: factory_at(sys.snapshot("HEAD~9320")),
        },
        { witness: factory_at(sys.snapshot("HEAD~9330")) },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~9400")), factory_at(sys.snapshot("HEAD~9400"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~9400")), factory_at(sys.snapshot("HEAD~9400"))),
            other_checkpoint: (factory_at(sys.snapshot("HEAD~8900")), fail(failure)),
            witness: factory_at(sys.snapshot("HEAD~9420")),
        },
    ];
    snapshots
}
