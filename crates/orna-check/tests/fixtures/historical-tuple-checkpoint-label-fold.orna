pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn deferred_factory(pin: sys.SnapshotRef) =
    (child_pin: sys.SnapshotRef) => factory_at(pin);

pub fn tuple_checkpoint_label_fold_rebind() {
    let checkpoints = [
        (
            [
                deferred_factory(sys.snapshot("HEAD~30")),
                deferred_factory(sys.snapshot("HEAD~31")),
            ],
            [
                deferred_factory(sys.snapshot("HEAD~30")),
                deferred_factory(sys.snapshot("HEAD~32")),
            ],
            [
                deferred_factory(sys.snapshot("HEAD~31")),
                deferred_factory(sys.snapshot("HEAD~32")),
            ],
        ),
    ];
    let saved = checkpoints;
    let candidate = [
        (
            [
                deferred_factory(sys.snapshot("HEAD~40")),
                deferred_factory(sys.snapshot("HEAD~41")),
            ],
            [
                deferred_factory(sys.snapshot("HEAD~40")),
                deferred_factory(sys.snapshot("HEAD~42")),
            ],
            [
                deferred_factory(sys.snapshot("HEAD~40")),
                deferred_factory(sys.snapshot("HEAD~43")),
            ],
        ),
    ];
    checkpoints = candidate;
    {
        saved: saved,
        retained: checkpoints,
        candidate: candidate,
    }
}
