
            pub fn direct(rows: [Int]) = first(rows);
            pub fn pipeline(rows: [Int]) = rows | first();
            pub fn named(rows: [Int]) = first(rows: rows);
            pub fn qualified(rows: [Int]) = first(rows);
            pub fn qualified_pipeline(rows: [Int]) = rows | first();
            pub fn qualified_named(rows: [Int]) = first(rows: rows);
        