pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

// The second callback captures the first callback's pin through a local
// alias, then shadows the same name again at the next depth.
pub fn callback_chain_at(pin: sys.SnapshotRef) =
    (pin: sys.SnapshotRef) => {
        let captured = pin;
        (pin: sys.SnapshotRef) => factory_at(captured)
    };

pub fn paired_shadowed_callback_depths_retain_each_lane() {
    let roots = (
        callback_chain_at(sys.snapshot("HEAD~100")),
        callback_chain_at(sys.snapshot("HEAD~90")),
    );
    let (left_root, right_root) = roots;
    let left_bridge = left_root(sys.snapshot("HEAD~80"));
    let right_bridge = right_root(sys.snapshot("HEAD~70"));

    let rolling = (left_bridge, right_bridge);
    let saved = rolling;
    rolling = (left_root(sys.snapshot("HEAD~79")), right_bridge);
    let middle = rolling;
    let (middle_left, middle_right) = middle;
    rolling = (middle_left, right_root(sys.snapshot("HEAD~69")));
    let final = rolling;

    let (saved_left, saved_right) = saved;
    let (final_left, final_right) = final;
    let saved_left_result = saved_left(sys.snapshot("HEAD~40"));
    let saved_right_result = saved_right(sys.snapshot("HEAD~39"));
    let middle_left_result = middle_left(sys.snapshot("HEAD~38"));
    let middle_right_result = middle_right(sys.snapshot("HEAD~37"));
    let final_left_result = final_left(sys.snapshot("HEAD~36"));
    let final_right_result = final_right(sys.snapshot("HEAD~35"));

    {
        saved_left: std.concurrent.parallel([() => saved_left_result, () => saved_left_result]),
        saved_right: std.concurrent.parallel([() => saved_right_result, () => saved_right_result]),
        middle_left: std.concurrent.parallel([() => middle_left_result, () => middle_left_result]),
        middle_right: std.concurrent.parallel([() => middle_right_result, () => middle_right_result]),
        final_left: std.concurrent.parallel([() => final_left_result, () => final_left_result]),
        final_right: std.concurrent.parallel([() => final_right_result, () => final_right_result]),
    }
}
