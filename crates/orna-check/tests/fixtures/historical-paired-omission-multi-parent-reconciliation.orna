pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn omitted_first_pair_rolls_back_after_crossed_parent(failure: Error) {
    let parents = [
        (fail(failure), fail(failure)),
        (factory_at(sys.snapshot("HEAD~100")), factory_at(sys.snapshot("HEAD~101"))),
        (factory_at(sys.snapshot("HEAD~101")), factory_at(sys.snapshot("HEAD~100"))),
        (factory_at(sys.snapshot("HEAD~102")), factory_at(sys.snapshot("HEAD~103"))),
    ];
    { parent_fold: parents }
}

pub fn valid_paired_omissions_keep_all_parent_depth_labels(failure: Error) {
    let parents = [
        (fail(failure), fail(failure)),
        (factory_at(sys.snapshot("HEAD~200")), factory_at(sys.snapshot("HEAD~201"))),
        (factory_at(sys.snapshot("HEAD~202")), fail(failure)),
        (fail(failure), factory_at(sys.snapshot("HEAD~203"))),
        (factory_at(sys.snapshot("HEAD~204")), factory_at(sys.snapshot("HEAD~205"))),
    ];
    { parent_fold: parents }
}
