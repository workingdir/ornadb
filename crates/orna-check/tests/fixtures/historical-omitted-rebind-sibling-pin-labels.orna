pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn paired_sibling_labels() =
    (left_pin: sys.SnapshotRef, right_pin: sys.SnapshotRef) => {
        left_pin: left_pin,
        left_capture: factory_at(left_pin),
        right_pin: right_pin,
        right_capture: factory_at(right_pin),
    };

pub fn omitted_rebind_keeps_sibling_labels_separate() {
    let callback = paired_sibling_labels();
    let complete = callback(sys.snapshot("HEAD~100"), sys.snapshot("HEAD~99"));
    let omitted = callback(sys.snapshot("HEAD~90"));
    {
        complete: complete,
        omitted: omitted,
    }
}
