pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn checkpoint(pin: sys.SnapshotRef) = {
    factory: factory_at(pin),
};

pub fn pinned_map_width_rebind_returns_values() {
    let saved = [
        checkpoint(sys.snapshot("HEAD~12")),
        checkpoint(sys.snapshot("HEAD~11")),
    ];
    let rolling = saved;
    rolling = [
        checkpoint(sys.snapshot("HEAD~10")),
        checkpoint(sys.snapshot("HEAD~9")),
    ];
    {
        saved: saved,
        rolling: rolling,
    }
}
