pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn nested_checkpoint_at(root_pin: sys.SnapshotRef) =
    (leaf_pin: sys.SnapshotRef) => {
        root: factory_at(root_pin),
        leaf: factory_at(leaf_pin),
    };

pub fn crossed_nested_checkpoint_at(root_pin: sys.SnapshotRef) =
    (leaf_pin: sys.SnapshotRef) => {
        root: factory_at(leaf_pin),
        leaf: factory_at(root_pin),
    };

pub fn crossed_nested_snapshot_boundary_list_fold_is_rejected() {
    let folded = [
        nested_checkpoint_at(sys.snapshot("HEAD~112")),
        crossed_nested_checkpoint_at(sys.snapshot("HEAD~102")),
    ];
    folded
}
