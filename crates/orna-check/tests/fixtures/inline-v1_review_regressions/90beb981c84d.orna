
            pub protocol Display {
                fn display(self): Str;
            }
            pub table Audit { message: Str, }
            pub table Note(id: Int) {
                value: Str,
                impl Display {
                    fn display(self): Str {
                        if true {
                            return self.value;
                            Audit.insert({ message: "after nested return" });
                        }
                        self.value
                    }
                }
            }
        