pub fn pinned_factory(selector: Str) =
    sys.database.as_of(sys.snapshot(selector)).energy.factory;

pub fn forwarded_pinned_factory(selector: Str) = pinned_factory(selector);

pub fn helper_calls_after_dynamic_selector_reassignment_do_not_compose() {
    let selector = "HEAD~10";
    let before = forwarded_pinned_factory(selector);
    selector = "HEAD";
    let current = forwarded_pinned_factory(selector);
    [before, current]
}
