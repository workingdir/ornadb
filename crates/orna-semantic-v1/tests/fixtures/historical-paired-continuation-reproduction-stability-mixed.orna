pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);
pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn final_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
            };

pub fn followup_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                continuation: final_at(terminal_pin),
            };

pub fn cascade_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                followup: followup_at(terminal_pin),
            };

// Distinct captured pair lanes remain distinct after rebind reproduction.
pub fn paired_continuation_reproductions_reject_cross_lane_mixing() {
    let left_origin = cascade_at(sys.snapshot("HEAD~1160"))(sys.snapshot("HEAD~1120"))(sys.snapshot("HEAD~1080"))(sys.snapshot("HEAD~1040"));
    let right_origin = cascade_at(sys.snapshot("HEAD~1150"))(sys.snapshot("HEAD~1110"))(sys.snapshot("HEAD~1070"))(sys.snapshot("HEAD~1030"));
    let left_reproduced = cascade_at(sys.snapshot("HEAD~1160"))(sys.snapshot("HEAD~1120"))(sys.snapshot("HEAD~1080"))(sys.snapshot("HEAD~1040"));
    let right_reproduced = cascade_at(sys.snapshot("HEAD~1150"))(sys.snapshot("HEAD~1110"))(sys.snapshot("HEAD~1070"))(sys.snapshot("HEAD~1030"));

    let followup_roots_rolling = (left_origin.followup, right_origin.followup);
    followup_roots_rolling = (followup_at(sys.snapshot("HEAD~1039")), followup_at(sys.snapshot("HEAD~1029")));
    followup_roots_rolling = (followup_at(sys.snapshot("HEAD~1038")), followup_at(sys.snapshot("HEAD~1028")));
    let left_followup_root = left_reproduced.followup;
    let right_followup_root = right_reproduced.followup;
    let followup_bridges_rolling = (
        left_followup_root(sys.snapshot("HEAD~1000")),
        right_followup_root(sys.snapshot("HEAD~990")),
    );
    followup_bridges_rolling = (
        left_followup_root(sys.snapshot("HEAD~998")),
        right_followup_root(sys.snapshot("HEAD~988")),
    );
    let (left_followup_bridge, right_followup_bridge) = followup_bridges_rolling;
    let followup_leaves_rolling = (
        left_followup_bridge(sys.snapshot("HEAD~980")),
        right_followup_bridge(sys.snapshot("HEAD~970")),
    );
    followup_leaves_rolling = (
        left_followup_bridge(sys.snapshot("HEAD~978")),
        right_followup_bridge(sys.snapshot("HEAD~968")),
    );
    let (left_followup_leaf, right_followup_leaf) = followup_leaves_rolling;
    let left_followup = left_followup_leaf(sys.snapshot("HEAD~960"));
    let right_followup = right_followup_leaf(sys.snapshot("HEAD~950"));

    let left_terminal = left_followup.continuation(sys.snapshot("HEAD~920"))(sys.snapshot("HEAD~900"))(sys.snapshot("HEAD~880"));
    let right_terminal = right_followup.continuation(sys.snapshot("HEAD~910"))(sys.snapshot("HEAD~890"))(sys.snapshot("HEAD~870"));

    {
        cross_pair: [left_terminal.terminal, right_terminal.terminal],
    }
}
