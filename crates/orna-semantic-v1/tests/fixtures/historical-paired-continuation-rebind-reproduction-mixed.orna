pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);
pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn terminal_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
            };

pub fn followup_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                continuation: terminal_at(terminal_pin),
            };

pub fn cascade_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                followup: followup_at(terminal_pin),
            };

// Recreating both nested chains after their storms must not permit terminal cross-pairing.
pub fn paired_continuation_rebind_reproductions_reject_cross_lane_mixing() {
    let left_origin = cascade_at(sys.snapshot("HEAD~1060"))(sys.snapshot("HEAD~1020"))(sys.snapshot("HEAD~980"))(sys.snapshot("HEAD~940"));
    let right_origin = cascade_at(sys.snapshot("HEAD~1050"))(sys.snapshot("HEAD~1010"))(sys.snapshot("HEAD~970"))(sys.snapshot("HEAD~930"));
    let left_reproduced = cascade_at(sys.snapshot("HEAD~1060"))(sys.snapshot("HEAD~1020"))(sys.snapshot("HEAD~980"))(sys.snapshot("HEAD~940"));
    let right_reproduced = cascade_at(sys.snapshot("HEAD~1050"))(sys.snapshot("HEAD~1010"))(sys.snapshot("HEAD~970"))(sys.snapshot("HEAD~930"));

    let left_followup_root_rolling = left_origin.followup;
    left_followup_root_rolling = followup_at(sys.snapshot("HEAD~939"));
    left_followup_root_rolling = followup_at(sys.snapshot("HEAD~938"));
    let left_followup_root = left_reproduced.followup;
    let right_followup_root_rolling = right_origin.followup;
    right_followup_root_rolling = followup_at(sys.snapshot("HEAD~929"));
    right_followup_root_rolling = followup_at(sys.snapshot("HEAD~928"));
    let right_followup_root = right_reproduced.followup;

    let left_followup_bridge_rolling = left_followup_root(sys.snapshot("HEAD~900"));
    left_followup_bridge_rolling = left_followup_root(sys.snapshot("HEAD~898"));
    let left_followup_bridge = left_followup_root(sys.snapshot("HEAD~900"));
    let right_followup_bridge_rolling = right_followup_root(sys.snapshot("HEAD~890"));
    right_followup_bridge_rolling = right_followup_root(sys.snapshot("HEAD~888"));
    let right_followup_bridge = right_followup_root(sys.snapshot("HEAD~890"));
    let left_followup_leaf_rolling = left_followup_bridge(sys.snapshot("HEAD~880"));
    left_followup_leaf_rolling = left_followup_bridge(sys.snapshot("HEAD~878"));
    let left_followup_leaf = left_followup_bridge(sys.snapshot("HEAD~880"));
    let right_followup_leaf_rolling = right_followup_bridge(sys.snapshot("HEAD~870"));
    right_followup_leaf_rolling = right_followup_bridge(sys.snapshot("HEAD~868"));
    let right_followup_leaf = right_followup_bridge(sys.snapshot("HEAD~870"));
    let left_followup = left_followup_leaf(sys.snapshot("HEAD~860"));
    let right_followup = right_followup_leaf(sys.snapshot("HEAD~850"));
    let left_followup_reproduced = left_reproduced.followup(sys.snapshot("HEAD~900"))(sys.snapshot("HEAD~880"))(sys.snapshot("HEAD~860"));
    let right_followup_reproduced = right_reproduced.followup(sys.snapshot("HEAD~890"))(sys.snapshot("HEAD~870"))(sys.snapshot("HEAD~850"));

    let left_terminal_root_rolling = left_followup.continuation;
    left_terminal_root_rolling = terminal_at(sys.snapshot("HEAD~859"));
    left_terminal_root_rolling = terminal_at(sys.snapshot("HEAD~858"));
    let left_terminal_root = left_followup_reproduced.continuation;
    let right_terminal_root_rolling = right_followup.continuation;
    right_terminal_root_rolling = terminal_at(sys.snapshot("HEAD~849"));
    right_terminal_root_rolling = terminal_at(sys.snapshot("HEAD~848"));
    let right_terminal_root = right_followup_reproduced.continuation;
    let left_terminal_bridge_rolling = left_terminal_root(sys.snapshot("HEAD~840"));
    left_terminal_bridge_rolling = left_terminal_root(sys.snapshot("HEAD~838"));
    let left_terminal_bridge = left_terminal_root(sys.snapshot("HEAD~840"));
    let right_terminal_bridge_rolling = right_terminal_root(sys.snapshot("HEAD~830"));
    right_terminal_bridge_rolling = right_terminal_root(sys.snapshot("HEAD~828"));
    let right_terminal_bridge = right_terminal_root(sys.snapshot("HEAD~830"));
    let left_terminal_leaf_rolling = left_terminal_bridge(sys.snapshot("HEAD~820"));
    left_terminal_leaf_rolling = left_terminal_bridge(sys.snapshot("HEAD~818"));
    let left_terminal_leaf = left_terminal_bridge(sys.snapshot("HEAD~820"));
    let right_terminal_leaf_rolling = right_terminal_bridge(sys.snapshot("HEAD~810"));
    right_terminal_leaf_rolling = right_terminal_bridge(sys.snapshot("HEAD~808"));
    let right_terminal_leaf = right_terminal_bridge(sys.snapshot("HEAD~810"));
    let left_final = left_terminal_leaf(sys.snapshot("HEAD~800"));
    let right_final = right_terminal_leaf(sys.snapshot("HEAD~790"));

    {
        cross_pair: [left_final.terminal, right_final.terminal],
    }
}
