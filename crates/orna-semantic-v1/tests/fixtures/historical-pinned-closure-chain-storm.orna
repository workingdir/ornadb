pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);

pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn rebind_storm(
    pin_0: sys.SnapshotRef,
    pin_1: sys.SnapshotRef,
    pin_2: sys.SnapshotRef,
    pin_3: sys.SnapshotRef,
    pin_4: sys.SnapshotRef,
) {
    let rolling_pin = pin_0;
    let stage_0 = chained_factory(rolling_pin);
    let pin_1_alias = pin_1;
    rolling_pin = pin_1_alias;
    let stage_1 = chained_factory(rolling_pin);
    rolling_pin = pin_2;
    let stage_2 = chained_factory(rolling_pin);
    let pin_3_alias = pin_3;
    rolling_pin = pin_3_alias;
    let stage_3 = chained_factory(rolling_pin);
    rolling_pin = pin_4;
    let stage_4 = chained_factory(rolling_pin);
    {
        stage_0: stage_0,
        stage_1: stage_1,
        stage_2: stage_2,
        stage_3: stage_3,
        stage_4: stage_4,
    }
}

pub fn forwarded_storm(
    pin_0: sys.SnapshotRef,
    pin_1: sys.SnapshotRef,
    pin_2: sys.SnapshotRef,
    pin_3: sys.SnapshotRef,
    pin_4: sys.SnapshotRef,
) = rebind_storm(pin_0, pin_1, pin_2, pin_3, pin_4);

pub fn deep_storm(
    pin_0: sys.SnapshotRef,
    pin_1: sys.SnapshotRef,
    pin_2: sys.SnapshotRef,
    pin_3: sys.SnapshotRef,
    pin_4: sys.SnapshotRef,
) = forwarded_storm(pin_0, pin_1, pin_2, pin_3, pin_4);

pub fn independent_storms_keep_all_stages_pinned() {
    let alpha = deep_storm(
        sys.snapshot("HEAD~50"),
        sys.snapshot("HEAD~40"),
        sys.snapshot("HEAD~30"),
        sys.snapshot("HEAD~20"),
        sys.snapshot("HEAD~10"),
    );
    let beta = deep_storm(
        sys.snapshot("HEAD~51"),
        sys.snapshot("HEAD~41"),
        sys.snapshot("HEAD~31"),
        sys.snapshot("HEAD~21"),
        sys.snapshot("HEAD~11"),
    );
    let gamma = deep_storm(
        sys.snapshot("HEAD~52"),
        sys.snapshot("HEAD~42"),
        sys.snapshot("HEAD~32"),
        sys.snapshot("HEAD~22"),
        sys.snapshot("HEAD~12"),
    );
    let delta = deep_storm(
        sys.snapshot("HEAD~53"),
        sys.snapshot("HEAD~43"),
        sys.snapshot("HEAD~33"),
        sys.snapshot("HEAD~23"),
        sys.snapshot("HEAD~13"),
    );
    {
        alpha_0: [alpha.stage_0, chained_factory(sys.snapshot("HEAD~50"))],
        alpha_1: [alpha.stage_1, chained_factory(sys.snapshot("HEAD~40"))],
        alpha_2: [alpha.stage_2, chained_factory(sys.snapshot("HEAD~30"))],
        alpha_3: [alpha.stage_3, chained_factory(sys.snapshot("HEAD~20"))],
        alpha_4: [alpha.stage_4, chained_factory(sys.snapshot("HEAD~10"))],
        beta_0: [beta.stage_0, chained_factory(sys.snapshot("HEAD~51"))],
        beta_1: [beta.stage_1, chained_factory(sys.snapshot("HEAD~41"))],
        beta_2: [beta.stage_2, chained_factory(sys.snapshot("HEAD~31"))],
        beta_3: [beta.stage_3, chained_factory(sys.snapshot("HEAD~21"))],
        beta_4: [beta.stage_4, chained_factory(sys.snapshot("HEAD~11"))],
        gamma_0: [gamma.stage_0, chained_factory(sys.snapshot("HEAD~52"))],
        gamma_1: [gamma.stage_1, chained_factory(sys.snapshot("HEAD~42"))],
        gamma_2: [gamma.stage_2, chained_factory(sys.snapshot("HEAD~32"))],
        gamma_3: [gamma.stage_3, chained_factory(sys.snapshot("HEAD~22"))],
        gamma_4: [gamma.stage_4, chained_factory(sys.snapshot("HEAD~12"))],
        delta_0: [delta.stage_0, chained_factory(sys.snapshot("HEAD~53"))],
        delta_1: [delta.stage_1, chained_factory(sys.snapshot("HEAD~43"))],
        delta_2: [delta.stage_2, chained_factory(sys.snapshot("HEAD~33"))],
        delta_3: [delta.stage_3, chained_factory(sys.snapshot("HEAD~23"))],
        delta_4: [delta.stage_4, chained_factory(sys.snapshot("HEAD~13"))],
    }
}
