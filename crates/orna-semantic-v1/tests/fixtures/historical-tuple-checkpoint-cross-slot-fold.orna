pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn tuple_checkpoint_cross_slot_compaction_fold() {
    // The rows keep their slot pins disjoint, but compaction would fold each
    // slot to the same {HEAD~20, HEAD~21} map and invent cross-slot identity.
    let checkpoints = [
        (
            factory_at(sys.snapshot("HEAD~20")),
            factory_at(sys.snapshot("HEAD~21")),
        ),
        (
            factory_at(sys.snapshot("HEAD~21")),
            factory_at(sys.snapshot("HEAD~20")),
        ),
    ];
    let saved = checkpoints;
    let folded = checkpoints;
    {
        saved: saved,
        folded: folded,
    }
}
