pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);
pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn cascade_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                nested: {
                    bridge: chained_factory(bridge_pin)().read,
                    leaf: {
                        reader: chained_factory(leaf_pin)().read,
                        continuation: chained_factory(leaf_pin)().read(),
                        terminal: chained_factory(terminal_pin)().read(),
                    },
                },
            };

pub fn pair_at(left_root: sys.SnapshotRef, right_root: sys.SnapshotRef) =
    (cascade_at(left_root), cascade_at(right_root));
pub fn forwarded_pair(left_root: sys.SnapshotRef, right_root: sys.SnapshotRef) =
    pair_at(left_root, right_root);
pub fn chained_pair(left_root: sys.SnapshotRef, right_root: sys.SnapshotRef) =
    forwarded_pair(left_root, right_root);

// Rebind the paired chain at root, bridge, and leaf closure depths before invoking its terminal closures.
pub fn paired_nested_chains_survive_rebind_cascades() {
    let roots_rolling = chained_pair(sys.snapshot("HEAD~260"), sys.snapshot("HEAD~250"));
    let roots_0 = roots_rolling;
    roots_rolling = chained_pair(sys.snapshot("HEAD~259"), sys.snapshot("HEAD~249"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~258"), sys.snapshot("HEAD~248"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~257"), sys.snapshot("HEAD~247"));
    let roots_3 = roots_rolling;
    roots_rolling = chained_pair(sys.snapshot("HEAD~256"), sys.snapshot("HEAD~246"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~255"), sys.snapshot("HEAD~245"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~254"), sys.snapshot("HEAD~244"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~253"), sys.snapshot("HEAD~243"));
    let roots_7 = roots_rolling;
    roots_rolling = roots_0;
    let roots_returned = roots_rolling;

    let (returned_left_root_chain, returned_right_root_chain) = roots_returned;
    let (stage_3_left_root_chain, stage_3_right_root_chain) = roots_3;
    let (stage_7_left_root_chain, stage_7_right_root_chain) = roots_7;

    let bridges_rolling = (returned_left_root_chain(sys.snapshot("HEAD~220")), returned_right_root_chain(sys.snapshot("HEAD~210")));
    let bridges_0 = bridges_rolling;
    bridges_rolling = (stage_3_left_root_chain(sys.snapshot("HEAD~219")), stage_3_right_root_chain(sys.snapshot("HEAD~209")));
    bridges_rolling = (stage_7_left_root_chain(sys.snapshot("HEAD~218")), stage_7_right_root_chain(sys.snapshot("HEAD~208")));
    bridges_rolling = (returned_left_root_chain(sys.snapshot("HEAD~217")), returned_right_root_chain(sys.snapshot("HEAD~207")));
    let bridges_3 = bridges_rolling;
    bridges_rolling = (stage_3_left_root_chain(sys.snapshot("HEAD~216")), stage_3_right_root_chain(sys.snapshot("HEAD~206")));
    bridges_rolling = (stage_7_left_root_chain(sys.snapshot("HEAD~215")), stage_7_right_root_chain(sys.snapshot("HEAD~205")));
    bridges_rolling = (returned_left_root_chain(sys.snapshot("HEAD~214")), returned_right_root_chain(sys.snapshot("HEAD~204")));
    bridges_rolling = (stage_7_left_root_chain(sys.snapshot("HEAD~213")), stage_7_right_root_chain(sys.snapshot("HEAD~203")));
    let bridges_7 = bridges_rolling;
    bridges_rolling = bridges_0;
    let bridges_returned = bridges_rolling;

    let (returned_left_bridge_chain_0, returned_right_bridge_chain_0) = bridges_returned;
    let leaves_rolling = (returned_left_bridge_chain_0(sys.snapshot("HEAD~180")), returned_right_bridge_chain_0(sys.snapshot("HEAD~170")));
    let leaves_0 = leaves_rolling;
    let (stage_3_left_bridge_chain_1, stage_3_right_bridge_chain_1) = bridges_3;
    leaves_rolling = (stage_3_left_bridge_chain_1(sys.snapshot("HEAD~179")), stage_3_right_bridge_chain_1(sys.snapshot("HEAD~169")));
    let (stage_7_left_bridge_chain_2, stage_7_right_bridge_chain_2) = bridges_7;
    leaves_rolling = (stage_7_left_bridge_chain_2(sys.snapshot("HEAD~178")), stage_7_right_bridge_chain_2(sys.snapshot("HEAD~168")));
    let (stage_3_left_bridge_chain_3, stage_3_right_bridge_chain_3) = bridges_3;
    leaves_rolling = (stage_3_left_bridge_chain_3(sys.snapshot("HEAD~177")), stage_3_right_bridge_chain_3(sys.snapshot("HEAD~167")));
    let leaves_3 = leaves_rolling;
    let (returned_left_bridge_chain_4, returned_right_bridge_chain_4) = bridges_returned;
    leaves_rolling = (returned_left_bridge_chain_4(sys.snapshot("HEAD~176")), returned_right_bridge_chain_4(sys.snapshot("HEAD~166")));
    let (stage_7_left_bridge_chain_5, stage_7_right_bridge_chain_5) = bridges_7;
    leaves_rolling = (stage_7_left_bridge_chain_5(sys.snapshot("HEAD~175")), stage_7_right_bridge_chain_5(sys.snapshot("HEAD~165")));
    let (returned_left_bridge_chain_6, returned_right_bridge_chain_6) = bridges_returned;
    leaves_rolling = (returned_left_bridge_chain_6(sys.snapshot("HEAD~174")), returned_right_bridge_chain_6(sys.snapshot("HEAD~164")));
    let (stage_7_left_bridge_chain_7, stage_7_right_bridge_chain_7) = bridges_7;
    leaves_rolling = (stage_7_left_bridge_chain_7(sys.snapshot("HEAD~173")), stage_7_right_bridge_chain_7(sys.snapshot("HEAD~163")));
    let leaves_7 = leaves_rolling;
    leaves_rolling = leaves_0;
    let leaves_returned = leaves_rolling;

    let (returned_left_terminal_chain, returned_right_terminal_chain) = leaves_returned;
    let returned_left_value = returned_left_terminal_chain(sys.snapshot("HEAD~140"));
    let returned_right_value = returned_right_terminal_chain(sys.snapshot("HEAD~130"));
    let (stage_3_left_terminal_chain, stage_3_right_terminal_chain) = leaves_3;
    let stage_3_left_value = stage_3_left_terminal_chain(sys.snapshot("HEAD~137"));
    let stage_3_right_value = stage_3_right_terminal_chain(sys.snapshot("HEAD~127"));
    let (stage_7_left_terminal_chain, stage_7_right_terminal_chain) = leaves_7;
    let stage_7_left_value = stage_7_left_terminal_chain(sys.snapshot("HEAD~133"));
    let stage_7_right_value = stage_7_right_terminal_chain(sys.snapshot("HEAD~123"));

    {
        returned: {
            left: {
                root: [returned_left_value.root, chained_factory(sys.snapshot("HEAD~260"))],
                bridge: [returned_left_value.nested.bridge, chained_factory(sys.snapshot("HEAD~220"))().read],
                reader: [returned_left_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~180"))().read],
                continuation: [returned_left_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~180"))().read()],
                terminal: [returned_left_value.nested.leaf.terminal, chained_factory(sys.snapshot("HEAD~140"))().read()],
            },
            right: {
                root: [returned_right_value.root, chained_factory(sys.snapshot("HEAD~250"))],
                bridge: [returned_right_value.nested.bridge, chained_factory(sys.snapshot("HEAD~210"))().read],
                reader: [returned_right_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~170"))().read],
                continuation: [returned_right_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~170"))().read()],
                terminal: [returned_right_value.nested.leaf.terminal, chained_factory(sys.snapshot("HEAD~130"))().read()],
            },
        },
        stage_3: {
            left: {
                root: [stage_3_left_value.root, chained_factory(sys.snapshot("HEAD~260"))],
                bridge: [stage_3_left_value.nested.bridge, chained_factory(sys.snapshot("HEAD~217"))().read],
                reader: [stage_3_left_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~177"))().read],
                continuation: [stage_3_left_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~177"))().read()],
                terminal: [stage_3_left_value.nested.leaf.terminal, chained_factory(sys.snapshot("HEAD~137"))().read()],
            },
            right: {
                root: [stage_3_right_value.root, chained_factory(sys.snapshot("HEAD~250"))],
                bridge: [stage_3_right_value.nested.bridge, chained_factory(sys.snapshot("HEAD~207"))().read],
                reader: [stage_3_right_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~167"))().read],
                continuation: [stage_3_right_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~167"))().read()],
                terminal: [stage_3_right_value.nested.leaf.terminal, chained_factory(sys.snapshot("HEAD~127"))().read()],
            },
        },
        stage_7: {
            left: {
                root: [stage_7_left_value.root, chained_factory(sys.snapshot("HEAD~253"))],
                bridge: [stage_7_left_value.nested.bridge, chained_factory(sys.snapshot("HEAD~213"))().read],
                reader: [stage_7_left_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~173"))().read],
                continuation: [stage_7_left_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~173"))().read()],
                terminal: [stage_7_left_value.nested.leaf.terminal, chained_factory(sys.snapshot("HEAD~133"))().read()],
            },
            right: {
                root: [stage_7_right_value.root, chained_factory(sys.snapshot("HEAD~243"))],
                bridge: [stage_7_right_value.nested.bridge, chained_factory(sys.snapshot("HEAD~203"))().read],
                reader: [stage_7_right_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~163"))().read],
                continuation: [stage_7_right_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~163"))().read()],
                terminal: [stage_7_right_value.nested.leaf.terminal, chained_factory(sys.snapshot("HEAD~123"))().read()],
            },
        cross_chain: [returned_left_value.nested.leaf.terminal, returned_right_value.nested.leaf.terminal],
        },
    }
}
