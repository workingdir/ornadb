pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn nested_storm_rejects_sibling_depth_crossing() {
    let parents = [
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~10")), factory_at(sys.snapshot("HEAD~11"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~20")), factory_at(sys.snapshot("HEAD~21"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~11")), factory_at(sys.snapshot("HEAD~10"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~21")), factory_at(sys.snapshot("HEAD~20"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~30")), factory_at(sys.snapshot("HEAD~31"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~40")), factory_at(sys.snapshot("HEAD~41"))) },
        },
    ];
    { parent_fold: parents }
}

pub fn nested_storm_keeps_every_sibling_depth_label() {
    let parents = [
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~50")), factory_at(sys.snapshot("HEAD~51"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~60")), factory_at(sys.snapshot("HEAD~61"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~52")), factory_at(sys.snapshot("HEAD~53"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~62")), factory_at(sys.snapshot("HEAD~63"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~54")), factory_at(sys.snapshot("HEAD~55"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~64")), factory_at(sys.snapshot("HEAD~65"))) },
        },
    ];
    { parent_fold: parents }
}
