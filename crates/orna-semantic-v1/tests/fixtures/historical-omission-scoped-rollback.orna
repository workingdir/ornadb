pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn scoped_omission_rollback_preserves_sibling_depths(failure: Error) {
    let parents = [
        {
            left: { pins: ((fail(failure), fail(failure)), (fail(failure), fail(failure))) },
            right: { pins: ((fail(failure), fail(failure)), (fail(failure), fail(failure))) },
        },
        {
            left: { pins: ((factory_at(sys.snapshot("HEAD~610")), factory_at(sys.snapshot("HEAD~611"))), (factory_at(sys.snapshot("HEAD~612")), factory_at(sys.snapshot("HEAD~613")))) },
            right: { pins: ((factory_at(sys.snapshot("HEAD~710")), factory_at(sys.snapshot("HEAD~711"))), (factory_at(sys.snapshot("HEAD~712")), factory_at(sys.snapshot("HEAD~713")))) },
        },
        {
            left: { pins: ((factory_at(sys.snapshot("HEAD~620")), factory_at(sys.snapshot("HEAD~621"))), (factory_at(sys.snapshot("HEAD~622")), factory_at(sys.snapshot("HEAD~623")))) },
            right: { pins: ((factory_at(sys.snapshot("HEAD~720")), factory_at(sys.snapshot("HEAD~721"))), (factory_at(sys.snapshot("HEAD~722")), factory_at(sys.snapshot("HEAD~723")))) },
        },
        {
            left: { pins: ((factory_at(sys.snapshot("HEAD~611")), factory_at(sys.snapshot("HEAD~610"))), (factory_at(sys.snapshot("HEAD~632")), factory_at(sys.snapshot("HEAD~633")))) },
            right: { pins: ((factory_at(sys.snapshot("HEAD~730")), factory_at(sys.snapshot("HEAD~731"))), (factory_at(sys.snapshot("HEAD~732")), factory_at(sys.snapshot("HEAD~733")))) },
        },
        {
            left: { pins: ((factory_at(sys.snapshot("HEAD~640")), factory_at(sys.snapshot("HEAD~641"))), (factory_at(sys.snapshot("HEAD~642")), factory_at(sys.snapshot("HEAD~643")))) },
            right: { pins: ((factory_at(sys.snapshot("HEAD~740")), factory_at(sys.snapshot("HEAD~741"))), (factory_at(sys.snapshot("HEAD~742")), factory_at(sys.snapshot("HEAD~743")))) },
        },
    ];
    { parent_fold: parents }
}
