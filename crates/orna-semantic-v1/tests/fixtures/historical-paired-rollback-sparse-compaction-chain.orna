pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn paired_rollback_sparse_compaction_chain(failure: Error) {
    let compacted = [
        { checkpoints: { witness: factory_at(sys.snapshot("HEAD~600")) } },
        {
            checkpoints: {
                left_checkpoint: (fail(failure), factory_at(sys.snapshot("HEAD~610"))),
                right_checkpoint: (factory_at(sys.snapshot("HEAD~510")), fail(failure)),
                witness: factory_at(sys.snapshot("HEAD~611")),
            },
        },
        {
            checkpoints: {
                left_checkpoint: (factory_at(sys.snapshot("HEAD~620")), factory_at(sys.snapshot("HEAD~620"))),
                right_checkpoint: (factory_at(sys.snapshot("HEAD~520")), factory_at(sys.snapshot("HEAD~520"))),
                witness: factory_at(sys.snapshot("HEAD~621")),
            },
        },
        {
            checkpoints: {
                left_checkpoint: (factory_at(sys.snapshot("HEAD~630")), factory_at(sys.snapshot("HEAD~630"))),
                right_checkpoint: (factory_at(sys.snapshot("HEAD~530")), factory_at(sys.snapshot("HEAD~531"))),
                witness: factory_at(sys.snapshot("HEAD~632")),
            },
        },
        { checkpoints: { witness: factory_at(sys.snapshot("HEAD~633")) } },
        {
            checkpoints: {
                left_checkpoint: (factory_at(sys.snapshot("HEAD~640")), factory_at(sys.snapshot("HEAD~641"))),
                right_checkpoint: (factory_at(sys.snapshot("HEAD~540")), factory_at(sys.snapshot("HEAD~540"))),
                witness: factory_at(sys.snapshot("HEAD~641")),
            },
        },
        { checkpoints: { witness: factory_at(sys.snapshot("HEAD~642")) } },
        {
            checkpoints: {
                left_checkpoint: (factory_at(sys.snapshot("HEAD~650")), factory_at(sys.snapshot("HEAD~650"))),
                right_checkpoint: (factory_at(sys.snapshot("HEAD~550")), factory_at(sys.snapshot("HEAD~550"))),
                witness: factory_at(sys.snapshot("HEAD~651")),
            },
        },
    ];
    compacted
}
