pub fn factory_at(pin: sys.SnapshotRef) = sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);
pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

// Each returned closure shadows the previous pin name; its own call selects its own snapshot.
pub fn nested_factory(pin: sys.SnapshotRef) =
    (pin: sys.SnapshotRef) =>
        (pin: sys.SnapshotRef) => chained_factory(pin);

pub fn paired_nested_rebind_checkpoints() {
    let root_saved = nested_factory(sys.snapshot("HEAD~100"));
    let root_rolling = root_saved;
    root_rolling = nested_factory(sys.snapshot("HEAD~102"));
    root_rolling = nested_factory(sys.snapshot("HEAD~101"));
    root_rolling = root_saved;

    let left_saved = root_rolling(sys.snapshot("HEAD~10"));
    let right_saved = root_rolling(sys.snapshot("HEAD~20"));
    let left_rolling = left_saved;
    left_rolling = root_rolling(sys.snapshot("HEAD~12"));
    left_rolling = root_rolling(sys.snapshot("HEAD~11"));
    left_rolling = left_saved;
    let right_rolling = right_saved;
    right_rolling = root_rolling(sys.snapshot("HEAD~22"));
    right_rolling = root_rolling(sys.snapshot("HEAD~21"));
    right_rolling = right_saved;

    {
        left: left_rolling(sys.snapshot("HEAD~1")),
        right: right_rolling(sys.snapshot("HEAD~2")),
    }
}
