pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn omitted_tail_checkpoint_at(failure: Error, root_pin: sys.SnapshotRef) =
    (branch_pin: sys.SnapshotRef) =>
    (leaf_pin: sys.SnapshotRef) =>
    (tail_pin: sys.SnapshotRef) => {
        root: factory_at(root_pin),
        branch: factory_at(branch_pin),
        leaf: factory_at(leaf_pin),
        tail: fail(failure),
    };

pub fn complete_tail_checkpoint_at(failure: Error, root_pin: sys.SnapshotRef) =
    (branch_pin: sys.SnapshotRef) =>
    (leaf_pin: sys.SnapshotRef) =>
    (tail_pin: sys.SnapshotRef) => {
        root: factory_at(root_pin),
        branch: factory_at(branch_pin),
        leaf: factory_at(leaf_pin),
        tail: factory_at(tail_pin),
    };

pub fn nested_snapshot_boundary_reset_depth_values(failure: Error) {
    let saved_omitted = omitted_tail_checkpoint_at(failure, sys.snapshot("HEAD~620"));
    let rolling = saved_omitted;
    rolling = complete_tail_checkpoint_at(failure, sys.snapshot("HEAD~610"));
    let saved_complete = rolling;
    rolling = complete_tail_checkpoint_at(failure, sys.snapshot("HEAD~600"));
    rolling = saved_omitted;
    let reset_omitted = rolling;
    rolling = saved_complete;
    let reset_complete = rolling;

    {
        saved_omitted: saved_omitted(sys.snapshot("HEAD~590"))(sys.snapshot("HEAD~580"))(sys.snapshot("HEAD~570")),
        reset_omitted: reset_omitted(sys.snapshot("HEAD~560"))(sys.snapshot("HEAD~550"))(sys.snapshot("HEAD~540")),
        reset_complete: reset_complete(sys.snapshot("HEAD~530"))(sys.snapshot("HEAD~520"))(sys.snapshot("HEAD~510")),
    }
}
