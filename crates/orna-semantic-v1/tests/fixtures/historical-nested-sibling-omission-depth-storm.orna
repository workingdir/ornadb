pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

// One omitted sibling depth later reuses a label from its paired sibling.
// Only those conflicting pin leaves should roll back; adjacent depths keep
// their independently reconciled labels through the rest of the storm.
pub fn omitted_sibling_depth_storm_keeps_adjacent_depth_labels(failure: Error) {
    let parents = [
        {
            nested: {
                left: { pins: ((fail(failure), fail(failure)), (factory_at(sys.snapshot("HEAD~120")), factory_at(sys.snapshot("HEAD~121")))) },
                right: { pins: ((factory_at(sys.snapshot("HEAD~100")), factory_at(sys.snapshot("HEAD~101"))), (fail(failure), fail(failure))) },
            },
        },
        {
            nested: {
                left: { pins: ((factory_at(sys.snapshot("HEAD~200")), factory_at(sys.snapshot("HEAD~201"))), (factory_at(sys.snapshot("HEAD~220")), factory_at(sys.snapshot("HEAD~221")))) },
                right: { pins: ((factory_at(sys.snapshot("HEAD~210")), factory_at(sys.snapshot("HEAD~211"))), (factory_at(sys.snapshot("HEAD~230")), factory_at(sys.snapshot("HEAD~231")))) },
            },
        },
        {
            nested: {
                left: { pins: ((factory_at(sys.snapshot("HEAD~100")), factory_at(sys.snapshot("HEAD~242"))), (factory_at(sys.snapshot("HEAD~240")), factory_at(sys.snapshot("HEAD~241")))) },
                right: { pins: ((factory_at(sys.snapshot("HEAD~250")), factory_at(sys.snapshot("HEAD~251"))), (factory_at(sys.snapshot("HEAD~260")), factory_at(sys.snapshot("HEAD~261")))) },
            },
        },
        {
            nested: {
                left: { pins: ((factory_at(sys.snapshot("HEAD~300")), factory_at(sys.snapshot("HEAD~301"))), (factory_at(sys.snapshot("HEAD~320")), factory_at(sys.snapshot("HEAD~321")))) },
                right: { pins: ((factory_at(sys.snapshot("HEAD~310")), factory_at(sys.snapshot("HEAD~311"))), (factory_at(sys.snapshot("HEAD~330")), factory_at(sys.snapshot("HEAD~331")))) },
            },
        },
    ];
    { parent_fold: parents }
}
