pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);

pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn cascade_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) => {
            root: chained_factory(root_pin),
            nested: {
                bridge: chained_factory(bridge_pin)().read,
                leaf: {
                    reader: chained_factory(leaf_pin)().read,
                    continuation: chained_factory(leaf_pin)().read(),
                },
            },
        };

pub fn structure_at(
    primary_pin: sys.SnapshotRef,
    secondary_pin: sys.SnapshotRef,
    tertiary_pin: sys.SnapshotRef,
) = {
    primary: cascade_at(primary_pin),
    nested: {
        secondary: cascade_at(secondary_pin),
        deeper: {
            tertiary: cascade_at(tertiary_pin),
        },
    },
};

pub fn chained_cascades_survive_structural_rebind_storms() {
    let rolling = structure_at(
        sys.snapshot("HEAD~80"),
        sys.snapshot("HEAD~60"),
        sys.snapshot("HEAD~40"),
    );
    let stage_0 = rolling;
    rolling = structure_at(
        sys.snapshot("HEAD~79"),
        sys.snapshot("HEAD~59"),
        sys.snapshot("HEAD~39"),
    );
    rolling = structure_at(
        sys.snapshot("HEAD~78"),
        sys.snapshot("HEAD~58"),
        sys.snapshot("HEAD~38"),
    );
    rolling = structure_at(
        sys.snapshot("HEAD~77"),
        sys.snapshot("HEAD~57"),
        sys.snapshot("HEAD~37"),
    );
    let stage_3 = rolling;
    rolling = structure_at(
        sys.snapshot("HEAD~76"),
        sys.snapshot("HEAD~56"),
        sys.snapshot("HEAD~36"),
    );
    rolling = structure_at(
        sys.snapshot("HEAD~75"),
        sys.snapshot("HEAD~55"),
        sys.snapshot("HEAD~35"),
    );
    rolling = structure_at(
        sys.snapshot("HEAD~74"),
        sys.snapshot("HEAD~54"),
        sys.snapshot("HEAD~34"),
    );
    rolling = structure_at(
        sys.snapshot("HEAD~73"),
        sys.snapshot("HEAD~53"),
        sys.snapshot("HEAD~33"),
    );
    let stage_7 = rolling;
    rolling = stage_0;
    let returned = rolling;

    let outer_cursor = stage_3.primary;
    let stage_3_outer = outer_cursor;
    outer_cursor = returned.primary;
    let returned_outer = outer_cursor;
    outer_cursor = stage_7.nested.deeper.tertiary;
    let stage_7_outer = outer_cursor;
    outer_cursor = stage_3_outer;
    let returned_to_stage_3_outer = outer_cursor;

    let inner_cursor = returned_outer(sys.snapshot("HEAD~70"));
    let returned_inner = inner_cursor;
    inner_cursor = stage_7_outer(sys.snapshot("HEAD~23"));
    let stage_7_inner = inner_cursor;
    inner_cursor = returned_to_stage_3_outer(sys.snapshot("HEAD~57"));
    let stage_3_inner = inner_cursor;

    let returned_value = returned_inner(sys.snapshot("HEAD~20"));
    let stage_7_value = stage_7_inner(sys.snapshot("HEAD~10"));
    let stage_3_value = stage_3_inner(sys.snapshot("HEAD~20"));
    {
        returned: {
            root: [returned_value.root, chained_factory(sys.snapshot("HEAD~80"))],
            bridge: [
                returned_value.nested.bridge,
                chained_factory(sys.snapshot("HEAD~70"))().read,
            ],
            continuation: [
                returned_value.nested.leaf.continuation,
                chained_factory(sys.snapshot("HEAD~20"))().read(),
            ],
        },
        stage_7: {
            root: [stage_7_value.root, chained_factory(sys.snapshot("HEAD~33"))],
            bridge: [
                stage_7_value.nested.bridge,
                chained_factory(sys.snapshot("HEAD~23"))().read,
            ],
            continuation: [
                stage_7_value.nested.leaf.continuation,
                chained_factory(sys.snapshot("HEAD~10"))().read(),
            ],
        },
        stage_3: {
            root: [stage_3_value.root, chained_factory(sys.snapshot("HEAD~77"))],
            bridge: [
                stage_3_value.nested.bridge,
                chained_factory(sys.snapshot("HEAD~57"))().read,
            ],
            continuation: [
                stage_3_value.nested.leaf.continuation,
                chained_factory(sys.snapshot("HEAD~20"))().read(),
            ],
        },
    }
}
