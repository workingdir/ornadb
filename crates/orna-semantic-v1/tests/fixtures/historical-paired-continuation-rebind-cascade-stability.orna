pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);
pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn terminal_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
            };

pub fn followup_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                continuation: terminal_at(terminal_pin),
            };

pub fn cascade_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                followup: followup_at(terminal_pin),
            };

pub fn paired_cascade_at(left_pin: sys.SnapshotRef, right_pin: sys.SnapshotRef) =
    (cascade_at(left_pin), cascade_at(right_pin));

// Restore captured follow-up and terminal continuations across cascaded paired depth storms.
pub fn paired_continuation_rebind_cascades_remain_consistent() {
    let roots = paired_cascade_at(sys.snapshot("HEAD~960"), sys.snapshot("HEAD~950"));
    let (left_root, right_root) = roots;
    let left_origin = left_root(sys.snapshot("HEAD~920"))(sys.snapshot("HEAD~880"))(sys.snapshot("HEAD~840"));
    let right_origin = right_root(sys.snapshot("HEAD~910"))(sys.snapshot("HEAD~870"))(sys.snapshot("HEAD~830"));
    let left_reproduced = cascade_at(sys.snapshot("HEAD~960"))(sys.snapshot("HEAD~920"))(sys.snapshot("HEAD~880"))(sys.snapshot("HEAD~840"));
    let right_reproduced = cascade_at(sys.snapshot("HEAD~950"))(sys.snapshot("HEAD~910"))(sys.snapshot("HEAD~870"))(sys.snapshot("HEAD~830"));

    let followup_roots_saved = (left_origin.followup, right_reproduced.followup);
    let followup_roots_rolling = followup_roots_saved;
    followup_roots_rolling = (followup_at(sys.snapshot("HEAD~739")), followup_at(sys.snapshot("HEAD~729")));
    followup_roots_rolling = (followup_at(sys.snapshot("HEAD~738")), followup_at(sys.snapshot("HEAD~728")));
    followup_roots_rolling = (followup_at(sys.snapshot("HEAD~737")), followup_at(sys.snapshot("HEAD~727")));
    followup_roots_rolling = followup_roots_saved;
    let followup_roots_restored = followup_roots_rolling;
    let (left_followup_root, right_followup_root) = followup_roots_restored;

    let followup_bridges_saved = (
        left_followup_root(sys.snapshot("HEAD~800")),
        right_followup_root(sys.snapshot("HEAD~790")),
    );
    let followup_bridges_rolling = followup_bridges_saved;
    followup_bridges_rolling = (
        left_followup_root(sys.snapshot("HEAD~798")),
        right_followup_root(sys.snapshot("HEAD~788")),
    );
    followup_bridges_rolling = (
        left_followup_root(sys.snapshot("HEAD~799")),
        right_followup_root(sys.snapshot("HEAD~789")),
    );
    followup_bridges_rolling = followup_bridges_saved;
    let followup_bridges_restored = followup_bridges_rolling;
    let (left_followup_bridge, right_followup_bridge) = followup_bridges_restored;

    let followup_leaves_saved = (
        left_followup_bridge(sys.snapshot("HEAD~780")),
        right_followup_bridge(sys.snapshot("HEAD~770")),
    );
    let followup_leaves_rolling = followup_leaves_saved;
    followup_leaves_rolling = (
        left_followup_bridge(sys.snapshot("HEAD~778")),
        right_followup_bridge(sys.snapshot("HEAD~768")),
    );
    followup_leaves_rolling = (
        left_followup_bridge(sys.snapshot("HEAD~779")),
        right_followup_bridge(sys.snapshot("HEAD~769")),
    );
    followup_leaves_rolling = followup_leaves_saved;
    let followup_leaves_restored = followup_leaves_rolling;
    let (left_followup_leaf, right_followup_leaf) = followup_leaves_restored;
    let left_followup_after_storm = left_followup_leaf(sys.snapshot("HEAD~760"));
    let right_followup_after_storm = right_followup_leaf(sys.snapshot("HEAD~750"));
    let left_followup_origin = left_origin.followup(sys.snapshot("HEAD~800"))(sys.snapshot("HEAD~780"))(sys.snapshot("HEAD~760"));
    let right_followup_origin = right_origin.followup(sys.snapshot("HEAD~790"))(sys.snapshot("HEAD~770"))(sys.snapshot("HEAD~750"));
    let left_followup_reproduced = left_reproduced.followup(sys.snapshot("HEAD~800"))(sys.snapshot("HEAD~780"))(sys.snapshot("HEAD~760"));
    let right_followup_reproduced = right_reproduced.followup(sys.snapshot("HEAD~790"))(sys.snapshot("HEAD~770"))(sys.snapshot("HEAD~750"));

    let terminal_roots_saved = (left_followup_origin.continuation, right_followup_reproduced.continuation);
    let terminal_roots_rolling = terminal_roots_saved;
    terminal_roots_rolling = (terminal_at(sys.snapshot("HEAD~659")), terminal_at(sys.snapshot("HEAD~649")));
    terminal_roots_rolling = (terminal_at(sys.snapshot("HEAD~658")), terminal_at(sys.snapshot("HEAD~648")));
    terminal_roots_rolling = (terminal_at(sys.snapshot("HEAD~657")), terminal_at(sys.snapshot("HEAD~647")));
    terminal_roots_rolling = terminal_roots_saved;
    let terminal_roots_restored = terminal_roots_rolling;
    let (left_terminal_root, right_terminal_root) = terminal_roots_restored;

    let terminal_bridges_saved = (
        left_terminal_root(sys.snapshot("HEAD~680")),
        right_terminal_root(sys.snapshot("HEAD~670")),
    );
    let terminal_bridges_rolling = terminal_bridges_saved;
    terminal_bridges_rolling = (
        left_terminal_root(sys.snapshot("HEAD~678")),
        right_terminal_root(sys.snapshot("HEAD~668")),
    );
    terminal_bridges_rolling = (
        left_terminal_root(sys.snapshot("HEAD~679")),
        right_terminal_root(sys.snapshot("HEAD~669")),
    );
    terminal_bridges_rolling = terminal_bridges_saved;
    let terminal_bridges_restored = terminal_bridges_rolling;
    let (left_terminal_bridge, right_terminal_bridge) = terminal_bridges_restored;

    let terminal_leaves_saved = (
        left_terminal_bridge(sys.snapshot("HEAD~660")),
        right_terminal_bridge(sys.snapshot("HEAD~650")),
    );
    let terminal_leaves_rolling = terminal_leaves_saved;
    terminal_leaves_rolling = (
        left_terminal_bridge(sys.snapshot("HEAD~658")),
        right_terminal_bridge(sys.snapshot("HEAD~648")),
    );
    terminal_leaves_rolling = (
        left_terminal_bridge(sys.snapshot("HEAD~659")),
        right_terminal_bridge(sys.snapshot("HEAD~649")),
    );
    terminal_leaves_rolling = terminal_leaves_saved;
    let terminal_leaves_restored = terminal_leaves_rolling;
    let (left_terminal_leaf, right_terminal_leaf) = terminal_leaves_restored;
    let left_terminal_after_storm = left_terminal_leaf(sys.snapshot("HEAD~640"));
    let right_terminal_after_storm = right_terminal_leaf(sys.snapshot("HEAD~630"));
    let left_terminal_origin = left_followup_origin.continuation(sys.snapshot("HEAD~680"))(sys.snapshot("HEAD~660"))(sys.snapshot("HEAD~640"));
    let right_terminal_origin = right_followup_origin.continuation(sys.snapshot("HEAD~670"))(sys.snapshot("HEAD~650"))(sys.snapshot("HEAD~630"));
    let left_terminal_reproduced = left_followup_reproduced.continuation(sys.snapshot("HEAD~680"))(sys.snapshot("HEAD~660"))(sys.snapshot("HEAD~640"));
    let right_terminal_reproduced = right_followup_reproduced.continuation(sys.snapshot("HEAD~670"))(sys.snapshot("HEAD~650"))(sys.snapshot("HEAD~630"));

    {
        followup_checkpoints: {
            roots: [followup_roots_saved, followup_roots_restored],
            bridges: [followup_bridges_saved, followup_bridges_restored],
            leaves: [followup_leaves_saved, followup_leaves_restored],
            left: [left_followup_origin, left_followup_after_storm, left_followup_reproduced],
            right: [right_followup_origin, right_followup_after_storm, right_followup_reproduced],
        },
        terminal_checkpoints: {
            roots: [terminal_roots_saved, terminal_roots_restored],
            bridges: [terminal_bridges_saved, terminal_bridges_restored],
            leaves: [terminal_leaves_saved, terminal_leaves_restored],
            left: [left_terminal_origin, left_terminal_after_storm, left_terminal_reproduced],
            right: [right_terminal_origin, right_terminal_after_storm, right_terminal_reproduced],
        },
    }
}
