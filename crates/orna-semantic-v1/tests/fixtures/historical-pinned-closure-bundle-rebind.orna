pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);

pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn rebound_bundle_keeps_each_component_on_its_pin() {
    let current = {
        left: chained_factory(sys.snapshot("HEAD~30")),
        right: forwarded_factory(sys.snapshot("HEAD~30")),
    };
    let original = current;
    current = {
        left: chained_factory(sys.snapshot("HEAD~20")),
        right: forwarded_factory(sys.snapshot("HEAD~20")),
    };
    let middle = current;
    current = {
        left: chained_factory(sys.snapshot("HEAD~10")),
        right: forwarded_factory(sys.snapshot("HEAD~10")),
    };
    {
        original_left: [original.left, chained_factory(sys.snapshot("HEAD~30"))],
        original_right: [original.right, forwarded_factory(sys.snapshot("HEAD~30"))],
        middle_left: [middle.left, chained_factory(sys.snapshot("HEAD~20"))],
        middle_right: [middle.right, forwarded_factory(sys.snapshot("HEAD~20"))],
        latest_left: [current.left, chained_factory(sys.snapshot("HEAD~10"))],
        latest_right: [current.right, forwarded_factory(sys.snapshot("HEAD~10"))],
    }
}
