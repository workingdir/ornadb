pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn accepts_sparse_pair_rebind_cascade(failure: Error) {
    let parents = [
        { pins: (factory_at(sys.snapshot("HEAD~10")), fail(failure)) },
        { pins: (factory_at(sys.snapshot("HEAD~20")), factory_at(sys.snapshot("HEAD~20"))) },
        { pins: (factory_at(sys.snapshot("HEAD~30")), factory_at(sys.snapshot("HEAD~30"))) },
    ];
    { parent_fold: parents }
}

pub fn rejects_sparse_pair_identity_split_cascade(failure: Error) {
    let parents = [
        { pins: (factory_at(sys.snapshot("HEAD~40")), fail(failure)) },
        { pins: (factory_at(sys.snapshot("HEAD~50")), factory_at(sys.snapshot("HEAD~50"))) },
        { pins: (factory_at(sys.snapshot("HEAD~60")), factory_at(sys.snapshot("HEAD~61"))) },
    ];
    { parent_fold: parents }
}
