pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

// If the right tuple is omitted, captures from the supplied left tuple must
// remain unresolved too. The callback returns real historical database values.
pub fn paired_capture_wave() =
    ((left_selected, left_sibling): (sys.SnapshotRef, sys.SnapshotRef),
     (right_selected, right_sibling): (sys.SnapshotRef, sys.SnapshotRef)) =>
        (terminal_pin: sys.SnapshotRef) => {
            left_selected_capture: factory_at(left_selected),
            left_sibling_capture: factory_at(left_sibling),
            right_selected_capture: factory_at(right_selected),
            right_sibling_capture: factory_at(right_sibling),
            terminal_capture: factory_at(terminal_pin),
        };

pub fn omitted_tuple_suppresses_sibling_capture_rebinding() {
    let callback = paired_capture_wave();
    let incomplete = callback(
        (sys.snapshot("HEAD~600"), sys.snapshot("HEAD~590")),
    )(sys.snapshot("HEAD~570"));
    let complete = callback(
        (sys.snapshot("HEAD~560"), sys.snapshot("HEAD~550")),
        (sys.snapshot("HEAD~540"), sys.snapshot("HEAD~530")),
    )(sys.snapshot("HEAD~520"));
    {
        incomplete: incomplete,
        complete: complete,
    }
}
