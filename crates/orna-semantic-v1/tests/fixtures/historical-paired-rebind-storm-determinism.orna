pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn accepts_paired_rebind_storm(failure: Error) {
    let parents = [
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~100")), factory_at(sys.snapshot("HEAD~100"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~101")), factory_at(sys.snapshot("HEAD~102"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~110")), fail(failure)) },
            right: { pins: (factory_at(sys.snapshot("HEAD~111")), factory_at(sys.snapshot("HEAD~112"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~120")), factory_at(sys.snapshot("HEAD~120"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~121")), factory_at(sys.snapshot("HEAD~122"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~130")), fail(failure)) },
            right: { pins: (factory_at(sys.snapshot("HEAD~131")), factory_at(sys.snapshot("HEAD~132"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~140")), factory_at(sys.snapshot("HEAD~140"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~141")), factory_at(sys.snapshot("HEAD~142"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~150")), fail(failure)) },
            right: { pins: (factory_at(sys.snapshot("HEAD~151")), factory_at(sys.snapshot("HEAD~152"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~160")), factory_at(sys.snapshot("HEAD~160"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~161")), factory_at(sys.snapshot("HEAD~162"))) },
        },
    ];
    { parent_fold: parents }
}

pub fn rejects_paired_rebind_storm_split_without_losing_sibling_values(failure: Error) {
    let parents = [
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~200")), factory_at(sys.snapshot("HEAD~200"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~201")), factory_at(sys.snapshot("HEAD~202"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~210")), fail(failure)) },
            right: { pins: (factory_at(sys.snapshot("HEAD~211")), factory_at(sys.snapshot("HEAD~212"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~220")), factory_at(sys.snapshot("HEAD~220"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~221")), factory_at(sys.snapshot("HEAD~222"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~230")), fail(failure)) },
            right: { pins: (factory_at(sys.snapshot("HEAD~231")), factory_at(sys.snapshot("HEAD~232"))) },
        },
        {
            left: { pins: (factory_at(sys.snapshot("HEAD~240")), factory_at(sys.snapshot("HEAD~250"))) },
            right: { pins: (factory_at(sys.snapshot("HEAD~251")), factory_at(sys.snapshot("HEAD~252"))) },
        },
    ];
    { parent_fold: parents }
}

