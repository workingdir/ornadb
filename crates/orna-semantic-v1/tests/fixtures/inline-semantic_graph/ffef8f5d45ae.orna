
            pub table Reading(id: Int) { value: Int, }

            pub fn sum_to(limit: Int): Int {
                let total = 0;
                for value in 0..limit {
                    total += value;
                }
                total
            }

            pub fn populate() {
                for value in 0..2 {
                    Reading.insert({ id: value, value: value });
                }
            }
        