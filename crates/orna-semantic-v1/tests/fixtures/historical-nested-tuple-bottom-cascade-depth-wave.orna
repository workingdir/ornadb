pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn bottom_cascade_tuple_wave(root_pin: sys.SnapshotRef) =
    ((selected, (left, (middle, right))): (sys.SnapshotRef, (sys.SnapshotRef, (sys.SnapshotRef, sys.SnapshotRef)))) => {
        let outer_selected = selected;
        let outer_left = left;
        let outer_middle = middle;
        let outer_right = right;
        ((selected, (left, (middle, right))): (sys.SnapshotRef, (sys.SnapshotRef, (sys.SnapshotRef, sys.SnapshotRef)))) => {
            let first_selected = selected;
            let first_left = left;
            let first_middle = middle;
            let first_right = right;
            ((selected, (left, (middle, right))): (sys.SnapshotRef, (sys.SnapshotRef, (sys.SnapshotRef, sys.SnapshotRef)))) => {
                let second_selected = selected;
                let second_left = left;
                let second_middle = middle;
                let second_right = right;
                ((selected, (left, (middle, right))): (sys.SnapshotRef, (sys.SnapshotRef, (sys.SnapshotRef, sys.SnapshotRef)))) => {
                    let third_selected = selected;
                    let third_left = left;
                    let third_middle = middle;
                    let third_right = right;
                    {
                        outer_selected: std.concurrent.parallel([() => factory_at(outer_selected), () => factory_at(outer_selected)]),
                        outer_left: std.concurrent.parallel([() => factory_at(outer_left), () => factory_at(outer_left)]),
                        outer_middle: std.concurrent.parallel([() => factory_at(outer_middle), () => factory_at(outer_middle)]),
                        outer_right: std.concurrent.parallel([() => factory_at(outer_right), () => factory_at(outer_right)]),
                        first_selected: std.concurrent.parallel([() => factory_at(first_selected), () => factory_at(first_selected)]),
                        first_left: std.concurrent.parallel([() => factory_at(first_left), () => factory_at(first_left)]),
                        first_middle: std.concurrent.parallel([() => factory_at(first_middle), () => factory_at(first_middle)]),
                        first_right: std.concurrent.parallel([() => factory_at(first_right), () => factory_at(first_right)]),
                        second_selected: std.concurrent.parallel([() => factory_at(second_selected), () => factory_at(second_selected)]),
                        second_left: std.concurrent.parallel([() => factory_at(second_left), () => factory_at(second_left)]),
                        second_middle: std.concurrent.parallel([() => factory_at(second_middle), () => factory_at(second_middle)]),
                        second_right: std.concurrent.parallel([() => factory_at(second_right), () => factory_at(second_right)]),
                        third_selected: std.concurrent.parallel([() => factory_at(third_selected), () => factory_at(third_selected)]),
                        third_left: std.concurrent.parallel([() => factory_at(third_left), () => factory_at(third_left)]),
                        third_middle: std.concurrent.parallel([() => factory_at(third_middle), () => factory_at(third_middle)]),
                        third_right: std.concurrent.parallel([() => factory_at(third_right), () => factory_at(third_right)]),
                    }
                }
            }
        }
    };

pub fn paired_bottom_cascade_tuple_depth_identities(failure: Error) {
    let left_root = bottom_cascade_tuple_wave(sys.snapshot("HEAD~600"));
    let right_root = bottom_cascade_tuple_wave(sys.snapshot("HEAD~590"));
    let left_first = left_root((
        sys.snapshot("HEAD~450"),
        (sys.snapshot("HEAD~440"), (sys.snapshot("HEAD~430"), sys.snapshot("HEAD~420"))),
    ));
    let right_first = right_root((
        sys.snapshot("HEAD~410"),
        (sys.snapshot("HEAD~400"), (sys.snapshot("HEAD~390"), sys.snapshot("HEAD~380"))),
    ));

    // A failure in an interior leaf invalidates the whole left wave. The
    // paired right lane completes that depth and captures distinct identities.
    let left_second = left_first((
        sys.snapshot("HEAD~370"),
        (fail(failure), (sys.snapshot("HEAD~350"), sys.snapshot("HEAD~340"))),
    ));
    let right_second = right_first((
        sys.snapshot("HEAD~330"),
        (sys.snapshot("HEAD~320"), (sys.snapshot("HEAD~310"), sys.snapshot("HEAD~300"))),
    ));

    // The lanes reverse: left completes depth three, right fails at its first
    // leaf, then left fails at its final leaf while right completes depth four.
    let left_third = left_second((
        sys.snapshot("HEAD~290"),
        (sys.snapshot("HEAD~280"), (sys.snapshot("HEAD~270"), sys.snapshot("HEAD~260"))),
    ));
    let right_third = right_second((
        fail(failure),
        (sys.snapshot("HEAD~240"), (sys.snapshot("HEAD~230"), sys.snapshot("HEAD~220"))),
    ));
    let left_values = left_third((
        sys.snapshot("HEAD~210"),
        (sys.snapshot("HEAD~200"), (sys.snapshot("HEAD~190"), fail(failure))),
    ));
    let right_values = right_third((
        sys.snapshot("HEAD~170"),
        (sys.snapshot("HEAD~160"), (sys.snapshot("HEAD~150"), sys.snapshot("HEAD~140"))),
    ));

    {
        left: {
            outer_selected: left_values.outer_selected,
            outer_left: left_values.outer_left,
            outer_middle: left_values.outer_middle,
            outer_right: left_values.outer_right,
            first_selected: left_values.first_selected,
            first_left: left_values.first_left,
            first_middle: left_values.first_middle,
            first_right: left_values.first_right,
            second_selected: left_values.second_selected,
            second_left: left_values.second_left,
            second_middle: left_values.second_middle,
            second_right: left_values.second_right,
            third_selected: left_values.third_selected,
            third_left: left_values.third_left,
            third_middle: left_values.third_middle,
            third_right: left_values.third_right,
        },
        right: {
            outer_selected: right_values.outer_selected,
            outer_left: right_values.outer_left,
            outer_middle: right_values.outer_middle,
            outer_right: right_values.outer_right,
            first_selected: right_values.first_selected,
            first_left: right_values.first_left,
            first_middle: right_values.first_middle,
            first_right: right_values.first_right,
            second_selected: right_values.second_selected,
            second_left: right_values.second_left,
            second_middle: right_values.second_middle,
            second_right: right_values.second_right,
            third_selected: right_values.third_selected,
            third_left: right_values.third_left,
            third_middle: right_values.third_middle,
            third_right: right_values.third_right,
        },
    }
}

pub fn scalar_and_tuple_wave(global_pin: sys.SnapshotRef, pins: (sys.SnapshotRef, (sys.SnapshotRef, sys.SnapshotRef))) =
    (leaf_pin: sys.SnapshotRef) => {
        global_capture: std.concurrent.parallel([() => factory_at(global_pin), () => factory_at(global_pin)])
    };

pub fn scalar_pin_after_incomplete_tuple_wave(failure: Error) {
    let incomplete = scalar_and_tuple_wave(
        sys.snapshot("HEAD~90"),
        (sys.snapshot("HEAD~80"), (sys.snapshot("HEAD~70"), fail(failure)))
    );
    let complete = scalar_and_tuple_wave(
        sys.snapshot("HEAD~60"),
        (sys.snapshot("HEAD~50"), (sys.snapshot("HEAD~40"), sys.snapshot("HEAD~30")))
    );
    let incomplete_values = incomplete(sys.snapshot("HEAD~20"));
    let complete_values = complete(sys.snapshot("HEAD~10"));
    {
        incomplete: { global: incomplete_values.global_capture },
        complete: { global: complete_values.global_capture },
    }
}
