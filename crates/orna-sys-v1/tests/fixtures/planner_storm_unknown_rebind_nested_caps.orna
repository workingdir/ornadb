pub table PlannerStormUnknownRebindNestedCaps(id: Int) {
    first: Bool,
    middle: Bool,
    deep: Bool,
    sibling: Bool,
}
pub fn unknown_rebind_nested_caps() = PlannerStormUnknownRebindNestedCaps
    | union(
        PlannerStormUnknownRebindNestedCaps
            | take(20)
            | union(
                PlannerStormUnknownRebindNestedCaps | take(40) | filter(row => row.deep),
                PlannerStormUnknownRebindNestedCaps | take(40) | filter(row => row.deep),
                PlannerStormUnknownRebindNestedCaps | take(40) | filter(row => row.deep)
            )
            | take(10)
            | filter(row => row.first),
        PlannerStormUnknownRebindNestedCaps | take(8) | filter(row => row.sibling)
    )
    | union(
        PlannerStormUnknownRebindNestedCaps
            | take(6)
            | union(
                PlannerStormUnknownRebindNestedCaps | take(24) | filter(row => row.deep),
                PlannerStormUnknownRebindNestedCaps | take(24) | filter(row => row.deep)
            )
            | take(3)
            | filter(row => row.middle),
        PlannerStormUnknownRebindNestedCaps | take(4) | filter(row => row.sibling)
    )
    | union(
        PlannerStormUnknownRebindNestedCaps | take(2) | filter(row => row.first),
        PlannerStormUnknownRebindNestedCaps | take(1) | filter(row => row.sibling)
    );
