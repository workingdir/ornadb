pub table PlannerStormPartialEstimateRebindStages(id: Int) {
    first: Bool,
    middle: Bool,
    deep: Bool,
    sibling: Bool,
}
pub fn partial_estimate_rebind_stages() = PlannerStormPartialEstimateRebindStages
    | union(
        PlannerStormPartialEstimateRebindStages
            | take(20)
            | union(
                PlannerStormPartialEstimateRebindStages | take(40) | filter(row => row.deep),
                PlannerStormPartialEstimateRebindStages | take(40) | filter(row => row.deep),
                PlannerStormPartialEstimateRebindStages | take(40) | filter(row => row.deep)
            )
            | take(10)
            | union(
                PlannerStormPartialEstimateRebindStages | take(30) | filter(row => row.middle),
                PlannerStormPartialEstimateRebindStages | take(30) | filter(row => row.middle)
            )
            | filter(row => row.first),
        PlannerStormPartialEstimateRebindStages | take(8) | filter(row => row.sibling)
    )
    | union(
        PlannerStormPartialEstimateRebindStages
            | take(6)
            | union(
                PlannerStormPartialEstimateRebindStages | take(24) | filter(row => row.deep),
                PlannerStormPartialEstimateRebindStages | take(24) | filter(row => row.deep)
            )
            | take(3)
            | filter(row => row.middle),
        PlannerStormPartialEstimateRebindStages | take(4) | filter(row => row.sibling)
    )
    | union(
        PlannerStormPartialEstimateRebindStages | take(2) | filter(row => row.first),
        PlannerStormPartialEstimateRebindStages | take(1) | filter(row => row.sibling)
    );
