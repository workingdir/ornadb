pub table PlannerStormRebindCapHandoffEstimates(id: Int) {
    root: Bool,
    nested: Bool,
    leaf: Bool,
}
pub fn rebind_cap_handoff_estimates() = PlannerStormRebindCapHandoffEstimates
    | take(100)
    | union(
        PlannerStormRebindCapHandoffEstimates
            | take(100)
            | union(
                PlannerStormRebindCapHandoffEstimates | take(80) | filter(row => row.leaf),
                PlannerStormRebindCapHandoffEstimates | take(80) | filter(row => row.leaf)
            )
            | take(50)
            | filter(row => row.nested),
        PlannerStormRebindCapHandoffEstimates | take(20) | filter(row => row.root)
    )
    | union(
        PlannerStormRebindCapHandoffEstimates
            | take(30)
            | union(
                PlannerStormRebindCapHandoffEstimates | take(40) | filter(row => row.leaf),
                PlannerStormRebindCapHandoffEstimates | take(40) | filter(row => row.leaf)
            )
            | filter(row => row.nested),
        PlannerStormRebindCapHandoffEstimates | take(10) | filter(row => row.root)
    );
