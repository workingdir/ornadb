pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn single_pair_sparse_pin_fold_chain(failure: Error) {
    let checkpoints = [
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~6000")), fail(failure)),
            right_checkpoint: (fail(failure), fail(failure)),
            witness: factory_at(sys.snapshot("HEAD~6001")),
        },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~6000")), factory_at(sys.snapshot("HEAD~6010"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~5900")), factory_at(sys.snapshot("HEAD~5900"))),
            witness: factory_at(sys.snapshot("HEAD~6011")),
        },
        { witness: factory_at(sys.snapshot("HEAD~6021")) },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~6000")), factory_at(sys.snapshot("HEAD~6020"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~5900")), factory_at(sys.snapshot("HEAD~5900"))),
            witness: factory_at(sys.snapshot("HEAD~6031")),
        },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~6020")), factory_at(sys.snapshot("HEAD~6000"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~5900")), factory_at(sys.snapshot("HEAD~5900"))),
            witness: factory_at(sys.snapshot("HEAD~6041")),
        },
        {
            left_checkpoint: (factory_at(sys.snapshot("HEAD~6000")), factory_at(sys.snapshot("HEAD~6050"))),
            right_checkpoint: (factory_at(sys.snapshot("HEAD~5900")), factory_at(sys.snapshot("HEAD~5900"))),
            witness: factory_at(sys.snapshot("HEAD~6051")),
        },
    ];
    checkpoints
}
