pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

// Restoring a paired callback tuple must not make its two lane pins compatible.
pub fn paired_callback_pins_reject_cross_lane_mix() {
    let rolling = (
        (
            () => factory_at(sys.snapshot("HEAD~80")),
            () => factory_at(sys.snapshot("HEAD~60")),
        ),
        (
            () => factory_at(sys.snapshot("HEAD~40")),
            () => factory_at(sys.snapshot("HEAD~20")),
        ),
    );
    let saved = rolling;
    rolling = (
        (
            () => factory_at(sys.snapshot("HEAD~79")),
            () => factory_at(sys.snapshot("HEAD~59")),
        ),
        (
            () => factory_at(sys.snapshot("HEAD~39")),
            () => factory_at(sys.snapshot("HEAD~19")),
        ),
    );
    rolling = saved;

    let ((left_root, left_leaf), (right_root, right_leaf)) = rolling;
    std.concurrent.parallel([left_leaf, right_leaf])
}
