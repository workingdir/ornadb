pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn accepts_nested_three_way_rebind_chain() {
    let parents = [
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~500")), factory_at(sys.snapshot("HEAD~500"))),
                (factory_at(sys.snapshot("HEAD~501")), factory_at(sys.snapshot("HEAD~502"))),
            ),
        },
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~510")), factory_at(sys.snapshot("HEAD~510"))),
                (factory_at(sys.snapshot("HEAD~511")), factory_at(sys.snapshot("HEAD~512"))),
            ),
        },
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~520")), factory_at(sys.snapshot("HEAD~520"))),
                (factory_at(sys.snapshot("HEAD~521")), factory_at(sys.snapshot("HEAD~522"))),
            ),
        },
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~530")), factory_at(sys.snapshot("HEAD~530"))),
                (factory_at(sys.snapshot("HEAD~531")), factory_at(sys.snapshot("HEAD~532"))),
            ),
        },
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~540")), factory_at(sys.snapshot("HEAD~540"))),
                (factory_at(sys.snapshot("HEAD~541")), factory_at(sys.snapshot("HEAD~542"))),
            ),
        },
    ];
    { parent_fold: parents }
}

pub fn rejects_nested_three_way_pair_split_without_losing_sibling_values() {
    let parents = [
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~600")), factory_at(sys.snapshot("HEAD~600"))),
                (factory_at(sys.snapshot("HEAD~601")), factory_at(sys.snapshot("HEAD~602"))),
            ),
        },
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~610")), factory_at(sys.snapshot("HEAD~610"))),
                (factory_at(sys.snapshot("HEAD~611")), factory_at(sys.snapshot("HEAD~612"))),
            ),
        },
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~620")), factory_at(sys.snapshot("HEAD~620"))),
                (factory_at(sys.snapshot("HEAD~621")), factory_at(sys.snapshot("HEAD~622"))),
            ),
        },
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~630")), factory_at(sys.snapshot("HEAD~631"))),
                (factory_at(sys.snapshot("HEAD~641")), factory_at(sys.snapshot("HEAD~642"))),
            ),
        },
        {
            pins: (
                (factory_at(sys.snapshot("HEAD~640")), factory_at(sys.snapshot("HEAD~640"))),
                (factory_at(sys.snapshot("HEAD~651")), factory_at(sys.snapshot("HEAD~652"))),
            ),
        },
    ];
    { parent_fold: parents }
}
