pub fn storage_policy(storage: sys.Storage): sys.Value = storage.publication_policy;
pub fn storage_pending_rows(storage: sys.Storage): Int = storage.pending_rows;
pub fn storage_pending_bytes(storage: sys.Storage): Int = storage.pending_bytes;
pub fn storage_last_publication(storage: sys.Storage): Instant? = storage.last_publication;
pub fn storage_last_snapshot(storage: sys.Storage): sys.SnapshotRef? = storage.last_snapshot;
pub fn storage_generation(storage: sys.Storage): Int = storage.logical_generation;
pub fn storage_objects() = sys.storage.objects;

pub fn maintenance_kind(job: sys.MaintenanceJob): sys.MaintenanceKind = job.kind;
pub fn maintenance_status(job: sys.MaintenanceJob): sys.BuildStatus = job.status;
pub fn maintenance_progress(job: sys.MaintenanceJob): Decimal? = job.progress;
pub fn maintenance_ended(job: sys.MaintenanceJob): Instant? = job.ended;
pub fn maintenance_failure(job: sys.MaintenanceJob): sys.Diagnostic? = job.failure;
pub fn checkpoint_publications() =
    sys.storage.maintenance | filter(job => job.kind == sys.MaintenanceKind.checkpoint_publish);
