pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);

pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn rebinding_a_pin_keeps_old_closures_and_uses_the_new_pin() {
    let pin = sys.snapshot("HEAD~10");
    let before = chained_factory(pin);
    pin = sys.snapshot("HEAD");
    let after = forwarded_factory(pin);
    {
        before: [before, chained_factory(sys.snapshot("HEAD~10"))],
        after: [after, forwarded_factory(sys.snapshot("HEAD"))],
    }
}
