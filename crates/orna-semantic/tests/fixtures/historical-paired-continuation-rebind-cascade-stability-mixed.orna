pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);
pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn terminal_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
            };

pub fn followup_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                continuation: terminal_at(terminal_pin),
            };

pub fn cascade_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                followup: followup_at(terminal_pin),
            };

// Each restored nested cascade must preserve the terminal identity of its own pair side.
pub fn paired_continuation_rebind_cascades_reject_cross_lane_mixing() {
    let left_origin = cascade_at(sys.snapshot("HEAD~960"))(sys.snapshot("HEAD~920"))(sys.snapshot("HEAD~880"))(sys.snapshot("HEAD~840"));
    let right_origin = cascade_at(sys.snapshot("HEAD~950"))(sys.snapshot("HEAD~910"))(sys.snapshot("HEAD~870"))(sys.snapshot("HEAD~830"));

    let followup_roots_saved = (left_origin.followup, right_origin.followup);
    let followup_roots_rolling = followup_roots_saved;
    followup_roots_rolling = (followup_at(sys.snapshot("HEAD~739")), followup_at(sys.snapshot("HEAD~729")));
    followup_roots_rolling = (followup_at(sys.snapshot("HEAD~738")), followup_at(sys.snapshot("HEAD~728")));
    followup_roots_rolling = followup_roots_saved;
    let (left_followup_root, right_followup_root) = followup_roots_rolling;
    let followup_bridges_saved = (left_followup_root(sys.snapshot("HEAD~800")), right_followup_root(sys.snapshot("HEAD~790")));
    let followup_bridges_rolling = followup_bridges_saved;
    followup_bridges_rolling = (left_followup_root(sys.snapshot("HEAD~798")), right_followup_root(sys.snapshot("HEAD~788")));
    followup_bridges_rolling = followup_bridges_saved;
    let (left_followup_bridge, right_followup_bridge) = followup_bridges_rolling;
    let followup_leaves_saved = (left_followup_bridge(sys.snapshot("HEAD~780")), right_followup_bridge(sys.snapshot("HEAD~770")));
    let followup_leaves_rolling = followup_leaves_saved;
    followup_leaves_rolling = (left_followup_bridge(sys.snapshot("HEAD~778")), right_followup_bridge(sys.snapshot("HEAD~768")));
    followup_leaves_rolling = followup_leaves_saved;
    let (left_followup_leaf, right_followup_leaf) = followup_leaves_rolling;
    let left_followup = left_followup_leaf(sys.snapshot("HEAD~760"));
    let right_followup = right_followup_leaf(sys.snapshot("HEAD~750"));

    let terminal_roots_saved = (left_followup.continuation, right_followup.continuation);
    let terminal_roots_rolling = terminal_roots_saved;
    terminal_roots_rolling = (terminal_at(sys.snapshot("HEAD~659")), terminal_at(sys.snapshot("HEAD~649")));
    terminal_roots_rolling = (terminal_at(sys.snapshot("HEAD~658")), terminal_at(sys.snapshot("HEAD~648")));
    terminal_roots_rolling = terminal_roots_saved;
    let (left_terminal_root, right_terminal_root) = terminal_roots_rolling;
    let terminal_bridges_saved = (left_terminal_root(sys.snapshot("HEAD~680")), right_terminal_root(sys.snapshot("HEAD~670")));
    let terminal_bridges_rolling = terminal_bridges_saved;
    terminal_bridges_rolling = (left_terminal_root(sys.snapshot("HEAD~678")), right_terminal_root(sys.snapshot("HEAD~668")));
    terminal_bridges_rolling = terminal_bridges_saved;
    let (left_terminal_bridge, right_terminal_bridge) = terminal_bridges_rolling;
    let terminal_leaves_saved = (left_terminal_bridge(sys.snapshot("HEAD~660")), right_terminal_bridge(sys.snapshot("HEAD~650")));
    let terminal_leaves_rolling = terminal_leaves_saved;
    terminal_leaves_rolling = (left_terminal_bridge(sys.snapshot("HEAD~658")), right_terminal_bridge(sys.snapshot("HEAD~648")));
    terminal_leaves_rolling = terminal_leaves_saved;
    let (left_terminal_leaf, right_terminal_leaf) = terminal_leaves_rolling;
    let left_terminal = left_terminal_leaf(sys.snapshot("HEAD~640"));
    let right_terminal = right_terminal_leaf(sys.snapshot("HEAD~630"));

    {
        cross_pair: [left_terminal.terminal, right_terminal.terminal],
    }
}
