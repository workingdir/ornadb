pub dim Length;
pub dim Time;
pub dim Speed = Length / Time;
pub unit m : Length base;
pub unit mile : Length = 1609.344.m;
pub unit s : Time base;
pub unit hour : Time = 3600.s;
pub unit mph : Speed = mile / hour;

pub fn identity<T>(value: T): T = value;
pub fn apply(callback: fn(Int): Int): Int = callback(1);
pub fn measured(value: Float<mph>): Float<mph> = value;
