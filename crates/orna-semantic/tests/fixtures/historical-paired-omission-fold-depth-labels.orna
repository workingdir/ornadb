pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn nested_tuple_wave(root_pin: sys.SnapshotRef) {
    let selected = root_pin;
    let left = root_pin;
    let right = root_pin;
    ((selected, (left, right)): (sys.SnapshotRef, (sys.SnapshotRef, sys.SnapshotRef))) => {
        let outer_selected = selected;
        let outer_left = left;
        let outer_right = right;
        ((selected, (left, right)): (sys.SnapshotRef, (sys.SnapshotRef, sys.SnapshotRef))) => {
            let middle_selected = selected;
            let middle_left = left;
            let middle_right = right;
            ((selected, (left, right)): (sys.SnapshotRef, (sys.SnapshotRef, sys.SnapshotRef))) => {
                {
                    outer_selected: factory_at(outer_selected),
                    outer_left: factory_at(outer_left),
                    outer_right: factory_at(outer_right),
                    middle_selected: factory_at(middle_selected),
                    middle_left: factory_at(middle_left),
                    middle_right: factory_at(middle_right),
                    terminal_selected: factory_at(selected),
                    terminal_left: factory_at(left),
                    terminal_right: factory_at(right),
                }
            }
        }
    }
}

pub fn paired_omission_fold_depth_labels(failure: Error) {
    let left_root = nested_tuple_wave(sys.snapshot("HEAD~900"));
    let right_root = nested_tuple_wave(sys.snapshot("HEAD~890"));
    let left_middle = left_root((
        sys.snapshot("HEAD~850"),
        (sys.snapshot("HEAD~840"), sys.snapshot("HEAD~830")),
    ));
    let right_middle = right_root((
        sys.snapshot("HEAD~820"),
        (sys.snapshot("HEAD~810"), sys.snapshot("HEAD~800")),
    ));

    // The paired second fold omits opposite tuple leaves. Neither side may
    // use the other side's live pin to relabel a depth that this fold omitted.
    let left_inner = left_middle((
        sys.snapshot("HEAD~780"),
        (sys.snapshot("HEAD~770"), fail(failure)),
    ));
    let right_inner = right_middle((
        fail(failure),
        (sys.snapshot("HEAD~740"), sys.snapshot("HEAD~730")),
    ));
    let left_values = left_inner((
        sys.snapshot("HEAD~700"),
        (sys.snapshot("HEAD~690"), sys.snapshot("HEAD~680")),
    ));
    let right_values = right_inner((
        sys.snapshot("HEAD~670"),
        (sys.snapshot("HEAD~660"), sys.snapshot("HEAD~650")),
    ));

    {
        left: left_values,
        right: right_values,
    }
}

pub fn safe_paired_omission_fold(failure: Error) = [
    (
        factory_at(sys.snapshot("HEAD~500")),
        factory_at(sys.snapshot("HEAD~501")),
    ),
    (
        fail(failure),
        factory_at(sys.snapshot("HEAD~502")),
    ),
];

pub fn unsafe_paired_omission_fold(failure: Error) = [
    (
        factory_at(sys.snapshot("HEAD~500")),
        factory_at(sys.snapshot("HEAD~501")),
    ),
    (
        fail(failure),
        factory_at(sys.snapshot("HEAD~500")),
    ),
];
