pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);

pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn tuple_pin_slots_remain_distinct_after_structural_round_trip() {
    let rolling = (
        (sys.snapshot("HEAD~80"), sys.snapshot("HEAD~60")),
        sys.snapshot("HEAD~40"),
    );
    let first = rolling;
    rolling = (
        (sys.snapshot("HEAD~79"), sys.snapshot("HEAD~59")),
        sys.snapshot("HEAD~39"),
    );
    rolling = (
        (sys.snapshot("HEAD~78"), sys.snapshot("HEAD~58")),
        sys.snapshot("HEAD~38"),
    );
    rolling = (
        (sys.snapshot("HEAD~77"), sys.snapshot("HEAD~57")),
        sys.snapshot("HEAD~37"),
    );
    let intermediate = rolling;
    rolling = (
        (sys.snapshot("HEAD~76"), sys.snapshot("HEAD~56")),
        sys.snapshot("HEAD~36"),
    );
    rolling = (
        (sys.snapshot("HEAD~75"), sys.snapshot("HEAD~55")),
        sys.snapshot("HEAD~35"),
    );
    rolling = (
        (sys.snapshot("HEAD~74"), sys.snapshot("HEAD~54")),
        sys.snapshot("HEAD~34"),
    );
    rolling = (
        (sys.snapshot("HEAD~73"), sys.snapshot("HEAD~53")),
        sys.snapshot("HEAD~33"),
    );
    rolling = first;
    let returned = rolling;

    let ((intermediate_primary, _), _) = intermediate;
    let ((returned_primary, _), _) = returned;
    [
        chained_factory(intermediate_primary),
        chained_factory(returned_primary),
    ]
}
