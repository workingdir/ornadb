pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);
pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn final_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
            };

pub fn terminal_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                continuation: final_at(terminal_pin),
            };

pub fn continuation_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) =>
            (terminal_pin: sys.SnapshotRef) => {
                root: chained_factory(root_pin),
                bridge: chained_factory(bridge_pin)().read,
                leaf: chained_factory(leaf_pin)().read,
                terminal: chained_factory(terminal_pin)().read(),
                continuation: terminal_at(terminal_pin),
            };

// Left restores the deepest continuation from root down; right storms descendants before the root.
pub fn paired_continuation_chains_keep_consistent_identity_across_rebind_orders() {
    let left_stage_one = continuation_at(sys.snapshot("HEAD~960"))(sys.snapshot("HEAD~920"))(sys.snapshot("HEAD~880"))(sys.snapshot("HEAD~840"));
    let right_stage_one = continuation_at(sys.snapshot("HEAD~950"))(sys.snapshot("HEAD~910"))(sys.snapshot("HEAD~870"))(sys.snapshot("HEAD~830"));
    let left_stage_one_reproduced = continuation_at(sys.snapshot("HEAD~960"))(sys.snapshot("HEAD~920"))(sys.snapshot("HEAD~880"))(sys.snapshot("HEAD~840"));
    let right_stage_one_reproduced = continuation_at(sys.snapshot("HEAD~950"))(sys.snapshot("HEAD~910"))(sys.snapshot("HEAD~870"))(sys.snapshot("HEAD~830"));
    let left_stage_two_origin = left_stage_one.continuation(sys.snapshot("HEAD~800"))(sys.snapshot("HEAD~780"))(sys.snapshot("HEAD~760"));
    let right_stage_two_origin = right_stage_one.continuation(sys.snapshot("HEAD~790"))(sys.snapshot("HEAD~770"))(sys.snapshot("HEAD~750"));
    let left_stage_two_reproduced = left_stage_one_reproduced.continuation(sys.snapshot("HEAD~800"))(sys.snapshot("HEAD~780"))(sys.snapshot("HEAD~760"));
    let right_stage_two_reproduced = right_stage_one_reproduced.continuation(sys.snapshot("HEAD~790"))(sys.snapshot("HEAD~770"))(sys.snapshot("HEAD~750"));

    let left_final_root_saved = left_stage_two_origin.continuation;
    let left_final_root_rolling = left_final_root_saved;
    left_final_root_rolling = final_at(sys.snapshot("HEAD~739"));
    left_final_root_rolling = final_at(sys.snapshot("HEAD~738"));
    left_final_root_rolling = final_at(sys.snapshot("HEAD~737"));
    left_final_root_rolling = left_final_root_saved;
    let left_final_root_restored = left_final_root_rolling;
    let left_final_bridge_saved = left_final_root_restored(sys.snapshot("HEAD~740"));
    let left_final_bridge_rolling = left_final_bridge_saved;
    left_final_bridge_rolling = left_final_root_restored(sys.snapshot("HEAD~738"));
    left_final_bridge_rolling = left_final_root_restored(sys.snapshot("HEAD~739"));
    left_final_bridge_rolling = left_final_bridge_saved;
    let left_final_bridge_restored = left_final_bridge_rolling;
    let left_final_leaf_saved = left_final_bridge_restored(sys.snapshot("HEAD~720"));
    let left_final_leaf_rolling = left_final_leaf_saved;
    left_final_leaf_rolling = left_final_bridge_restored(sys.snapshot("HEAD~718"));
    left_final_leaf_rolling = left_final_bridge_restored(sys.snapshot("HEAD~719"));
    left_final_leaf_rolling = left_final_leaf_saved;
    let left_final_leaf_restored = left_final_leaf_rolling;
    let left_final_after_storm = left_final_leaf_restored(sys.snapshot("HEAD~700"));
    let left_final_origin = left_stage_two_origin.continuation(sys.snapshot("HEAD~740"))(sys.snapshot("HEAD~720"))(sys.snapshot("HEAD~700"));
    let left_final_reproduced = left_stage_two_reproduced.continuation(sys.snapshot("HEAD~740"))(sys.snapshot("HEAD~720"))(sys.snapshot("HEAD~700"));

    let right_final_root_saved = right_stage_two_origin.continuation;
    let right_final_bridge_saved = right_final_root_saved(sys.snapshot("HEAD~730"));
    let right_final_bridge_rolling = right_final_bridge_saved;
    right_final_bridge_rolling = right_final_root_saved(sys.snapshot("HEAD~728"));
    right_final_bridge_rolling = right_final_root_saved(sys.snapshot("HEAD~729"));
    right_final_bridge_rolling = right_final_bridge_saved;
    let right_final_bridge_restored = right_final_bridge_rolling;
    let right_final_leaf_saved = right_final_bridge_restored(sys.snapshot("HEAD~710"));
    let right_final_leaf_rolling = right_final_leaf_saved;
    right_final_leaf_rolling = right_final_bridge_restored(sys.snapshot("HEAD~708"));
    right_final_leaf_rolling = right_final_bridge_restored(sys.snapshot("HEAD~709"));
    right_final_leaf_rolling = right_final_leaf_saved;
    let right_final_leaf_restored = right_final_leaf_rolling;
    let right_final_before_root_storm = right_final_leaf_restored(sys.snapshot("HEAD~690"));
    let right_final_root_rolling = right_final_root_saved;
    right_final_root_rolling = final_at(sys.snapshot("HEAD~729"));
    right_final_root_rolling = final_at(sys.snapshot("HEAD~728"));
    right_final_root_rolling = right_final_root_saved;
    let right_final_root_restored = right_final_root_rolling;
    let right_final_bridge_after_root = right_final_root_restored(sys.snapshot("HEAD~730"));
    let right_final_leaf_after_root = right_final_bridge_after_root(sys.snapshot("HEAD~710"));
    let right_final_after_storm = right_final_leaf_after_root(sys.snapshot("HEAD~690"));
    let right_final_origin = right_stage_two_origin.continuation(sys.snapshot("HEAD~730"))(sys.snapshot("HEAD~710"))(sys.snapshot("HEAD~690"));
    let right_final_reproduced = right_stage_two_reproduced.continuation(sys.snapshot("HEAD~730"))(sys.snapshot("HEAD~710"))(sys.snapshot("HEAD~690"));

    {
        left_checkpoints: {
            roots: [left_final_root_saved, left_final_root_restored],
            bridges: [left_final_bridge_saved, left_final_bridge_restored],
            leaves: [left_final_leaf_saved, left_final_leaf_restored],
            outputs: [left_final_origin, left_final_after_storm, left_final_reproduced],
        },
        right_checkpoints: {
            bridges: [right_final_bridge_saved, right_final_bridge_restored, right_final_bridge_after_root],
            leaves: [right_final_leaf_saved, right_final_leaf_restored, right_final_leaf_after_root],
            outputs: [right_final_origin, right_final_before_root_storm, right_final_after_storm, right_final_reproduced],
        },
    }
}
