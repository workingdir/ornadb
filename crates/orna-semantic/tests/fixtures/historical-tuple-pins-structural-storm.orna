pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);

pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn tuple_pin_slots_keep_identity_through_structural_storm_rebinds() {
    let rolling = (
        (sys.snapshot("HEAD~80"), sys.snapshot("HEAD~60")),
        sys.snapshot("HEAD~40"),
    );
    let stage_0 = rolling;
    rolling = (
        (sys.snapshot("HEAD~79"), sys.snapshot("HEAD~59")),
        sys.snapshot("HEAD~39"),
    );
    rolling = (
        (sys.snapshot("HEAD~78"), sys.snapshot("HEAD~58")),
        sys.snapshot("HEAD~38"),
    );
    rolling = (
        (sys.snapshot("HEAD~77"), sys.snapshot("HEAD~57")),
        sys.snapshot("HEAD~37"),
    );
    let stage_3 = rolling;
    rolling = (
        (sys.snapshot("HEAD~76"), sys.snapshot("HEAD~56")),
        sys.snapshot("HEAD~36"),
    );
    rolling = (
        (sys.snapshot("HEAD~75"), sys.snapshot("HEAD~55")),
        sys.snapshot("HEAD~35"),
    );
    rolling = (
        (sys.snapshot("HEAD~74"), sys.snapshot("HEAD~54")),
        sys.snapshot("HEAD~34"),
    );
    rolling = (
        (sys.snapshot("HEAD~73"), sys.snapshot("HEAD~53")),
        sys.snapshot("HEAD~33"),
    );
    let stage_7 = rolling;
    rolling = stage_0;
    let returned = rolling;

    let ((returned_primary, returned_secondary), returned_tertiary) = returned;
    let ((stage_3_primary, stage_3_secondary), _) = stage_3;
    let ((stage_7_primary, stage_7_secondary), _) = stage_7;
    {
        returned: {
            primary: [
                chained_factory(returned_primary),
                chained_factory(sys.snapshot("HEAD~80")),
            ],
            secondary: [
                chained_factory(returned_secondary),
                chained_factory(sys.snapshot("HEAD~60")),
            ],
            tertiary: [
                chained_factory(returned_tertiary),
                chained_factory(sys.snapshot("HEAD~40")),
            ],
        },
        stage_3: {
            primary: [
                chained_factory(stage_3_primary),
                chained_factory(sys.snapshot("HEAD~77")),
            ],
            secondary: [
                chained_factory(stage_3_secondary),
                chained_factory(sys.snapshot("HEAD~57")),
            ],
        },
        stage_7: {
            primary: [
                chained_factory(stage_7_primary),
                chained_factory(sys.snapshot("HEAD~73")),
            ],
            secondary: [
                chained_factory(stage_7_secondary),
                chained_factory(sys.snapshot("HEAD~53")),
            ],
        },
    }
}
