pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);

pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn cascade_at(root_pin: sys.SnapshotRef) = (
    chained_factory(root_pin),
    (bridge_pin: sys.SnapshotRef) => (
        chained_factory(bridge_pin)().read,
        (leaf_pin: sys.SnapshotRef) => (
            chained_factory(leaf_pin)().read,
            chained_factory(leaf_pin)().read(),
        ),
    ),
);

// The pair carries complete root-to-leaf closure chains through each storm rebind.
pub fn paired_chains_survive_snapshot_storm_rebinds() {
    let rolling = (cascade_at(sys.snapshot("HEAD~160")), cascade_at(sys.snapshot("HEAD~150")));
    let stage_0 = rolling;
    rolling = (cascade_at(sys.snapshot("HEAD~159")), cascade_at(sys.snapshot("HEAD~149")));
    rolling = (cascade_at(sys.snapshot("HEAD~158")), cascade_at(sys.snapshot("HEAD~148")));
    rolling = (cascade_at(sys.snapshot("HEAD~157")), cascade_at(sys.snapshot("HEAD~147")));
    let stage_3 = rolling;
    rolling = (cascade_at(sys.snapshot("HEAD~156")), cascade_at(sys.snapshot("HEAD~146")));
    rolling = (cascade_at(sys.snapshot("HEAD~155")), cascade_at(sys.snapshot("HEAD~145")));
    rolling = (cascade_at(sys.snapshot("HEAD~154")), cascade_at(sys.snapshot("HEAD~144")));
    rolling = (cascade_at(sys.snapshot("HEAD~153")), cascade_at(sys.snapshot("HEAD~143")));
    let stage_7 = rolling;
    rolling = stage_0;
    let returned = rolling;

    let (returned_left_chain, returned_right_chain) = returned;
    let (returned_left_root, returned_left_bridge_chain) = returned_left_chain;
    let (returned_left_bridge, returned_left_leaf_chain) = returned_left_bridge_chain(sys.snapshot("HEAD~120"));
    let (returned_left_reader, returned_left_continuation) = returned_left_leaf_chain(sys.snapshot("HEAD~80"));
    let (returned_right_root, returned_right_bridge_chain) = returned_right_chain;
    let (returned_right_bridge, returned_right_leaf_chain) = returned_right_bridge_chain(sys.snapshot("HEAD~110"));
    let (returned_right_reader, returned_right_continuation) = returned_right_leaf_chain(sys.snapshot("HEAD~70"));
    let (stage_3_left_chain, stage_3_right_chain) = stage_3;
    let (stage_3_left_root, stage_3_left_bridge_chain) = stage_3_left_chain;
    let (stage_3_left_bridge, stage_3_left_leaf_chain) = stage_3_left_bridge_chain(sys.snapshot("HEAD~117"));
    let (stage_3_left_reader, stage_3_left_continuation) = stage_3_left_leaf_chain(sys.snapshot("HEAD~77"));
    let (stage_3_right_root, stage_3_right_bridge_chain) = stage_3_right_chain;
    let (stage_3_right_bridge, stage_3_right_leaf_chain) = stage_3_right_bridge_chain(sys.snapshot("HEAD~107"));
    let (stage_3_right_reader, stage_3_right_continuation) = stage_3_right_leaf_chain(sys.snapshot("HEAD~67"));
    let (stage_7_left_chain, stage_7_right_chain) = stage_7;
    let (stage_7_left_root, stage_7_left_bridge_chain) = stage_7_left_chain;
    let (stage_7_left_bridge, stage_7_left_leaf_chain) = stage_7_left_bridge_chain(sys.snapshot("HEAD~113"));
    let (stage_7_left_reader, stage_7_left_continuation) = stage_7_left_leaf_chain(sys.snapshot("HEAD~73"));
    let (stage_7_right_root, stage_7_right_bridge_chain) = stage_7_right_chain;
    let (stage_7_right_bridge, stage_7_right_leaf_chain) = stage_7_right_bridge_chain(sys.snapshot("HEAD~103"));
    let (stage_7_right_reader, stage_7_right_continuation) = stage_7_right_leaf_chain(sys.snapshot("HEAD~63"));

    {
        returned: {
            left: {
                root: [returned_left_root, chained_factory(sys.snapshot("HEAD~160"))],
                bridge: [returned_left_bridge, chained_factory(sys.snapshot("HEAD~120"))().read],
                reader: [returned_left_reader, chained_factory(sys.snapshot("HEAD~80"))().read],
                continuation: [returned_left_continuation, chained_factory(sys.snapshot("HEAD~80"))().read()],
            },
            right: {
                root: [returned_right_root, chained_factory(sys.snapshot("HEAD~150"))],
                bridge: [returned_right_bridge, chained_factory(sys.snapshot("HEAD~110"))().read],
                reader: [returned_right_reader, chained_factory(sys.snapshot("HEAD~70"))().read],
                continuation: [returned_right_continuation, chained_factory(sys.snapshot("HEAD~70"))().read()],
            },
        },
        stage_3: {
            left: {
                root: [stage_3_left_root, chained_factory(sys.snapshot("HEAD~157"))],
                bridge: [stage_3_left_bridge, chained_factory(sys.snapshot("HEAD~117"))().read],
                reader: [stage_3_left_reader, chained_factory(sys.snapshot("HEAD~77"))().read],
                continuation: [stage_3_left_continuation, chained_factory(sys.snapshot("HEAD~77"))().read()],
            },
            right: {
                root: [stage_3_right_root, chained_factory(sys.snapshot("HEAD~147"))],
                bridge: [stage_3_right_bridge, chained_factory(sys.snapshot("HEAD~107"))().read],
                reader: [stage_3_right_reader, chained_factory(sys.snapshot("HEAD~67"))().read],
                continuation: [stage_3_right_continuation, chained_factory(sys.snapshot("HEAD~67"))().read()],
            },
        },
        stage_7: {
            left: {
                root: [stage_7_left_root, chained_factory(sys.snapshot("HEAD~153"))],
                bridge: [stage_7_left_bridge, chained_factory(sys.snapshot("HEAD~113"))().read],
                reader: [stage_7_left_reader, chained_factory(sys.snapshot("HEAD~73"))().read],
                continuation: [stage_7_left_continuation, chained_factory(sys.snapshot("HEAD~73"))().read()],
            },
            right: {
                root: [stage_7_right_root, chained_factory(sys.snapshot("HEAD~143"))],
                bridge: [stage_7_right_bridge, chained_factory(sys.snapshot("HEAD~103"))().read],
                reader: [stage_7_right_reader, chained_factory(sys.snapshot("HEAD~63"))().read],
                continuation: [stage_7_right_continuation, chained_factory(sys.snapshot("HEAD~63"))().read()],
            },
        },
    }
}
