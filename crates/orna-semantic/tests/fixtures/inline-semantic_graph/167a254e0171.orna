
            table Reading(id: Int) { value: Int, }
            fn increment(value: Int) = value + 1;
            pub fn direct(values: [Int]) = map(values, increment);
            pub fn pipeline(values: [Int]) = values | map(transform: value => value + 1);
            pub fn named(values: [Int]) = map(transform: value => value + 1, rows: values);
            pub fn flattened(values: [Int]) = flat_map(rows: values, transform: value => [value, value + 1]);
            pub fn reads(values: [Int]) = map(values, value => Reading.count() + value);
        