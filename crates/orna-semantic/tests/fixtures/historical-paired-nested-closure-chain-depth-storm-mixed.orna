pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn forwarded_factory(pin: sys.SnapshotRef) = factory_at(pin);

pub fn chained_factory(pin: sys.SnapshotRef) = forwarded_factory(pin);

pub fn cascade_at(root_pin: sys.SnapshotRef) =
    (bridge_pin: sys.SnapshotRef) =>
        (leaf_pin: sys.SnapshotRef) => {
            root: chained_factory(root_pin),
            nested: {
                bridge: chained_factory(bridge_pin)().read,
                leaf: {
                    reader: chained_factory(leaf_pin)().read,
                    continuation: chained_factory(leaf_pin)().read(),
                },
            },
        };

pub fn pair_at(left_root: sys.SnapshotRef, right_root: sys.SnapshotRef) =
    (cascade_at(left_root), cascade_at(right_root));

pub fn forwarded_pair(left_root: sys.SnapshotRef, right_root: sys.SnapshotRef) =
    pair_at(left_root, right_root);

pub fn chained_pair(left_root: sys.SnapshotRef, right_root: sys.SnapshotRef) =
    forwarded_pair(left_root, right_root);

// Rebind the pair of root chains, then separately storm-rebind their partially applied bridge chains.
pub fn paired_nested_chain_depth_storms_preserve_captured_pins() {
    let roots_rolling = chained_pair(sys.snapshot("HEAD~180"), sys.snapshot("HEAD~170"));
    let roots_0 = roots_rolling;
    roots_rolling = chained_pair(sys.snapshot("HEAD~179"), sys.snapshot("HEAD~169"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~178"), sys.snapshot("HEAD~168"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~177"), sys.snapshot("HEAD~167"));
    let roots_3 = roots_rolling;
    roots_rolling = chained_pair(sys.snapshot("HEAD~176"), sys.snapshot("HEAD~166"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~175"), sys.snapshot("HEAD~165"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~174"), sys.snapshot("HEAD~164"));
    roots_rolling = chained_pair(sys.snapshot("HEAD~173"), sys.snapshot("HEAD~163"));
    let roots_7 = roots_rolling;
    roots_rolling = roots_0;
    let roots_returned = roots_rolling;

    let (returned_left_chain, returned_right_chain) = roots_returned;
    let (stage_3_left_chain, stage_3_right_chain) = roots_3;
    let (stage_7_left_chain, stage_7_right_chain) = roots_7;

    let bridges_rolling = (returned_left_chain(sys.snapshot("HEAD~140")), returned_right_chain(sys.snapshot("HEAD~130")));
    let bridges_0 = bridges_rolling;
    bridges_rolling = (stage_3_left_chain(sys.snapshot("HEAD~139")), stage_3_right_chain(sys.snapshot("HEAD~129")));
    bridges_rolling = (stage_7_left_chain(sys.snapshot("HEAD~138")), stage_7_right_chain(sys.snapshot("HEAD~128")));
    bridges_rolling = (returned_left_chain(sys.snapshot("HEAD~137")), returned_right_chain(sys.snapshot("HEAD~127")));
    let bridges_3 = bridges_rolling;
    bridges_rolling = (stage_3_left_chain(sys.snapshot("HEAD~136")), stage_3_right_chain(sys.snapshot("HEAD~126")));
    bridges_rolling = (stage_7_left_chain(sys.snapshot("HEAD~135")), stage_7_right_chain(sys.snapshot("HEAD~125")));
    bridges_rolling = (returned_left_chain(sys.snapshot("HEAD~134")), returned_right_chain(sys.snapshot("HEAD~124")));
    bridges_rolling = (stage_7_left_chain(sys.snapshot("HEAD~133")), stage_7_right_chain(sys.snapshot("HEAD~123")));
    let bridges_7 = bridges_rolling;
    bridges_rolling = bridges_0;
    let bridges_returned = bridges_rolling;

    let (returned_left_leaf_chain, returned_right_leaf_chain) = bridges_returned;
    let returned_left_value = returned_left_leaf_chain(sys.snapshot("HEAD~100"));
    let returned_right_value = returned_right_leaf_chain(sys.snapshot("HEAD~90"));
    let (stage_3_left_leaf_chain, stage_3_right_leaf_chain) = bridges_3;
    let stage_3_left_value = stage_3_left_leaf_chain(sys.snapshot("HEAD~97"));
    let stage_3_right_value = stage_3_right_leaf_chain(sys.snapshot("HEAD~87"));
    let (stage_7_left_leaf_chain, stage_7_right_leaf_chain) = bridges_7;
    let stage_7_left_value = stage_7_left_leaf_chain(sys.snapshot("HEAD~93"));
    let stage_7_right_value = stage_7_right_leaf_chain(sys.snapshot("HEAD~83"));

    {
        returned: {
            left: {
                root: [returned_left_value.root, chained_factory(sys.snapshot("HEAD~180"))],
                bridge: [returned_left_value.nested.bridge, chained_factory(sys.snapshot("HEAD~140"))().read],
                reader: [returned_left_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~100"))().read],
                continuation: [returned_left_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~100"))().read()],
            },
            right: {
                root: [returned_right_value.root, chained_factory(sys.snapshot("HEAD~170"))],
                bridge: [returned_right_value.nested.bridge, chained_factory(sys.snapshot("HEAD~130"))().read],
                reader: [returned_right_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~90"))().read],
                continuation: [returned_right_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~90"))().read()],
            },
        },
        stage_3: {
            left: {
                root: [stage_3_left_value.root, chained_factory(sys.snapshot("HEAD~180"))],
                bridge: [stage_3_left_value.nested.bridge, chained_factory(sys.snapshot("HEAD~137"))().read],
                reader: [stage_3_left_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~97"))().read],
                continuation: [stage_3_left_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~97"))().read()],
            },
            right: {
                root: [stage_3_right_value.root, chained_factory(sys.snapshot("HEAD~170"))],
                bridge: [stage_3_right_value.nested.bridge, chained_factory(sys.snapshot("HEAD~127"))().read],
                reader: [stage_3_right_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~87"))().read],
                continuation: [stage_3_right_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~87"))().read()],
            },
        },
        stage_7: {
            left: {
                root: [stage_7_left_value.root, chained_factory(sys.snapshot("HEAD~173"))],
                bridge: [stage_7_left_value.nested.bridge, chained_factory(sys.snapshot("HEAD~133"))().read],
                reader: [stage_7_left_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~93"))().read],
                continuation: [stage_7_left_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~93"))().read()],
            },
            right: {
                root: [stage_7_right_value.root, chained_factory(sys.snapshot("HEAD~163"))],
                bridge: [stage_7_right_value.nested.bridge, chained_factory(sys.snapshot("HEAD~123"))().read],
                reader: [stage_7_right_value.nested.leaf.reader, chained_factory(sys.snapshot("HEAD~83"))().read],
                continuation: [stage_7_right_value.nested.leaf.continuation, chained_factory(sys.snapshot("HEAD~83"))().read()],
            },
        cross_chain: [returned_left_value.nested.leaf.reader, returned_right_value.nested.leaf.reader],
        },
    }
}
