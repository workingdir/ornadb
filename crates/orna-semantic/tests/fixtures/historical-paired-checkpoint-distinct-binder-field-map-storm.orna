pub fn factory_at(pin: sys.SnapshotRef) =
    sys.database.as_of(pin).energy.factory;

pub fn left_checkpoint_first(root_pin: sys.SnapshotRef) =
    (child_pin: sys.SnapshotRef) => {
        root_pin: sys.snapshot(root_pin),
        child_pin: sys.snapshot(child_pin),
        root: factory_at(root_pin),
        child: factory_at(child_pin),
    };

pub fn left_checkpoint_second(root_pin: sys.SnapshotRef) =
    (child_pin: sys.SnapshotRef) => {
        root_pin: sys.snapshot(root_pin),
        child_pin: sys.snapshot(child_pin),
        root: factory_at(root_pin),
        child: factory_at(child_pin),
    };

pub fn right_checkpoint_first(root_pin: sys.SnapshotRef) =
    (child_pin: sys.SnapshotRef) => {
        root_pin: sys.snapshot(root_pin),
        child_pin: sys.snapshot(child_pin),
        root: factory_at(root_pin),
        child: factory_at(child_pin),
    };

pub fn right_checkpoint_second(root_pin: sys.SnapshotRef) =
    (child_pin: sys.SnapshotRef) => {
        root_pin: sys.snapshot(root_pin),
        child_pin: sys.snapshot(child_pin),
        root: factory_at(root_pin),
        child: factory_at(child_pin),
    };

pub fn paired_checkpoint_distinct_binder_field_maps_across_storms() {
    let left_saved = [
        left_checkpoint_first(sys.snapshot("HEAD~840")),
        left_checkpoint_second(sys.snapshot("HEAD~838")),
    ];
    let left_rolling = left_saved;
    left_rolling = [
        left_checkpoint_first(sys.snapshot("HEAD~837")),
        left_checkpoint_second(sys.snapshot("HEAD~836")),
    ];
    left_rolling = [
        left_checkpoint_first(sys.snapshot("HEAD~835")),
        left_checkpoint_second(sys.snapshot("HEAD~834")),
    ];
    let left_after_storm = left_rolling;
    left_rolling = left_saved;
    let left_restored = left_rolling;

    let right_saved = [
        right_checkpoint_first(sys.snapshot("HEAD~830")),
        right_checkpoint_second(sys.snapshot("HEAD~828")),
    ];
    let right_rolling = right_saved;
    right_rolling = [
        right_checkpoint_first(sys.snapshot("HEAD~827")),
        right_checkpoint_second(sys.snapshot("HEAD~826")),
    ];
    right_rolling = [
        right_checkpoint_first(sys.snapshot("HEAD~825")),
        right_checkpoint_second(sys.snapshot("HEAD~824")),
    ];
    let right_after_storm = right_rolling;
    right_rolling = right_saved;
    let right_restored = right_rolling;

    {
        left: {
            saved: left_saved,
            after_storm: left_after_storm,
            restored: left_restored,
        },
        right: {
            saved: right_saved,
            after_storm: right_after_storm,
            restored: right_restored,
        },
    }
}
