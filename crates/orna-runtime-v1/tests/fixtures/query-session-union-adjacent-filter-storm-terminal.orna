sys.Storage
    | union(sys.MaintenanceJob | filter(job => job.id >= 8))
    | union(sys.MaintenanceJob | filter(job => job.id >= 8))
    | drop(0)
    | filter(storage => storage.id >= 8)
    | filter(storage => storage.id == 10 || storage.id >= 15)
    | filter(storage => storage.id == 10 || storage.id >= 20)
    | filter(storage => storage.id == 10 || storage.id == 20 || storage.id >= 25)
    | filter(storage => storage.id == 10 || storage.id == 20 || storage.id >= 30)
    | filter(storage => storage.id == 10 || storage.id == 20 || storage.id == 30)
    | filter(storage => sys.Storage.lookup(storage.target).title == "later")
    | exists(storage => true)
    |? (failure => failure.code)
