sys.Storage
    | take(0)
    | union(
        sys.Storage | project(storage => storage.id) | filter(id => id == 7)
        | union(
            sys.Storage | project(storage => storage.id) | filter(id => id == 7)
            | union(
                sys.Storage | project(storage => storage.id) | filter(id => id == 7)
                | union(
                    sys.Storage | project(storage => storage.id) | filter(id => id == 8)
                    | union(
                        sys.Storage | project(storage => storage.id) | filter(id => id == 7)
                        | union(
                            sys.Storage | project(storage => storage.id) | filter(id => id == 7)
                            | union(
                                sys.Storage | project(storage => storage.id) | filter(id => id == 7)
                                | union(
                                    sys.Storage | project(storage => storage.id) | filter(id => id == 8)
                                    | union(
                                        sys.Storage | project(storage => storage.target) | filter(id => id == 99)
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
    | filter(id => sys.Storage.lookup(id).title == "later")
    | take(2)
    | last() ?? 0
