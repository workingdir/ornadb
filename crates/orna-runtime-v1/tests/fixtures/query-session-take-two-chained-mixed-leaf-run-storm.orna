sys.Storage
    | filter(storage => storage.id >= 7 && storage.id < 15)
    | take(7)
    | filter(storage => storage.id != 8)
    | filter(storage => storage.id != 10)
    | filter(storage => storage.id != 12)
    | take(3)
    | filter(storage => storage.id != 11)
    | take(2)
    | union(
        sys.Storage
            | filter(storage => storage.id >= 15 && storage.id < 23)
            | take(6)
            | filter(storage => storage.id != 16)
            | filter(storage => storage.id != 18)
            | filter(storage => storage.id != 20)
            | take(2)
            | filter(storage => storage.id != 17)
            | take(1)
    )
    | union(
        sys.Storage
            | filter(storage => storage.id >= 23 && storage.id < 31)
            | take(8)
            | filter(storage => storage.id != 24)
            | filter(storage => storage.id != 26)
            | filter(storage => storage.id != 28)
            | filter(storage => storage.id != 30)
            | take(3)
            | filter(storage => storage.id != 23)
            | take(2)
    )
    | union(
        sys.Storage
            | filter(storage => storage.id >= 31 && storage.id < 39)
            | take(8)
            | filter(storage => storage.id != 32)
            | filter(storage => storage.id != 34)
            | filter(storage => storage.id != 36)
            | filter(storage => storage.id != 38)
            | take(3)
            | filter(storage => storage.id != 35)
            | take(2)
    )
    | union(
        sys.Storage
            | filter(storage => storage.id >= 39 && storage.id < 48)
            | take(9)
            | filter(storage => storage.id != 40)
            | filter(storage => storage.id != 42)
            | filter(storage => storage.id != 44)
            | take(6)
            | filter(storage => storage.id != 43)
            | take(5)
    )
    | filter(storage => storage.id != 9)
    | filter(storage => storage.id != 15)
    | filter(storage => storage.id != 25)
    | filter(storage => storage.id != 27)
    | filter(storage => storage.id != 31)
    | filter(storage => storage.id != 33)
    | filter(storage => storage.id != 39)
    | filter(storage => storage.id != 41)
    | filter(storage => storage.id != 45)
    | filter(storage => sys.Storage.lookup(storage.target).title == "later")
    | take(2)
    | count()
    |? (failure => failure.code)
