sys.Storage
    | take(0)
    | union(sys.Storage | project(storage => storage.id) | union(sys.Storage | project(storage => storage.target) | filter(id => id == 99) | union(sys.Storage | project(storage => storage.id) | filter(id => id == 8))))
    | take(4)
    | filter(id => sys.Storage.lookup(id).title == "later")
    | last() ?? 0
