if true {
    let shared_unknown = sys.MaintenanceJob
        | filter(job => job.id >= 8)
        | union(sys.MaintenanceJob | filter(job => job.id >= 9))
        | filter(job => job.id == 99);

    sys.Storage
        | filter(storage => storage.id >= 7)
        | filter(storage => storage.id == 99)
        | union(shared_unknown)
        | union(shared_unknown)
        | filter(job => job.id >= 10)
        | filter(job => job.id == 99)
        | exists(job => true)
        |? (failure => failure.code)
} else { 0 }
